      "dependsOn": [
        "Step 1.1 · Syllabary_CM",
        "Step 1.2 · join Unicode + Syllabary_CM",
        "Step 1.3 · rest Unicode signs",
        "Step 1.4 · join matched + rest signs",
        "Step 2 · Diri lexical list (optional)",
        "Steps 3-4 · sign catalogue v13",
        "Step 5.1 · ATF -> atf_tokens (school ATF folder)",
        "Step 5.2 · atf_tokens -> grapheme",
        "Check · verify the whole pipeline"
      ],
      "problemMatcher": [],
      "detail": "runs every step in order"
