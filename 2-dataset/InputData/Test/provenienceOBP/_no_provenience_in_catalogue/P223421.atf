5. ASZ{{zu-zu-um}} = %a ka-tu-u2-um
#for sum5-sum5
@reverse
@column 1
1. ukur3 si-ig = %a la-ap-nu-um
2. KA silim-ma = %a ka-tu-u2-um
3. KA-KA = %a mu-usz-ta-ri-hu-um
4. zu-ma = %a la-ap-nu-um
5. ASZ{{zu-zu-um}} = %a ka-tu-u2-um
