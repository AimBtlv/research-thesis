&P223421 = TIM 09, 090
#atf: use lexical
@obverse
@column 1
1. ukur3 si-ig = %a la-ap-nu-um
2. KA silim-ma = %a ka-tu-u2-um
3. KA-KA = %a mu-usz-ta-ri-hu!(RI)-um
4. zu-ma = %a la-ap-nu-um
