&P313396 = CT 43, 106
#atf: lang akk
@tablet
@obverse
1. _{d}marduk_ ra-i-im-ka a-hi ka-ta
2. asz-szu-mi-ia li-la-ab-bi-ir-ka
3. a-hi at-ta lu sza-al-ma-ta
4. ki-ma a-hi at-ta ti-du-u2
5. sza-at-ta-am u2-ul _sum{sar}_
6. u2-ul _sum el-lum{sar}_
7. u2-ul si-ir-bi-it-ta-am
8. tu-sza-bi-lam
9. a-na-ku u2-ul a-sza-ap-pa-ra-ak-kum
10. u3 at-ta szu-mi u2-ul ta-za-ak-ka-ar
11. {disz}mu-ba-li2-it,-_{d}marduk_
12. a-na ma-ah-ri-ka at,-t,ar-dam
13. sza 1(disz) _gin2 ku3-babbar sum{sar}_
14. sza 1(disz) _gin2 ku3-babbar sum el-lum{sar}_
15. u3 si-ir-bi-it-ta-am
@reverse
1. [s,i-im-da]-am#-ma szu-bi-lam
2. [ka]-la# sza#-at-ti a-na _ki-si3-ga_
3. bi#-ib-bu-li-im sza _e2_ a-bi-ka
4. [mi]-na-a a-na-ad-di-in
5. e#-si#-ir-ma _gu2-un a-sza3_ u3 _ka-sir3 e2_
6. i#-na#-di-im-ma 2(gisz) _gin2 [x] gu2?_ ma
7. a#-na _{d}utu#_ u3# be-el-ti-ia
8. _szuku_-ti [...]
9. u3# sza usz-ta-bi-lam
10. [x]-da# a-na _e2-babbar-ra_
11. [x]-da a-na _e2 ul-masz_ u3 _e2 {d}utu_
12. [x]-ad?-ig? li-sza-ki-lu
13. {d}na#-bi-um be-li
14. [da]-ri#-isz u4-mi li-la-ab-bi-ir-ka
