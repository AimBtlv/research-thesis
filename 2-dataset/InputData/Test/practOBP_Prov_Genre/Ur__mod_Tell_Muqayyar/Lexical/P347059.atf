11. ga-am3-ma-gen = %a lu-ut-ta-al-kam
12. he2-em-ma-du = %a li-it-ta-al-kam
$ double ruling
13. gen-am3-ma-sze = %a at-la-ka-asz-szum
14. ga-am3-ma-szi-gen = %a lu-ut-ta-al-ka-asz-szum
15. he2#-em-ma-szi-du = %a li-it-ta-al-ka-asz-szum
$ double ruling
16. gen-am3-ma-mu-sze = %a at-la-kam a-na s,e-ri-ia
17. ga-am3-mu-e-szi-gen = %a lu-ut-ta-al-ka-ak-kum
18. he2-em-mu-e-szi-du = %a li-it-ta-al-ka-ak-kum
$ double ruling
19. gen-ne2 = %a a-lik
20. ga-gen = %a lu-ul-lik
21. he2-en-du = %a li-il-lik
$ double ruling
22. gen-en-szi = %a a-lik-szum
23. ga-en-szi-gen = %a lu-ul-lik-szum
24. he2-en-szi-du = %a li-lik-szum
$ double ruling
25. gen-ba = %a at-la-ak
26. ga-ba-gen = %a lu-ut-ta-la-ak
27. ha-ba-du = %a li-it-ta-la-ak
$ double ruling
28. gen-ba-szi = %a at-la-ak-szum
29. ga-ba-szi-gen = %a lu-ut-ta-la-ak-szum
30. ha-ba-szi-du = %a li-it-ta-la-ak-szum
$ double ruling
31. am3-du = %a i-la-kam
32. am3-du-un = %a a-al-la-kam
33. am3-du-un = %a ta-al-la-kam
$ double ruling
34. am3-szi-du = %a i-il-la-ka-asz-szum
35. am3-szi-du-un = %a a-la-ka-asz-szum
36. am3-szi-du-un = %a ta-al-la-ka-asz-szum
$ double ruling
37. mu-e-szi-du = %a i-la-ka-ak-kum
38. mu-e-szi-du-un = %a a-la-ka-ak-kum
$ double ruling
39. am3-ma-du = %a it-ta-al-la-kam
40. am3-ma-du-un = %a at-ta-la-kam
41. am3-ma-du-un = %a ta-at-<ta>-al-la-kam
@reverse
1. am3-ma-szi-du = %a it-ta-al-<la>-ka-asz-szum
2. am3-ma-szi-du-un = %a at-ta-al-la-ka-asz-szum
3. am3-ma-szi-du-un = %a ta-at-ta-la-ka-asz-szum
$ double ruling
4. am3-mu-e-szi-du = %a it-ta-al-la-ka-asz-szum
5. am3-mu-e-szi-du-un = %a ta-at-ta-la-ka-asz-szum
$ double ruling
6. i3-du = %a i-la-ak
7. i3-du-un = %a a-la-ak
8. i3-du-un = %a ta#-la#-ak
$ double ruling
9. in-szi-du = %a i-la-ak-szum
10. in-szi-du-[un] = %a a-la-ak-szum
11. in-szi-du#-un# = %a ta-la-ak-szum
$ double ruling
12. ba-du# = %a it-ta-al-la-ak
13. ba-du-[un] = %a at-ta-al-la-ak
14. ba-du-un# = %a ta-at-ta-la-ak
$ double ruling
15. ba#-szi-du# = %a it-ta-al-la-ak-szum 
16. ba#-szi-du-un# = %a at-ta-al-la-ak-szum
17. ba#-szi-du-un = %a ta-at#-ta-al-la-ak-szum
$ double ruling
18. i-im-gen = %a il-li-kam
19. i-im-gen-en = %a al-[li]-kam
20. i-im-gen-en = %a ta-[al-li]-kam
$ double ruling
