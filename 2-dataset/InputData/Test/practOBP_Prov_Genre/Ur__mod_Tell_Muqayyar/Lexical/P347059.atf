33. im-mu-e-szi-gen-en = %a at-ta-al-ka-ak-kum!(SZUM)
$ double ruling
34. i3-gen = %a il-lik
35. i3-gen-en = %a al-lik
36. i3-gen-en = %a ta-al-lik
$ double ruling
37. in-szi-gen = %a il-lik-szum
38. in-szi-gen-en = %a al-lik-szum
39. in-szi-gen-en = %a ta-al-lik-szum
@left
