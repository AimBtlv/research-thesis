22. i-im-szi-gen-en = %a al-li-ka-asz-[szum]
23. i-im-szi-gen-en = %a ta-al-li-ka-asz-szum#
$ double ruling
24. mu-e-szi-gen = %a il-li-ka-ak-kum#
25. mu-e-szi-gen-en!(UN) = %a al-li-ka-ak-kum#
$ double ruling
26. im-ma-gen = %a it-ta-al-kam
27. im-ma-gen-en = %a at-ta-al-kam
28. im-ma-gen-en = %a ta!(AT)-at-ta-al-kam
$ double ruling
29. im-ma-szi-gen = %a it-ta-al-ka-asz-szum
30. im-ma-szi-gen-en = %a at-ta-al-ka-asz-szum
31. im-ma-szi-gen-en = %a ta-at-ta-al-ka-asz-szum
$ double ruling
