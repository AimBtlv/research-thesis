&P382520 = CT 02, pl. 39, Bu 1891-05-09, 387 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _e2_ su-mu-ra-a-ah 
#tr.ts: ana bīt sumu-araḫ
#tr.en: Concerning the house of Sumu-araḫ
2. sza _da e2_ ni-id-nu-sza 
#tr.ts: ša ṭēḫi bīt nidnuša
#tr.en: which is adjacent to the house of Nidnuša
3. u3 _da e2_ {d}al-la-tum 
#tr.ts: u ṭēḫi bīt allatum
#tr.en: and is adjacent to the temple of (the goddess) Allatum,
4. {disz}{d}suen-e-ri-ba-am 
#tr.ts: sîn-erībam
#tr.en: Sîn-erībam
5. _dumu_ akszak{ki}-ra-bi 
#tr.ts: mār akšak-rabî
#tr.en: son of Akšak-rabî
6. ib-qu2-ur2-ma 
#tr.ts: ibqurma
#tr.en: has claimed and then
7. a-na da-ia-<<NU>>-ni i-li-ku-ma 
#tr.ts: ana dayyānī i(l)likūma
#tr.en: they have gone to the judges.
8. da-ia-nu di-nam u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: dayyānū dīnam ušāḫizūšunūtīma
#tr.en: The judges have granted them a trial and,
9. {disz}{d}suen-e-ri-ba-am ar-nam 
#tr.ts: sîn-erībam arnam
#tr.en: (regarding) Sîn-erībam, a punishment
10. i-mi-du-szu-ma 
#tr.ts: īmidūšūma
#tr.en: they have imposed upon him and then
11. ku-nu-kam sza la ra-ga-mi 
#tr.ts: kunu(k)kam ša la ragāmi(m)
#tr.en: a sealed document (promising) not to sue
12. u2-sze-zi-bu-szu 
#tr.ts: ušēzibūšu
#tr.en: had him make out.
13. u2-ul i-ta-ar-ma 
#tr.ts: ul itârma
#tr.en: (That) again
14. {disz}{d}suen-e-ri-ba-am 
#tr.ts: sîn-erībam
#tr.en: Sîn-erībam,
@reverse 
1. a-na _e2_ su-mu-ra-a-ah 
#tr.ts: ana bīt sumu-araḫ
#tr.en: regarding the house of Sumu-araḫ,
2. u2-ul i-ra-ga-mu 
#tr.ts: ul ira(g)gamu
#tr.en: will not raise a claim,
3. _mu_ {d}utu sa3-bi-um u3 zimbir{ki} 
#tr.ts: nīš šamaš ṣabium u sippar
#tr.en: by the life of Šamaš, Ṣabium and Sippar (he has sworn).
4. _igi_ ia-ah-ba-as-DINGIR 
#tr.ts: maḫar yaḫbas-ilu
#tr.en: Before Yaḫbas-ilu (and)
5. _igi_ na-bi-i3-li2-szu 
#tr.ts: maḫar nabi-ilīšu
#tr.en: before Nabi-ilīšu,
6. _dumu-mesz_ li-pi2-it-esz18-dar 
#tr.ts: mārī lipit-ištar
#tr.en: sons of Lipit-ištar;
7. _igi_ ur-{d}szu-bu-la _sanga_ 
#tr.ts: maḫar ur-šubula šangû
#tr.en: before Ur-šubula chief administrator,
8. _dumu_ er3-ra-na-da 
#tr.ts: mār erra-nada
#tr.en: son of Erra-nada;
9. _igi_ {d}utu-ma-an-szum2 _dumu_ i3-li2-KA-ga-mil 
#tr.ts: maḫar šamaš-manšum mār ilī-pî-gāmil
#tr.en: before Šamaš-manšum, son of Ilī-pî-gāmil;
10. _igi_ {d}suen-be-el-i3-li2 _dumu_ nu-ur2-sin 
#tr.ts: maḫar sîn-bēl-ilī mār nūr-sîn
#tr.en: before Sîn-bēl-ilī, son of Nūr-sîn;
11. _igi_ be-li2-na-s,ir _dumu_ sin-ga-mil 
#tr.ts: maḫar bēlī-nāṣir mār sîn-gāmil
#tr.en: before Bēlī-nāṣir, son of Sîn-gāmil;
12. _igi_ en-ne-nu-um _dumu_ za-na-tum 
#tr.ts: maḫar ennenum mār zanatum
#tr.en: before Ennenum, son of Zanatum;
13. _igi_ ARAD2-sa3 _dumu_ i3-li2-ib-ba-an-ni 
#tr.ts: maḫar warassa mār ilī-ibbanni
#tr.en: before Warassa, son of Ilī-ibbanni;
14. _igi_ i-na-szu-{d}utu _dumu_ i3-li2-i-din-nam 
#tr.ts: maḫar īnašu-šamaš mār ilī-i(d)dinam
#tr.en: before Īnašu-šamaš, son of Ilī-iddinam;
15. _igi_ {d}suen-tab-ba-we-di-im 
#tr.ts: maḫar sîn-tappâ-wedim
#tr.en: before Sîn-tappâ-wedim,
@left 
1. _dumu_ sze-ru-um-i3-li2 _igi_ a-ba-tum _dub-sar_ 
#tr.ts: mār šerum-ilī maḫar abatum ṭupšarrum
#tr.en: son of Šerum-ilī; before Abatum, the scribe;
2. _igi_ sza-ma-ia _dumu_ ur-{d}nanna 
#tr.ts: maḫar šamaya mār ur-nanna
#tr.en: before Šamaya, son of Ur-nanna;
3. _igi_ mu-na-wi-ru-um _dumu_ sin-e-ri-ba 
#tr.ts: maḫar muna(w)wirum mār sîn-erībam
#tr.en: before Munawwirum, son of Sîn-erībam.
