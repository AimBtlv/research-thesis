&P365124 = CT 02, pl. 46, Bu 1891-05-09, 2181 
#atf: lang akk 
@tablet 
@obverse 
1. {disz}a-hu-szi-na {disz}ib-ni-{d}utu 
#tr.ts: aḫūšina ibni-šamaš
#tr.en: Aḫūšina, Ibni-šamaš,
2. {disz}il-ta-ni {disz}ku-za-ba-tum 
#tr.ts: iltani kuzabatum
#tr.en: Iltani (and) Kuzabatum
3. _dumu-mesz_ er3-ra-ga-mil 
#tr.ts: mārī erra-gāmil
#tr.en: the sons of Erra-gāmil,
4. {disz}na-ra-am-tum u3 sa-mi-nu-u2 
#tr.ts: narāmtum u saminū
#tr.en: Narāmtum and Saminū,
5. asz-sza-at er3-ra-ga-mil u3 nu-ur2-sin 
#tr.ts: aššat erra-gāmil u nūr-sîn
#tr.en: the wives of Erra-gāmil, and Nūr-sîn
6. _szesz_ a-bi-szu-nu a-na e-ri-ib-sin 
#tr.ts: aḫi abīšunu ana erīb-sîn
#tr.en: their uncle (lit. the brother of their father), against Erīb-sîn,
7. _dumu_ puzur4-akszak{ki} a-na mi-im-ma 
#tr.ts: mār puzur-akšak ana mimma
#tr.en: son of Puzur-akšak, for everything
8. sza er3-ra-ga-mil i-zi-bu 
#tr.ts: ša erra-gāmil īzibu
#tr.en: that Erra-gāmil had left
9. u3 e-li-szu ir-szu-u2 
#tr.ts: u elīšu iršû
#tr.en: and (still) they had a claim against him,
10. i-tu-ru ir-gu-mu-ma 
#tr.ts: itūrū irgumūma
#tr.en: brought again a claim. So
11. {disz}su-mu-akszak{ki} ik-szu-du-ma 
#tr.ts: sumu-akšak ikšudūma
#tr.en: they approached Sumu-akšak and
12. di-nam u2-sza-hi-zu-nu-ti-ma 
#tr.ts: dīnam ušāḫi(s)sunūtīma
#tr.en: he granted them a trial and
13. {disz}e-ri-ib-sin a-na _e2_ {d}utu 
#tr.ts: erīb-sîn ana bīt šamaš
#tr.en: Erīb-sîn to the temple of Šamaš
14. a-na u2-bu-bi-im id-di-isz-szu!-ma 
#tr.ts: ana u(b)bubim iddiššūma
#tr.en: they handed over to clear himself.
15. i-na _ka2-mah_ a-na mi-im-ma 
#tr.ts: ina bābim ṣīrim ana mimma
#tr.en: At the “High Gate”, concerning all
16. sza er3-ra-ga-mil 
#tr.ts: ša erra-gāmil
#tr.en: of Erra-gāmil:
17. isz-tu pe2-e a-di _ku3-sig17_ 
#tr.ts: ištu pê adi ḫurāṣim
#tr.en: “everything (lit. from chaff to gold)
18. it-ti-ia la i-ba-asz-szu-u2 
#tr.ts: ittīya la ibaššû
#tr.en: is (lit. are) not with me” (= I haven't)
19. it-ma-ma 
#tr.ts: itmāma
#tr.en: swore and thus
@reverse 
1. ru-gu-mu-szu-nu na-as2-hu 
# coll. Ferwerda 
#tr.ts: rugu(m)mûšunu nasḫu
#tr.en: thier claim was rejected.
2. tup-pi2 la ra-ga-mi-im 
#tr.ts: ṭuppi la ragāmim
#tr.en: A tablet (promising) not to sue
3. isz-nu-u2-ma a-na e-ri-ib-sin 
#tr.ts: išnūma ana erīb-sîn
#tr.en: again, to Erīb-sîn
4. i-zi-bu u2-ul i-tu!(ta)-ru-ma 
#tr.ts: īzibū ul itu(r)rūma
#tr.en: they made out. (That) they will not return
5. a-na e-ri-ib-sin u2-ul i-ra-ga-mu 
#tr.ts: ana erīb-sîn ul ira(g)gamu
#tr.en: and not bring a claim against Erīb-sîn,
6. _mu_ {d}utu {d}a-a {d}marduk 
#tr.ts: nīš šamaš ayya marduk
#tr.en: by the life of Šamaš, Ayya, Marduk
7. u3 sin-mu-ba-li2-it, 
#tr.ts: u sîn-muba(l)liṭ
#tr.en: and Sîn-muballiṭ
8. _in-pa3-de3-esz_ 
#tr.ts: itmû
#tr.en: they have sworn.
$ single ruling 
9. _igi_ i3-li2-i-din-nam _dumu_ en-nam-sin 
#tr.ts: maḫar ilī-i(d)dinam mār ennam-sîn
#tr.en: Before Ilī-iddinam, son of Ennam-sîn;
10. _igi_ sin-e-ri-ba-am _dumu_ {d}nanna-lu2-ti 
#tr.ts: maḫar sîn-erībam mār nanna-luti
#tr.en: before Sîn-erībam, son of Nanna-luti;
11. _igi_ szu-i3-li2-szu _dumu_ lu2-{d}utu 
#tr.ts: maḫar šū-ilīšu mār awīl-šamaš
#tr.en: before Šū-ilīšu, son of Awīl-šamaš;
12. _igi_ lu2-{d}nin-szubur-ka _dumu_ na-bi-ia? 
#tr.ts: maḫar lu-ninšuburka mār nabīya
#tr.en: before Lu-ninšuburka, son of Nabīya;
13. _igi_ im-gur-sin _igi_ qi2-isz-nu-nu 
#tr.ts: maḫar imgur-sîn maḫar qīš-nunu
#tr.en: before Imgur-sîn (and) before Qīš-nunu,
14. _dumu-me_ ib-ni-{d}iszkur 
#tr.ts: mārī ibni-adad
#tr.en: sons of Ibni-adad;
15. _igi_ ig-mil-sin _dumu_ sin-be-el-i3-li2 
#tr.ts: maḫar igmil-sîn mār sîn-bēl-ilī
#tr.en: before Igmil-sîn, son of Sîn-bēl-ilī;
16. _igi_ sig-{d}iszkur _dumu_ na-ra-am-i3-li2-szu 
#tr.ts: maḫar ipqu-adad mār narām-ilīšu
#tr.en: before Ipqu-adad, son of Narām-ilīšu;
17. _igi_ ARAD2-i3-li2-szu _dumu_ puzur4-{d}utu 
#tr.ts: maḫar warad-ilīšu mār puzur-šamaš
#tr.en: before Warad-ilīšu, son of Puzur-šamaš;
18. _igi_ a-pi2-lum _dumu_ ib-ni-{d}SZU-PA 
#tr.ts: maḫar apilum mār ibni-šupa
#tr.en: before Apilum, son of Ibni-šupa;
19. _igi_ ip-qa2-tum _dumu_ sin-e-ri-ba-am 
#tr.ts: maḫar ipqatum mār sîn-erībam
#tr.en: before Ipqatum, son of Sîn-erībam;
20. _igi_ nu-ur2-{d}utu _dumu_ sin-ki-nam-di-ni 
#tr.ts: maḫar nūr-šamaš mār sîn-kīnam-dini
#tr.en: before Nūr-šamaš, son of Sîn-kīnam-dini;
21. _igi_ e!-tel-an-na-sze-me _dumu_ sin-la-ma-su2# 
#tr.ts: maḫar etel-annašeme mār sîn-lama(s)su
#tr.en: before Etel-annašeme, son of Sîn-lamassu.
@left 
@column 1 
1. _mu ugnim_ tam-unug!(tum){ki} 
#tr.ts: šanat ummān larsam
#tr.en: The year: “(Sîn-muballiṭ defeated) the army of Larsa”
@column 2 
1. _igi_ e-ri-ib-sin 
#tr.ts: maḫar erīb-sîn
#tr.en: before Erīb-sîn,
2. _dumu_ e-ri-ba-ia 
#tr.ts: mār erībaya
#tr.en: son of Erībaya.

