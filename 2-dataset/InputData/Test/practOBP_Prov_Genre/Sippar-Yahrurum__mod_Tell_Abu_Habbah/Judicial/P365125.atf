&P365125 = CT 02, pl. 50, Bu 1891-05-09, 2463 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _a-sza3 e2 sag-geme2 sag-ARAD_ 
#tr.ts: ana eqlim bītim amtim wardim
#tr.en: Concerning a field, a house, a female slave, a male slave
2. u3 _{gesz}kiri6 {gesz}geszimmar gub-ba_ 
#tr.ts: u kirîm gišimmarim zaqpim
#tr.en: and a date palm grove
3. i-ta bi-zi-za-na 
#tr.ts: itā bizīzāna
#tr.en: next to (the property of) Bizīzāna
4. u3 isz-ka-ri-im sza {d}utu 
#tr.ts: u iškarim ša šamaš
#tr.en: and (next to) the iškaru-field of Šamaš,
5. {disz}be-le-su2-nu u3 na-ap-sa-nu-um 
#tr.ts: bēle(s)sunu u napsānum
#tr.en: Bēlessunu and Napsānum
6. u3 ma!-ta-tum _dumu-munus_ i-zi-da-ri-e 
#tr.ts: u mātātum mārat iṣi-darê
#tr.en: and Mātātum daughter of Iṣi-darê,
7. a-na ma-ia-tum u3 su-mu-ra-ah 
#tr.ts: ana mayyatum u sumu-rāḫ
#tr.en: against Mayyatum and Sumu-rāḫ
8. _dumu-me_ a-sa3-li-ia 
#tr.ts: mārī azalīya
#tr.en: sons of Azalīya
9. ir-gu-mu-u2-ma 
#tr.ts: irgumūma
#tr.en: have brought a claim but
10. _di-ku5-mesz_ i-na _e2_ {d}utu 
#tr.ts: dayyānū ina bīt šamaš
#tr.en: the judges in the temple of Šamaš
11. ru-gu-mi-szu-nu i-su2-hu 
#tr.ts: rugu(m)mišunu i(s)suḫū
#tr.en: have rejected their complaint.
12. u2-ul i-tu-ru-ma 
#tr.ts: ul itu(r)rūma
#tr.en: Anew,
13. a-na wa-ar-ki-at _u4_-mi 
#tr.ts: ana warkiāt ūmī
#tr.en: in future,
14. a-na _a-sza3 e2 sag-geme2 sag-ARAD_ 
#tr.ts: ana eqlim bītim amtim wardim
#tr.en: for the field, the house, the female and the male slaves
15. u3 _{gesz}kiri6_ 
#tr.ts: u kirîm
#tr.en: and the orchard
@reverse 
1. sza ma-ia-tum u3 su-mu-ra-ah 
#tr.ts: ša mayyatum u sumu-rāḫ
#tr.en: of Mayyatum and Sumu-rāḫ,
2. {disz}be-le-su2-nu {disz}na-ap-sa-nu-um 
#tr.ts: bēle(s)sunu napsānum
#tr.en: Belessunu, Napsānum
3. u3 ma-ta-tum _dumu-munus_ i-zi-da-ri-e 
#tr.ts: u mātātum mārat iṣi-darê
#tr.en: and Mātātum daughter of Iṣi-darê,
4. isz-tu zi-ka-ri-im 
#tr.ts: ištu zikarim
#tr.en: male
5. a-di si2-ni-isz-tim!(tum)
#tr.ts: adi si(n)ništim
#tr.en: or female (lit. from male to female),
6. _dumu-mesz_ a-mur-ru-um 
#tr.ts: mārū amurrûm
#tr.en: (or any) children of Amurrûm,
7. a-na ma-ia-tum u3 su-mu-ra-ah 
#tr.ts: ana mayyatum u sumu-rāḫ
#tr.en: against Mayyatum and Sumu-rāḫ
8. u2-ul e-ra-ga-mu 
#tr.ts: ul era(g)gamū
#tr.en: will not bring a claim.
9. di-in _e2_ {d}utu i-na e2-babbar 
#tr.ts: dīn bīt šamaš ina ebabbar
#tr.en: Verdict of the temple of Šamaš in Ebabbar.
10. _mu_ {d}utu {d}a-a {d}marduk 
#tr.ts: nīš šamaš ayya marduk
#tr.en: By the life of Šamaš, Ayya, Marduk
11. u3 sa3-bi-um it-ma 
#tr.ts: u ṣabium itma
#tr.en: and Ṣabium, they (lit. he) have sworn.
12. {disz}i-bi-sin _dumu_ na-bi-i3-li2-szu 
#tr.ts: i(b)bi-sîn mār nabi-ilīšu
#tr.en: Ibbi-sîn son of Nabi-ilīšu,
13. {disz}isz-me-{d}iszkur 
#tr.ts: išme-adad
#tr.en: Išme-adad,
14. {disz}{d}utu-ia 
#tr.ts: šamšīya
#tr.en: Šamšīya,
15. {disz}nu-ur2-i3-li2-szu 
#tr.ts: nūr-ilīšu
#tr.en: Nūr-ilīšu
16. _di-ku5-mesz_ 
#tr.ts: dayyānū
#tr.en: are the judges.
17. _igi_ nu-nu-uru4 
#tr.ts: maḫar nunu-ēriš
#tr.en: Before Nunu-ēriš;
@left 
@column 1 
