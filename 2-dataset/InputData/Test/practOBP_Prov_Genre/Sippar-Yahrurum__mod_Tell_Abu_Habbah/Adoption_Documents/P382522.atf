&P382522 = CT 02, pl. 40, Bu 1891-05-09, 394 
#atf: lang akk 
@tablet 
@obverse 
1. {disz}ka-ra-na-tum 
#tr.ts: karānatum
#tr.en: Karānatum

2. _dumu-munus_ nu-ur2-{d}suen 
#tr.ts: mārat nūr-sîn
#tr.en: is the daughter of Nūr-sîn.

3. i-na ma-ri-szu u3 ma-ra-ti-[szu] 
#tr.ts: ina mārīšu u mārātīšu
#tr.en: Among his sons and his daughters,

4. mi-im-ma ma-ma-an 
#tr.ts: mimma ma(m)man
#tr.en: to nobody, anything

5. e-li ka-ra-na-tum 
#tr.ts: eli karānatum
#tr.en: Karāntum

6. _dumu-munus_ nu-ur2-{d}suen 
#tr.ts: mārat nūr-sîn
#tr.en: daughter of Nūr-sîn

7. u2-la i-szu 
#tr.ts: ula isû
#tr.en: owes.

8. da-mi-iq-tum 
#tr.ts: damiqtum
#tr.en: Damiqtum

9. _nin-a-ni_ sza ka-ra-na-tum 
#tr.ts: aḫāssa ša karānatum
#tr.en: her sister, of Karānatum,

10. a-na mu-ti-im 
#tr.ts: ana mutim
#tr.en: will marry (lit. to a husband

11. i-na-di-szi 
#tr.ts: ina(d)di(š)ši
#tr.en: will give) her.

@reverse 
1. _igi_ e2-a-i-din-nam 
#tr.ts: maḫar ea-i(d)dinam
#tr.en: Before Ea-iddinam

2. _dumu_ zi-ki-la-ia 
#tr.ts: mār zikilaya
#tr.en: son of Zikilaya;

3. _igi_ s,i2-is-su-na-ra-at 
#tr.ts: maḫar ṣissu-na(m)rat
#tr.en: before Ṣissu-namrat

4. _dumu_ i3-li2-isz-ti-kal2 
#tr.ts: mār iliš-tikal
#tr.en: son of Iliš-tikal;

5. _igi_ u-bar-ru-um _dumu_ sin-tab-ba-we-di 
#tr.ts: maḫar ubarrum mār sîn-tappâ-wēdi(m)	
#tr.en: before Ubarrum son of Sîn-tappa-wēdim;

6. _igi_ ip-qu2-sza _dumu_ ku-na-tum 
#tr.ts: maḫar ipquša mār kunatum
#tr.en: before Ipquša son of Kunatum;

7. _igi_ sin-be-la-ap-li 
#tr.ts: maḫar sîn-bēl-apli(m)
#tr.en: before Sîn-bēl-aplim

8. _dumu_ be-la-nu-um
#tr.ts: mār bēlanum						
#tr.en: son of Bēlanum.
