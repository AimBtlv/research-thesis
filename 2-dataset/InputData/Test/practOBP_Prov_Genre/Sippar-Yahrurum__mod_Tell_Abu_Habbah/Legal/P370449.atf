&P370449 = CT 08, pl. 17, Bu 1888-05-12, 040 
#atf: lang akk 
@tablet 
@obverse 
1. [a]-na# sza-pi2-il-ti _ku3-babbar_-im 
#tr.ts: ana šapilti kaspim
#tr.en: Concerning the remainder of the silver

2. sza# _a-sza3_-im 
#tr.ts: ša eqlim
#tr.en: for (lit. of) the field

3. [sza] lu2-{d}nin-szubur-ka _dumu_ szu-{d}utu 
#tr.ts: ša lu-ninsuburka mār šū-šamaš
#tr.en: which Lu-ninsuburka son of Šū-šamaš

4. _ki_ ga-ru-bu-um i-sza-mu 
#tr.ts: itti garubum išāmu
#tr.en: from Garubum had bought,

5. {disz}ga-ru-bu-um 
#tr.ts: garubum
#tr.en: Garubum

6. ir-gu-um-ma 
#tr.ts: irgumma
#tr.en: raised a claim and 

7. _ku3-babbar_-am li-ba-szu ut,-t,e4#-[eb] 
#tr.ts: kaspam li(b)bašu uṭṭīb
#tr.en: (Lu-ninsuburka) satisfied his (of Garubum) heart with the silver.

8. u2-ul i-ta-ar-[ma] 
#tr.ts: ul itârma
#tr.en: (That) again

9. {disz}ga-ru-bu-um# 
#tr.ts: garubum
#tr.en: Garubum

10. _dumu_ szu-mi-a-hi-ia# 
#tr.ts: mār šumī-aḫīya
#tr.en: son of Šumī-ahīya

11. a-na _a-sza3_-im u2-ul i-ra#-[ga-am] 
#tr.ts: ana eqlim ul ira(g)gam
#tr.en: will not sue regarding the field,

12. _mu_ {d}utu {d}amar-utu sa3!-bi#-[um] 
#tr.ts: nīš šamaš marduk sabium
#tr.en: (by) the name of Šamaš, Marduk (and) Sabûm

13. it-ma 
#tr.ts: itmâ
#tr.en: he swore.

@reverse 
1. _igi_ be-li2-ia _dumu_ nu-ur2#-[i3-li2-szu] 
#tr.ts: maḫar bēlīya mār nūr-ilīšu
#tr.en: Before Bēlīya son of Nūr-ilīšu;

2. _igi_ nu-ri-ia 
#tr.ts: maḫar nūrīya
#tr.en: before Nūrīya

3. _dumu_ ma-nu-um-ki-{d}suen# 
