#tr.ts: maḫar za(l)lilum mār sîn-i(d)dinam
#tr.en: before Zallilum son of Sîn-iddinam;

5. _igi_ {d}nanna-ki-ag2 
#tr.ts: maḫar nanna-ki-ag
#tr.en: before Nanna-kiag;

6. _dumu_ a-ri-ik-i-di#-[{d}en-lil2] 
#tr.ts: maḫar arik-idi-enlil
#tr.en: before Arik-idi-enlil;

7. _igi_ ib-ni-{d}en-lil2 
#tr.ts: maḫar ibni-enlil
