&P509808 = MHET 2/3, 425 
#atf: lang akk 
@tablet 
@obverse 
1. _[n(iku)] GAN2 a-sza3_ i-na _a-gar3_ a-ta-na#-nu-um 
2. i-ta _a-sza3_ ARAD-{d}suen _dumu_ ha-li-lum 
3. u3 i-ta nam-ka-ar a-ba-tim 
4. _sag-bi_ nam-ka-ar a-ta2-nu-um 
5. _sag-bi 2(disz)-kam-ma a-sza3_ tab-ba-we-di-im 
6. _ki_ sze-ri-ik-ti-{d}a-a _lukur_ {d}utu 
7. _dumu-munus_ {d}utu-sipa 
8. {disz}be-le-su2-nu _lukur_ {d}utu 
9. _dumu-munus_ i-ku-un-pi4-{d}suen 
10. i-na _har ku3-babbar-sza in-szi-in-sa10_ 
11. _sa10 til-la-bi-sze3_ 
12. _1(u) 3(disz) 1/3(disz) gin2 ku3-babbar in-na-an-la2 _
13. _inim-bi al-til_ 
14. _u4 kur2#-sze3 lu2 lu2-ra_ 
15. _inim nu-um-ga2-ga2#-a_ 
@reverse 
1. _mu_ {d}utu {d}a-a {d}marduk 
