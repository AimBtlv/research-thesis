#tr.en: and the city of Sippar, they have sworn together.
13. _igi_ i-din-nu-nu _dumu_ li-pi2-it-{d}en-lil2 
#tr.ts: maḫar i(d)din-nunu mār lipit-enlil
#tr.en: Before Iddin-nunu son of Lipit-enlil;
14. _igi_ i-din-{d}ma-mu _dumu_ na-nu-um 
#tr.ts: maḫar i(d)din-mamu mār nanum
#tr.en: before Iddin-mamu son of Nanum;
15. _igi_ sza-i3-li2-szu _dumu_ {d}mar-tu-na-s,ir 
#tr.ts: maḫar ša-ilīšu mār amurru-nāṣir
#tr.en: before Ša-ilīšu son of Amurru-nāṣir;
16. _igi_ nu-ur2-{d}kab-ta _dumu_ im-gur-{d}suen 
#tr.ts: maḫar nūr-kabta mār imgur-sîn
#tr.en: before Nūr-kabta son of Imgur-sîn;
17. _igi_ u-bar-ru-um _dumu_ {d}suen-le-e-i 
#tr.ts: maḫar ubarrum mār sîn-lē’î
#tr.en: before Ubarrum son of Sîn-lē’î;
18. _igi_ t,a3-ab-<gi6>-uri2{ki} _dumu_ ak-sza-ia 
#tr.ts: maḫar ṭāb-akkadim mār akšaya
#tr.en: before Ṭāb-akkadim son of Akšaya;
19. _igi_ {d}utu-dingir _dumu_ im-di-{d}en-lil2 
#tr.ts: maḫar šamaš-ilī mār imdi-enlil
#tr.en: before Šamaš-ilī son of Imdī-enlil;
20. _igi_ {d}utu-da-a-an _dumu_ sin-ka-szi-id 
#tr.ts: maḫār šamaš-dan mār sîn-kašid
#tr.en: before Šamaš-dan son of Sîn-kašid;
21. _igi_ ak-sza-ia _dumu_ {d}utu-he2-gal2 
