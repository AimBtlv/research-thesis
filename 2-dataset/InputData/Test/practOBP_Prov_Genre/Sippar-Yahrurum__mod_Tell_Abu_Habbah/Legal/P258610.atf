@obverse 
1. _e2_ ma-hi-ri-im 
#tr.ts: bīt maḫīrim
#tr.en: A stall
2. _ki_ ri-ba-tum _lukur-{d}utu_ 
#tr.ts: itti ri(b)batum nadīt šamaš
#tr.en: from Ribbatum nadītu of Šamaš
3. _dumu-<munus>_ ip-qa2-tum 
#tr.ts: mārat ipqatum
#tr.en: daughter of Ipqatum,
4. {disz}a-di-du-um 
#tr.ts: adidum
#tr.en: Adidum,
5. a-na ki-is,-ri 
#tr.ts: ana kiṣrī
#tr.en: against payment of rent
6. a-na _mu 1(disz)-kam_
#tr.ts: ana ištēt šattim
#tr.en: for one year,
7. u2-sze-s,i2 
#tr.ts: ušēṣi
#tr.en: has rented.
@reverse 
1. ki-is,-ri _mu 1(disz)-kam_-szu 
#tr.ts: kiṣrī šattīšu
#tr.en: (As) yearly rental,
2. _1(disz) gin2 igi-6(disz)-gal2 ku3-babbar_ 
#tr.ts: išten šuduš šiqil kaspam
#tr.en: 210 grains of silver
3. _i3-la2-e_ 
#tr.ts: išaqqal
#tr.en: he will pay.
$ single ruling
4. ba-am-ta-am  
#tr.ts: bāmtam
#tr.en: Half (of the rental fee),
5. i-na e-re-bi-szu
#tr.ts: ina erēbīšu
#tr.en: by the time of his moving in,
6. i-sza!-qa2-al 
#tr.ts: iša(q)qal
#tr.en: he will pay.
7. _igi_ sig-an-tum 
#tr.ts: maḫar ipqu-antum
#tr.en: Before Ipqu-antum;
8. _igi_ i3-li2-ma-a-bi 
#tr.ts: maḫar ilīma-abī
#tr.en: before Ilīma-abī.
@left 
