&P512370 = BAP 107
#atf: lang akk
@tablet
@obverse
1. 1(disz) _sag-geme2_ an-pi4-sza qa2-du _dumu-mesz gaba_
#tr.ts: ištēt amtum annum-pîša qadu mārī irtim
#tr.en: 1 female slave, (her name is) Annum-pîša, togheter with (her) suckling sons

2. _ha-la_ ARAD2-{d}marduk _ugula gidri_
#tr.ts: zitti warad-marduk wakil ḫaṭṭim
#tr.en: is the share of capitain Warad-marduk;

3. 1(disz) _sag-ARAD2_ s,il2-li2-{d}er3-ra
#tr.ts: ištēn wardum ṣilli-erra
#tr.en: 1 male slave, (his name is) Ṣilli-erra,

4. _ha-la_ ib-ni-{d}marduk
#tr.ts: zitti ibni-marduk
#tr.en: is the share of Ibni-marduk;

5. 1(disz) _sag-geme2_ la-la-bi-tum
#tr.ts: ištēt amtum lalabitum
#tr.en: 1 female slave, (her name is) Lalabitum,

6. _ha-la_ pa-as-sa3-lum
#tr.ts: zitti passālum
#tr.en: is the share of Passālum;

7. mi-im-ma an-ni-i-im
#tr.ts: mimma annîm
#tr.en: all these

8. _ha-la hi-a dumu-mesz_ ARAD2-{d}ul-masz-szi-tum
#tr.ts: zīzāt mārī warad-ulmaššitum
#tr.en: are the shares of Warad-ulmaššitum's sons

9. sza ARAD2-{d}marduk _ugula gidri_ a-hu-szu-nu
#tr.ts: ša warad-marduk wakil ḫaṭṭim aḫūšunu
#tr.en: that capitain Warad-marduk their brother,

10. i-na e-mu-uq ra-ma-ni-szu
#tr.ts: ina emūq ramānīšu
#tr.en: on the strenght of his own (share),

11. ir-szu-u2-ma
#tr.ts: iršûma
#tr.en: acquired and

12. a-na ib-ni-{d}marduk
#tr.ts: ana ibni-marduk
#tr.en: with Ibni-marduk

13. u3 pa-as-sa3-lum ah-hi-szu
#tr.ts: u passālum aḫḫīšu
#tr.en: and Passālum his brothers,

14. i-na t,u2-ba-ti-szu i-zu-zu
#tr.ts: ina ṭūbātīšu izūzu
#tr.en: voluntarily (lit. of his own good intentions) has shared.

15. isz-tu ARAD2-{d}marduk _ugula gidri_ a-hu-szu-nu
#tr.ts: ištu warad-marduk wakil ḫaṭṭim aḫūšunu
#tr.en: Since capitain Warad-marduk their brother,

16. a-na mar-szi-it
#tr.ts: ana maršīt
#tr.en: with respect to the property of

17. {disz}ARAD2-{d}ul-masz-szi-tum a-bi-szu-nu
#tr.ts: warad-ulmaššitum abīšunu
#tr.en: Warad-ulmaššitum their father,

18. i-na ni-isz _dingir_
#tr.ts: ina nīš ilim
#tr.en: by taking an oath (lit. by the life of the god)

19. a-na ib-ni-{d}marduk
#tr.ts: ana ibni-marduk
#tr.en: with regard to Ibni-marduk

20. u3 pa-as-sa3-lum ah-hi-szu
#tr.ts: u passālum aḫḫīšu
#tr.en: and Passālum his brothers,

21. u2-ub-bi-bu
#tr.ts: ubbibu
#tr.en: cleared of claims,

@reverse
1. u2-ul i-tu-ur-ru-ma
#tr.ts: ul iturrūma
#tr.en: they will not return (on the decision) and

2. {disz}ib-ni-{d}marduk u3 pa-as-sa3-lum
#tr.ts: ibni-marduk u passālum
#tr.en: Ibni-marduk and Passālum

3. _dumu-mesz_ ARAD2-{d}ul-masz-szi-tum
#tr.ts: mārū warad-ulmaššitum
#tr.en: sons of Warad-ulmaššitum

4. a-na ARAD2-{d}marduk _ugula gidri_ a-hi-szu-nu
#tr.ts: ana warad-marduk wakil ḫaṭṭim aḫīšunu
#tr.en: against capitain Warad-marduk their brother,

5. u2-ul i-ra-ag-ga-mu
#tr.ts: ul iraggamū
#tr.en: will not raise a claim.

6. _mu_ {d}utu {d}marduk u3 am-mi-s,a-du-qa2 _lugal-e_
#tr.ts: nīš šamaš marduk u ammi-ṣaduqa šarrim
#tr.en: (By) the life of Šamaš, Marduk and Ammi-ṣaduqa the king

7. _in-pa3-de3-mesz_
#tr.ts: itmû
#tr.en: they have sworn.

8. _igi_ {d}nanna-ma-an-szum2 _di-ku5_
#tr.ts: maḫar nanna-manšum dayyānim
#tr.en: Before Nanna-manšum, judge;

9. _igi_ {d}suen-isz-me-a-ni _di-ku5_
#tr.ts: maḫar sîn-išmea(n)ni dayyānim
#tr.en: before Sîn-išmeanni, judge;

10. _igi_ sig-an-nu-ni-tum _di-ku5_
#tr.ts: maḫar ipqu-annunītum dayyānim
#tr.en: before Ipqu-annunītum, judge;

11. _igi_ sig-i3-li2-szu _di-ku5_
#tr.ts: maḫar ipqu-ilīšu dayyānim
#tr.en: before Ipqu-ilīšu, judge;

12. _igi_ a-bu-wa-qar _dumu_ {d}suen-i-din-nam
#tr.ts: maḫar abu-waqar mār sîn-i(d)dinam
#tr.en: before Abu-waqar son of Sîn-iddinam;

13. _igi_ dumu-u4-2(u)-kam _ugula mar-tu_
#tr.ts: maḫar mār-ešrîm wakil amurrim
#tr.en: before Mār-ešrîm, general;

14. _igi_ tam-la-tum _dumu_ sig-ir-ni-na
#tr.ts: maḫar tamlatum mār ipqu-irnina
#tr.en: before Tamlatum son of Ipqu-irnina;

15. _igi_ ARAD2-e2-idim-an-na _dumu_ ip-qa2-tum
#tr.ts: maḫar warad-eidimanna mār ipqatum
#tr.en: before Warad-eidimanna son of Ipqatum;

16. _igi_ szu-mi-li-ib-szi _dumu_ i-na-pa-le-e-szu
#tr.ts: maḫar šumum-libši mār ina-palêšu
# See P258679 (copy), seal 12.
#tr.en: before Šumum-libši son of Ina-palêšu;

17. _igi_ qi2-isz-ti-{d}e2-a _dumu e2-dub-ba-a_
#tr.ts: maḫar qīšti-ea mār bīt ṭuppi
#tr.en: before Qīšti-ea, the military scribe.

$ single ruling
18. _iti bara2-za3-gar u4 3(u)-kam_
#tr.ts: waraḫ nisānim ūmam šalāša
#tr.en: The month of Nisānum, the day 30,

19. _mu_ am-mi-s,a-du-qa2 _lugal-e du11-ga mah {d}utu lugal-a-ni-ta i7_ am-mi-s,a-du-qa2-nu-hu-usz-ni-szi
#tr.ts: šattum ša ammi-ṣaduqa šarrum ina qibīt šamaš ṣīrtim šarrīšu nāram ammi-ṣaduqa-nuḫuš-nišī
#tr.en: the year in which Ammi-ṣaduqa the king by the supreme command of Šamaš his king (dug) the canal "Ammi-ṣaduqa-is-abundance-of-the-people".
