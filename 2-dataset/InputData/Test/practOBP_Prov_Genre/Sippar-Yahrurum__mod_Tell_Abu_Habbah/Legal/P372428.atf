#atf: lang akk 
@tablet 
@obverse 
1. {disz}esz18-dar-um-mi _mu-ni_ 
#tr.ts: ištar-ummi šumša 
#tr.it: Ištar-ummi il suo nome 
2. _dumu-munus_ bu-za-zu-um 
#tr.ts: mārat buzāzum 
#tr.it: figlia di Buzazum 
3. u3 la-ma-sa3-tum 
#tr.ts: u lamassatum 
#tr.it: e Lamassatum, 
4. _ki_ bu-za-zu-um _ad-da2-ni_ 
#tr.ts: itti buzāzum abiša 
#tr.it: da Buzazum suo padre 
5. u3 la-ma-sa3-tum _ama-a-ni_ 
#tr.ts: u lamassatum ummiša 
#tr.it: e Lamassatum sua madre, 
6. ARAD2-{d}suen _dumu_ ib-ni-{d}suen 
#tr.ts: warad-sîn mār ibni-sîn 
#tr.it: Warad-Sîn, figlio di Ibni-Sîn, 
7. a-na a-szu-ti-im u3 mu-tu-ti-im 
#tr.ts: ana aššūtim u mutūtim 
#tr.it: come moglie e marito 
8. i-hu-si2 
#tr.ts: iḫussi 
#tr.it: ha preso. 
9. _2/3(disz) ma-na ku3-babbar_ 
#tr.ts: šinipiāt mina kaspim 
#tr.it: 2/3 di mina d'argento 
10. u3 _1(disz) sag-nita2_ AN-qe2-ru-ub _mu-ni_ 
#tr.ts: u ištēn wardum ankišub-awilum šumšu 
#tr.it: e uno schiavo, Ankišub-awilum (è) il suo nome, 
11. te-er-ha-sa3 
#tr.ts: terḫassa 
#tr.it: (come) "prezzo della sposa", 
12. a-na la-ma-sa3-tum 
#tr.ts: ana lamassatum 
#tr.it: a Lamassatum 
13. u3 bu-za-zu-um 
#tr.ts: u buzāzum 
#tr.it: e Buzazum 
14. ARAD2-{d}suen isz-qu2-ul 
#tr.ts: warad-sîn išqul 
#tr.it: Warad-Sîn ha pagato. 
15. a-na wa!-ar-ki-it u4-mi-im 
#tr.ts: ana warkit ūmim 
#tr.it: In futuro (lit. nei giorni a venire) 
16. bu:za:zu:um la-ma-sa3-tum 
=: ZU ZA BU UM 
#tr.ts: buzāzum lamassatum 
#tr.it: Buzazum, Lamassatum 
17. u3 ma-ru bu-za-zu-um 
#tr.ts: u mārū buzāzum 
#tr.it: e i figli di Buzazum 
18. u2-la i-ra-ga-mu 
#tr.ts: ula iraggamū 
#tr.it: non reclameranno. 
19. ARAD2-{d}suen esz18-dar-um-mi 
#tr.ts: warad-sîn ištar-ummi 
#tr.it: Se Warad-Sîn Ištar-ummi 
20. i-zi-ma 
#tr.ts: izzimma 
#tr.it: lascerà, 
21. _1(disz) ma-na ku3-babbar i3-la2-e_ 
#tr.ts: ištēn mana kaspim išaqqal 
#tr.it: una mina d'argento pagherà; 
22. esz18-dar-um-mi ARAD2-{d}suen 
#tr.ts: ištar-ummi warad-sîn 
#tr.it: se Ištar-ummi Warad-Sîn 
23. i-zi-ma 
#tr.ts: izzimma 
#tr.it: lascerà, 
@reverse 
1. isz-tu di-im-ti-im 
#tr.ts: ištu dimtim 
#tr.it: dalla torre 
2. i-na-pa-s,u2-ni-szi 
#tr.ts: ina(p)paṣūni(š)ši 
#tr.it: la getteranno. 
3. ni-isz {d}utu u3 {d}a-a 
#tr.ts: niš šamaš u ayya 
#tr.it: (Hanno giurato) nel nome di Šamaš e Ayya, 
4. ni-isz zimbir{ki} 
#tr.ts: niš šippar 
#tr.it: nel nome di Šippar 
5. u3 im-me-ru-um 
#tr.ts: u immerum 
#tr.it: e (di) Immerum 
6. sza a-na wa-ar-ki-it 
#tr.ts: ša ana warkit 
#tr.it: che in futuro 
7. u4-mi-im i-ra-ga-mu 
#tr.ts: ūmim iraggamū 
#tr.it: (contro Ištar-ummi e i suoi figli non) reclameranno 
8. _igi_ an-pi4-{d}utu _sanga {d}utu_ 
#tr.ts: maḫar anum-pî-šamaš šangû šamaš 
#tr.it: Dinnanzi ad Anum-pi-šamaš, amministratore (del tempio) di Šamaš, 
9. _igi_ dingir-mu-sza-lim 
#tr.ts: maḫar ilī-mušallim 
#tr.it: dinnanzi ad Ilī-mušallim, 
10. _igi_ {d}da-mu-gal-zu 
#tr.ts: maḫar damu-galzu 
#tr.it: dinnanzi a Damu-galzu, 
11. _igi_ lu-da-ri 
#tr.ts: maḫar Lu-dari 
#tr.it: dinnanzi a Lu-dari, 
12. _igi_ {d}utu-a:suk-ni-szi 
#tr.ts: maḫar šamaš-sukaniši 
#tr.it: dinnanzi a Šamaš-sukaniši, 
13. _igi_ i3-li2-e!-mu-qi2 
#tr.ts: maḫar ilī-emūqī 
#tr.it: dinnanzi ad Ilī-emuqi, 
14. _dumu_ i-la-ak-szu-qir 
#tr.ts: mār ilakšu bā'iru 
#tr.it: figlio di Ilakšu il pescatore. 
15. _igi_ a-t,i-du-um na-s,i2-ru-um 
#tr.ts: maḫar aṭidum naṣirum 
#tr.it: dinnanzi ad Aṭidum la guardia (?) 
16. _igi_ na-ra-am-i3-li2-szu 
#tr.ts: maḫar naram-ilišu 
#tr.it: dinnanzi a Naram-ilišu 
17. _dumu_ a-pa-t,a3-bu-um 
#tr.ts: mār apaṭabum 
#tr.it: figlio di Apaṭabum, 
18. _igi_ {d}suen-i-din-nam _sanga esz18-dar_ 
#tr.ts: maḫar sîn-iddinam šangû ištar 
#tr.it: dinnanzi a Sin-iddinam amministratore (del tempio) di Ištar, 
19. _igi_ da-da-wa-qar 
#tr.ts: maḫar dadawaqar 
#tr.it: dinnanzi a dadawaqar, 
20. _igi_ ba-ta-tum 
#tr.ts: maḫar batatum 
#tr.it: dinnanzi a Batatum, 
21. _igi_ sa3-bi-tum 
#tr.ts: maḫar sabītum 
#tr.it: dinnanzi a Sabitum, 
22. _igi_ pa-at-{d}suen 
#tr.ts: maḫar pat-sîn 
#tr.it: dinnanzi a Pat-sin, 
23. _igi_ na-di-ti-ia 
#tr.ts: maḫar naditiya 
#tr.it: dinnanzi a Naditiya 
24. _dumu-munus_ ba-za-nu-um 
#tr.ts: mārat bazanum 
#tr.it: figlia di Bazanum 
25. _igi_ sa-la-tum 
#tr.ts: maḫar salatum 
#tr.it: dinnanzi a Salatum, 
