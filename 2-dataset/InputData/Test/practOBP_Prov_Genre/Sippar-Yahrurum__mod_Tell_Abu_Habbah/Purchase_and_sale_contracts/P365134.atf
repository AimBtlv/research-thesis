&P365134 = CT 06, pl. 20, Bu 1891-05-09, 0330 
#atf: lang akk 
@tablet 
@obverse 
1. _1(esze3) GAN2 a-sza3 a-gar3_ tap-ti-a-tum 
#tr.ts: ištēn ebel eqlum ugārum taptiātum
#tr.en: A field of 1 eblum in the Taptiātum irrigation district

2. i-na hal-hal-la{ki} 
#tr.ts: ina ḫalḫalla	
#tr.en: at Ḫalḫalla

3. i-ta _a-sza3 aga-us2-mesz_ 
#tr.ts: itā eqel rēdî
#tr.en: next to the field of the soldiers

4. u3 i-ta _a-sza3 aga-us2-mesz_-ma 
#tr.ts: u itā eqel rēdīma
#tr.en: and next to the very field of the soldiers

5. _sag-bi 1(disz)-kam-ma a-sza3 hi-a 3(iku) GAN2 us2-a_ 
#tr.ts: pūssu maḫrītum eqlī šalāšat ikû saniq
#tr.en: its first front is next to the 3 iku’s fields,

6. _sag-bi 2(disz)-kam-ma a-sza3_ i-ku-un-pi4-{d}suen 
#tr.ts: šanītum pūssu eqel ikūn-pî-sîn
#tr.en: its second front is the field of Ikūn-pî-sîn

7. _dumu_ {d}suen-ta-ia-ar 
#tr.ts: mār sîn-tayyār
#tr.en: son of Sîn-tayyār

8. sza _ki_ sig-i3-li2-szu _ugula dam-gar3_ isz-sza-mu 
#tr.ts: ša itti ipqu-ilīšu akil tamkārim iššamu
#tr.en: which was bought by Ipqu-ilīšu the overseer of the merchant(s),

9. _ku3-bi 1/3(disz) ma-na_ 
#tr.ts: kasapšu šaluš manā
#tr.en: its value is 20 shekels of silver;

10. _3(disz) sar e2 du3-a_ i-na hal-hal-la{ki} 
#tr.ts: šalāšat mūšar bītam epšam ina ḫālḫālla
#tr.en: a built house plot of 3 SAR at Ḫalḫalla

11. _da e2 dumu-munus_ bu-s,u2-um 
#tr.ts: ṭēḫi bīt mārat būṣum
#tr.en: adjacent to the house of Būṣum’s daughter

12. u3 _da e2 aga-us2_ 
#tr.ts: u ṭēḫi bīt rēdîm
#tr.en: and adjacent to the house of the soldier,

13. _sag-bi 1(disz)-kam sila_ 
#tr.ts: pūssu maḫrītum sūqum
#tr.en: its first front is the street,

14. _egir-bi_ tar-ba-s,um 
#tr.ts: warkassu tarbaṣum
#tr.en: its rear is the pen,

15. _ku3-bi 1(u) gin2_ 
#tr.ts: kasapšu ešret šiqlū
#tr.en: its value is 10 shekels,

16. _ki_ ib-ba-tum _dumu_ dumu-ki 
#tr.ts: itti ibbatum mār mār-erṣetim
#tr.en: from Ibbatum son of Mār-erṣetim

17. {disz}a-ma-at-{d}ma-mu _lukur_ {d}utu 
#tr.ts: amat-māmu nadīt šamaš
#tr.en: Amat-māmu nadītu of Šamaš

18. _dumu-munus_ ak-sza-ia 
#tr.ts: mārat akšaya						
#tr.en: daughter of Akšaya

19. i-na _har ku3-babbar-bi in-szi-in-sa10_ 
#tr.ts: ina šawer kaspīša išām
#tr.en: bought with her ring of silver,

20. _sa10 til-la-bi-sze3_ 
#tr.ts: ana šīmīšu gamrim
#tr.en: at its full price,

@reverse 
1. _1/2(disz) ma-na ku3-babbar in-na-an-la2_ 
#tr.ts: mišil manā kaspam išqul
#tr.en: 30 shekels of silver she paid.

2. _sza3-ga-a-ni al-du10 inim-bi al-til_ 
#tr.ts: libbašu ṭāb awassu gamrat
#tr.en: His (of the seller) heart is satisfied, its transaction is settled.

3. _u4 kur2-sze3 lu2 lu2-ra inim nu-ga2-ga2-a_ 
#tr.ts: ana warkiāt ūmim awīlum ana awīlim ul iraggumu
#tr.en: That in the future, one against the other shall not raise a claim,

4. _mu_ {d}utu {d}marduk sa-am-su-i-lu-na _lugal_ 
#tr.ts: nīš šamaš marduk samsu-iluna šarrim
#tr.en: (by) the name of Šamaš, Marduk (and) Samsu-iluna the king

5. _in-pa3_ 
#tr.ts: itma
#tr.en: she has sworn.

$ single ruling 
6. _igi_ {d}suen-be-el-ap-lim _di-ku5 dumu_ {d}suen-ma-gir 
#tr.ts: maḫār sîn-bēl-aplim dayyānim mār sîn-māgir
#tr.en: Before Sîn-bēl-aplim, judge, son of Sîn-māgir;

7. _igi_ sig-{d}a-a _szagina dumu_ e2-a-ma-gir 
#tr.ts: maḫār ipqu-ayya šakkanakkim mār ea-māgir
#tr.en: before Ipqu-ayya, governator, son of Ea-māgir;

8. _igi_ {d}suen-a-ha-am-i-din-nam _dumu_ {d}suen-i-din-nam 
#tr.ts: maḫār sîn-aḫam-i(d)dinam mār sîn-i(d)dinam
#tr.en: before Sîn-aḫam-iddinam son of Sîn-iddinam;

9. _igi_ {d}utu-ra#-[bi] _dumu#_ puzur4-{d}suen 
#tr.ts: maḫār šamaš-rabi mār puzur-sîn
#tr.en: before Šamaš-rabi son of Puzur-sîn;

10. _igi_ da-an-er3-ra _dumu_ {d}suen#-AN-x-x-x 
#tr.ts: maḫār dan-erra mār ...
#tr.en: before Dan-erra son of ...;

11. _igi_ {d}suen-i-din-nam _dumu_ i-bi-{d}suen 
#tr.ts: maḫār sîn-i(d)dinam mār i(b)bi-sîn
#tr.en: before Sîn-iddinam son of Ibbi-sîn;

12. _igi_ {d}suen-na-di-in-szu-mi _dub-sar_ 
#tr.ts: maḫār sîn-nādin-šumī ṭupšarrim
#tr.en: before Sîn-nādin-šumī the scribe.

$ single ruling 
13. _iti sig4-a u4 1(u) 5(disz)-kam_ 
#tr.ts: waraḫ simānim ūmam ḫamiššeret
#tr.en: The month of Simānum, the day 15,

14. _mu_ sa-am-su-i-lu-na _lugal-e us2-sa a2-ag2-ga2 {d}en-lil2-la2_
#tr.ts: šanat samsu-iluna šarrim warki ana têrti enlil
#tr.en: the year of Samsu-iluna the king following (the year) "at the command of Enlil".
