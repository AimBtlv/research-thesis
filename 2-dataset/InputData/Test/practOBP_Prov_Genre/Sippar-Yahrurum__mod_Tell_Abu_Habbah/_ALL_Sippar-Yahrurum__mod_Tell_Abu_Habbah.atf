&P386540 = TCL 01, 104
#atf: lang akk
@tablet
@obverse
1. isz-tu 2/3(disz) _sar e2_ u3# _iti 6(disz)-kam_ 
#tr.ts: ištu šinip mūšar bītam u šeššet warḫī
#tr.en: After that 40 shekels of the house and six months,

2. ba-ma-at sza-at-tim 
#tr.ts: bamat šattim
#tr.en: half of a year(ly income),

3. sza sig-{d}nin-gal a-hi a-bi-szu 
#tr.ts: ša ipqu-ningal aḫi abīšu
#tr.en: of Ipqu-ningal his uncle (lit. his father's brother),

4. {disz}sin-i-din-nam il-qu2-u2 asz-szum _ha-la_-szu# 
#tr.ts: sîn-i(d)dinam ilqû aššum zittīšu
#tr.en: Sîn-iddinam had took, about his share

5. _ki_ sig-{d}edin {disz}ru-ut-tum {disz}sza-mu-uh-tum 
#tr.ts: itti ipqu-šērū'a ruttum šamuḫtum
#tr.en: with Ipqu-šērū'a, Ruttum, Šamuḫtum

6. u3 be-le-tum _lukur_ {d}marduk is,-s,a-bi-it 
#tr.ts: u bēletum nadīt marduk iṣṣabit
#tr.en: and Bēletum nadītu of Marduk he quarreled (so)

7. i-di-im-ma _di-ku5-mesz lugal_ ik-szu-ud-ma 
#tr.ts: idīmma dayyānī šarrim ikšudma
#tr.en: started a lawsuit and approached the king's judges.

8. _di-ku5-mesz_ di-nam u2-sza-hi-is-su2-nu-ti-ma 
#tr.ts: dayyānū dīnam ušāḫissūšunūtīma
#tr.en: The judges granted them a trial and

9. i-na _e2_ u3 _iti 6(disz)-kam_ ba-ma-at <sza-at>-tim 
#tr.ts: ina bītim u šeššet warhī bamat šattim
#tr.en: the house and the 6 months, half of a year(ly income),

10. za-za-am iq-bu-szum-ma 
#tr.ts: zâzam iqbûšumma
#tr.en: they told him to take; moreover

11. 1(u) _gin2 e2 da_ sig-{d}nin-gal# 
#tr.ts: ešret šiqil bītam itā ipqu-ningal
#tr.en: 10 shekels of the house next to Ipqu-ningal

12. u3 _iti 2(disz)-kam ugula_ ba-<ab>-tim 
# Rivkah Harris, Ancient Sippar (1975) p. 58 n. 4 
#tr.ts: u šinā warḫī akil babtim
#tr.en: and 2 months (of the income for the office) of overseer of the ward

13. i-na bi-it a-bi-ia-tum a-bi-szu 
#tr.ts: ina bīt abiyatum abīšu
#tr.en: in the house of Abiyatum his father

14. it#-ti a-hi-szu# il#-qi2#-ma# 
#tr.ts: itti aḫīšu ilqēma
#tr.en: he (Sîn-iddinam) took from his brother.

15. _szunigin 5/6(disz) sar e2_ 
#tr.ts: napḫarum parasrab mūšar bītam
#tr.en: Total: 50 shekels of the house,

16. e-zu-ub _za3-ga-e3-a_ 
#tr.ts: ezub mūṣîm
#tr.en: except the right-of-way,

@reverse 
1. u3 _iti 8(disz)-kam_ i-na _mu 1(disz)-kam_ 
#tr.ts: u samānat warḫī ina šattim
#tr.en: and 8 months (of income) every year

2. {disz}sin-i-din-nam i-ik#-ka-al 
#tr.ts: sîn-i(d)dinam ikkal
#tr.en: Sîn-iddinam will enjoy.

3. i-na mu-s,e-e sza sin-i-din-nam 
#tr.ts: ina mūṣê ša sîn-i(d)dinam
#tr.en: Through the right-of-way of Sîn-iddinam,

4. {disz}sza-mu-<uh>-tum _lukur_ {d}utu u3 be-le-tum _lukur_ {d}marduk 
#tr.ts: šamuḫtum nadīt šamaš u bēletum nadīt marduk
#tr.en: Šamuḫtum, nadītu of Šamaš and Bēletum nadītu of Marduk

5. us,-s,i2-a u2-ul i-ta-ar 
#tr.ts: uṣṣiā ul itâr	
#tr.en: will go out. That (lit. will not do) again

6. {disz}sig-{d}nin-gal u3 a-ah-ha-tu-sza 
# expected: sig-{d}edin u3 a-ah-ha-tu-szu
#tr.ts: ipqu-šērū'a u aḫḫātūšu
#tr.en: Ipqu-šērū'a and his sisters,

7. a-na _e2_ is-qi2 te-er-tim a-na sin-i-din-nam# 
#tr.ts: ana bītim isqi têrtim ana sîn-i(d)dinam	        
#tr.en: regarding the house (and) the income for the office, against Sîn-iddinam

8. a-hi-szu-nu u2-ul i-ra-ga-mu 
#tr.ts: aḫīšunu ul ira(g)gamū
#tr.en: their brother, will not claim,

9. _mu_ {d}utu {d}marduk ha-am-mu-ra-pi2 it-mu-u2! 
#tr.ts: nīš šamaš marduk ḫammurapi itmû
#tr.en: they swore (by) the name of Šamaš, Marduk (and) Ḫammurapi.

10. ul-la-nu-um _ha-la_-ti-szu-nu _dub_ s,i-ih-[tum] 
#tr.ts: ullānum zittīšunu ṭuppum ṣiḫtum
#tr.en: Apart from (the tablet of) their share, any fraudolent tablet

11. sza i-na qa2-ti-szu-nu i-li-a-am 
#tr.ts: ša ina qātīšunu i(l)liam			
#tr.en: that should turn up in their hands

12. sa-ar he-pi2 _di-ku5-mesz_ dingir-szu#-ba-ni# 
#tr.ts: sar ḫepi dayyānū ilšu-bānī
#tr.en: is to be considered false and be destroyed. Judges: Ilšu-bānī,

13. {disz}akszak{ki}-i#-din#-nam# {disz}{d}utu-illat-su2 
#tr.ts: akšak-i(d)dinam šamaš-tillassu
#tr.en: Akšak-iddinam, Šamaš-tillassu,

14. {disz}i-din-er3-ra {disz}dingir-szu-ba-ni 
#tr.ts: i(d)din-erra ilšu-bānī
#tr.en: Iddin-erra, Ilšu-bānī

15. _[lu2] inim-bi-mesz_ {disz}sin-ga-mil 
#tr.ts: šībū sîn-gāmil
#tr.en: Witnesses: Sîn-gāmil,

16. [{disz}dingir]-szu#?-a#-pil#?-szu# 
#tr.ts: ilšu-apilšu
#tr.en: Ilšu-apilšu.

17. _[iti] apin#?-du8#?-[a] u4# 1(u)#?-kam_ 
#tr.ts: waraḫ kinūnim ūmam ešertum
#tr.en: The month of Kinūnum, the day 10 (?),

18. _mu# kilib3# gu2#-[du3-a]-bi_
#tr.ts: šanat napḫar zā'irī
#tr.en: the year: "(Ḫammurapi slaughtered) all the enemies (of the Subartu mountains)".

