#tr.ts: maḫar damu-galzu
#tr.en: before Damu-galzu;

17. _igi_ {d}utu-u8!-a-ni-szi 
#tr.ts: maḫar šamaš-ū’a-nišī
#tr.en: before Šamaš-ū’a-nišī;

18. _igi_ {d}suen-ib-ni 
#tr.ts: maḫār sîn-ibni
#tr.en: before Sîn-ibni

19. _dumu_ szu-{d}ma-mi-tum 
#tr.ts: mār šū-mamitum
#tr.en: son of Šū-mamitum;

20. _igi_ {d}engur-a-a-bu-um 
#tr.ts: maḫār engur-abum
#tr.en: before Engur-abum

