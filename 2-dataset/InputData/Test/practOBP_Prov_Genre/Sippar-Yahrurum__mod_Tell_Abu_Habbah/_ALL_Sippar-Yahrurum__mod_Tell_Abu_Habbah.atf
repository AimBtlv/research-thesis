#tr.ts: ša i(t)ti (ḫ)alikum
#tr.en: that from Ḫalikum

3. _dumu_ ar-wi-um 
#tr.ts: mār arwium
#tr.en: son of Arwûm

4. {disz}a-mu-ru-um 
#tr.ts: amu(r)rum
#tr.en: Amurrum

5. u3 ta-ku-ma-tum 
#tr.ts: u takū(m)mātum
#tr.en: and Takūmmātum

6. _lukur nig2_ {d}utu i-sza-mu 
#tr.ts: nadītum ša šamaš išāmū
#tr.en: nadītu of Šamaš had bought,

7. {disz}hi-isz-sza-tum _lukur nig2_ {d}utu 
#tr.ts: ḫiššatum nadītum ša šamaš
#tr.en: Ḫiššatum nadītu of Šamaš

8. _dumu-munus_ a-li-kum 
#tr.ts: mārat (ḫ)alikum
#tr.en: daughter of Ḫalikum

9. ir-gu-um-ma 
#tr.ts: irgumma
#tr.en: has sued and

10. ru-gu-mu-sza 
#tr.ts: rugu(m)mûša
#tr.en: her claim,

11. i-na _e2_ {d}utu 
#tr.ts: ina bīt šamaš
#tr.en: in the temple of Šamas,

12. na-as2-hu 
#tr.ts: nasḫū
#tr.en: has been rejected.

13. u3-ul i-ta-ar-ma 
#tr.ts: ul itârma
#tr.en: (That) again

14. {disz}a-li-kum 
#tr.ts: (ḫ)alikum
#tr.en: Ḫalikum

15. u3 hi-isz-sza-tum _lukur nig2_ {d}utu 
#tr.ts: u ḫiššatum nadītum ša šamaš
#tr.en: and Ḫiššatum nadītu of Šamaš

16. [a]-na# ta#-ku#-ma-[tum] 
#tr.ts: ana takū(m)mātum
#tr.en: against Takūmmātum,

17. a-na _{gesz}kiri6 {gesz}geszimmar_ 
#tr.ts: ana kiri gišimmarim
#tr.en: regarding the date palm grove,

18. u3-ul e-ra-ga-mu 
#tr.ts: ul era(g)gamū
#tr.en: will not claim,

19. _mu_ {d}utu 
#tr.ts: nīš šamaš
#tr.en: (by) the name of Šamaš,

@reverse 
1. {d}marduk 
#tr.ts: marduk
#tr.en: Marduk,

2. sa-mu-la-el3 
#tr.ts: samu-la-el
#tr.en: Sumu-la-el

