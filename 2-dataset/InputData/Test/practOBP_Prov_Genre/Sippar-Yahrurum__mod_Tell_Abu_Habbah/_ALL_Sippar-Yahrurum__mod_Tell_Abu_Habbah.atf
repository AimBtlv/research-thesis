$ single ruling 
4. _igi_ {d}utu-dingir _dumu_ en-nam-{d}marduk 
#tr.ts: maḫar šamaš-ilī mār ennam-marduk
#tr.en: Before Šamaš-ilī son of Ennam-marduk;

5. _igi_ sin-i-din-nam _lu2_ na-gi-ir 
#tr.ts: maḫar sîn-i(d)dinam nāgir(im)
