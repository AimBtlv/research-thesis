&P355865 = CT 04, pl. 47, Bu 1888-05-12, 0711 
#atf: lang akk 
@tablet 
@obverse 
1. asz-szum _1(disz) ansze_ bi-il-tim 
#tr.ts: aššum ištēn imērim biltim
#tr.en: Concerning 1 pack donkey
2. sza i-na li-<bi> szi-mu-ru-um{ki} 
#tr.ts: ša ina li(b)bi šimu(r)rum
#tr.en: that in Šimurrum
3. _ki_ ARAD-{d}en-lil2 u3 s,il2-li2-isz8-tar2 
#tr.ts: itti warad-enlil u ṣilli-ištar
#tr.en: from Warad-enlil and Ṣilli-ištar
4. {disz}dingir-szu-a-bu-szu _dumu_ {d}suen-na-s,ir 
#tr.ts: ilšu-abūšu mār sîn-nāṣir
#tr.en: Ilšu-abūšu son of Sîn-nāṣir
5. i-gu-ru-szu-ma ih-li-qu2-szu 
#tr.ts: īgurūšūma iḫliqūšu
#tr.en: had rented it and (that) fled (from) him.
6. asz-szum _ansze_ bi-il-tim {disz}dingir-szu-a-bu-szu 
#tr.ts: aššum imērim biltim ilšu-abūšu
#tr.en: Because of the pack donkey, Ilšu-abūšu
7. {disz}ARAD-{d}en-lil2 u3 s,il2-li2-isz8-tar2 i-di-nu-ma 
#tr.ts: warad-enlil u ṣilli-ištar idīnūma
#tr.en: Warad-enlil and Ṣilli-ištar have started a lawsuit so
8. da-ia-nu i-na _ka2_ {d}utu 
#tr.ts: dayyānū ina bāb šamaš
#tr.en: the judges, at the Gate of Šamaš
9. i-na li-bi zimbir{ki} 
#tr.ts: ina li(b)bi sippar
#tr.en: in Sippar,
10. di-nam u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: dīnam ušāḫizūšunūtīma
#tr.en: have granted them a trial and
11. a-na szu-ri-nim sza {d}utu 
#tr.ts: ana šuri(n)nim ša šamaš
#tr.en: (to take an oath) to the emblem of Šamaš,
12. da-ia-nu {disz}ARAD-{d}en-lil2 u3 s,il2-li2-isz8-tar2 
#tr.ts: dayyānū warad-enlil u ṣilli-ištar
#tr.en: the judges, Warad-enlil and Ṣilli-ištar
13. a-na dingir-szu-a-bu-szu id-di-nu-szu-<nu>-ma 
#tr.ts: ana ilšu-abūšu iddinūšunūma
#tr.en: have sent to Ilšu-abūšu and
14. i-na szu-ri-nim sza {d}utu 
#tr.ts: ina šuri(n)nim ša šamaš
#tr.en: before the emblem of Šamaš
15. i-na _ka2_ {d}utu la-bi-ru-tim 
#tr.ts: ina bāb šamaš labirutim
#tr.en: at the Old Gate of Šamaš
16. {disz}dingir-szu-a-bu-szu _dumu_ {d}suen-na-s,ir 
#tr.ts: ilšu-abūšu mār sîn-nāṣir
#tr.en: Ilšu-abūšu son of Sîn-nāṣir,
17. {disz}ARAD-{d}en-lil2 u3 s,il2-li2-isz8-tar2 
#tr.ts: warad-enlil u ṣilli-ištar
#tr.en: Warad-enlil and Ṣilli-ištar
18. im-ta-ag-ru-ma 
#tr.ts: imtagrūma
#tr.en: have reached an agreement and
19. a-na _6(disz) gin2 ku3-babbar_ sza za-ba-an{ki} 
#tr.ts: ana šeššet šiqil kaspim ša zaban
#tr.en: for the 6 shekels of silver from (lit. of) Zaban
20. u3 _1(u) gin2 ku3-babbar_ 
#tr.ts: u ešret šiqil kaspim
#tr.en: and the 10 shekels of silver
@reverse 
1. sza zimbir{ki}-ra-bi-im 
#tr.ts: ša sippar-rabîm
#tr.en: from (lit. of) Sippar-rabîm,
2. asz-szum _ansze_-szu-nu il-qu2-u2 
#tr.ts: aššum imērīšunu ilqû
#tr.en: that for their donkey they had taken,
3. a-na ARAD-{d}en-lil2 u3 s,il2-li2-isz8-tar2 
#tr.ts: ana warad-enlil u ṣilli-ištar
#tr.en: against Warad-enlil and Ṣilli-ištar
4. {disz}dingir-szu-a-bu-szu _dumu_ sin-na-s,ir 
#tr.ts: ilšu-abūšu mār sîn-nāṣir
#tr.en: Ilšu-abūšu son of Sîn-nāṣir
5. u2-ul e-ra-ga-am _u4 kur2-sze3_ 
#tr.ts: ul era(g)gam ana warkiāt ūmī
#tr.en: will not sue. (That) in future,
6. la i-tu-ru-u2-ma 
#tr.ts: la itu(r)rūma
#tr.en: again (lit. will not return)
7. {disz}dingir-szu-a-bu-szu _dumu_ {d}suen-na-s,ir 
#tr.ts: ilšu-abūšu mār sîn-nāṣir
#tr.en: Ilšu-abūšu son of Sîn-nāṣir,
8. {disz}ARAD-{d}en-lil2 s,il2-li2-isz8-tar2 
#tr.ts: warad-enlil ṣilli-ištar
#tr.en: Warad-enlil (and) Ṣilli-ištar,
9. a-hu-um a-na a-hi-im asz-szum _ansze_ 
#tr.ts: aḫum ana aḫim aššum imērim
#tr.en: one against the other, concerning the donkey,
10. u2-ul e-ra-ga-am 
#tr.ts: ul era(g)gam
#tr.en: will not raise a claim,
11. _mu_ {d}utu {d}marduk a-pil-{d}suen 
#tr.ts: nīš šamaš marduk apil-sîn
#tr.en: by the life of Šamaš, Marduk, Apil-sîn
12. u3 _iri_ zimbir{ki} isz-ti-ni-isz it-mu 
#tr.ts: u āli sippar ištiniš itmû
#tr.en: and the city of Sippar, they have sworn together.
13. _igi_ i-din-nu-nu _dumu_ li-pi2-it-{d}en-lil2 
#tr.ts: maḫar i(d)din-nunu mār lipit-enlil
#tr.en: Before Iddin-nunu son of Lipit-enlil;
14. _igi_ i-din-{d}ma-mu _dumu_ na-nu-um 
#tr.ts: maḫar i(d)din-mamu mār nanum
#tr.en: before Iddin-mamu son of Nanum;
15. _igi_ sza-i3-li2-szu _dumu_ {d}mar-tu-na-s,ir 
#tr.ts: maḫar ša-ilīšu mār amurru-nāṣir
#tr.en: before Ša-ilīšu son of Amurru-nāṣir;
16. _igi_ nu-ur2-{d}kab-ta _dumu_ im-gur-{d}suen 
#tr.ts: maḫar nūr-kabta mār imgur-sîn
#tr.en: before Nūr-kabta son of Imgur-sîn;
17. _igi_ u-bar-ru-um _dumu_ {d}suen-le-e-i 
#tr.ts: maḫar ubarrum mār sîn-lē’î
#tr.en: before Ubarrum son of Sîn-lē’î;
18. _igi_ t,a3-ab-<gi6>-uri2{ki} _dumu_ ak-sza-ia 
#tr.ts: maḫar ṭāb-akkadim mār akšaya
#tr.en: before Ṭāb-akkadim son of Akšaya;
19. _igi_ {d}utu-dingir _dumu_ im-di-{d}en-lil2 
#tr.ts: maḫar šamaš-ilī mār imdi-enlil
#tr.en: before Šamaš-ilī son of Imdī-enlil;
20. _igi_ {d}utu-da-a-an _dumu_ sin-ka-szi-id 
#tr.ts: maḫār šamaš-dan mār sîn-kašid
#tr.en: before Šamaš-dan son of Sîn-kašid;
21. _igi_ ak-sza-ia _dumu_ {d}utu-he2-gal2 
#tr.ts: maḫar akšaya mār šamaš-ḫengallum
#tr.en: before Akšaya son of Šamaš-ḫengallum;
22. _igi_ {d}utu-na-s,ir _maszkim di-ku5_ 
#tr.ts: maḫar šamaš-nāṣir rābiṣ dayyānim
#tr.en: before Šamaš-nāṣir, judicial officer;
@left 
@column 1
1. _igi_ i-din-{d}suen _dub-sar_ 
#tr.ts: maḫar i(d)din-sîn ṭupšarrim
#tr.en: before Iddin-sîn the scribe.
2. _iti_ e!-lu-nim _u4 5(disz)-kam_ 
#tr.ts: waraḫ elūnim ūmam ḫamšat
#tr.en: The month of Elūnum the day 5,
@column 2 
1. _mu_ a-pil-{d}suen! _lugal-e bad3 du-ur-mu-ti{ki} ba-du3_ 
#tr.ts: šanat apil-sîn šarrum dūr durmuti īpušu
#tr.en: the year "Apil-sîn the king built the walls of Durmuti".
@envelope 
@obverse 
1. _dub_ asz-szum _1(disz) ansze_ bi-il-tim sza i-na li-bi 
#tr.ts: ṭuppum aššum ištēn imērim biltim ša ina li(b)bi
#tr.en: Tablet concerning 1 pack donkey which in
