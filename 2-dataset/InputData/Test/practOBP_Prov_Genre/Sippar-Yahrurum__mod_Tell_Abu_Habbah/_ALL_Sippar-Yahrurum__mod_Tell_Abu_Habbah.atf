&P510403 = BDHP 22 & 23 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _a-sza3 e2 sag-munus sag-nita2_ 
#tr.ts: ana eqlim bītim amtim wardim
#tr.en: Concerning the field, the house, the male and female slave,

2. bu-sze-sza u3 wa-ar-ka-ti-sza 
#tr.ts: būšêša u warkatīša
#tr.en: her personal possessions and her inherited property

3. sza geme2-{d}utu _lukur_ {d}utu 
#tr.ts: ša amat-šamaš nadīt šamaš
#tr.en: of Amat-šamas nadītu of Šamaš

4. _dumu-munus_ ARAD-{d}nanna 
#tr.ts: mārat warad-nanna
#tr.en: daughter of Warad-nanna,

5. {disz}sig-zalag2-{d}nanna 
#tr.ts: sig-zalag-nanna
#tr.en: Sig-zalag-nanna

6. _dumu_ {d}nanna-lu2-du10 
#tr.ts: mār nanna-lu-dug
#tr.en: son of Nanna-lu-dug

7. u2-la i-ta-ar-ma 
#tr.ts: ula itârma
#tr.en: will not return (on the decision) and

8. u3-la e-ra-ga-am 
#tr.ts: ula era(g)gam
#tr.en: will not raise a claim.

9. {disz}hi-il-lum _di-ku5_ babila2{ki} 
#tr.ts: ḫillum dayyān bābila
#tr.en: Ḫillum judge of Babylon,

10. 1(disz) _di-ku5_ zimbir{ki} 
#tr.ts: ištēn dayyān sippar
#tr.en: one judge from (lit. of) Sippar

11. u3 lukur {d}utu _di-ku5_ ga-gi-im 
#tr.ts: u nadīt šamaš dayyān gagîm
#tr.en: and (from ?) the nadītu(s) of šamaš, a judge of the cloister;

12. _mu_ {d}utu {d}amar-utu 
#tr.ts: nīš šamaš marduk
#tr.en: (by) the name of Šamaš, Marduk

13. u3 sa3-bi-um _in-pa3-de3_ 
#tr.ts: u ṣabium itamma
#tr.en: and Ṣabium, he swears.

14. ap-lu-sa3-a 
#tr.ts: aplu(s)sa
#tr.en: Her inheritance,

15. a#-sza-ar e-ra-mu 
#tr.ts: ašar erâmu
#tr.en: wherever she prefers,

16. i-na-di-in 
#tr.ts: ina(d)din
#tr.en: (Amat-šamas) may give.

@reverse 
1. _igi!_ im-gur-sin 
#tr.ts: maḫar imgur-šîn
#tr.en: Before Imgur-sîn

2. _dumu_ su2-ka-li 
#tr.ts: mār su(k)kali
#tr.en: son of Sukkali;

3. _igi_ i-te?-{d}utu 
#tr.ts: maḫar itê-šamaš
#tr.en: before Itê-šamaš

4. _dumu_ ur-{d}bil4-ga 
#tr.ts: mār ur-bilga
#tr.en: son of Ur-bilga;

5. _igi_ nu-ru-bu-um 
#tr.ts: maḫar nu(r)rubum
#tr.en: before Nurrubum

6. _dumu_ isz-du-ki-in 
#tr.ts: mār išdu-kīn(um)
#tr.en: son of Išdu-kīnum;

7. _igi_ ARAD-{d}mar-tu 
#tr.ts: maḫar warad-amurru
#tr.en: before Warad-amurru.

8. _iti_ ti-ru-um 
#tr.ts: waraḫ tīrum
#tr.en: The month of Tīrum

9. _mu alan_ sa3-bi-um _ba-dim2-ke4_ 
#tr.ts: šanat ṣalam ṣabium innepiš
#tr.en: the year: "A statue of Ṣabium was built".

@envelope 
@obverse 
1. _dub_ a-na _a-sza3 e2 sag-munus sag-nita2_ 
#tr.ts: ṭuppum ana eqlim bītim amtim wardim
#tr.en: Tablet concerning the field, the house, the male and female slave,

2. bu-sze-e-sza-a u2 wa-ar-ka-ti-sza 
#tr.ts: būšêša u warkatīša	
#tr.en: her personal possessions and her inherited property,

3. isz-tu pe2-e a-di _ku3-sig17_ 
#tr.ts: ištu pê adi ḫurāṣim
#tr.en: everything (lit. from chaff to gold).

4. mi-im-ma {disz}geme2-{d}utu lukur {d}utu 
#tr.ts: mimma amat-šamaš nadīt šamaš
#tr.en: All that Amat-šamas nadītu of Šamaš

5. _dumu-munus_ ARAD-{d}nanna i-szu-u2 
#tr.ts: mārat warad-nanna īšu
#tr.en: daughter of Warad-nanna has,

6. {disz}sig-zalag2-{d}nanna _dumu_ {d}nanna-lu2-du10 
#tr.ts: sig-zalag-nanna mār nanna-lu-dug
#tr.en: Sig-zalag-nanna son of Nanna-lu-dug

7. u2-la i-ta-ar-ma u2-la e-ra-ga-am 
#tr.ts: ula itârma ula era(g)gam
#tr.en: will not claim again.

8. {disz}hi-il-lum _di-ku5_ babila2{ki} 
#tr.ts: ḫillum dayyān bābila
#tr.en: Ḫillum judge of Babylon,

9. di-ku5 zimbir<{ki}> u3 _di-ku5 lukur_ {d}utu 
#tr.ts: dayyān sippar u dayyān nadīt šamaš
#tr.en: a judge from (lit. of) Sippar and a judge of the nadītu(s) of Šamaš

10. sza ga-gi-im i-na _e2_ {d}utu 
#tr.ts: ša gagîm ina bīt šamaš
#tr.en: from (lit. of) the cloister, in the temple of Šamaš

11. i-di-nu-szu-nu-ti-ma 
#tr.ts: i(d)dinūšunūtīma
#tr.en: have given justice to them:

12. sig-zalag2-{d}nanna _dumu_ {d}nanna-lu2-du10 
#tr.ts: sig-zalag-nanna mār nanna-lu-dug
#tr.en: (the complaint of) Sig-zalag-nanna son of Nanna-lu-dug

13. na-si-ih ap-lu-sa3 {disz}geme2-{d}utu 
#tr.ts: nasiḫ aplu(s)sa amat-šamaš
#tr.en: is rejected. Amat-šamaš her inheritance

14. a-sza-ar t,a3-bu-szi-im 
#tr.ts: ašar ṭābušim
#tr.en: wherever she pleases

15. i-na-di-in _igi_ im-gur-sin 
#tr.ts: ina(d)din maḫar imgur-sîn
#tr.en: may give. Before Imgur-sîn

16. _dumu_ su2-ka-lum _igi_ i-te?-{d}utu _dumu_ ur-{d}bil4-ga 
#tr.ts: mār su(k)kalum maḫār itê-šamaš mār ur-bilga
#tr.en: son of Sukkalum; before Ite-šamaš son of Ur-bilga;

17. _igi_ nu-ru-bu-um _dumu_ isz-du-ki-nu-um 
#tr.ts: maḫār nu(r)rubum mār išdu-kīnum
#tr.en: before Nurrubum son of Išdu-kīnum;

