#tr.ts: nūr-šamaš mār ...
#tr.en: Nūr-šamaš son of ...,

5. szi-bu an-nu-tu-un sza mah-ri-szu-nu 
#tr.ts: šībū annûtun ša maḫrīšunu
#tr.en: these are the witnesses before whom

6. {disz}{d}suen-i-din-nam _dumu_ {d}utu-an-dul3-li2 
#tr.ts: sîn-i(d)dinam mār šamaš-ṣulūlī
#tr.en: Sîn-iddinam son of Šamaš-ṣulūlī

7. a-na e-ri-ib-{d}suen 
#tr.ts: ana erīb-sîn
#tr.en: to Erīb-sîn

