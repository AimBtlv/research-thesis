#tr.ts: mār takti
#tr.en: son of Takti

9. _a-sza3_ a-na er-re-szu-tim 
#tr.ts: eqlam ana errēšūtim
#tr.en: the field in tenancy

10. a-na _gu2-un_ 
#tr.ts: ana biltim 
#tr.en: for rent 

11. a-na _mu 1(disz)-kam_ 
#tr.ts: ana ištēt šattim
#tr.en: for 1 year

12. _ib2-ta-e3_ 
#tr.ts: ušēṣi
#tr.en: has rented.

13. _u4 buru14-sze3_ 
#tr.ts: ina ūm ebūrim 
