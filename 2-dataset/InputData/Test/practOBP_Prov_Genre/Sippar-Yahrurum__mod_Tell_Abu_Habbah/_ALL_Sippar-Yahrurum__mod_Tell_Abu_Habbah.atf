&P386509 = TCL 01, 073 
#atf: lang akk 
@tablet 
@obverse 
1. pu-uh2 _1(iku) GAN2 3(u) sar a-sza3_ 
#tr.ts: pūḫ ištēn ikû šalāšā mūšar eqlim
#tr.en: Replacement of a field of 130 SAR

2. sza _a-gar3_ ha-ra-ma-tim 
#tr.ts: ša ugār ḫaramatim
#tr.en: in the Ḫaramatum irrigation district

3. sza i-ta _a-sza3_ szum-ma-an-la-{d}utu 
#tr.ts: ša itā eqel šumman-lā-šamaš
#tr.en: which is next to the field of Šumman-lā-šamaš

4. _dumu_ i-zi-ga-tar 
#tr.ts: mār izi-gatar
#tr.en: son of Izi-gatar

5. u3 i-ta _a-sza3_ la-ma-si2 _lukur_ {d}utu 
#tr.ts: u itā eqel lama(s)sī nadīt šamaš
#tr.en: and next to the field of Lamassī nadītu of Šamaš

6. _dumu-munus_ {d}sze-rum-i3-li2 
#tr.ts: mārat šērum-ilī
#tr.en: daughter of Šērum-ilī,

7. sza ri-isz-{d}utu {disz}ki-ma-a-hi-ia 
#tr.ts: ša rīš-šamaš kīma-aḫīya
#tr.en: (and for) which Rīš-šamaš, Kīma-aḫīya

8. u3 sa3-ar-ri-qum _dumu-mesz_ {d}utu-a-bu-um 
#tr.ts: u zarriqum mārū šamaš-abum
#tr.en: and Zarriqum, sons of Šamaš-abum

9. ki-ir-ba-nam# a-na _a-gar3_ ha-ra-ma-tim 
#tr.ts: kirbānam ana ugār ḫaramatim
#tr.en: the clod in the Ḫaramatum irrigation district

10. u3 _i7_ id-di 
#tr.ts: u nārim iddi
#tr.en: and in the canal had thrown,

11. _1(iku) GAN2 3(u) sar a-sza3_ sza _a-gar3_ ha-ra-ma-tim 
#tr.ts: ištēn ikû šalāšā mūšar eqlum ša ugār ḫaramatim
#tr.en: (with) a field of 130 SAR in the Ḫaramatum irrigation district

12. sza i-ta _a-sza3_ ar-szi-ia _dumu_ ba-ta-at-ta 
#tr.ts: ša itā eqel aršīya mār batatta
#tr.en: which is next to the field of Aršīya son of Batatta

13. sza it-ti e2-nam-ti-la _dumu_ nu-nu-uru4# 
#tr.ts: ša itti enamtila mār nunu-ēriš
#tr.en: (and) which from Enamtila son of Nunu-ēriš

14. {disz}la-ma-si2 _lukur_ {d}utu _dumu-munus_ {d}sze-rum-i3-li2 
#tr.ts: lama(s)sī nadīt šamaš mārat šērum-ilī
#tr.en: Lamassī nadītu of Šamaš daughter of Šērum-ilī

15. i-sza-mu
#tr.ts: išamu
#tr.en: had purchased.

16. _1(iku) GAN2 3(u) sar a-sza3_ 
#tr.ts: ištēn ikû šalāšā mūšar eqlum
#tr.en: A field of 130 SAR

17. i-na _a-gar3_ ha-ra-ma-tim 
#tr.ts: ina ugār ḫaramatim
#tr.en: in the Ḫaramatum irrigation district

18. i-ta _a-sza3_ ar-szi-ia 
#tr.ts: itā eqel aršīya
#tr.en: next to the field of Aršīya

19. _dumu_ ba-ta-at-ta 
#tr.ts: mār batatta
#tr.en: son of Batatta,

20. {disz}la-ma-si2 _lukur_ {d}utu 
#tr.ts: lama(s)sī nadīt šamaš
#tr.en: Lamassī nadītu of Šamaš

21. _dumu-munus_ {d}sze-rum-i3-li2 
#tr.ts: mārat šērum-ilī
#tr.en: daughter of Šērum-ilī

@reverse 
1. u2-pi2-ih ki-ir-ba-nam a-na _i7_ id-di 
#tr.ts: upīḫ kirbānam ana nārim iddi
#tr.en: has exchanged (and) has thrown the clod in the canal.

2. _gesz-gan-na ib2-ta-bala_ 
#tr.ts: bukānam šūtuq
#tr.en: (Lamassi) has concluded the exchange (lit. has handed over the pestle)

3. _inim-bi al-til <<sza3-ga-ni i3-du10>>_ 
#tr.ts: awāssu gamrat
#tr.en: its (of the field) transaction is settled,

4. _sza3-ga-ni i3-du10_ 
