#tr.ts: šattum ša buntaḫun-ila šarrum
#tr.en: The year in which Buntaḫun-ila was king.

7. _igi_ nu-ur2-i3-li2-szu 
#tr.ts: maḫār nūr-ilīšu
#tr.en: Before Nūr-ilīšu

8. _dumu_ e-ia 
#tr.ts: mār eya
#tr.en: son of Eya;

9. _igi_ ur-{d}lugal-ban3-da 
#tr.ts: maḫar ur-lugalbanda
#tr.en: before Ur-lugalbanda

10. _dumu_ {d}suen-mu-ba-li2-it, 
#tr.ts: mār sîn-muba(l)liṭ
#tr.en: son of Sîn-muballiṭ;

11. _igi_ {d}suen-e-ri-ba-am 
#tr.ts: maḫār sîn-erībam
#tr.en: before Sîn-erībam

12. _dumu_ nu-ur2-i3-li2-szu 
#tr.ts: mār nūr-ilīšu
#tr.en: son of Nūr-ilīšu;

13. _igi_ sag-{d}nanna-i3-zu 
#tr.ts: maḫār sag-nanna-izu
#tr.en: before Sag-nanna-izu

14. _dumu_ i-din-{d}suen 
#tr.ts: mār i(d)din-sîn
#tr.en: son of Iddin-sîn;

15. _igi_ dingir-mu-sza-lim 
#tr.ts: maḫār ilī-muša(l)lim
#tr.en: before Ilī-mušallim;

