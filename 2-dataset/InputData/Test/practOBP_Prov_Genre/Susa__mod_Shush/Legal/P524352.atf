&P524352 = MDP 23, 272 
#atf: lang akk 
@tablet 
@obverse 
1. [_n ma-na] 1(u) gin2 ku3-babbar_ sza3 _mu 2(disz)-kam-ma_ 
2. [{munus}]wa#-qar-tu um-ma-<szu> le-qa-at-ma# 
3. [x x] x# _ku3-babbar tab-ba ki_ ARAD-{d}mar-tu 
4. [{munus}wa]-qar#-tu u3 li-ib-lu-t,a2 il-[qu2-u2] 
5. [_iti_] sza3#-ba#-t,i _ku3-babbar_ il-qu2-u2 
6. [i-qi2]-ip-pu-ni i-zi-bu-ni-im-ma 
7. [a-na] ba#-ab-ti u3 szi2-hi-it, _kaskal_ 
8. [um]-ma#-nu u2-ul szu-hu-uz 
9. [_ku3-babbar_ um]-ma-na i-pa-lu-ma 
10. [ne-me-el] ib#-ba-asz-szu-ma ma-al-la ah-ma-mi 
@reverse 
