&P332849 = MHET 1/2, 007
#atf: use lexical
# IM 80030 = Di 91
#SA A
# column numbers on drawing are opposite those in transliteration
@tablet
@reverse?
@column 1
1. [me]-me
2. pap#-pap
3. a#-a#
4. a#-a#-a#
$ rest of column broken
@column 2
1. me-me
2. pap-pap
3. a-[a]
4. a-a-[a]
5. ku#-[ku]
6. lu#-[lu]
$ rest of column broken
