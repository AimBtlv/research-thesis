&P332892 = MHET 1/2, 051
#atf: use lexical
#atf: lang akk
@tablet
@obverse
1. qa2-tam s,a-bat {d}marduk
2. ba-la-t,u2-ki {d}marduk#
3. mu-ba-li2-it, {d}[marduk]
4. ra-im ze-ri-im# {d#}[marduk]
5. ra-im na-pi2-[isz-ti] {d#}[marduk]
6. a-ta-na#-[ah] {d#}marduk
7. sza?-ar#? [...] {d#}marduk
8. x [...] {d#}marduk
9. [...] ra-bi {d#}marduk
10. [...] {d#}marduk
11. [...] sza-tim {d#}marduk
12. [...] an-ni {d}marduk
13. [...] x-x-me {d}marduk
14. i?-na-la-li-im {d}marduk
15. ra-bi szu-zu-ub {d}marduk
@reverse
1. %s {d}nidaba KA diri#? {d}marduk
2. pa-t,e-er e-il#-ti {d}marduk
3. pa-ni {d}marduk i#?-na %s e2-sag-il2 %a lu!-mur!(HI)
4. na-hi-isz sza-a#-na {d}marduk ta-ka-lu
5. bu-lu-ut, {d}marduk ra-bi
6. [szu]-zu-ub {d}marduk# ra-bi
7. sza#-x {d}marduk# lu-u4-lu-ul
8. [...] x na-ar-bi-szu x <({d}marduk)>
9. u2-ul [a?]-ma#-szi-e {d}marduk#
10. sza-ta [... {d}]marduk
11. bu-ul-[x?]-t,a2# [... {d}]marduk#
12. na-ap#-sze#-ra-am [...] {d}marduk
13. [qa2?]-ta na-asz2-ki [s,a?-bit? {d}]marduk
14. lib3!-bu!(SZE) ki-it-tam [{d}marduk]
