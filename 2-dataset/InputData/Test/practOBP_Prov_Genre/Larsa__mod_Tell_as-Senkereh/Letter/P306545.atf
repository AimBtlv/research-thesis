&P306545 = YOS 02, 004
#atf: lang akk
@tablet
@obverse
1. a-na _{d}suen_-e-ri-ba-am
#tr.en: To Sin-erībam
2. qi2-bi2-ma 
#tr.en: speak!
3. um-ma _{d}suen_-ma-gir-ma
#tr.en: Thus (says) Sin-māgir:
4. da-mi-iq e-pe2-szum an-nu-um
#tr.en: "Good behaviour this (is),"
5. sza asz-ta-na-pa-ra-kum-ma
#tr.en: "that I write to you again and again, and"
6. di-a-ti la ta-sza-al-lu
#tr.en: "you pay no attention to me."
7. a-nu-um-ma _{d}utu_-ki-nam-i-de
#tr.en: "Now! Šamaš-kīnam-ide,"
8. a-na s,e-ri-ka at,-t,ar-dam
#tr.en: "I have sent to you."
9. bi-it!(ISZ) ku-nu-ki-ia pi2-te-ma
#tr.en: "Open my storehouse."
10. 3(u) 6(disz) _{gesz}ka-apin-hi-a_
#tr.en: "36 tongues of seeder ploughs,"
11. 4(u) 8(disz) _{gesz}ka-apin-tug2-gur10-hi-a_
#tr.en: 48 tongues of harbum ploughs,"
12. 1(disz) 6(disz) _{gesz}ka-gan2-ur3-hi-a_
#tr.en: "66 tongues of harrows,"
13. id-na-szum-ma li-ib-lam
#tr.en: "give him, and let him bring here."
14. ap-pu-tum
#tr.en: "Please."
15. u2-ul ta-asz-pu-ra-am
#tr.en: "You shall not say to me,"
@reverse
1. la# ta-qa2-ab#-bi
#tr.en: "You did not write me."
2. u3 sza-ni-tam
#tr.en: "Something else."
3. a-na bi-it _du10_-ab-_kisz{ki}_
#tr.en: "To the house of Ṭāb-Kiš"
4. a-li-ik-ma
#tr.en: "go!"
5. 2(disz) _{gesz}mar-gid2-da-hi-a_
#tr.en: "Two wagons,"
6. 5(u) 8(disz) _{gesz}ka-kul-mar-gid2-da-hi-a_
#tr.en: "58 ... wagons"
7. li-id-di-na-kum-ma
#tr.en: "let him give to you, and"
8. i-na _{gesz}ma2_ mu-qe2-el-pi2-tim
#tr.en: "on a boat going downstream"
9. szu-ur-ki-ba-am-ma
#tr.en: "load them! And"
10. li-ib-lu-nim
#tr.en: "let them bring them here to me."
11. u3 ri-im-_{d}iszkur_
#tr.en: "And Rīm-Adad,"
12. li-il-li-kam
#tr.en: "let him come here."
