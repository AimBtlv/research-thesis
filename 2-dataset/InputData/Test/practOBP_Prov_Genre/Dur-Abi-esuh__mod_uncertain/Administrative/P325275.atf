&P325275 = CUSAS 08, 039
#atf: lang akk
@tablet
@obverse
1. 1(asz) 2(barig) 3(ban2) a-na _3(disz) masz2-szu-gid2-gid2_
# CUSAS 8 adds: -[mesz] at end of the line
#tr.ts: ištēn kur šinā pān šalāš sât ana šalāšat bārî
#tr.en: 1 kor, 2 bushels (and) 3 seahs for 3 diviners;

2. 2(barig) 3(ban2) a-bu-wa-qar _dumu_ a-hu-wa-qar
#tr.ts: šinā pān šalāš sât abu(m)-waqar mār aḫu(m)-waqar
#tr.en: 2 bushels (and) 3 seahs, Abum-waqar son of Aḫum-waqar;

3. 3(barig) _erin2#_ a-mi-rum _erin2_ unu{ki} u3# i3-si#-[in{ki}]
#tr.ts: šalāšat pān ṣābum āmirum ṣābi unug u isin
#tr.en: 3 bushels, the scout, soldiers of Uruk and Isin;

4. 2(barig) 2(disz) x? _szu-i-mesz_ x
#tr.ts: šinā pān šitta ... gallābū
#tr.en: 2 bushels, 2 barbers ...;

5. 1(barig) sa-am-su-i-lu-na-usz-ta-al
#tr.ts: ištēn pān samsu-iluna-uštal
#tr.en: 1 bushel, Samsu-iluna-uštal;

6. 1(barig) _lu2 a-igi#-du8_
#tr.ts: ištēn pān sēkirum
#tr.en: 1 bushel, the canal worker;

$ single ruling
7. ($ blank space $) 3(asz) 2(barig) _sze gur_
#tr.ts: šalāšat kur šinā pān ûm
#tr.en: (total) 1020 liters of barley. (It is the barley,

8. ($ blank space $) _{gesz}ba-ri2#-ga_ {d}marduk sza nam-har#-ti
#tr.ts: parsikti marduk ša namḫarti(m)
#tr.en: measured by) the parsiktu-measure of Marduk for receipts

9. szi-i-iq me-sze-qi2-im ra-aq-qi2#-im
#tr.ts: šīq mešēqim raqqim
#tr.en: according to the small misure,

10. a-na 3(disz)! _mesz2-szu-gid2-gid2 u3_ a-hi-a-tim
# CUSAS 29 emends to 3(disz)!, copy has 2(disz)
#tr.ts: ana šalāšat bārî u aḫiātim
#tr.en: for 3 diviners and others, (that,)

11. i-nu-ma um-ma-na-tum#
