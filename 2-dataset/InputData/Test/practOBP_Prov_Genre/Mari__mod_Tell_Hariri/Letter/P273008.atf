#tr.ts: inūma têrētum 
#tr.en: When the omens 
10. isz-ta-al-ma 
#tr.ts: ištalmā 
#tr.en: have become favorable, 
11. a-t,a3-ar-ra-su2-nu-ti 
#tr.ts: aṭarrassunūti 
