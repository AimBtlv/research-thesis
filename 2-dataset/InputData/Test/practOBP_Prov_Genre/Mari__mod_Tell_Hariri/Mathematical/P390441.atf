&P390441 = RA 078, 030-035 
#atf: lang akk 
@tablet 
@obverse 
1. 1(disz) _sze_-tum _sze_-t,e6-tam 1(disz)-ti-tam u2-s,i2-ma 
#tr.en: A barley-corn: to a single barley-corn I increased, 
# 1 sze is approximately 0.05g of barley 
