2. {disz}erisz-ti-{d}utu _dumu-munus_ {d}suen-e-ri-ba-am 
3. re-di-it wa-ar-ka-ti-sza  
4. _1(esze3) GAN2 a-sza3_ i-na pa-hu-s,um{ki} 
5. i-ta _a-sza3_ sig-isz8-tar2 _dumu_ ma-an-nu-ki-ma-i3-li2-ia 
6. u3 i-ta _a-sza3_ il-ta-ni a-ha-ti-sza 
7. _1(u) sar {gesz}kiri6_ i-na pa-hu-s,um{ki} 
8. i-ta {gesz}bi-ni sza {d}lugal-sag-il2 
9. _e2_ ga-gi-im ma-la ma-s,u2-u2 
10. mi-im-ma an-ni-im wa-ar-ka-sa3 bu-szu-sza 
11. s,u2-lu-sza sza i-ga-ri-im 
12. isz-tu pe2-e a-di _ku3-sig17_ 
13. sza geme2-{d}utu _dumu-munus_ dingir-szu-i-bi-szu 
14. a-na erisz-ti-{d}utu _dumu-munus_ sin-e-ri-ba-am 
15. _dumu-munus_ a-hi-sza id-di-nu 
16. a-di erisz-ti-{d}utu _dumu-munus_ sin-e-ri-ba-am 
17. ba-al-t,a3-at _a-sza3 {gesz}kiri6 u3 e2_ 
18. qa2-as2-sa3-ma u3-ka-al 
19. _a-sza3_-sza a-na er-re-szi-im  
20. _{gesz}kiri6_-sza a-na sza-ki-im  
21. _e2_-sza a-na ki-is-ri 
# Suurmeijer reads: _e2_-sza3
22. {disz}erisz-ti-{d}utu-ma i-na-ad-di-in 
@reverse 
1. ah-hu-sza u2-ul i-pa-ra-ku-szi-im 
2. i-na ah-hi-sza sza i-pi2-ru-szi 
3. u3 i-pa-la-hu-szi a-pil2-sza 
4. ma-la li-ib-bi-sza u2-ul i-ma-s,i-ma 
5. ap-lu-sa3 a-na a-hi-im 
6. u2-ul i-na-ad-di-in 
7. _mu_ {d}utu {d}a-a {d}marduk 
8. u3 sa-am-su-i-lu-na _lugal_ it-mu-u2
9. _igi_ {d}utu-tab-ba-szu _sanga {d}utu_ 
10. _igi_ isz-me-{d}suen _sanga {d}utu_ 
11. _igi_ {d}marduk-la-ma-sa3-szu _ugula lukur {d}utu-mesz_ 
12. _igi_ ra-pa-asz-s,il2-li2-e2-a 
13. _igi_ {d}iszkur-ma-an-szum2 _igi_ ARAD-i3-li2-szu 
14. _igi_ erisz-ti-{d}utu _dumu-munus_ sig-isz8-tar2 
15. [_igi_] a-ma-at-kal-la-tim _dumu-munus_ lu2-{d}nanna 
16. _igi_ erisz-ti-{d}utu _dumu-munus_ a-hu-szi-na  
17. _igi_ na-ra-am-ta-ni _dumu-munus_ mu-na-wi-rum 
18. _igi_ be-le-su2-nu _dumu-munus_ i3-li2-re-me-ni 
19. _igi_ inim-{d}x-sun2? _dumu-munus_ sin-ra?-bi 
20. _igi_ la-ma-sa3-ni _dumu-munus_ pu-ut,-ra-am 
21. _igi_ inim-{d}a-a _dumu-munus_ ma-ta-a 
22. _igi_ geme2-{d}ma-mu _dumu-munus_ dingir-ma-an-szum2 
23. _iti gu4-si-sa2 u4 3(disz)-kam_  
24. _mu us2-sa {uruda}ki-lugal-gub hur-sag 
# an erasure before hur-sag 
@seal 1 
