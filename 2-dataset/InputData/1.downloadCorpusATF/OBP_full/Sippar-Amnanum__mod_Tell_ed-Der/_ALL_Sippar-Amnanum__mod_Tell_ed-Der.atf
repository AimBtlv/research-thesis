&P224720 = TIM 07, 029 
#atf: lang akk 
@tablet 
@obverse 
1. _2(ban2) za3-hi-li-a{sar}_ a-na ze-ra#-ni 
2. _ki_ {d}suen-na-di-in-szu-mi _dumu_ {d}amar-utu-na-s,i-ir 
3. {disz}ib-ni-{d}amar-utu _nu-{gesz}kiri6 dumu_ {d}suen-e-ri-ba-am 
4. _szu ba-an-ti_ 
5. _u4 buru14-sze3_ 
@reverse 
1. ze-ra-[ni] 
2. u2-ta#-[ar] 
$ single ruling 
3. _igi_ szu-pi2-sza _sanga_ {d}gu-la 
# Stol, Fs Renger (1999) p. 584 
4. _igi_ dingir-szu-ib-ni _dumu_ a-wi-il-{d}mar-tu 
$ single ruling 
$ blank space 
5. _iti udru{duru5} u4 1(u) 7(disz)-kam#_ 
6. _mu_ am-mi-s,a-du-qa2 _lugal# {d}amar-utu en ir9-ra szu-nir gal-gal-la_ 
@seal 1 
$ (uninscribed, with caption:) 
1. _kiszib3_ {d}iszkur-i3-li2

