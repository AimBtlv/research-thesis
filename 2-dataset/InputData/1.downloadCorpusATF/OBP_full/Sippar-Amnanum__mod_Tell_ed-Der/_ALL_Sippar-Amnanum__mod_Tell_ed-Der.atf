&P512411 = Suurmeijer diss. Di 2117 
#atf: lang akk
@tablet 
$ (in unopened envelope except for obverse bottom:)
@obverse 
1'. _igi_ lu2-{d}[mar-tu _gala-mah_] 
2'. _igi_ a-ba-an-da-di [_dumu_ {d}utu-ma-an-szum2] 
3'. _igi_ ip-qa2-tum [_dumu_ dingir-da-x] 
@envelope 
@obverse 
1. _4(disz) gin2 e2_ i-na _ka2_ {d}nun-gal 
2. _da e2_ erisz-ti-{d}a-a _lukur {d}utu_ 
3. _dumu-munus_ i3-li2-isz-ti-kal# 
4. u3 _da e2_ erisz#-ti#-{d}a-a _lukur {d}utu_ 
5. _dumu-munus_ lu2-{d}nin-szubur-ka  
6. _sag-bi sila_ 
7. _egir-bi e2_ erisz-ti-{d}a-a _lukur {d}utu_ 
8. _dumu-munus_ lu2-{d}nin-szubur-ka-me 
9. _ki_ erisz-ti-{d}a-a _lukur {d}utu_ {disz}{d}utu-qar-ra-ad 
10. u3 nu-rum-li-s,i _dumu-mesz_ i3-li2-isz-ti-kal 
11. {disz}erisz-ti-{d}a-a _lukur {d}utu_ 
12. _dumu-munus_ lu2-{d}nin-szubur-ka 
13. [... _in-szi-in-sa10] sa10 til-la-bi-sze3_ 
14. [... _ku3-babbar in-na]-an#-la2_ 
15. [_sza3-ga-ni] al#-du10_ 
16. _u4-kur2-sze3 lu2 lu2-ra_ 
17. _inim nu-um-ga2-ga2-a_ 
@reverse 
1. _mu_ {d}utu {d}a-a [{d}marduk] 
2. u3 sa-am-su-i-lu-na _lugal_ 
3. _in-pa3-de3-mesz_ 
4. _igi_ dingir-pi4-{d}a-a _sanga_ {d}utu 
5. _igi_ lu2-{d}mar-tu _gala-mah_ 
6. _igi_ a-ba-an-da-di 
7. _dumu_ {d}utu-ma-an-szum2 
8. _igi_ ip-qa2-tum _dumu_ dingir-da-x  
9. _igi_ dingir-lam-ha-x _dumu_ dingir-szu-ba-ni 
10. _igi_ {d}suen-a-ha-am-i-din-nam 
11. _dumu_ hu-za-lum# 
12. _igi_ u2-tul-{d}ma-mi _dumu_ dingir-su-i-bi 
13. _igi_ ib-ni-{d}iszkur _dub-sar_ 
14. _iti gan-gan-e3 u4 1(disz)-kam_  
15. _mu i7_ sa-am-su-i-lu-na-he2-gal2 mu-un-ba-al_ 
@seal 1 
1. ARAD-{d}suen# 
2. _sanga_ {d}[utu] 
3. _dumu_ li-pi2-it-[isz8-tar2] 
4. _ARAD_ {d}a-[a] 
@seal 2 
1. lu2-{d}mar-tu 
2. _dumu_ u3-mu-un-{d}utu-mu 
3. _ARAD_ {d}bu-ne-ne

