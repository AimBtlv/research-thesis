17. i-mu-ru _di-<ku5-mesz>_ di-nam u2-sza-hi-su-szu-nun-[ti] 
18. _szu-nir ku3-sig17_ u2-sza-al-li-isz 
19. u3 _szu-nir_ sza# {d}suen iz-zi-zu 
20. szi-bu ba-ab-tum mu-du-u2 _e2_ i3-li2-isz-ti-[kal] 
21. sza {d}nun-gal il-qu2-u2 u2-bi-ir-ru-ma 
