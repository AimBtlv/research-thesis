&P512373 = Suurmeijer diss. Di 0689   
#atf: lang akk 
@tablet 
$ (tablet is inside unopened envelope) 
@envelope 
@obverse 
1. _1(esze3) GAN2 a-sza3_ i-na _a-gar3_ pa-hu-s,um{ki} 
2. i-ta erisz-ti-{d}a-a _dumu-munus_ sig-isz8-tar2 
3. u3 i-ta il-ta-ni _nu-bar dumu-munus_ dingir-su-i-bi-szu 
4. _1(u) sar {gesz}kiri6_ i-na pa-hu-s,um{ki} 
5. i-ta _{gesz}kiri6 sza {d}<lugal>-sag-il2_ 
6. _1/2(disz) sar e2 du3-a_ i-na ga-gi4-im{ki} 
7. _da e2_ in-bu-sza _dumu-munus_ a-na-tum 
8. u3 _da e2 sila_ 
9. mi-im-ma an-ni-im 
10. sza geme2-{d}utu _dumu-munus_ dingir-szu-iu-bi-szu 
11. a-na erisz-ti-{d}utu _dumu-munus_ sin-e-ri-ba-am  
12. _dumu-munus_ a-hi-sza ap-lu-us-sa3 
13. id-di-nu 
14. a-hu-sza ap-lu-sza 
15. _a-sza3_-am {gesz}kiri6 u3 e2_ ga-gi4-im{ki}  
16. {disz}erisz-ti-{d}utu _dumu-munus_ sin-e-ri-ba-am 
17. ma-la li-ib-bi-sza 
18. u2-ul i-ma-s,i2-ma 
19. a-na _ku3-babbar_-im u2-ul i-na-ad-di-in# 
@reverse 
1. {disz}erisz-ti-{d}utu a-na geme2-{d}utu 
2. um-mi-sza u2-ul um-mi at-ti i-qa2-ab-bi-ma 
3. i-na _a-sza3-bi# {gesz#}kiri6 u3 e2_ 
4. i-te-el-li 
5. u3 szum-ma geme2-{d}utu a-na erisz-ti-{d}utu 
6. ma-ar-ti-sza u2-ul ma-ar-ti at-ti 
7. i-na _e2_ u3 u2-ni-a-tim i-te-el-li  
8. a-di geme2-{d}utu ba-al-t,a3-at 
9. _a-sza3_-am _{gesz}kiri6 u3 e2_ qa2-as2-sa3-ma 
10. u2-ka-al 
11. _mu_ {d}utu {d}a-a {d}marduk sa-am-su-i-lu-na 
12. u3 _iri_ zimbir{ki} it-mu-u2 
13. _igi_ dingir-pi4-{d}a-a u3 isz-me-{d}suen _sanga {d}utu_ 
14. _igi_ {d}marduk-la-ma#-sa3-szu u3 ra-pa-asz-s,il2-li2-e2-a 
15. _ugula lukur {d}utu-mesz_ 
16. _igi_ sin-e-ri-ba-am _dumu_ lu2-{d}utu 
17. _igi_ {d}iszkur-i-din-nam _dumu_ szu-bu-ri-im 
18. _igi_ i#-din#-sin _dumu_ sin-e-ri-ba-am 
19. _igi_ sin-na-s,ir _dumu_ i-din-{d}nin-szubur 
20. _igi_ be-el-ta-ni _dumu-munus_ dingir-pi4-sin 
21. _igi_ be-el-ta-ni _dumu-munus_ sin-isz-me-a-ni 
22. _igi_ in-bu-sza _dumu-munus_ a-na-tum 
23. _igi_ geme2-{d}utu _dumu-munus_ {d}suen#-isz#?-[me-an-ni?] 
24. _igi_ la-ma-sa3-ni _dumu-munus_ pu-ut,-ra-am 
25. _igi_ {d}nanna-ma-an-szum2 _dub-sar_ 
26. _iti NE!-[NE]-gar u4 4(disz)-kam_ 
27.  _mu_ sa-am-ssu-i-lu-na 
@seal 1 
$ (no linguistic content) 
@seal 2 
