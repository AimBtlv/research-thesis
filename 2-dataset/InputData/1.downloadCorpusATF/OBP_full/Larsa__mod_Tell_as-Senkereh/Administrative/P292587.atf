&P292587 = YOS 08, 102 
#atf: lang akk 
@tablet 
$ (YOS 08 copy switches obverse and reverse)
@obverse 
1. _igi_ a-wi-i-a-tum 
2. {disz}za-a-lum 
3. {disz}sza-ni-nu-um _di-ku5_ 
4. {disz}{d}suen-na-wi-ir _sza3-tam_  
5. {disz}a-hu-wa-qar _dub-sar_ 
6. {disz}a-hu-wa-qar _dam-gar3_ 
7. {disz}i-din-{d}mar-tu _dam-gar3_ 
8. {disz}i3-li2-s,i-li2!? 
9. {disz}dingir-szu-illat-su2 _di-ku5_ 
10. {disz}puzur4-{d}utu _dumu#_ u2-qa2-dingir 
11. {disz}{d}suen-li-ta-lal3 
12. u3 {d}suen-ma-gir _ra2-gaba_ 
13. asz-szum di-ni-im <sza> _u8-udu-hi#-a#_ 
