2. i-pu-szu-u2-ma 
3. _la'u4! 2(disz) me 2(u) 3(disz) u8-udu_ 
4. _la'u4!(|LA2+ASZ|) 1(asz) gu2 3(u) 6(disz) ma-na siki_ 
# Feuerherm reads LAL+GAG both times, also line 7, but copy differs
5. _sza3 mu iri?{ki?}_ dam#-qi2-i3-li2-szu _in-[dab-ba]_   
# Rim-Sin 25 
6. _la'u4!(|LAL+ASZ|) [1(disz)] me 4(u) 5(disz) u8-udu_  
7. _1(u) 5(disz) ma-na siki_ 
8. _sza3 mu du11!-ga an {d}en-lil2 {d}en-ki-ga-ta#_ 
# Rin-Sin 27 
9. sza gi-mi-lum 
10. _1(gesz2) 1(u) 7(disz) u8-udu_ 
11. _1(u) 3(disz) u8#-[udu] 
12. a-hi-a-tum# 
13. ($ blank space $) _4(disz) me 5(u) 8(disz) u8-udu_ 
14. ($ blank space $) _1(asz) gu2 5(u) 1(disz) ma-na siki_ 
15. _nig2-ka9 til-la_ 
16. sza gi-mi-lum 
17. _ugu#_ i-din-i-a-tum 
18. [u3] {d}suen-pa-t,e4-er 
19. [i]-szu-u2 
20. [e-zi-ib] _la'u4!(|LAL+ASZ|) 1(disz) me 9(disz) u8-udu_ sza s,i!-li2-i3!-li2!-szu 
21. [_sza3 mu] du11#-ga an {d}en-lil2 {d}en-ki-ga-ta_ 
22. [sza?] _ugu_ ARAD-{d}nanna a-bi-szu-nu  
23. u3? a-hi a-bi-szu-nu i-szu-u2 
