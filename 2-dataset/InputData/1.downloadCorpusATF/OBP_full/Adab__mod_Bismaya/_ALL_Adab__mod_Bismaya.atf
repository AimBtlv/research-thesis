&P333347 = AJSL 32, p. 098-101 no. 1
#atf: lang akk
@tablet
@obverse
1. [a-na] {d}ri-im-{d}[x-x]
2. [qi2]-bi2-[ma]
3. um#-ma {d}ri-im-_{d}suen_-[...]
4. _{d}utu_ li-ba-al-li#-[it,-ka]
5. asz-szum _a-sza3_ {disz}a-hu-szu-[nu]
6. sza {disz}a-bu-um-_dingir_ isz-szu-ru-szu#
7. sza-ad-da-ag-di-im {disz}a-bu-um-_dingir_
8. _a-sza3_-lam isz-ku-uk
9. isz-bi-ir u3 sze-szu# il-qe3-ma
10. {disz}a-hu-szu-nu pi-szu u2-ul i-pu-su-um
11. sza-at-ta-am mi-ik-ra#-am
12. im-ku#-ur
13. isz-ku-uk isz#-bi-ir-ma
14. i-nu-ma# a-na# e-re-szi-im
15. qa2-su2 isz#-ku#-nu#
16. {disz}a-hu-szu-[nu] il#-li-ik-ma
17. asz-szum {disz}a-bu-um-_dingir_ i-na# ni-IG?-ni-ri-im
18. s,u2-ha-ri-szu it#-ta-DI?
19. u3 a-na _a-sza3_ e-re-szi-im
20. qa2-su2 isz#-ta#-ka-an
21. {disz}a-hu-szu-nu su#-un#-ni-iq-szu-ma
22. ni-isz szar-ri-im i-na pi-szu# szu-ku-un-ma
23. la# i-ta-ar#-ma _a-sza3_-lam
24. [la] i-[ba]-aq#-qa2-ar-szu
@reverse
$ blank

