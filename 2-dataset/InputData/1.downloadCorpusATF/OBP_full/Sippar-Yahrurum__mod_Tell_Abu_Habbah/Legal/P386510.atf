14. _dumu_ sig-esz18-dar 
#tr.ts: mār ipqu-ištar
#tr.en: son of Ipqu-ištar;

15. _igi_ we-er-esz18-dar _dumu_ {d}we-er-a-bu-szu 
#tr.ts: maḫar wēr-ištar mār wēr-abūšu
#tr.en: before Wer-ištar son of Wēr-abūšu;

16. _igi_ i3-li2-isz-me-an-ni 
#tr.ts: maḫar Ilī-išmeanni
#tr.en: before Ilī-išmeanni

17. _dumu_ bu-ba-di
#tr.ts: mār bubadi
#tr.en: son of Bubadi;

18. _igi_ uri2{ki}-ga-mil 
#tr.ts: maḫar ur-gāmil
#tr.en: before Ur-gāmil

19. _dumu_ sin-be-el-i3-li2 
#tr.ts: mār sîn-bēl-ilī
#tr.en: son of Sîn-bēl-ilī.

20. _mu ugnim larsa{ki} {gesz}tukul ba-sag3_ 
#tr.ts: šanat ummān larsa ina kakkim immaḫiṣ
