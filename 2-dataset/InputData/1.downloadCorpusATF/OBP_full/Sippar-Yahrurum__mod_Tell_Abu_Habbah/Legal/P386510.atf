&P386510 = TCL 01, 074 
#atf: lang akk 
@tablet 
@obverse 
1. _a-sza3_ sza ha-ra-ma-tum 
#tr.ts: eqlum ša ḫaramatum
#tr.en: The field in Ḫaramatum

2. i-ta _a-sza3_ la-ma-si2 _dumu-munus_ {d}sze-rum-i3-li2 
#tr.ts: itā eqel lama(s)sī mārat šērum-ilī
#tr.en: next to the field of Lamassī daughter of Šērum-ilī

3. ki-ir-ba-nam a-na ha-ra-ma-tum is-su2-uk 
#tr.ts: kirbānam ana ḫaramatum issuk
#tr.en: became eroded (lit. has thrown a clod) toward Ḫaramatum (and)

4. ki-ir-ba-nam a-na _i7_ zimbir{ki} is-su2-uk 
#tr.ts: kirbānam ana purattim issuk
#tr.en: became eroded toward the Euphrates.

5. sza ri-isz-{d}utu {disz}ki-ma-a-hi-ia 
#tr.ts: ša rīš-šamaš kīma-aḫīya
#tr.en: (It is the one) that Rīš-šamaš, Kīma-aḫīya

6. u3 sa3-ri-qum _dumu-mesz_ {d}utu-a-bu-um 
#tr.ts: u za(r)riqum mārū šamaš-abum
#tr.en: and Zarriqum, sons of Šamaš-abum,

7. _ki_ geme2-{d}utu _dumu-munus_ bur-{d}suen 
#tr.ts: itti amat-šamaš mārat būr-sîn
#tr.en: with Amat-šamaš daughter of Būr-sîn

8. u3 la-ma-si2 _dumu-munus_ {d}sze-rum-i3-li2 
#tr.ts: u lama(s)sī mārat šērum-ilī
#tr.en: and Lamassī daughter of Šērum-ilī

9. usz-pe2-lu-u2-ma i-tu-ru-u2-ma 
#tr.ts: ušpelūma itūrūma
#tr.en: exchanged and (for which) they came back and (that)

10. {disz}ri-isz-{d}utu {disz}ki-ma-a-hi-ia 
#tr.ts: rīš-šamaš kīma-aḫīya
#tr.en: Rīš-šamaš, Kīma-aḫīya

11. u3 sa3-ri-qum ib-qu2-ru-u2-ma 
#tr.ts: u za(r)riqum ibqurūma
#tr.en: and Zarriqum claimed, and (for which)

12. _5(disz) gin2 ku3-babbar_ ni-ip-la-at _a-sza3_-im 
#tr.ts: ḫamšat šiqil kaspam niplāt eqlim
#tr.en: 5 shekels of silver, the balance for the field,

13. {disz}geme2-{d}utu u3 la-ma-si2 asz-szum <wa>-ta-ar-tim 
#tr.ts: amat-šamaš u lama(s)sī aššum watartim
#tr.en: Amat-šamaš and Lamassī, because of the excess (size),

14. isz-qu2-la-a-ma ba-aq-ri-szu-nu 
#tr.ts: išqulāma baqrīšunu
#tr.en: weighed out so their claims

15. u3 ru-gu-ma-ni-szu-nu 
#tr.ts: u rugu(m)mānīšunu
#tr.en: and their complaints,

16. sza ri-isz-{d}utu {disz}ki-ma-a-hi-ia 
#tr.ts: ša rīš-šamaš kīma-aḫīya
#tr.en: of Rīš-šamaš, Kīma-aḫīya

17. u3 sa3-ri-qum 
#tr.ts: u za(r)riqum
#tr.en: and Zarriqum,

18. is-su2-ha 
#tr.ts: issuḫā
#tr.en: (Amat-šamaš and Lamassī) rejected.

@reverse 
1. u2-ul i-tu-ru-u2-ma 
#tr.ts: ul itu(r)rūma
