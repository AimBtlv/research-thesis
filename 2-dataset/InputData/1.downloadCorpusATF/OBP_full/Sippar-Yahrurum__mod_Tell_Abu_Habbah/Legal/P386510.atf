8. _mu_ {d}utu {d}a-a _mu_ {d}marduk 
#tr.ts: nīš šamaš ayya nīš marduk
#tr.en: (by) the life of Šamaš (and) Ayya; (by) the life of Marduk

9. u3 {d}suen-mu-ba-li2-it, 
#tr.ts: u sîn-muba(l)liṭ
#tr.en: and Sîn-muballiṭ

10. _in-pa3-de3-mesz_ 
#tr.ts: itmû
#tr.en: they swore.

11. _igi_ ar-sa3-nu-um _dumu_ za-ku-rum 
#tr.ts: maḫar arsanum mār zakurum
#tr.en: Before Arsanum son of Zakurum;

12. _igi_ {d}suen-a-bu-szu _dumu_ i-szar-{d}utu 
#tr.ts: maḫar sîn-abūšu mār išar-šamaš
#tr.en: before Sîn-abūšu son of Išar-šamaš;

13. _igi_ ta-pi2-gi-ri-{d}utu 
#tr.ts: maḫar ta(p)pi-gi(r)ri-šamaš
