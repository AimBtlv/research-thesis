&P355866 = CT 04, pl. 47, Bu 1891-05-09, 0475 
#atf: lang akk 
@tablet 
@obverse 
1. _1(esze3) GAN2 a-sza3_ i-na zi-ma-gir
#tr.ts: šinā ebel eqlam ina zimagir
#tr.en: A field of 2 eblu in the Zimagir (irrigation district),
2. i-na {i7}li-ia-a-nim 
#tr.ts: ina liyānim
#tr.en: by the canal Liyānim
3. i-sza-at-ti 
#tr.ts: išatti
#tr.en: watered (lit. takes the water),
4. _da a-sza3_ sa3-la-ta-nu-um 
#tr.ts: ita eqel salatānum
#tr.en: next to the field of Salatānum,
5. szu-bu-ra-szu 
#tr.ts: šubu(r)rašu
#tr.en: its rear end
6. _a-sza3_ {d}suen-sze-mi 
#tr.ts: eqel sîn-šēmi
#tr.en: is the field of Sîn-šēmi
7. _dumu_ a-hu-um 
#tr.ts: mār aḫum
#tr.en: son of Aḫum
8. u3 _da a-sza3_ nu-ur2-i3-li2-szu 
#tr.ts: u ita eqel nūr-ilīšu
#tr.en: and next to the field of Nūr-ilīšu
9. _dumu_ {d}suen-en-nam 
#tr.ts: mār sîn-ennam
#tr.en: son of Sîn-ennam,
10. i-na li-ib-bi 
#tr.ts: ina libbi
#tr.en: inside
11. szu-ku-si2-szu 
#tr.ts: šukūsīšu
#tr.en: his subsistence field,
12. a-na be-la-a _dumu-munus-a-ni_ 
#tr.ts: ana bēlâ māratīša
#tr.en: to Bēlâ his daughter
13. {disz}nu-ur2-i3-li2-szu 
#tr.ts: nūr-ilīšu
#tr.en: Nūr-ilīšu
14. _dumu_ {d}suen-en-nam 
#tr.ts: mār sîn-ennam
#tr.en: son of Sîn-ennam
15. i-di-in 
#tr.ts: i(d)din
#tr.en: has given.
16. _igi_ hu-mu-ru-um 
#tr.ts: maḫar ḫu(m)murum
#tr.en: Before Ḫummurum
@reverse 
1. _dumu_ {d}suen-en-nam 
#tr.ts: mār sîn-ennam
#tr.en: son of Sîn-ennam;
2. _igi_ da-ki-ru-um _dub-sar_ 
#tr.ts: maḫar dakirum ṭupšarrim
#tr.en: before Dakirum, scribe
3. _dumu_ za-ab-za-bu-um 
#tr.ts: mār zabzabum
#tr.en: son of Zabzabum;
4. _igi_ za-za-tum _dumu-munus_ sa3-am-sum2 
#tr.ts: maḫar zazatum mārat samsum
#tr.en: before Zazatum daughter of Samsum;
5. _igi_ {d}a-a-ri-sza-at 
#tr.ts: maḫar ayya-rīšat
#tr.en: before Ayya-rīšat
6. _dumu-munus_ {d}suen-en-nam 
#tr.ts: mārat sîn-ennam
#tr.en: daughter of Sîn-ennam;
7. _igi_ {d}a-a-ri-sza-at 
#tr.ts: maḫar ayya-rīšat
#tr.en: before Ayya-rīšat
8. _dumu-munus_ puzur4-{d}utu 
#tr.ts: mārat puzur-šamaš
#tr.en: daughter of Puzur-šamaš;
9. _igi_ a-ma-at-{d}a-a
#tr.ts: maḫar amat-ayya
#tr.en: before Amat-ayya
10. _dumu-munus_ a-wi-la-ni 
#tr.ts: mārat awīlani
#tr.en: daughter of Awīlani;
11. _igi_ sa-na-ak-ra-tum 
#tr.ts: maḫar sanakratum
#tr.en: before Sanakratum
12. _dumu-munus_ mu-sa-li-mu-um 
#tr.ts: mārat muša(l)limum
#tr.en: daughter of Mušallimum.
13. _iti ti-ru-um_ 
#tr.ts: waraḫ tirum
#tr.en: The month of Tirum,
14. _mu_ i-s,i2-su-mu-a-bu-um 
#tr.ts: šanat izi-sumu-abum
#tr.en: the year "Izi-sumu-abum
15. _ba-usz2_ 
#tr.ts: imūt
#tr.en: died".
16. _igi_ dingir-mu-sza-lim 
#tr.ts: maḫar ilu-muša(l)lim
#tr.en: Before Ilu-mušallim;
@left
1. _igi_ {d}da-mu-gal-zu _dub-sar_ 
#tr.ts: maḫar damu-galzu ṭupšarrim
#tr.en: before Damu-galzu, the scribe;
2. _igi_ {d}utu-a-suk!-ni-szi _igi_ lu-da-ri 
#tr.ts: maḫar šamaš-asuk-nīši maḫār ludari
#tr.en: before Šamaš-asuk-nīši; before Ludari.
