&P386540 = TCL 01, 104
#atf: lang akk
@tablet
@obverse
1. isz-tu 2/3(disz) _sar e2_ u3# _iti 6(disz)-kam_ 
#tr.ts: ištu šinip mūšar bītam u šeššet warḫī
#tr.en: After that 40 shekels of the house and six months,

2. ba-ma-at sza-at-tim 
#tr.ts: bamat šattim
#tr.en: half of a year(ly income),

3. sza sig-{d}nin-gal a-hi a-bi-szu 
#tr.ts: ša ipqu-ningal aḫi abīšu
#tr.en: of Ipqu-ningal his uncle (lit. his father's brother),

4. {disz}sin-i-din-nam il-qu2-u2 asz-szum _ha-la_-szu# 
#tr.ts: sîn-i(d)dinam ilqû aššum zittīšu
#tr.en: Sîn-iddinam had took, about his share

5. _ki_ sig-{d}edin {disz}ru-ut-tum {disz}sza-mu-uh-tum 
#tr.ts: itti ipqu-šērū'a ruttum šamuḫtum
#tr.en: with Ipqu-šērū'a, Ruttum, Šamuḫtum

6. u3 be-le-tum _lukur_ {d}marduk is,-s,a-bi-it 
#tr.ts: u bēletum nadīt marduk iṣṣabit
#tr.en: and Bēletum nadītu of Marduk he quarreled (so)

7. i-di-im-ma _di-ku5-mesz lugal_ ik-szu-ud-ma 
#tr.ts: idīmma dayyānī šarrim ikšudma
#tr.en: started a lawsuit and approached the king's judges.

8. _di-ku5-mesz_ di-nam u2-sza-hi-is-su2-nu-ti-ma 
#tr.ts: dayyānū dīnam ušāḫissūšunūtīma
#tr.en: The judges granted them a trial and

9. i-na _e2_ u3 _iti 6(disz)-kam_ ba-ma-at <sza-at>-tim 
#tr.ts: ina bītim u šeššet warhī bamat šattim
#tr.en: the house and the 6 months, half of a year(ly income),

10. za-za-am iq-bu-szum-ma 
#tr.ts: zâzam iqbûšumma
#tr.en: they told him to take; moreover

11. 1(u) _gin2 e2 da_ sig-{d}nin-gal# 
#tr.ts: ešret šiqil bītam itā ipqu-ningal
#tr.en: 10 shekels of the house next to Ipqu-ningal

12. u3 _iti 2(disz)-kam ugula_ ba-<ab>-tim 
# Rivkah Harris, Ancient Sippar (1975) p. 58 n. 4 
#tr.ts: u šinā warḫī akil babtim
#tr.en: and 2 months (of the income for the office) of overseer of the ward

13. i-na bi-it a-bi-ia-tum a-bi-szu 
#tr.ts: ina bīt abiyatum abīšu
#tr.en: in the house of Abiyatum his father

14. it#-ti a-hi-szu# il#-qi2#-ma# 
#tr.ts: itti aḫīšu ilqēma
#tr.en: he (Sîn-iddinam) took from his brother.

15. _szunigin 5/6(disz) sar e2_ 
#tr.ts: napḫarum parasrab mūšar bītam
#tr.en: Total: 50 shekels of the house,

16. e-zu-ub _za3-ga-e3-a_ 
#tr.ts: ezub mūṣîm
#tr.en: except the right-of-way,

@reverse 
1. u3 _iti 8(disz)-kam_ i-na _mu 1(disz)-kam_ 
#tr.ts: u samānat warḫī ina šattim
