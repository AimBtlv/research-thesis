#tr.en: before ... son of ...;

7. igi [... _dumu_ ...]-x-tum 
#tr.ts: maḫar ... mār ...
#tr.en: before ... son of ...;

8. igi [... _dumu_ ...]-szu 
#tr.ts: maḫar ... mār ...
#tr.en: before ... son of ...;

9. igi [...] 
#tr.ts: maḫar ...;
#tr.en: before ...;

10. igi [...] 
#tr.ts: maḫar ...
#tr.en: before ...

$ single ruling 
11. _iti diri u4 2(u) [n-kam]_ 
#tr.ts: waraḫ dirigîm ūmām ešrā ...
#tr.en: The intercalary month, the day 20 + n,

12. _mu i7# [ti-lim-da-{d}en-lil2-la2] u3 {i7}buranun{ki}_
