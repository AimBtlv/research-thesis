&P512368 = BAP 103 
#atf: lang akk 
@tablet 
@obverse 
1. _1(disz) sar e2 du3-a kislah_ 
#tr.ts: ištēn mūšar maškanum
#tr.en: An unbuilt plot of 1 SAR
