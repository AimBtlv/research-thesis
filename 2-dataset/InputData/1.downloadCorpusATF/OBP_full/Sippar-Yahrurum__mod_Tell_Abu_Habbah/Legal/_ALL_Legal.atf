#tr.ts: ina šewir kaspim išām
#tr.it: con l'anello d'argento ha comprato,
2. _sa10 til-la-bi-sze3 1(disz) ma#-na ku3-babbar_
#tr.ts: šīmišu gamrim ištēn mana kaspam
