#tr.ts: ana mārūtim ilqû
#tr.en: adopted.
9. u ma-ri {d}bu-ne2-ne2-a-bi
#tr.ts: u mārī bunene-abī
#tr.en: And (even) if sons Bunene-abī
10. u3 hu-szu-tum li-ir#-szu-u2-ma 
#tr.ts: u ḫu(š)šūtum liršûma
