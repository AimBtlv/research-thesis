12. u3 ki-ir-ba-nu-um i-li-im-ma
#expected i-li-a-am-ma
#tr.ts: u kirbānum i(l)liamma
#tr.en: (lit. and the clod) turns up,

13. sa3-ar i-he-pe2 sza ap-lu-ti-im 
#tr.ts: sar iḫe(p)pe ša aplutīm
