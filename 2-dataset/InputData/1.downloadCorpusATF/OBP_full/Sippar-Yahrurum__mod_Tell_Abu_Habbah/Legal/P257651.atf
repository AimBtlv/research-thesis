2. a-na ki-s,i-ir _e2_ 
#tr.ts: ana kiṣir bītim
#tr.en: is the rent payment for the house.
3. _iti ab-e3-a_ 
#tr.ts: waraḫ ṭebētum
#tr.en: (In) the month of Ṭebētum
4. i-ru-ub 
#tr.ts: i(r)rub
#tr.en: he will enter;
@reverse 
