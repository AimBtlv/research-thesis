&P366278 = CT 48, 082   
#atf: lang akk 
@tablet 
@obverse 
1. asz-szum i-na _dub_ um-[ma-tim]  
#tr.ts: aššum ina ṭuppi ummatim
#tr.en: Since in the original tablet

2. 1(u) 8(disz) 2/3(disz) _sar_ me-[er-szu-um] 
#tr.ts: samāššeret u šinip mūšar meršum	
#tr.en: 18 SAR and 40 shekels of drained land

3. sza-at,-ru-[ma] 
#tr.ts: šaṭrūma
#tr.en: are written,

4. t,up-pi2 um-ma-tim sza# 
#tr.ts: ṭuppi ummatim ša
#tr.en: the original tablet that

5. {disz}a-ha-tum _dumu-munus_ i-tu?-x-x-im 
#tr.ts: aḫatum mārat itu...
#tr.en: Aḫatum daughter of ...

6. i-na qa2-ti ARAD-sin 
#tr.ts: ina qātī warad-sîn
#tr.en: from the hands of Warad-sîn

7. u3 lu2-{d}nanna _dumu-me_ ma-an-nu-ba-lum-{d}utu  
#tr.ts: u lu-nanna mārī mannu-balum-šamaš
#tr.en: and Lu-nanna sons of Mannu-balum-šamaš

8. i-le-qu2-u2 
#tr.ts: ile(q)qû
#tr.en: will take, (as of only)

9. 1(u) 3(disz) 2/3(disz) _sar_ me-er-szu#-um 
#tr.ts: šalāššeret u šinip mūšar meršum
#tr.en: 13 SAR and 40 shekels of drained land

10. {disz}a-ha-tum sza-ma-at# 
#tr.ts: aḫatum šamat
#tr.en: Aḫatum is the buyer,

11. wa-tar-tum sza i-ba-asz-[szi-u2] 
#tr.ts: wartatum ibassû
#tr.en: a surplus exists;

12. {disz}ARAD-sin-ma 
#tr.ts: warad-šîmma
#tr.en: Warad-sîn himself

@revese 
1. u3 lu2-{d}nanna a-ah-[szu]  
#tr.ts: u lu-nanna aḫ(ū)šu
#tr.en: and Lu-nanna his brother

2. a-na 1(u) 3(disz) 2/3(disz) _sar_ i-ma-da-du#-[ma]
#tr.ts: ana šalāššeret u šinip mūšarī ima(d)dadūma
#tr.en: will measure (it) in relation to the 13 SAR and 40 shekels but

3. u2-ma-al-lu-u2 
#tr.ts: umallû
#tr.en: will deliver in full.

4. _igi_ i3-li2-sukkal _dumu_ ARAD-sin 
#tr.ts: maḫar ilī-sukkal mār warad-sîn
#tr.en: Before Ilī-sukkal son of Warad-sîn;

5. _igi_ i-din-e2-a _dumu_ bur-sin 
#tr.ts: maḫar i(d)din-ea mār būr-sîn
#tr.en: before Iddin-ea son of Būr-sîn;

6. _igi_ akszak{ki}-i-din-nam _dumu_ ha-ra-rum 
#tr.ts: maḫar Akšak-i(d)dinam mār ḫararum
#tr.en: before Akšak-iddinam son of Ḫararum;

7. _igi_ sig-{d}iszkur _dumu_ u-bar-{d}utu  
#tr.ts: maḫar ipqu-adad mār ubār-šamaš
#tr.en: before Ipqu-adad son of Ubār-šamaš;

8. _igi_ ba-s,um _dumu_ a-pil#-[x x] 
#tr.ts: maḫar baṣum mār apil...
#tr.en: before Baṣum son of ...;

9. _igi_ sig-e2-a _dub-sar#_ 
#tr.ts: maḫar ipqu-ea ṭupšarrim
#tr.en: before Ipqu-ea the scribe.

10. _mu ugnim#_ tu-ru-ku-um{ki#} 
#tr.ts: šanat ummān turu(k)kun
#tr.en: The year "(Ḫammurapi overthrew) the army of Turukkum.".
