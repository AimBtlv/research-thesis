&P365143 = CT 06, pl. 29, Bu 1891-05-09, 0419 
#atf: lang akk 
@tablet 
@obverse 
1. {disz}ARAD-{d}bu-ne-ne 
#tr.ts: warad-bunene
#tr.en: Warad-bunene

2. sza pir-hi-i3-li2-szu be-el-szu 
#tr.ts: ša pirḫi-ilīšu bēlšu
#tr.en: whom Pirḫi-ilīšu his owner

3. a-na asz2-nun-na a-na _1(disz) 1/2(disz) ma-na ku3-babbar_
#tr.ts: ana ešnunna ana išten u mišil manā kaspim
#tr.en: in Ešnunna for 90 shekels of silver

4. id-di-nu-szu 
#tr.ts: iddinūšu
#tr.en: had sold (lit. given)

5. _mu 5(disz)-kam_ i-na li-ib-bi asz2-nun-na{ki} 
#tr.ts: ḫamiš šanātim ina libbi ešnunna
#tr.en: (for) 5 years in Ešnunna

6. be-lu-tam il-li-ik-ma 
#tr.ts: bēlūtam illikma
#tr.en: served in clientage and (then)

7. a-na babila{ki} it-ta-bi-tam 
#tr.ts: ana babila ittabitam
#tr.en: fled to Babylon.

8. {disz}{d}suen-mu-sza-lim u3 {d}amar-utu-la-ma-sa3-szu a-bi _erin2-mesz_ 
#tr.ts: sîn-muša(l)lim u marduk-lama(s)sašu abi ṣābi
#tr.en: The officers Sîn-mušallim and Marduk-lamassašu

9. {disz}ARAD-{d}bu-ne-ne is-su2-u2-ma 
#tr.ts: warad-bunene issûma
#tr.en: summoned Warad-bunene and

10. ki-a-am iq-bu-szum 
#tr.ts: kīam iqbūšum
#tr.en: thus said to him

11. um-ma szu-nu-ma 
#tr.ts: umma šunūma
#tr.en: as follows:

12. el-le-ta ab-bu-ut-ta-ka 
#tr.ts: ellēta abbuttaka
#tr.en: "You are free, your lock

13. gu-ul-lu-ba-at ta-al-la-ak i-na _aga-us2-mesz_ 
#tr.ts: gullubat tallak ina rēdî
#tr.en: is shaved off. You have to serve among the soldiers.".

14. {disz}ARAD-{d}bu-ne-ne szu-u2 
#tr.ts: warad-bunene šū
#tr.en: Warad-bunene himself

15. ki-a-am i-pu-ul 
#tr.ts: kīam īpul
#tr.en: thus answered

16. um-<ma> szu-u2-ma  
#tr.ts: umma šūma
#tr.en: as follows:

17. i-na _aga-us2-mesz_ u2-ul a-al-la-ak 
#tr.ts: ina rēdî ul allak
#tr.en: "I will not serve among the soldiers (but)

@reverse 
1. il-ka sza _e2_ a-bi-ia  
#tr.ts: ilka(m) ša bīt abīya
#tr.en: the service pertaining to my father’s estate

2. a-al-la-ak 
#tr.ts: allak
#tr.en: I shall perform.".

3. {disz}li-pi2-it-{d}iszkur {d}iszkur-lu-zi-rum 
#tr.ts: lipit-adad adad-luzirum
#tr.en: Lipit-adad, Adad-luzirum

4. u3 ib-ni-{d}utu ah-hu-szu 
#tr.ts: u ibni-šamaš aḫḫūšu
#tr.en: and Ibni-šamaš his brothers,

5. _mu_ {d}amar-utu u3 am-mi-di-ta-na _lugal-e_ 
#tr.ts: nīš marduk u ammi-ditana šarrim
#tr.en: (by) the name of Marduk and Ammi-ditana the king

6. _in-pa3-de3-e-mesz_ 
#tr.ts: itmû
#tr.en: have sworn (that)

7. a-na ARAD-{d}bu-ne-ne a-hi-szu-nu 
#tr.ts: ana warad-bunene aḫīšunu
#tr.en: against Warad-bunene their brother

8. a-na re-szu-tim la ra-ga-mi 
#tr.ts: ana rēšūtim la ragami
#tr.en: they will not bring a claim because of the state of slavery.

9. {disz}ARAD-{d}nu-ne-ne a-di ba-al-t,u2
#tr.ts: warad-bunene adi balṭu
#tr.en: As long as Warad-bunene lives

10. it-ti ah-hi-szu 
#tr.ts: itti aḫḫīšu
#tr.en: together with his brothers

11. i-lik! _e2_ a-bi-szu-nu 
#tr.ts: ilik bīt abīšunu
#tr.en: the service of their father’s house

12. i-il-la-ak 
#tr.ts: illak
#tr.en: he will perform.

$ single ruling 
13. _igi_ a-wi-il-{d}iszkur _ugula mar-tu_ 
#tr.ts: maḫar awīl-adad akil amurrim
#tr.en: Before Awīl-adad, general;

14. _igi_ an-pi2-sza _dumu_ {d}suen-i-din!-nam 
#tr.ts: maḫar anum-pî-ša mār sîn-i(d)dinam
#tr.en: before Anum-pî-ša son of Sîn-iddinam.

$ single ruling 
15. _iti szu-numun-a u4 2(u) 5(disz)-kam_
#tr.ts: waraḫ dumuzim ūmam ešrā ḫamšat
#tr.en: The month of Dumuzi, the day 25,

16. _mu_ am-mi-di-ta-na _lugal-e ad-gi4-a gu-la {d}utu {d}amar-utu-bi-da_ 
#tr.ts: šanat ammi-ditana šarrum ina milik šamaš u marduk rabîm
#tr.en: the year "Ammi-ditana the king, by the great advice of Šamaš and Marduk".
