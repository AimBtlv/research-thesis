1. _4(iku)#! GAN2# a-sza3 u2-sal i7 buranun-na_ i-ta _a-sza3 dumu-munus!_ masz-qum 
# cf. BE 06/1, 046 obv. 14-15 
2. u3# i-ta _i7 buranun-na_ 
3. _sag#-bi a-sza3 dumu-munus_ na-bi-{d}utu _sag-bi 2(disz)-kam-ma e_ ba-la-la 
4. sza _ki_ gi-mil-lum u3 ah-hi-szu _dumu-mesz_ li-sze-rum 
5. {disz}na-ra-am-ta#-ni _lukur_ {d}utu _dumu-munus_ ma-an-nu-um-ki-ma-{d}suen 
6. i-na _mu#_ sa-am-su-i-lu-na _mu gibil_ i-sza-mu 
7. _2(iku) GAN2 a-gar3_ a-szu-kum i-ta _a-sza3_ ma-an-nu-um-ki-ma-{d}suen 
8. u3 i-ta _a-sza3_ ni-szi-i-ni#-szu# _lukur#_ {d#}utu# _dumu-munus_ ma#-asz2#-kum 
9. _sag#-bi# e_ ba-la-la _sag-bi 2(disz)-kam-ma a#-sza3#_ ka-{d}a-a _dumu-munus_ na-bi-{d}utu# 
10. [sza _ki_ ip]-qu2#-{d}nanna# _dumu#_ [{d}]suen#-e-ri-<ba>-am 
11. {disz}na#?-ra#?-[am-ta-ni _lukur_ {d}utu _dumu-munus_ ma]-an#?-[nu]-um#?-ki#?-ma#-{d}suen# 
12. i#-na# _mu e2-babbar-ra_ i-sza-mu 
$ single ruling 
13. _1(esze3) GAN2 a-sza3 u2-sal i7 buranun-na_ i-ta _a-sza3_ ni-szi-i-ni-szu _lukur_ {d}utu# _dumu-munus_ ma-[asz2-kum] 
# cf. BE 06/1, 046 obv. 1-3 
14. u3 i-ta _i7 buranun-na_ 
15. _sag-bi# i7_ ha-ru-ma-lik _sag-bi 2(disz)-kam e_ ba-la-la 
16. sza _ki_ na-ra-am-ta-ni _lukur_ {d}utu _dumu-munus_ ma-an-nu-um-ki#-ma-{d}suen 
17. {disz}la-ma-sa3-ni# _lukur_ {d}utu _dumu-munus_ i-bi-{d}utu 
18. i-na _mu_ sza-ah-na-a i-sza-mu 
$ single ruling 
19. _2(iku) GAN2 a-gar3 a-szu-kum i-ta _a-sza3_ i-bi-{d}utu _dumu_ {d}suen-ma-gir 
20. u3# i#-ta# _e_ szar-ri _sag-bi a-sza3_ {disz}la-ma-sa3-<ni> _lukur_ {d}utu _dumu-munus_ li!-pi2-it-sin 
22. x x x x _a-sza3_ KA-{d}a-a _dumu-munus#_ na#-bi-{d}utu 
23. _sag#-bi 2(disz)-kam-ma a-sza3 dumu-munus lugal_ 
24. sza _ki_ a!-na-{d}utu-li-s,i2 u3 {d}suen-i-din-nam _dumu-mesz_ masz-qum 
@reverse 
1. {disz}la-ma-sa3-ni _lukur_ {d}utu _dumu-munus_ i-bi-{d}utu i-sza#-mu# 
