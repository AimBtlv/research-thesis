&P365166 = CT 08, pl. 03, Bu 1888-05-12, 012  
#atf: lang akk 
@tablet 
$ (Quasi-Hüllentafel)
@obverse 
1. _3(disz) 1/2(disz) sar ki-gal2_ 
#tr.ts: šalāšat mišil mūšar maškanum
#tr.en: A three and a half SAR empty lot

2. ($ blank space $) _sza3 1(u) sar ki-gal2_  
#tr.ts: libbum ešret mūšar maškanim
#tr.en: in a ten SAR empty lot

3. ($ blank space $) i-na zimbir{ki}-am-na-nim 
#tr.ts: ina sippir-amnānim
#tr.en: in Sippar-amnānum

4. sza _ki_ {d}suen-na-di-in-szu-mi isz#-sza-mu 
#tr.ts: ša itti sîn-nadin-šumī iššāmu
#tr.en: which by Sîn-nadin-šumī was bought,

5. _da e2_ {munus}bi-it-te-tum _lukur# [{d}utu_ a]-ha-at a-bi-szu 
#tr.ts: ṭēḫi bīt bittetum nadīt šamaš aḫat abīšu
#tr.en: next to the house of Bittetum the nadītu of Šamaš his aunt (lit. his father's sister)

6. u3 _da e2_ {d}suen-i-din-nam a#? [x?] x 
#tr.ts: u ṭēḫi bīt sîn-i(d)dinam ...
#tr.en: and next to the house of Sîn-iddinam ...

7. _sag-bi 1(disz)-kam-ma sila dagal-la_ 
#tr.ts: pūssu maḫrītum ribītum
#tr.en: its 1st front is the main street,

8. _sag-bi 2(disz)-kam-ma_ ni-di-tum sza |MASZ.EN.GAG|-hi-a_ 
#tr.ts: šanītum pūssu nidītum ša muškēnī
#tr.en: its 2nd front is the uncultivated plot of the servants

9. ($ blank space $) [x x?] _a-ga_ ku-ut-ta-tum  
#tr.ts: ... warkat kuttatum
#tr.en: ... in the rear of Kuttatum,

10. ($ blank space $) _ha-la_ [i]-na-e2-ul-masz-numun_ 
#tr.ts: zītti ina-eulmaš-zērum
#tr.en: is the share of Ina-eulmaš-zērum

11. ($ blank space $) _dumu_ i3-li2-ba-ni _dumu_ a-hi-szu-nu 
#tr.ts: mār ilī-bānī mār aḫīšunu
#tr.en: son of Ilī-bānī, the son of their brother,

12. sza it-ti ARAD-{d}suen u3 {d}suen-i-din-nam 
#tr.ts: ša itti warad-sîn u sîn-i(d)dinam
#tr.en: that with Warad-sîn and Sîn-iddinam

13. _dumu-mesz_ a-wi-il-{d}iszkur ah-hi a-bi-szu 
#tr.ts: mārī awil-adad aḫḫī abīšu
#tr.en: sons of Awil-adad, his uncles (lit. his father’s brothers),

14. i-zu-zu 
#tr.ts: izūzu
#tr.en: has shared.

15. zi-zu ga-am-ru 
#tr.ts: zīzu gamru
#tr.en: The division is completed,

16. li-ib-ba-szu-nu t,a3-ab 
#tr.ts: libbašunu ṭāb
#tr.en: their heart is satisfied.

17. wa!-tar-ti _e2-a-ba_ sza i-li-a-am 
#tr.ts: watarti bīt abim ša i(l)liam
#tr.en: (Every) surplus in the patrimony that (in the future) will show up,

18. sza bi-ri-szu-nu-ma 
#tr.ts: ša birišunuma
#tr.en: will belong to them jointly.

19. i-li-ik _e2-a-ba_ 
#tr.ts: ilik bīt abim
#tr.en: The service of the paternal estate

20. mi-it-ha-ri-isz i-il-la-ku 
#tr.ts: mitḫāriš illakū
#tr.en: they will perform in equal shares.

21. isz-tu a-na mi-im-ma mar-szi-it 
#tr.ts: ištu ana mimma maršit
#tr.en: After (that), concerning everything of the property of

22. {disz}a-wi-il-{d}iszkur a-bi-szu-nu 
#tr.ts: awīl-adad abīšunu
#tr.en: Awil-adad their father,

23. i-na _szu-nir_ {d}en-lil2 
#tr.ts: ina šurinni enlil
#tr.en: by means of the emblem of Enlil

24. i-na e-sze-er-tim sza i-li-szu-nu  
#tr.ts: ina ešertim ša ilīšunu
#tr.en: in the sanctuary of their god,

@reverse 
1. {disz}ARAD-{d}suen a-hu#-[szu-nu ra-bu]-u2 
#tr.ts: warad-sîn aḫūšunu rabu(m)
#tr.en: Warad-sîn their elder brother,

2. a-na {d}suen-i-din-nam# [u3 i-na-e2-ul-masz-numun]  
#tr.ts: ana sîn-i(d)dinam u ina-eulmaš-zērum
#tr.en: with respect to Sîn-iddinam and Ina-eulmaš-zērum

3. _dumu-mesz_ a-wi-[il-{d}iszkur] 
#tr.ts: mārī awīl-adad
#tr.en: sons of Awīl-adad,

4. u2-ub-bi-[bu] 
#tr.ts: ubbibu
#tr.en: had cleared (himself).

5. _u4-kur2-sze3_ a-hu a-na a-[hi la ra-ga]-mi-im 
#tr.ts: ana warkiāt ūmī aḫu(m) ana aḫi(m) la ragāmim
#tr.en: In the future, not to sue brother against brother,

6. _mu_ {d}utu {d}marduk u3 am-[mi-s,a-du]-qa2 _lugal_ 
#tr.ts: nīš Šamaš marduk u ammi-ṣaduqa šarrim
#tr.en: (by) the name of Šamaš, Marduk and Ammi-ṣaduqa the king

7. _in-pa3-de3-mesz_ 
#tr.ts: itmû
#tr.en: they have sworn.

$ single ruling 
8. _igi_ ib-ni-{d}suen [_dumu_ {d}]suen#-i-din-nam 
#tr.ts: maḫar ibni-sîn mār sîn-i(d)dinam
#tr.en: Before Ibni-sîn son of Sîn-iddinam;

9. _igi_ {d}nanna-ma-[an-szum2] _di-ku5 dumu_ sig-an-nu-ni-tum 
#tr.ts: maḫar nanna-manšum dayyānim mār ipqu-annunītum
#tr.en: before Nanna-manšum, judge, son of Ipqu-annunītum;

10. _igi_ {d}suen-isz-me#-[an-ni] _di-ku5 dumu_ ib-ni-{d}marduk 
#tr.ts: maḫar sîn-išmea(n)ni dayyānim mār ibni-marduk
#tr.en: before Sîn-išmeanni, judge, son of Ibni-marduk;

11. _igi_ sig-an#-[nu-ni-tum] _di-ku5 dumu_ ib-ni-{d}utu 
#tr.ts: maḫar ipqu-annunītum dayyānim mār ibni-šamaš
#tr.en: before Ipqu-annunītum, judge, son of Ibni-šamaš;

12. _igi_ sig-i3-li2-szu# [_di]-ku5 dumu_ gi-[mil {d}]marduk 
#tr.ts: maḫar ipqu-ilīšu dayyānim mār gimil-marduk
#tr.en: before Ipqu-ilīšu, judge, son of Gimil-marduk;

13. _igi_ {d}suen-na-di-in-szu-mi _dumu_ {d}marduk-na-s,i-ir 
#tr.ts: maḫar sîn-nadin-šumī mār marduk-nāṣir
#tr.en: before Sîn-nadin-šumī son of Marduk-nāṣir;

14. _igi_ {d}suen-na-s,i-ir _dumu_ sig-an-nu-ni-tum _zadim!_
#tr.ts: maḫar sîn-nāṣir mār ipqu-annunītum sasinnum
#tr.en: before Sîn-nāṣir son of Ipqu-annunītum, bowmaker;

15. _igi_ dumu-u4-2(u)-kam _ugula mar-tu_
#tr.ts: maḫar mār-ūm-ešrê akil amurrī
#tr.en: before Mār-ūm-ešrê, overseer of the troops;

16. _igi_ ta-ri-bu-um _dumu_ u2-tul2-isz8-tar2 
#tr.ts: maḫar taribum mār utul-ištar
#tr.en: before Taribum son of Utul-ištar;

17. _igi_ ARAD-{d}ul-masz-szi-tum sza ri-x-x-mesz 
# so Suurmeijer, copy: ri-x-x-AN-sin
#tr.ts: maḫar warad-ulmaššitum ša ri...
#tr.en: before Warad-ulmaššitum of the ...;

18. _igi_ qi2-isz-ti-{d}e2-a _dub-sar_  
#tr.ts: maḫar qīšti-ea ṭupšarrim
#tr.en: before Qīšti-ea, the scribe.

$ blank space 
19. _iti kin-{d}inanna 2(disz)-kam-ma u4 2(u)-3(disz)-kam_ 
#tr.ts: šanûm warah elūnim ūmam ešrā šalāšat
#tr.en: The intercalary month of Elūnum, the day 23

20. _mu_ am-mi-s,a-du-qa2 _lugal-e bad3_ am-mi-s,a-du-qa2{ki} _ka i7 buranun{ki}-na-ta bi2-in-dim2-ma-a_ 
#tr.ts: šattum ša ammi-ṣaduqa šarrum dūr ammi-ṣaduqa ina pī purattim ibnû
#tr.en: the year in which Ammi-ṣaduqa the king built the fort "Ammi-ṣaduqa" at the mouth of the Euphrates.

