&P372646 = VS 09, 130 & 131   
#atf: lang akk 
@tablet 
@obverse 
1. _5/6(disz) sar 8(disz) gin2 e2 du3-a_ 
#tr.ts: parasrab mūšar samānat šiqil bītam epšam
#tr.en: A built house plot of 58 šhekels

2. _da e2_ lu-usz-ta-mar _ma2-lah5_ 
#tr.ts: itā bīt luštamar malāḫim
#tr.en: next to the house of Luštamar the sailor

3. u3 _da e2_ si-na-tum a-hi-szu 
#tr.ts: u itā bīt sinatum aḫīšu
#tr.en: and next to the house of Sinatum his brother,

4. mi-im-ma bi-szi _e2-a-ba_ 
#tr.ts: mimma bīši bīt abim
#tr.en: all the property of the paternal estate

5. u3 bi-szi il-ta-ni _lukur-{d}utu_ a-ha-ti-szu-nu 
#tr.ts: u bīši iltani nadīt šamaš aḫātīšunu
#tr.en: and the property of Iltani nadītu of Šamaš their sister,

6. i-na _szu-nir_ sza {d}suen 
#tr.ts: ina šurinnim ša sîn
#tr.en: by means of Sîn's emblem

7. u3 {d}sza-sza-rum sza {d}utu u-bi-ru-ma 
#tr.ts: u ša(š)šarum ša šamaš ubi(r)ūma
#tr.en: and the saw of Šamaš, they established and

8. i-zu-zu-u2 
#tr.ts: izūzū
#tr.en: divided.

9. _ha-la_ ARAD-i3-li2-szu _dumu_ GAZ-isz8-tar2  
#tr.ts: zītti warad-ilīšu mār kasap-ištar
#tr.en: (This is) the share of Warad-ilīšu son of Kasap-ištar

10. sza _ki_ si-na-tum a-hi-szu i-zu-zu 
#tr.ts: ša itti sinatum aḫīšu izūzu
#tr.en: that with Sinatum his brother has divided.

11. zi-zu ga-am-ru isz-tu pe2-e 
#tr.ts: zīzu gamru ištu pê
#tr.en: The division is completed. (That) everything (lit. from chaff

12. a-di _ku3-sig17_ a-hu-um a-na a-hi-im 
#tr.ts: adi ḫurāṣim	aḫum ana aḫim
#tr.en: to gold) one against the other (lit. brother against brother)

13. u2-ul i-ra-ga-am 
#tr.ts: ul ira(g)gam
#tr.en: will not claim,

14. _mu_ {d}utu {d}a-a {d}marduk 
#tr.ts: nīš šamaš ayya marduk
#tr.en: (by) the name of Šamaš, Ayya, Marduk

15. u3 ha-am-mu-ra-pi2 
#tr.ts: u ḫammurapi
#tr.en: and Ḫammurapi

@reverse 
1. _in-pa3-de3-mesz_ 
#tr.ts: itmû
#tr.en: they have sworn.

2. _igi_ {d}nanna-lu2-til _ugula-e2_
#tr.ts: maḫar nanna-lutil akil bītim
#tr.en: Before Nanna-lutil overseer of the temple;

3. _igi_ mu-na-wi-rum _dumu_ sag-il2-zi-mu 
#tr.ts: maḫar muna(w)wirum mār ipqu-ilzimu
#tr.en: before Munawwirum son of Ipqu-ilzimu;

4. _igi_ {d}utu-li-wi-ir _dumu_ e-tel-sin 
#tr.ts: maḫar šamaš-li(w)wir mār etel-sîn
#tr.en: before Šamaš-liwwir son of Etel-sîn;

5. _igi_ ib-ni-{d}en-lil2 _dumu_ a-du-an-ni-a 
#tr.ts: maḫar ibni-enlil mār adu-annia(m)
#tr.en: before Ibni-enlil son of Adu-anniam;

6. _igi_ i3-li2-i-te-e _igi_ e-pi2-rum 
#tr.ts: maḫar ilī-itê maḫar epirum
#tr.en: before Ilī-itê (and) before Epirum

7. _dumu-me_ usz-tasz-ni-dingir 
#tr.ts: mārī uštašni-ilī
#tr.en: sons of Uštašni-ilī;

8. _igi_ sin-i-din-nam _dumu_ dumu-{d}utu 
#tr.ts: maḫar sîn-i(d)dinam mār mār-šamaš
#tr.en: before Sîn-iddinam son of Mār-šamaš;

9. _igi_ a-da-ia-tum _dumu_ sin-ga-mil 
#tr.ts: maḫar adayatum mār sîn-gāmil
#tr.en: before Adayatum son of Sîn-gāmil;

10. _igi_ sin-ma-gir _dumu_ sin-a-bu-szu 
#tr.ts: maḫar sîn-māgir mār sîn-abūšu
#tr.en: before Sîn-māgir son of Sîn-abūšu;

11. _igi_ {d}mar-tu-ba-ni _dumu_ a-da-ia-tum 
#tr.ts: maḫar amurru-bānī mār adayatum
#tr.en: before Amurru-bānī son of Adayatum;

12. _igi_ lu-usz-ta-mar _ma2-lah5_ 
#tr.ts: maḫār luštamar malāḫim
#tr.en: before Luštamar, sailor;

13. _igi_ dingir-pi4-sza _dumu_ {d}utu-a-bu-ni 
#tr.ts: maḫar ilum-pīša mār šamaš-abūni
#tr.en: before Ilum-pīša son of Šamaš-abūni;

14. _igi_ i3-li2-tukul-ti! sza _dumu-munus_ lugal 
#tr.ts: maḫar ilī-tukultī ša mārat šarrim
#tr.en: before Ilī-tukultī, of the king's daughter;

15. _igi_ sig-e2-a _dub-sar_ 
#tr.ts: maḫar ipqu-ea ṭupšarrim
#tr.en: before Ipqu-ea the scribe.

16. _iti udru{duru5} u4 7(disz)-kam_ 
#tr.ts: waraḫ šabāṭim ūmam sebet
#tr.en: The month of Šabātum, the day 7,

17. _mu bad3_ ma2-ri2{ki} _ba-gul-la_ 
#tr.ts: šattum ša dūr mari i'abitu
#tr.en: the year (in) which the walls of Mari were destroyed.

