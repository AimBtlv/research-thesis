&P283911 = MSL 12, 192 U
#atf: use lexical
#link: def A = Q000302 = Lu-azlag B and C
#BM 17289
@tablet
@obverse
@column 1
1. [lu2] nam-ta e3#-a = %a sza szi-im#-[...] & %s [lu2 nam-ta e3-a] = %a [sza szi-im-...]
>>A Seg.6, 1
2. lu2# ze2#-a# al#-ra# = %a s,a-ar#-[szum] & %s [lu2 ze2-a-al-ra] = %a [s,a-ar-szum]
>>A Seg.6, 2
3. lu2# gidim#-ma# = %a sza# i#-t,i-im-mi# & %s [lu2 gidim-ma] = %a [sza i-t,i-im-mi]
>>A Seg.6, 3
4. lu2# [sag bulug-ga] = %a mu-sze-li e-t,i-mi# & %s lu2# sag# bulug?#-ga?# = %a mu#-sze#-li# [e-t,i-mi]
>>A Seg.6, 4
5. lu2 sag#-sze3# nu2#-a# = %a mu#-pa#-sze-er szu-na-tim & %s lu2# sag#-sze3# nu2#-a# = %a mu#-pa#-sze-er szu#-na#-tim#
>>A Seg.6, 5
6. lu2# gissu# e3#-de3# = %a mu#-sze-li s,i-il-li & %s lu2# gissu# e3#-de3# = %a mu-sze-li s,i-il-li
>>A Seg.6, 6
7. lu2# inim#-ma = %a sza a-wa-tim & %s lu2 inim-ma = %a sza# a-wa-tim
>>A Seg.6, 7
8. lu2# inim# du11#-du11 = %a mu-ta-wu-u2 & %s lu2 inim du11-du11 = %a mu-ta-wu-u2
>>A Seg.6, 8
9. lu2# ki-inim-ma = %a szi#-i-bu & %s lu2 ki-inim-ma = %a szi-i-bu
>>A Seg.6, 9
10. lu2# ab-ba = %a szi-i-bu & %s lu2 ab-ba = %a szi-i-bu
>>A Seg.6, 10
11. lu2# sag DU-a = %a mah-s,a-am i-lim & %s lu2 sag DU-a = %a mah-s,a-am i-lim
>>A Seg.6, 11
12. [lu2 sag] DU#-a# = %a mu-uh2-hu-um ma-ah-s,u2 & %s lu2# sag DU-a = %a mu-x-hu-um ma-ah-s,u2
>>A Seg.6, 12
13. [lu2 sag giri16] = %a mu#-uh2-hu-um na-as#-[...] & %s lu2# sag# giri16 = %a mu-uh2-hu-um na-as-su
>>A Seg.6, 13
14. [...] = %a [mu-...]-ta?#-[...-DU] & %s [...] = %a mu#-[...-ta-...]-DU
>>A Seg.6, 14
15. [...] = %a [...-u2] & %s [...] = %a [...]-u2
>>A Seg.6, 15
16. [...] = %a [...-qu3-qu3] & %s [...] = %a [...]-qu3#-qu3
>>A Seg.6, 16

