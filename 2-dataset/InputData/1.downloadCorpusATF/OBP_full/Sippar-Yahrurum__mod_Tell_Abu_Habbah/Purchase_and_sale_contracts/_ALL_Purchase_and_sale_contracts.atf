&P355872 = CT 04, pl. 50, Bu 1891-05-09, 0318 
#atf: lang sux 
@tablet 
@obverse 
1. 1(iku) GAN2 {gesz}kiri6 
#tr.ts: ištēn ikû kirâm
#tr.en: An orchard of 1 IKU

2. us2-sa-du ka-ni-ik-ru-um 
#tr.ts: itā kanikrum
#tr.en: adjacent to (the properties of) Kanikrum

3. szesz-a-ni 
#tr.ts: aḫīša
#tr.en: her brother (of Ḫalikum)

4. u3 zi-kar3-pi4-{d}suen 
#tr.ts: u zikar-pî-sîn
#tr.en: and Zikar-pî-sîn,

5. ki ha-li-kum dumu ar-wi-um 
#tr.ts: itti ḫalikum mār arwium
#tr.en: from Ḫalikum son of Arwûm,

6. {disz}ta-ku-un-ma-tum lukur {d}utu 
#tr.ts: takūn-mātum nadīt šamaš
#tr.en: Takūmmātum nadītu of Šamaš

7. dumu-munus a-mu-ru-um 
#tr.ts: mārat amu(r)rum
#tr.en: daughter of Amurrum

8. u3 ra-ba-tum ama!(dam)-a-ni
#cp. CT 6 42a:6
#tr.ts: u rabâtum ummaša
#tr.en: and Rabâtum her mother

9. in-szi-in-sa10-esz 
#tr.ts: išāmā
#tr.en: have bought;

10. sa10-am3 til-la-bi-sze3 
#tr.ts: ana šīmīšu gamrim
#tr.en: as its full price

11. ku3-babbar in-na-an-la2 
#tr.ts: kaspam išqulā
#tr.en: they have paid the silver.

12. gesz-gan-na ib2-ta-an-bala 
#tr.ts: bukānam šūtuq
#tr.en: (The seller) has concluded the sale (lit. has handed over the pestle),

13. inim-bi al-til 
#tr.ts: awassu gamrat
#tr.en: its (of the field) transaction is settled.

14. u4 kur2-sze3 lu2 lu2-sze3 
#tr.ts: ana warkiāt ūmī awīlum ana awīlim
#tr.en: (That) in the future, one against the other

15. nu-mu-un-gi4-gi4-dam 
#tr.ts: la itūr
#tr.en: shall not return (on the decision),

@reverse 
1. mu {d}utu u3 im-me-ru-um 
#tr.ts: nīš šamaš u immerum
#tr.en: (by) the name of Šamaš and Immerum,

2. mu {d}marduk u3 su-mu-la-el3 
#tr.ts: nīš marduk u sumu-la-el
#tr.en: (by) the name of Marduk and Sumu-la-el

3. in-pa3-de3-esz 
#tr.ts: itmû
#tr.en: they have sworn.

4. igi ka-ni-ik-ru-um dumu ar-wi-um 
#tr.ts: maḫar kanikrum mār arwium
#tr.en: Before Kanikrum son of Arwûm;

5. igi i3-tur2-asz-dum dumu ak-ba-hu-ni-um 
#tr.ts: maḫar itūr-ašdum mār akbaḫunium
#tr.en: before Itūr-ašdum son of Akbaḫunûm;

6. igi a-ab-ba-t,a3-bu-um dumu a-za-ak-na-nu-um 
#tr.ts: maḫar abum-ṭābum mār azak-nanum
#tr.en: before Abum-ṭābum son of Azak-naum;

7. igi a-pil2-ku-bi dumu {d}utu-illat-su2 
#tr.ts: maḫar apil-kubi mār šamaš-tillassu
#tr.en: before Apil-kubi son of Šamaš-tillassu;

8. igi bur-{d}iszkur dumu ta-ti-im 
#tr.ts: maḫar būr-adad mār tatim
#tr.en: before Būr-adad son of Tatim;

9. igi {d}nanna-ma-an-szum2 
#tr.ts: maḫar nanna-manšum
#tr.en: before Nanna-manšum

10. dumu na-ra-am-{d}suen 
#tr.ts: mār narām-sîn
#tr.en: son of Narām-sîn;

11. igi an-pi4-{d}utu sanga 
#tr.ts: maḫar anum-pî-šamaš šangê
#tr.en: before Anum-pî-šamaš, temple chief administrator;

12. igi im-lik-{d}suen nar 
#tr.ts: maḫar imlik-sîn nārim
#tr.en: before Imlik-sîn, musician;

13. igi dingir-mu-sza-lim i3-du8 
#tr.ts: maḫar ilī-muša(l)lim atîm
#tr.en: before Ilī-mušallim, gatekeeper;

14. igi lu-da-ri2 ra2-gaba 
#tr.ts: maḫar lū-dāri rakbîm
#tr.en: before Lū-dāri, envoy;

15. igi {d}utu-kam dub-sar 
#tr.ts: maḫar šamaš-kam	ṭupšarrim
#tr.en: before Šamaš-kam, the scribe.

16. iti na-ab-ri 
#tr.ts: waraḫ nabrî(m)
#tr.en: The month of Nabrûm,

17. mu balag li-li-is3 2(disz)-a-bi {d}utu-ra mu-na-an-dim2 
#tr.ts: šattum ša šinā balag lillissāni ana šamaš ibnû
#tr.en: the year in which (Sumu-la-el) built two kettledrums instruments for Šamaš.

@left 
1. igi {d}za-ba4-ba4-a-bu-um 
#tr.ts: maḫar zababa-abum
#tr.en: before Zababa-abum

2. dumu puzur4-sza 
#tr.ts: mār puzurša
#tr.en: son of Puzurša.

&P365096 = CT 02, pl. 15, Bu 1888-05-12, 332 
#atf: lang akk 
@tablet 
@obverse 
1. _2/3(disz) sar 5(disz) gin2 e2 ki-gal2_ i-na ip-la-hi-i{ki} 
#tr.ts: šinip mūšar ḫamšat šiqil maškanam ina iplaḫi
#tr.en: An unbuilt plot of 45 shekels at Iplaḫi
2. _da e2_ {disz}wa-qar-a-hu-um sza _ki_ la-ma-si2 i-sza-mu 
#tr.ts: ṭēḫi bīt waqar-aḫum ša itti lama(s)si išamu
#tr.en: adjoining the house of Waqar-aḫum that he had bought from Lamassi,
3. u3 _da sila dagal-la_ 
#tr.ts: u ṭēḫi ribītim
#tr.en: and adjoining the street;
4. _sag-bi 1(disz)-[kam]-ma e2_ e-ri-isz-tum _lukur_ {d}utu 
#tr.ts: pūssu maḫrītum bīt erištum nadīt šamaš
#tr.en: its first front is (adjacent to) the house of Erištum, nadītu of Šamaš
5. _dumu-munus_ ra-bu-ut-{d}utu 
#tr.ts: mārat rabût-šamaš
#tr.en: (and) daughter of Rabût-šamaš,
6. _sag-bi 2(disz)-kam-ma e2_ lu2-{d}iszkur-ra 
#tr.ts: šanītum pūssu bīt awīl-adad
#tr.en: its second front is (adjacent to) the house of Awīl-adad,
7. _ki_ la-ma-si2 _lukur_ {d}utu _dumu-munus_ lu2-{d}iszkur-ra 
#tr.ts: itti lama(s)si nadīt šamaš mārat awīl-adad
#tr.en: from Lamassi, nadītu of Šamaš (and) daughter of Awīl-adad,
8. {disz}KA-{d}a-a _lukur_ {d}utu _dumu-munus_ dingir-szu-ba-a-lum 
#tr.ts: pî-aya nadīt šamaš mārat ilšu-bālum
#tr.en: Pî-aya, nadītu of Šamaš (and) daughter of Ilšu-bālum,
9. [i]-na# _har ku3-babbar in-szi-in-sa10_ 
#tr.ts: ina šawerim kaspim išām
#tr.en: has bought with the silver ring.
10. _sa10 til-la-bi-sze3_ 
#tr.ts: šīmīšu gamrim
#tr.en: Its full price,
11. _1(disz) sar e2 2(disz) gin2 ku3-babbar_ 
#tr.ts: ištēn mūšar bītim šinā šiqil kaspam
#tr.en: 2 shekels of silver (per) 1 SAR of house,
12. _in-na-an-la2_ 
#tr.ts: išqul
#tr.en: she has paid.
@reverse 
1. _gesz-gan-na ib-ta-bala_ 
#tr.ts: bukānam šūtuq
#tr.en: (The seller) has concluded the sale (lit. has handed over the pestle),
2. _inim-bi al-til_ 
#tr.ts: awassu gamrat
# Simmons reads awassunu = their transaction (cp. JCS 13/3 p. 91)
#tr.en: its transaction (of the plot) is settled.
3. _u4-kur2-sze3 lu2 lu2-ra_ 
#tr.ts: ana warkiāt ūmī awīlum ana awīlim
#tr.en: (That) in future one against the other
4. _inim nu-um-ga2-ga2-a_ 
#tr.ts: ul iraggam
#tr.en: shall not raise a claim,
5. _mu_ {d}utu {d}marduk sa-am-su-i-lu-na _lugal#_ 
#tr.ts: nīš šamaš marduk samsu-iluna šarrum
#tr.en: by the life of Šamaš, Marduk (and) Samsu-iluna the king,
6. it-mu-u2 
#tr.ts: itmû
#tr.en: they have sworn.
$ single ruling 
7. _igi_ a-bu-um-wa-qar wa-ar-ku-um 
#tr.ts: maḫar abum-waqar warkûm
#tr.en: Before Abum-waqar, lieutenant (of Šamaš);
8. _igi_ {d}nanna-tum _dumu_ bur-{d}suen 
#tr.ts: maḫar nannatum mār būr-sîn
#tr.en: before Nannatum, son of Būr-sîn;
9. _igi_ e-te-ia-tum _dumu_ e-si-e 
#tr.ts: maḫar eteyatum mār esê
#tr.en: before Eteyatum, son of Esê;
10. _igi_ ha-ap-pa-tum _dumu_ asz-qu2-du-um 
#tr.ts: maḫar ḫappatum mār ašqudum
#tr.en: before Ḫappatum, son of Ašqudum;
11. _igi_ a-pil2-i3-li2-szu _dumu_ a-ba?-ti-ia 
#tr.ts: maḫar apil-ilīšu mār abatīya
#tr.en: before Apil-ilīšu, son of Abatīya;
12. _igi_ [lu-ud]-lu#-ul-sin _dub-sar_ 
#tr.ts: maḫar ludlul-sîn ṭupšarrum
#tr.en: before Ludlul-sîn, the scribe.
$ single ruling 
13. _iti# [bara2]-za3-gar u4 1(u)-kam_ 
#tr.ts: waraḫ nisānim ūmam ešertum
#tr.en: The month of Nisānum, the day 10,
14. _mu i7_ sa-am-su-i-lu-na _lugal-e_ na-qa2-ab-nu-uh-szi
#tr.ts: šattum nāram samsu-iluna šarrum naqab-nuḫši
#tr.en: the year (in which Samsu-iluna the king dug) the canal “Samsu-iluna the king is source of abundance”.

