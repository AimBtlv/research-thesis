8. igi bur-{d}iszkur dumu ta-ti-im 
#tr.ts: maḫar būr-adad mār tatim
#tr.en: before Būr-adad son of Tatim;

9. igi {d}nanna-ma-an-szum2 
#tr.ts: maḫar nanna-manšum
#tr.en: before Nanna-manšum

10. dumu na-ra-am-{d}suen 
#tr.ts: mār narām-sîn
#tr.en: son of Narām-sîn;

11. igi an-pi4-{d}utu sanga 
#tr.ts: maḫar anum-pî-šamaš šangê
