@tablet 
@obverse 
1. 1(iku) GAN2 {gesz}kiri6 
#tr.ts: ištēn ikû kirâm
#tr.en: An orchard of 1 IKU

2. us2-sa-du ka-ni-ik-ru-um 
#tr.ts: itā kanikrum
#tr.en: adjacent to (the properties of) Kanikrum

3. szesz-a-ni 
#tr.ts: aḫīša
#tr.en: her brother (of Ḫalikum)

4. u3 zi-kar3-pi4-{d}suen 
#tr.ts: u zikar-pî-sîn
#tr.en: and Zikar-pî-sîn,

5. ki ha-li-kum dumu ar-wi-um 
#tr.ts: itti ḫalikum mār arwium
#tr.en: from Ḫalikum son of Arwûm,

6. {disz}ta-ku-un-ma-tum lukur {d}utu 
#tr.ts: takūn-mātum nadīt šamaš
#tr.en: Takūmmātum nadītu of Šamaš

7. dumu-munus a-mu-ru-um 
#tr.ts: mārat amu(r)rum
#tr.en: daughter of Amurrum

8. u3 ra-ba-tum ama!(dam)-a-ni
#cp. CT 6 42a:6
#tr.ts: u rabâtum ummaša
#tr.en: and Rabâtum her mother

9. in-szi-in-sa10-esz 
#tr.ts: išāmā
#tr.en: have bought;

10. sa10-am3 til-la-bi-sze3 
#tr.ts: ana šīmīšu gamrim
#tr.en: as its full price

11. ku3-babbar in-na-an-la2 
#tr.ts: kaspam išqulā
#tr.en: they have paid the silver.

12. gesz-gan-na ib2-ta-an-bala 
#tr.ts: bukānam šūtuq
#tr.en: (The seller) has concluded the sale (lit. has handed over the pestle),

13. inim-bi al-til 
#tr.ts: awassu gamrat
#tr.en: its (of the field) transaction is settled.

14. u4 kur2-sze3 lu2 lu2-sze3 
#tr.ts: ana warkiāt ūmī awīlum ana awīlim
#tr.en: (That) in the future, one against the other

15. nu-mu-un-gi4-gi4-dam 
#tr.ts: la itūr
#tr.en: shall not return (on the decision),

@reverse 
1. mu {d}utu u3 im-me-ru-um 
#tr.ts: nīš šamaš u immerum
#tr.en: (by) the name of Šamaš and Immerum,

2. mu {d}marduk u3 su-mu-la-el3 
#tr.ts: nīš marduk u sumu-la-el
#tr.en: (by) the name of Marduk and Sumu-la-el

3. in-pa3-de3-esz 
#tr.ts: itmû
#tr.en: they have sworn.

4. igi ka-ni-ik-ru-um dumu ar-wi-um 
#tr.ts: maḫar kanikrum mār arwium
