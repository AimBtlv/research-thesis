&P365097 = CT 02, pl. 16, Bu 1888-05-12, 616 
#atf: lang akk 
@tablet 
@obverse 
1. _1(iku) GAN2 a-sza3_ i-na hi-ga-nim 
#tr.ts: ištēn ikû eqlam ina ḫigānim
#tr.en: A field of 1 ikû in the "Ḫigānum" district
2. i-ta i3-li2-isz-na-di 
#tr.ts: ita ilīš-nadi
#tr.en: next to (the property of) Ilīš-nadi
3. u3 i-ta ip-qu2-sza _dumu_ e-ba?-ia 
#tr.ts: u ita ipquša mār ebaya
#tr.en: and next to (the property of) Ipquša son of Ebaya,
4. _sag-bi i7#_ ha-ar-ha-ri-tum 
#tr.ts: pūssu nār ḫarḫar(r)itum
#tr.en: its front is the canal Ḫarḫarritum,
5. _ki_ ia-bi-szum _dumu_ be-li2-ia 
#tr.ts: itti iabišum mār bēlīya
#tr.en: from Iabišum son of Bēlīya,
6. {disz}sza-at-{d}a-a _lukur_ {d}utu 
#tr.ts: šāt-aya nadīt šamaš
#tr.en: Šāt-aya, nadītu of Šamaš (and)
7. _dumu-munus_ an-pi4-sza
#tr.ts: mārat annum-pīša
#tr.en: daughter of Annum-pīša,
8. i-na sza-we-ri-sza _in-szi-sa10_ 
#tr.ts: ina šawerīša išām
#tr.en: bought with her ring.
9. _sa10 til-la-bi-sze3_ 
#tr.ts: šīmīšu gamrim
#tr.en: Its full price
10. _ku3-babbar in-na-la2_ 
#tr.ts: kaspim išqul
#tr.en: in silver she paid.
11. _gesz-gan-na ib2-ta-bala_ 
#tr.ts: bukānam šūtuq
#tr.en: (The seller) has concluded the sale (lit. has handed over the pestle),
@reverse 
1. _inim-bi al-til_ 
#tr.ts: awassu gamrat
# # Simmons reads awassunu = their transaction (cp. JCS 13/3 p. 91)
#tr.en: its transaction (of the field) is settled.
2. _u4-kur2-sze3 lu2 lu2-ra_ 
#tr.ts: ana warkiāt ūmī awīlum ana awīlim
#tr.en: (That) in future one against the other
3. _inim nu-um-ga2-ga2-a_ 
#tr.ts: ul iraggam
#tr.en: shall not raise a claim,
4. _mu_ {d}utu {d}marduk 
#tr.ts: nīš šamaš marduk
#tr.en: by the life of Šamaš, Marduk
5. u3 sa3-bi-um it-ma-a 
#tr.ts: u sabium itma
#tr.en: and Sabium she has sworn.
6. _igi_ i-tur2-ki-nu-um _dumu_ i-din-sin 
#tr.ts: maḫar itūr-kīnum mār i(d)din-sîn
#tr.en: Before Itūr-kīnum, son of Iddin-sîn;
7. _igi_ e-la-li2 _dumu_ sin-ub-lam 
#tr.ts: maḫar elali mār sîn-ublam
#tr.en: before Elali, son of Sîn-ublam;
8. _igi_ a-bu-wa-qar 
#tr.ts: maḫar abu-waqar
#tr.en: before Abu-waqar,
9. _dumu_ i-din-akszak{ki} 
#tr.ts: mār i(d)din-akšak
#tr.en: son of Iddin-akšak;
10. _igi_ {d}utu-tab-ba-szu 
#tr.ts: maḫar šamaš-tappâšu
#tr.en: before Šamaš-tappâšu,
11. _dumu_ sin-i-din-nam 
#tr.ts: mār sîn-i(d)dinam
#tr.en: son of Sîn-iddinam;
12. _igi_ im-gur-{d}suen 
#tr.ts: maḫar imgur-sîn
#tr.en: before Imgur-sîn,
13. _dumu_ sin-a-bu-szu 
#tr.ts: mār sîn-abūšu
#tr.en: son of Sîn-abūšu;
14. _igi_ sin-e-mu-qi2 
#tr.ts: maḫar sîn-emuqī
#tr.en: before Sîn-emuqī;
@left 
@column 1 
1. _igi_ dingir-na-s,ir 
#tr.ts: maḫar ilī-nāṣir
#tr.en: before Ilī-nāṣir;
2. _igi_ sin-e-ri-ba-am 
#tr.ts: maḫar sîn-erībam
#tr.en: before Sîn-erībam,
3. _dumu_ inim-{d}en-lil2-la2 
#tr.ts: mār awat-enlil
#tr.en: son of Awat-enlil;
@column 2 
1. _igi_ sza-i3-li2-szu 
#tr.ts: maḫar ša-ilīšu
#tr.en: before Ša-ilīšu;
2. _igi_ u-bar-{d}nin-urta
#tr.ts: maḫar ubār-ninurta
#tr.en: before Ubār-ninurta.
