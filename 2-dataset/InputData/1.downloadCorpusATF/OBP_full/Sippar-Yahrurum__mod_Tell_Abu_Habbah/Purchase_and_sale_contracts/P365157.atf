&P365157 = CT 06, pl. 43, Bu 1891-05-09, 2191 
#atf: lang akk 
@tablet 
@obverse 
1. _1/2(disz) sar e2 du3-a_ 
#tr.ts: mišil mūšar bītam epšam
#tr.en: A built house plot of 30 shekels

2. i-ta nig2-{d}utu 
#tr.ts: itā nig-utu
#tr.en: next to (the property of) Nig-utu

3. u3 i-ta ar-wi-tum 
#tr.ts: u itā arwītum
#tr.en: and next to (the property of) Arwītum

4. _dumu-munus_ i3-li2-ba-ni 
#tr.ts: mārat ilī-bānī
#tr.en: daughter of Ilī-bānī,

5. _ki_ in-na-ba-tum _dumu-munus_ bur{ur2}-sin 
#tr.ts: itti innabatum mārat būr-sîn
#tr.en: from Innabatum daughter of Būr-sîn

6. u3 hu-szu-tum _dumu-munus_ qa-ra-szu-mu-ia 
#tr.ts: u ḫu(š)šutum mārat qara'-šumuya
#tr.en: and Ḫuššutum daughter of Qara'-šumuya

7. {disz}ka-ma-zi _dumu-munus_ isz-hi-ti-ia 
#tr.ts: kamazi mārat išḫitīya
#tr.en: Kamazi daughter of Išḫitīya

8. _in-szi-sa10 sa10 til-la-be2-esz 
#tr.ts: išām ana šīmīšu gamrim
#tr.en: has bought. As its full price

9. _ku3-babbar in-na-la2 gesz-gan-na_ 
#tr.ts: kaspam išqul bukānam
#tr.en: she has paid the silver. The sale

10. _ib2-ta-bala inim al-til_ 
#tr.ts: šūtuq awātum gamrat
#tr.en: is concluded, the transaction is settled.

11. _u4 kur2-sze3 lu2 lu2-<ra>_ 
#tr.ts: ana warkiāt ūmī awīlum ana awīlim
#tr.en: (That) in future, one against the other

12. _nu-mu-un-gi-gi4-dam_ 
#tr.ts: la itūr
#tr.en: shall not return (on the decision)

13. _mu_ {d}utu {d}a-a _mu_ {d}marduk 
#tr.ts: nīš šamaš ayya nīš marduk
#tr.en: (by) the name of Šamaš (and) Ayya, (by) the name of Marduk

14. u3 a-pil2-{d}suen 
#tr.ts: u apil-sîn
#tr.en: and Apil-sîn

15. _in-pa3-de3-esz_ 
#tr.ts: itmû
#tr.en: they have sworn.

16. _igi_ ARAD-{d}suen 
#tr.ts: maḫar warad-sîn
#tr.en: Before Warad-sîn;

@reverse 
1. _igi_ szu-mu-uh-sin 
#tr.ts: maḫar šumuḫ-sîn
#tr.en: before Šumuḫ-sîn;

2. _igi_ {d}iszkur-re-me-ni 
#tr.ts: maḫar adad-rēmēni
#tr.en: before Adad-rēmēni;

3. _igi_ {d}nin-szubur-ma-an-szum2 
#tr.ts: maḫar ilabrat-manšum
#tr.en: before Ilabrat-manšum;

4. _igi_ {d}utu-ta-ia-ar 
#tr.ts: maḫar šamaš-tayār
#tr.en: before Šamaš-tayār;

5. _igi_ {d}a-a-tal-lik _ugula lukur_ {d}utu 
#tr.ts: maḫar ayya-tallik akil nadiāt šamaš
#tr.en: before Ayya-tallik, overseer of the nadītus of Šamaš;

6. _igi_ da-mi-iq-tum 
#tr.ts: maḫar damiqtum
#tr.en: before Damiqtum

7. _dumu-munus_ {d}utu-tab-ba-szu 
#tr.ts: mārat šamaš-tappâšu
#tr.en: daughter of Šamaš-tappâšu;

8. _igi_ la-ma-si2 _dumu-munus_ sin-en-nam 
#tr.ts: maḫar lama(s)si mārat sîn-ennam
#tr.en: before Lamassi daughter of Sîn-ennam;

9. _igi_ hu-du-ul-tum 
#tr.ts: maḫar ḫu(d)dultum
#tr.en: before Ḫuddultum

10. _dumu-munus_ nu-ur2-i3-li2-szu 
#tr.ts: mārat nūr-ilīšu
#tr.en: daughter of Nūr-ilīšu;

11. _igi_ e-ri-isz-tum 
#tr.ts: maḫar erištum
#tr.en: before Erištum

12. _dumu-munus_ ia-ta-rum 
#tr.ts: mārat yatarum
#tr.en: daughter of Yatarum;

13. _igi_ ar-wi-tum 
#tr.ts: maḫar arwītum
#tr.en: before Arwītum

14. _dumu-munus_ i3-li2-ba-ni 
#tr.ts: mārat ilī-bānī
#tr.en: daughter of Ilī-bānī;

15. _igi_ {d}a-a-re-sza!-at 
#tr.ts: maḫar ayya-rešat
#tr.en: before Ayya-rešat

16. _dumu-munus_ TE-AN-TE-nu-um 
#tr.ts: mārat teantenum (?)
#tr.en: daughter of Teantenum.

@left 
1. _1/3(disz) sar e2 du3-a_ a-na _ku3-babbar_ i-di-in 
#tr.ts: šaluš mūšar bītam epšam ana kaspim i(d)din
#tr.en: A built house plot of 20 shekel she has sold (lit. has given for silver),

2. 1/2(disz) NE hu-szu-tum in-na-ba-tum-ma 
#tr.ts: mišil NE ḫu(š)šutum innabatumma
#tr.en: half a ... (belongs to) Ḫuššutum (and) Innabatum.
