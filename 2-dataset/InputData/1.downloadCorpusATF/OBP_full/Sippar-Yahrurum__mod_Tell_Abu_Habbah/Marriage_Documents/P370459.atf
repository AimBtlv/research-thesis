&P370459 = CT 08, pl. 22, Bu 1891-05-09, 0374 
#atf: lang akk 
@tablet 
@obverse 
1. {disz}{d}utu-nu-ri _dumu-munus_ i-bi-sza-a-an 
#tr.ts: šamaš-nūrī mārat i(b)bi-ša(ḫ)an
#tr.en: Šamaš-nūrī daughter of Ibbi-šaḫan

2. _ki_ i-bi-{d}sza-a-an a-bi-sza 
#tr.ts: itti i(b)bi-ša(ḫ)an abīša
#tr.en: from Ibbi-šaḫan her father

3. {disz}{d}bu-ne2-ne2-a-bi 
#tr.ts: bunene-abī
#tr.en: Bunene-abī

4. u3 be-le-su-nu i-sza-mu-szi 
#tr.ts: u bēle(s)sunu išāmūši
#tr.en: and Bēlessunu have bought her.

5. a-na {d}bu-ne2-ne2-a-bi a-sza-at
#tr.ts: ana bunene-abī a(š)šat
#tr.en: To Bunene-abī she is a wife,

6. a-na be-le-su-nu a-ma-at 
#tr.ts: ana bēle(s)sunu amat
#tr.en: to Bēlessunu she is a slave.

7. _u4_-um {d}utu-nu-ri a-na be-le-su-[nu] 
#tr.ts: ūmum šamaš-nūrī ana bēle(s)sunu
#tr.en: (Should) one day Šamaš-nūrī to Bēlessunu 

8. be-el-ti-sza u2-ul be-el-ti at-ti 
#tr.ts: bēltīša ul bēltī atti
#tr.en: her mistress "You are not my mistress!"

9. iq-ta-bu u2-ga-la-ab-szi 
#tr.ts: iqtabu uga(l)labši
#tr.en: say, she (Bēlessunu) may shave her (and)

10. a-na _ku3-babbar_ i-na-ad-di-isz-szi 
#tr.ts: ana kaspim inaddišši
#tr.en: sell her (lit. give her for silver).

11. _sa10-am3 til-la-bi-sze3 5(disz) gin2 ku3-babbar_ 
#tr.ts: ana šīmīšu gamrim ḫamšat šiqil kaspam
#tr.en: At its full price, 5 shekels of silver

12. _[in]-na-an-la2 gesz-gan-na_ 
#tr.ts: išqul bukānam
#tr.en: he paid. The sale

13. _[ib2-ta]-bala inim-bi al-til_ 
#tr.ts: šūtuq awāssa gamrat
#tr.en: is concluded, its transaction (of the slave) is settled,

14. _[sza3-ga-ni] al-du10_ 
#tr.ts: libbašu ṭāb
#tr.en: his (the seller’s) heart is satisfied.

15. _[u4 kur2-sze3] lu2 lu2-ra_ 
#tr.ts: ana warkiāt ūmim awīlum ana awīlim
#tr.en: That in future one against the other

16. _[inim nu-um]-ga2-ga2-a_ 
#tr.ts: ul iraggumu
#tr.en: will not raise a claim,

@reverse 
1. [_mu_ {d}]utu {d}a-a {d}amar-utu 
#tr.ts: nīš šamaš ayya marduk
#tr.en: (by) the name of Šamaš, Ayya, Marduk

2. [u3] ha#-mu-ra-pi2 _in-pa3-de3#-mesz_ 
#tr.ts: u ḫammurapi itmû
#tr.en: and Ḫammurapi they have sworn.

$ single ruling 
3. _igi_ ma-s,i-a-am-i3-li2 [_dumu_] im-gur-sin 
#tr.ts: maḫar maṣiam-ilī mār imgur-sîn
#tr.en: Before Maṣiam-ilī son of Imgur-sîn;

4. _igi_ im-gur-rum _dumu_ i-din-sin 
#tr.ts: maḫar imgurrum mār i(d)din-sîn
#tr.en: before Imgurrum son of Iddin-sîn;

5. _igi_ dumu!-za-ma-nu-um _dumu_ {d}utu-dam#-qi2 
#tr.ts: maḫar mār-zamanum mār šamaš-damqi
#tr.en: before Mār-zamanum son of Šamaš-damqi;

6. _igi_ sin-isz-me-an-ni _dumu_ ha-ia-nu#-um# 
#tr.ts: maḫar sîn-išmeanni mār ḫayanum
#tr.en: before Sîn-išmeanni son of Ḫayanum;

7. _igi_ sin-i-din-nam _dumu_ s,il2-li2-isz8-tar2 
#tr.ts: maḫar sîn-i(d)dinam mār ṣillī-ištar
#tr.en: before Sîn-iddinam son of Ṣillī-ištar;

8. _igi_ {d}utu-ba-ni _dumu_ {d}iszkur-ra-bi 
#tr.ts: maḫar šamaš-bānī mār adad-rabi
#tr.en: before Šamaš-bānī son of Adad-rabi;

9. _igi_ dingir-ra-bi _dumu_ ib-ni-{d}mar-tu 
#tr.ts: maḫar ilum-rabi mār ibni-amurru
#tr.en: before Ilum-rabi son of Ibni-amurru.

$ blank space 
10. _iti_ a-ia-ru-um _u4 3(disz)-kam_ 
#tr.ts: waraḫ ayyarum ūmam šalāštum
#tr.en: The month of Ayyarum, the day 3,

11. _mu {gesz}gu-za_ {d}zar-pa-ni-tum 
#tr.ts: šanat kussi zarpanitum
#tr.en: the year "A throne for Zarpanitum".
