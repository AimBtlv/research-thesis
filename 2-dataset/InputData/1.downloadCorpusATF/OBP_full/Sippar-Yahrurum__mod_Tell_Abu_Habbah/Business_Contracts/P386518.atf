&P386518 = TCL 01, 082 & 083 
#atf: lang akk 
@tablet 
@obverse 
1. _3(disz) sar sig4 al-ur3-ra_ 
#tr.ts: šalāšat mūšar agurrum
#tr.en: 2160 (lit. 3 SAR of) bricks

2. s,a-ri-ip-tum 
#tr.ts: ṣariptum
#tr.en: (to be) kiln-fired

3. _ki_ la-ma-si2 _lukur_ {d}utu _dumu-munus_ sze-rum-i3-li2 
#tr.ts: itti lama(s)sī nadīt šamaš mārat šērum-ilī
#tr.en: from Lamassī nadītu of Šamaš daughter of Šērum-ilī

4. u3 geme2-{d}utu _dumu-munus_ bur-{d}suen 
#tr.ts: u amat-šamaš mārat būr-sîn
#tr.en: and Amat-šamaš daughter of Būr-sîn,

5. {disz}{d}suen-kur-i-i3-li2 
#tr.ts: sîn-šadî-ilī
#tr.en: Sîn-šadî-ilī,

6. {disz}an-pi4-{d}utu {disz}sig-an-tum 
#tr.ts: anum-pî-šamaš ipiq-antum
#tr.en: Anum-pî-šamaš, Ipiq-antum

7. u3 ta-ri-bu-um 
#tr.ts: u tarībum
#tr.en: and Tarībum

8. _dumu-mesz_ {d}utu-kur-i-i3-li2 
#tr.ts: mārū šamaš-šadî-ilī
#tr.en: sons of Šamaš-šadî-ilī

9. _szu ba-an-ti-mesz_ 
#tr.ts: ilqû
#tr.en: have assumed the obligation to deliver (lit. have borrowed).

10. _iti apin-du8-a u4 1(u) 8(disz)-kam_ 
#tr.ts: waraḫ araḫsamna ūm šamāššeret
#tr.en: The month of Araḫsamna, the day 18,

11. _sig4 al-ur3-ra_ 
#tr.ts: agurrī
#tr.en: the bricks (to be) kiln-fired

@reverse 
1. i-na pu-ut u2-tu-nim 
#tr.ts: ina pūt utūnim
#tr.en: in front of the kiln

2. i-na-ad-di-nu 
#tr.ts: inaddinū
#tr.en: they will deliver.

3. u2-ul i-di-nu-ma 
#tr.ts: ul i(d)dinūma
#tr.en: (If) they have not delivered,

4. _1(u) gin2 ku3-babbar i3-la2-e-mesz_ 
#tr.ts: ešret šiqil kaspam išaqqalū
#tr.en: 10 shekels of silver they will weigh out;

5. _ki lu2-silim-ma-ta u3 lu2-gi-na-ta_ 
#tr.ts: itti šalmim u kīnim
#tr.en: from the one (financially) sound and (legally) responsible

6. _szu ba-ab-te-ge26_ 
#tr.ts: ileqqeā
#tr.en: (Lamassī and Amat-šamaš) will receive.

7. _igi_ {d}en-ki-ma-an-szum2 
#tr.ts: maḫar enki-manšum
#tr.en: Before Enki-manšum

8. _dumu_ zi-li-lum 
#tr.ts: mār zililum
#tr.en: son of Zililum;

9. _igi_ lu-usz-ta-mar-sin 
#tr.ts: maḫar luštamar-sîn
#tr.en: before Luštamar-sîn

10. _dumu_ i3-li2-i-din-nam 
#tr.ts: mār ilī-i(d)dinam
#tr.en: son of Ilī-iddinam;

11. _igi_ sin-re-me-ni _dumu_ im-gur-sin 
#tr.ts: maḫar sîn-rēmēni mār imgur-sîn
#tr.en: before Sîn-rēmēni son of Imgur-sîn;

12. _igi_ sin-ia-tum ra-bi-s,i _di-ku5_ 
#tr.ts: maḫar sîyyatum rābiṣi dayyānim		
#tr.en: before Sîyyatum, judge's commissioner;

@left 
1. _igi_ {d}nin-pirig-qar-ra-ad 
#tr.ts: maḫar ninpirig-qarrād
#tr.en: before Ninpirig-qarrād

2. _dumu_ {d}utu-ga-mil 
#tr.ts: mār šamaš-gāmil
#tr.en: son of Šamaš-gāmil.

3. _mu iri a2-dam <ma3>-al-gi ba-gul_ 
#tr.ts: šanat ālī u namê malgium i'abitū
#tr.en: The year "Cities and pasture lands of Malgium were destroyed.".

