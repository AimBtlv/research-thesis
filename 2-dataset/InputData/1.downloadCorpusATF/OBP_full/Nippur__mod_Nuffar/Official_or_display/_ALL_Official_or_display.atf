#atf: lang akk
@obverse
@column 1'
1'. [u-sa-za]-ku#-[ni]
#tr.en: (As for the one) who removes (this inscription),
2'. {[d]}en#-lil2
#tr.en: the gods Enlil
3'. [u3] {d}utu
#tr.en: and Šamaš
4'. [_suhusz_]-su
#tr.en: his foundations
5'. [li-su2]-ha
#tr.en: may they both tear out,
6'. _[sze]-numun#_-su
#tr.en: (and) his seed
7'. [li-il-qu3]-ta2#
#tr.en: may they pluck out!
$ rest broken
