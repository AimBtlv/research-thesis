&P229304 = SLT 018
#atf: use lexical
# CBS 6580
#fragment in SLT now rejoined; see MSL 11 111 note 1.
@column 1
$1 column traces 
@column 2
1'. [zi3 gu2]-nida
#lem: zid[flour]; gunida[grain]
2'. zi3-sig15
#lem: zidsig[flour]
3'. zi3-gu
#lem: zidgu[flour]
4'. zi3-gu sag10
#lem: zidgu[flour]; sag[rare]
5'. zi3-gu gen
#lem: zidgu[flour]; jen[go]
6'. zi3-gu <<mu>> us2
#lem: zidgu[flour]; us[follow]
7'. zi3 3(disz)-kam-ma-sze3
#lem: zid[flour]; n
8'. zi3 du8
#lem: zid[flour]; du[spread]
9'. zi3-milla
#lem: zidmilla[flour]
10'. zi3 sze sa-a
#lem: zid[flour]; sze[barley]; sa[roast]
11'. zi3 dub-dub-bu
#lem: zid[flour]; dub[heap]
12'. zi3 ma-ad-ga2
#lem: zid[flour]; madja[~flour]
#Akkadian mas,hatu: inexpensive quality of flour
13'. zi3 e2-da-di
#lem: zid[flour]; edadi[flour]
14'. zi3 sur-ra
#lem: zid[flour]; sur[bread]
15'. zi3 lal3-la2
#lem: zid[flour]; lalla[insect]
16'. [ninda?] zi3-kum
#lem: ninda[bread]; zidgu[flour]
17'. [ninda zi3] gu2-nida
