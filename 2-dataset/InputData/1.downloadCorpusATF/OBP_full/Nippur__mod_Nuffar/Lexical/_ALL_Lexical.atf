&P230401 = MSL 04 46 IB + Ia (+) Ib + unpubl. fragment [OBGT I/2]
#atf: use lexical
# (text B: CBS 6509 + CBS 6563 + UM 29-16-30 (+) UM 6568 (+) "N 1761")
@column 1
#bib: Niek Veldhuis in Yoshikawa Fest (ASJ 22), p. 242
1'. [...-na]-an#-na = %a <(...)>
#lem: u; u
2'. [...]-na#-an-na = %a <(...)>
#lem: u; u
3'. [...]-na-an-na = %a <(...)>
#lem: u; u
4'. [ga2-a-da na]-me-a = %a e-la; ia-ti
#lem: ja'e[I]; me[be]; L; L
5'. [za-a-da] na-me-a = %a <(e-la ka-ti)>
#lem: za'e[you]; me[be]; L; L
6'. [e-ne-da] na#-me-a = %a <(e-la szu-a-ti)>
#lem: ane[he]; me[be]; L; L
7'. [... na-me]-a = %a <(...)>
#lem: u; X; u
# 8'-15'=1'-8'. Sumerian destroyed, Akkadian column blank
16'=9'. [...] = %a i-na ba;-lu-u2
#lem: u; L; L
17'=10'. [...] = %a <(...)>
#lem: u; u
@column 2
#bib: Niek Veldhuis in Yoshikawa Fest (ASJ 22), p. 243
1'. lu2#-re#-en#-[...] = %a [...]
#lem: u; u
2'. ga2-a-[gin7] = %a [ki-ma ia-ti]
#lem: ja'e[I]; L; L
3'. za-a-[gin7] = %a [ki-ma ka-ti]
#lem: za'e[you]; L; L
4'. e-ne-gin7# = %a [ki-ma szu-a-ti]
#lem: ane[he]; L; L
5'. lu2-sze-gin7 = %a [ki-ma a-nu-um-mi-im]
#lem: lu[person]; L; L
6'. lu2-ri-gin7# = %a [ki-ma ul-li-im]
#lem: lu[person]; L; L
7'. me-en-de3-en-[gin7] = %a [ki-ma ni-a-ti]
#lem: menden[we]; L; L
8'. [me-en-ze2-en-gin7] = %a [ki-ma ku-nu-ti]
#lem: menzen[you]; L; L
#bib: MSL 4, 62
9'=1'. e-ne-ne-[gin7] = %a [ki-ma szu-nu-ti]
#lem: anene[they]; L; L
10'=2'. lu2-ne-mesz-gin7# = %a <(ki-ma an-nu-tim)>
#lem: lu[person]; L; L
11'=3'. lu2-sze#-mesz-gin7# = %a <(ki-ma a-nu-um-mu-tim)>
#lem: lu[person]; L; L
12'=4'. lu2-ri#-mesz-gin7# = %a <(ki-ma ul-lu-tim)>
#lem: lu[person]; L; L
13'=5'. lu2-ne na-am3 = %a an-na-szu
#lem: lu[person]; me[be]; L
14'=6'. lu2-sze na-am3 = %a a-na-ma-szu
#lem: lu[person]; me[be]; L
15'=7'. lu2-ri na-am3 = %a ul-la-szu
#lem: lu[person]; me[be]; L
16'=8'. lu2-a-li-mesz = %a an-na-szu-nu
#lem: lu[person]; L
17'/18'=9'/10'. lu2-a-li-mesz; {d}en-lil2# he2-a = %a an-na-szu-nu; {d}en-[lil2] lu-u2
#lem: lu[person]; DN; he[whether]; L; L; L
$ double ruling
19'=11'. za-e = %a <(at-ta)>
#lem: za'e[you]; L
20'=12'. za-a-kam = %a <(ka-tum)>
#lem: za'e[you]; L
21'=13'. za-en-ze2-en = %a <(at-tu-nu)>
#lem: menzen[you]; L
22'=14'. za-en-me#-ze2-en = %a <(at-tu-nu)>
#lem: menzen[you]; L
$ (23'-24' missing)
#bib: MSL 4, 65; Niek Veldhuis in Yoshikawa Fest (ASJ 22), p. 243
25'=1'. [...]-ra#-kam# x x = %a [...]
#lem: u; u; u; u
$ double ruling
26'=2'. [a]-na-am3 = %a mi-nu-um
#lem: anam[what]; L
27'=3'. [e]-ne-am3 = %a mi-isz-szum
#lem: ane[he]; L
28'=4'. [a]-ba#-am3 = %a mi-nu-um
#lem: aba[who?]; L
29'=5'. [a-na]-am3 = %a mi-in-szum
#lem: anam[what]; L
@column 3
#bib: MSL 4, 63 and 56; Niek Veldhuis in Yoshikawa Fest (ASJ 22), pp. 243-4
1'. ki-bi-sze3 x x = %a [...]
#lem: ki[place]; u; u; u
2'. gu2-ta#? = %a [...]
#lem: X; u
3'. gu2-ta-am3 = %a isz-[tu ...]
#lem: gu[side]; L; u
4'. gu2-e-ta = %a isz-[tu an-na-nu-um]
#lem: gu'e[this side]; L; L
5'. gu2-sze-ta = %a isz-[tu a-na-ma-nu-um]
#lem: gu[side]; L; L
6'. gu2-ri-ta = %a isz#-[tu ul-la-nu-um]
#lem: gure[that side]; L; L
7'. gu2-sze3 gu-ri-esz = %a isz-tu# [an-na-nu-um ul-li-isz]
#lem: gu[side]; gure[that side]; L; L; L
8'. me-za3 me-za3-bi-sze3 = %a a#-di# [...]
#lem: X; X; L; L
9'. gu2-e-ta gu2-ri-esz = %a isz-tu [an-na-nu-um ul-li-isz]
#lem: gu'e[this side]; X; L; L; L
10'. me-za3 me-za3-bi-sze3 = %a a-di [...]
#lem: X; X; L; L
11'. mu-da-DU-DU = %a a-ta#-[al-lu-kam e-li-e]
#lem: X; L; L
12'/13'. inim szu mu-da-ab;-gi4-gi4 = %a a-wa-[tam]; tu-ur#!-[ra-am e-li-e]
#lem: inim[word]; szu[hand]; gi[turn]; L; L; L
14'. me-sze3-am3 = %a a-a-i-[sza-am-ma] 
#lem: mea[where?]; L
#first Akkadian a- is in the Sumerian side
15'. me-a = %a a-[li]
#lem: mea[where?]; L
16'. me#-a# an#-til3#-en = %a a-li2 [at]-ta
#lem: mea[where?]; til[live]; L; L
17'=657. [me-a i-til3]-en# = %a a-li2 a-na-ku
#lem: mea[where?]; til[live]; L; L
18'=659. [me-a an-til3-en]-de3#-en = %a a-li2 ni-i-nu
#lem: mea[where?]; til[live]; L; L
19'=660. [me-a an]-til3#-en-ze2-en = %a a-li2 at-tu-nu
#lem: mea[where?]; til[live]; L; L
20'=660a. [me-a] e-ne-ne = %a a-li2 szu-nu
#lem: mea[where?]; anene[they]; L; L
