11. lu2 szag4 usz2 lugud# de2#-a = %a sza li-ib-ba-szu da#-[ma] u3 sza-ar-ka ma-lu#-[u2] & %s lu2# szag4# [usz2 lugud de2-a] = %a [sza li-ib-ba-szu da-ma u3 sza-ar-ka ma-lu-u2]
