#tr.ts: mār rībam-ilī
#tr.en: son of Rībam-ilī.
@column 2
1. _iti szu-numun-a_
#tr.ts: waraḫ dumuzi
#tr.en: The month of Dumuzi
2. _mu_ unu{ki}
#tr.ts: šanat unug
#tr.en: the year “(Ḫammurapi captured) Uruk”.
@envelope
@obverse
1. a-na 1/2(disz) _sar e2 du3-a_
#tr.ts: ana mišil mūšar bītim epšim
#tr.en: Concerning the built house plot of 30 shekels
