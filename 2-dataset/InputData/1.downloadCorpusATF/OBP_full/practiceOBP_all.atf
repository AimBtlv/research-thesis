&P262755 = PBS 08/2, 264  
#atf: lang akk 

@tablet 
@obverse 

1. asz-szum _u4 2(u)-kam gudu4 e2_ {d}ba#-[ba6] 
#tr.ts: aššum ešrā ūmī pašīš bīt baba
#tr.en: Concerning the 20 days of pašīšu (office) in the temple of Baba
