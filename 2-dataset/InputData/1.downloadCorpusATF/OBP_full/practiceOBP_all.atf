#tr.ts: u ešrā ūmī pašīš bīt nergal
#tr.en: and the 20 days of pašīšu (office) in the temple of Nergal,
3. sza {disz}ur-{d}nin-gir2-[su] 
#tr.ts: ša ur-ningirsu
#tr.en: for which Ur-ningirsu
4. {disz}wa-qar-a-bu-szu 
#tr.ts: waqar-abūšu
#tr.en: Waqar-abūšu
