#tr.ts: šangê šamaš
#tr.en: temple chief administrator of Šamaš
3. _dumu_ {d}utu-tab-ba#-[szu] 
#tr.ts: mār šamaš-tappâšu
#tr.en: son of Šamaš-tappâšu
4. _ARAD_ sa-am-su-i-[lu-na] 
#tr.ts: warad samsu-iluna
#tr.en: servant of Samsu-iluna.
@seal 3
1. a-wi-il-[isz8-tar2] 
#tr.ts: awīl-ištar
#tr.en: Awīl-ištar
2. _dumu_ {d}nanna#-[tum] 
#tr.ts: mār nannatum
#tr.en: son of Nannatum
3. _ARAD_ {d}suen# 
#tr.ts: warad sîn
#tr.en: servant of Sîn
4. u3 {d}AN-[mar-tu]
# Wilcke interprets AN.AN.[MAR.TU]
#tr.ts: u diĝir-martu
#tr.en: and (of) Diĝir-martu.
@seal 4
# no linguistic content 
@seal 5 
1. i-din#-[{d}utu] 
#tr.ts: i(d)din-šamaš
#tr.en: Iddin-šamaš
2. _dumu_ {d}suen#-ma-[gir] 
#tr.ts: mār sîn-māgir
#tr.en: son of Sîn-māgir
@seal 6 
# no linguistic content 
@seal 7 
1. <kiszib> sin-i-din-nam 
#tr.ts: kunuk sîn-i(d)dinam
#tr.en: Seal of Sîn-iddinam
@seal 8
1. <kiszib> a-li2-ta-li-mi 
#tr.ts: kunuk ali-talīmī
#tr.en: Seal of Ali-talīmī
@seal 9
