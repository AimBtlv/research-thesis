#tr.ts: ištalmā 
#tr.en: have become favorable, 
11. a-t,a3-ar-ra-su2-nu-ti 
#tr.ts: aṭarrassunūti 
#tr.en: I will dispatch them. 
12. sza#-ni-tam asz-szum sa-ag-[bi] 
#tr.ts: šanītam aššum sagbî 
#tr.en: Another thing: concerning the patrols 
@reverse 
