20. ab2 pesz13 amar-a-ni 3(szar'u)-am3 
#tr.en: His cows pregnant with a calf are 108,000 
21. gu4-ab2-ka-ni 3(szar'u) 5(szar2)-am3 
#tr.en: His breed bulls are 126,000 
22. ab2 igi gun3-bi 1(szar'u) 4(szar2)-am3 
