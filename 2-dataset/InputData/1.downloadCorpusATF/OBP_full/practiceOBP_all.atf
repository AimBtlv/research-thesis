#tr.ts: waraḫ tīrum
#tr.en: The month of Tīrum

9. _mu alan_ sa3-bi-um _ba-dim2-ke4_ 
#tr.ts: šanat ṣalam ṣabium innepiš
#tr.en: the year: "A statue of Ṣabium was built".

@envelope 
@obverse 
1. _dub_ a-na _a-sza3 e2 sag-munus sag-nita2_ 
#tr.ts: ṭuppum ana eqlim bītim amtim wardim
#tr.en: Tablet concerning the field, the house, the male and female slave,

2. bu-sze-e-sza-a u2 wa-ar-ka-ti-sza 
#tr.ts: būšêša u warkatīša	
#tr.en: her personal possessions and her inherited property,

3. isz-tu pe2-e a-di _ku3-sig17_ 
#tr.ts: ištu pê adi ḫurāṣim
#tr.en: everything (lit. from chaff to gold).

4. mi-im-ma {disz}geme2-{d}utu lukur {d}utu 
#tr.ts: mimma amat-šamaš nadīt šamaš
#tr.en: All that Amat-šamas nadītu of Šamaš

5. _dumu-munus_ ARAD-{d}nanna i-szu-u2 
#tr.ts: mārat warad-nanna īšu
#tr.en: daughter of Warad-nanna has,

6. {disz}sig-zalag2-{d}nanna _dumu_ {d}nanna-lu2-du10 
#tr.ts: sig-zalag-nanna mār nanna-lu-dug
#tr.en: Sig-zalag-nanna son of Nanna-lu-dug

