&P306166 = YBC 05038 
#atf: use lexical 
#lemmatizer: sparse do sv 
# transliteration has been unwrapped to conform to normal columnar 
# order; glosses are written on left, above or under (2) on tablet 
#bib MSL 14, 116 
1. # " ~ LU2 
2. # " ~ LUGAL 
3. # " ~ DUN 
4. # " ~ SZUBUR 
5. # " ~ X 
# DUN with three @s wedges and broken final vertical 
6. # " ~ SUHUR 
7. # " ~ MUNSUB 
8. # " ~ ALAN# 
9. # " ~ ALAN 
10. # " ~ |MASZ.GU2.GAR3| 
11. # zubx(|MASZ.GU2.GAR3|) " zu-ub ~ |MASZ.GU2.GAR3| = %a zu-bu-um 
#bib MSL 14, 117 
12. # six(TUM) " si ~ TUM = %a qa-lu-um 
13. # egir " e-gi-ir ~ EGIR = %a wa-ar-ku-um 
14. # egirx(EGIR@g) " e-gi-ir ~ EGIR@g = %a wa-ar-ka-tum 
15. # " ~ TU 
16. # " ~ |SZE.NUN&NUN| 
17. # " ~ NAGA 
18. # " ~ SZINIG 
19. # " ~ |IGI.NAGA| 
20. # " ~ IN 
21. # " ~ |SZE.AB2xTAB| 
22. # " ~ |SZE.AB2xGUD| 
23. # " ~ SAR 
24. # " ~ |LAL2xSAR| 
25. # " ~ |U2.SAR| 
26. # " ~ SAR 
$ (end of text)

