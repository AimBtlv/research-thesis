&P423829 = RA 011, 163-164 B 
#atf: lang sux 
@tablet 
$ (Hammurapi year names 1-36, 41-43)
@obverse 
1. [mu ha-am-mu]-ra#-pi2 lugal# 
# Hammurapi 1 
2. [mu ...] x-na AN? [...]  
# Hammurapi 2 
3. mu# gu-za# [bara2 mah] babila[{ki}] 
# Hammurapi 3 
4. mu# bad3 ga2-gi4-a{ki} [...] 
# Hammurapi 4 
5. mu en ka-asz-bar an-ki 
# Hammurapi 5 
6. mu bara2 {d}nin-pirig 
# Hammurapi 6 
7. mu unu{ki} i3#-si-in-na{ki} 
# Hammurapi 7 
8. mu <ma-da> gu2 i7 su-mu-dar 
# Hammurapi 8 
9. mu i7 ha-am-mu-ra-pi2 [he2-gal2] 
# Hammurapi 9 
10. mu iri a2-dam ma3-al-gi4{ki#}  
# Hammurapi 10 
11. mu ra-pi2-qum{ki} 
# Hammurapi 11 
12. mu gu-za {d}zar-pa-ni-tum 
# Hammurapi 12 
13. mu {uruda}ki-lugal-gub <du8>-mah-bi 
# Hammurapi 13 
14. mu gu-za {d}inanna babila{ki} 
# Hammurapi 14 
15. mu alan-bi 7(disz)-am3 
# Hammurapi 15 
16. mu gu-za {d}na-bi-um 
# Hammurapi 16 
17. mu alan {d}inanna ki-bala masz-da3{ki#} 
# Hammurapi 17 
18. mu bara2? mah {d}en#-lil2# [babila{ki}-ra] 
# Hammurapi 18 
19. mu# bad3 mah igi-hur-sag-ga2{ki} 
# Hammurapi 19 
20. [mu ...] {d#}iszkur 
# Hammurapi 20 
@reverse 
1. [mu bad3 sza# ba-zum{ki}] 
# Hammurapi 21 
2. [mu] alan# ha-am-mu#-ra-pi2 
# Hammurapi 22 
3. [mu] usz8 bad3? zimbir{ki}-ra# 
# Hammurapi 23 
4. [mu] i7# ti-gi8-da {d?}en#?-lil2 
# Hammurapi 24 
5. mu# [bad3] gal#? zimbir#{ki#} 
# Hammurapi 25 
