&P524049 = Akkadica 140, 191-192 
#atf: lang akk 
@tablet 
@obverse 
1. [a]-na a-wi-lim sza {d}marduk u2-ba-al-la-t,u2-szu 
2. qi2-bi2-ma 
3. um-ma ib-ni-{d}utu-ma 
4. {d}utu u3 {d}marduk li-ba-al-li-t,u2-ka 
5. lu sza-al-ma-ta lu ba-al-t,a-ta 
6. _dingir_ na-s,i-ir-ka re-esz-ka a-na da-mi-iq-tim 
7. li-ki-il 
8. a-na szu-ul-mi-ka asz-pu-ra-am 
9. szu-lum-ka ma-har {d#}utu u3 {d}marduk 
10. lu da-ri 
11. asz-szum# _sze_-e u3 _ku3-babbar_ sza qa2#-[ti] _sanga_ an-nu-ni-tum 
12. sza-ka-ni-ka-tim tu-sza#-bi-lam 
13. a-na _sze_-e u3 _ku3#-babbar#_ szu-a-ti na-da-nim 
14. tup-pi2 a-na _sanga#_ an-nu-ni-tum 
15. {disz}a-wi-il-{d}na-bi-um s,u2-ha-ri usz-ta-bi-lam 
16. _sze_-am u3# [_ku3-babbar_] szu#-a-ti i-ip-pa-lu-ka 
17. asz-szum _sze_-e sza _lu2-kuruszda-mesz_ ma-ah-ru 
@reverse 
1. u3 szi-ta-at _sze#_-e# qu2-ut-ti-im-ma 
2. a-na _lu2-kuruszda-mesz_ na-da-nim 
3. sza ta-asz-pu-ra-am 
4. isz-tu ki-ma ta-asz-pu-ra-am 
5. _5(u) 6(asz) 2(barig) 4(ban2) 6(disz) sila3 sze gur_ ma-ah-ru 
6. u3 szi-ta-at _sze_-e _1(u) 6(asz) 2(barig) 4(ban2) 6(disz) sila3 sze# gur#_ 
7. sza uh2-hu-ru 
8. a-di t,e4-ma-am szu-a-ti 
9. a-sza-ap-pa-ra-ak-kum 
10. _sze_-am sza uh2-hu-ru 
11. a-na _lu2-kuruszda-mesz_ la tu-qa2-at-ta-ma 
12. la ta-na-ad-di-in 
13. i-na qa2-ti-ka ki-i-il
