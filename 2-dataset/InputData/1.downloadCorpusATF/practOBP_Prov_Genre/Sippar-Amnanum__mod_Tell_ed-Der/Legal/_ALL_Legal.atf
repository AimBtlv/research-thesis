&P512413 = Suurmeijer diss. Di 2129 
#atf: lang akk
@tablet
$ (in unopened envelope, or a Quasi Hüllentafel?)
@obverse 
1. _1(iku) 1/2(iku) GAN2 4(u) sar a-sza3_ 
2. u3 _2(disz) 1/2(disz) sar an-za-gar3_ na-ki-ir-tum 
3. sza _ki_ ku-ub-bu-rum _dumu_ sig-isz8-tar2 isz-sza-mu 
4. _1/2(iku) GAN2 8(disz) sar a-sza3_ 
5. sza _ki_ dingir-pi4-{d}utu _dumu_ s,il2-li2-{d}utu 
6. _4(u) sar a-sza3_ sza _ki_ ta-ad-di-in-nu-nu _nu-bar_ 
7. _dumu-munus_ a-du-a-an#-[ni]-am isz-sza-mu 
8. _1(iku) GAN2 1(u) 2(disz) sar a-sza3_ 
9. sza _ki_ a-pil-i3-li2-szu _dumu_ mu-na-wi-rum isz-sza-mu 
10. _3(iku) GAN2 a-sza3 2(disz) 1/2(disz) sar an-za-gar3 a-gar3_ bu-sza 
11. i-ta _a-sza3_ {d}a-a-HI TU dingir a _lukur {d}utu dumu-munus_ {d}suen-na-s,i-ir 
12. u3 i-ta a-tap _szu-i_ 
13. _sag-bi 1(disz)-kam-ma i7_ zimbir{ki}  
14. _sag-bi 2(disz)-kam-ma {gesz}kiri6_ sza _dumu-munus_ [i]-bi-{d}suen 
15. _ki_ geme2-be-el-tim _lukur {d}utu dumu-munus_ sig-{d}a-a 
16. {disz}[{d}suen-i]-qi2-sza-am _dumu_ {d}suen-i-din-nam 
17. [u3 be-li-ia]-tum _dumu_ {d}suen-a-ha-am-i-din-nam 
18. [_dumu-mesz_] {d}suen-e-ri-ba-am _dumu_ lu-usz-ta-mar-{d}suen 
19. [{disz}{d}inanna-ma]-an#-szum2# _gala-mah_ an-nu-ni-tum 
20. [_dumu_ {d}marduk-na]-s,i#-ir 
21. [_in]-szi-in-sa10_ 
22. _sa10 til-la-bi-sze3_ 
@reverse 
1. _1(u) 5(disz) gin2 ku3-babbar in-na-an-la2_ 
2. _igi-4(disz)-gal2 si-bi_ isz-ku-un 
3. _sza3-ga-ni_-sza _al-du10 inim-bi al-til_ 
4. _u4-kur2-sze3 lu2 lu2-ra inim nu-ga2-ga2-a_ 
5. _mu {d}utu {d}marduk u3 am-mi-di-ta-na _lugal_ 
6. _in-pe3-de3-mesz 
$ single ruling 
7. _igi_ dingir-su-ib-ni-szu _sanga_ {d}utu 
8. _igi_ e-tel-pi4-{d}na-bi-um _sanga_ {d}a-a 
9. _igi_ ib-ni-{d}utu _di-ku5 dumu_ {d}utu-na-s,i-ir 
10. _igi_ {d}marduk-mu-sza-lim _dumu_ {d}na-bi-um-ma-an-szum2 
11. _igi_ dingir-szu-a-bu-szu _ugula mar-tu_ 
12. _igi_ ARAD-{d}suen _dumu_ {d}suen-i-din-nam 
13. _igi_ {d}suen-isz-me-a-ni _dumu_ ib-ni-{d}marduk 
14. _igi_ a-bu-um-wa-qar _dumu_ {d}suen-i-din-nam 
15. _igi_ i3-li2-e-ri-ba-am _ku3-dim_ 
16. _igi_ {d}suen-na-s,i-ir _dub-sar 
17. [...] _u4 1(u)-kam_ 
18. [_mu_ am-mi-di-ta]-na _lugal-e [bad3_] isz-ku-un-{d}marduk{ki}-ke4 _gu2# i7_ si2-la-qum-ma-ta _bi2-in-du3-a-am3_ 
@seal 1 
1. {d}marduk-mu-sza#-[lim] 
2. _dumu_ {d}na-bi-um-ma-[an-szum2] 
