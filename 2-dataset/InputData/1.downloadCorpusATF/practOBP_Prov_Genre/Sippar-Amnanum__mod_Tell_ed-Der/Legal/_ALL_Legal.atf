&P509378 = MHET 1/1, 001 
#atf: lang akk 
@tablet 
@obverse 
1. _3(iku) GAN2 a-sza3_ i-na kar-{d}utu{ki} 
2. i-na _a-gar3_ ta-wi-ra-tim 
3. i-ta _a-sza3_ {d}utu-ra-bi 
4. _dumu_ ha-li-ia-um 
5. u3 i-ta _a-sza3_ be-el-szu-nu 
6. _dumu_ ib-ni-{d}mar-tu 
7. _sag-bi i7_ {d}a-a-bu-bu 
8. _sag-bi 2(disz)-kam-ma e_ ba-la-la 
9. _ki_ wa-qar-tum _lukur {d}utu_ 
10. _dumu-munus_ {d}suen-na-ap-sze-ra-am 
11. {disz}la-ma-sa3-ni _lukur {d}utu_ 
12. _dumu-munus_ ib-ni-{d}mar-tu 
13. i-na _har ku3-babbar_-sza# _in-szi-in-sa10_ 
14. _sa10 til-la-bi#-[sze3]_ 
15. _[... ku3-babbar in]-na-an-la2_ 
@reverse 
1. _sza3-ga-a-ni al-du10_ 
2. _inim-bi al-til_ 
3. _u4 kur2-sze3 lu2 lu2-ra_ 
4. _inim nu-um-ga2-ga2-a_ 
5. _mu_ {d}utu {d}a-a {d}amar-utu 
6. u3 sa-am-su-i-lu-na _lugal_ it-mu#-u2 
7. _igi_ {d}amar-utu-ni-szu _ugula lukur {d}utu-mesz_ 
8. _igi_ mu-na-wi-rum _ugula lukur {d}utu-mesz_ 
9. _igi_ i-din-{d}ma-mi 
10. _igi_ ip-qu2-{d}mar-tu _dumu!_ ip!-qa2!-tum! 
11. _igi_ i-bi-{d}utu _dumu_ {d}nanna#-ma-an-szum2# 
12. _igi_ a-wi-il-{d}utu _dumu_ ip-qu2-sza 
13. _igi_ {d}suen-e-ri-ba-am _dumu_ {d}suen-a-bu-szu 
14. _igi_ u2-s,ur-we-dam _dub-sar_ 
$ single ruling 
15. _iti ab-e3-a u4 1(u)-kam_ 
16. _mu_ sa-am-su-i-lu-na _lugal gibil 2(disz)-kam-ma_ 
@seal 1 
1. wa-qar!-tum 
2. dumu-munus {d}suen-na-ap-sze-ra-am# 
3. geme2 {d}utu u3 {d}a-a 
@seal 2 
