&P386668 = TCL 01, 232 
#atf: lang akk 
@tablet 
@obverse 
1. _{gesz}kiri6 dumu-mesz gudu4-abzu sag-a_ 
#tr.ts: kirî mārī gudapšîm rēštîm
#tr.en: The orchard of the gudapšu-priest's sons,

2. {disz}{d}suen-i-ri-ba-am 
#tr.ts: sîn-erībam
#tr.en: Sîn-erībam

3. u3 ap-lum ib-qu2-ru-u2-ma 
#tr.ts: u aplum ibqurūma
#tr.en: and Aplum claimed so

4. a-lum u3 szi-bu-tum 
#tr.ts: ālum u šībūtum
#tr.en: the city and the elders

5. di-na-am u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: dīnam ušāḫizūšunūtīma
#tr.en: granted them a trial and

6. a-na ni-isz i-li-im 
#tr.ts: ana nīš ilim
#tr.en: to take an oath (lit. by the life of the god)

7. {disz}a-wi-il-i3-li2 id-<di>-nu-u2-ma 
#tr.ts: awīl-ilī iddinūma
#tr.en: handed over Awīl-ilī

8. a-na _e2_ {d}nin-mar{ki} 
#tr.ts: ana bīt nin-marki
#tr.en: to the temple of Nin-marki.

9. i-na ba-ab {d}nin-mar{ki} 
#tr.ts: ina bāb nin-marki
#tr.en: At the gate of Nin-marki

10. {disz}{d}suen-i-ri-ba-am 
#tr.ts: sîn-erībam
#tr.en: Sîn-erībam

11. u3 ap-lum {disz}a-wi-il-i3-li2 
#tr.ts: u aplum awīl-ilī
#tr.en: and Aplum, Awīl-ilī

12. i-na ba-ab {d}nin-mar{ki} 
#tr.ts: ina bāb nin-marki
#tr.en: at the gate of Nin-marki

13. ut-te-ru-ni-isz-szu um-ma szu-nu-ma 
#tr.ts: ute(r)rūniššū umma šunūma
#tr.en: made him retract, (stating) as follows:

14. _{gesz}kiri6_ pa-nu-u2 bu-ur-ru-u2 
#tr.ts: kirûm pānû(m) burru
#tr.en: "Formerly the (lit. the former) orchard has been established (as yours),

15. i-na i-li te-el-qu2-u2 
#tr.ts: ina ilī telqû
#tr.en: by (the oath by) the god you have taken,

16. u2-bi-ru-<<ku-nu-u2>>-ku-nu-szi-im 
#tr.ts: ubi(r)rūkunūšim
#tr.en: they (the elders) have established (it) as yours (so)

17. la ni-tu-u2-ru-u2 
#tr.ts: lā nitu(r)ru
#tr.en: again (lit. we will not return)

18. la ni-ba-aq-<qa2>-ru-ka-ma 
#tr.ts: lā nibaqqarukama
#tr.en: we will not claim against you.". 

@reverse 
1. _mu_ {d}nanna {d}utu u3 {d}nin-mar{ki} 
#tr.ts: nīš sîn šamaš nin-marki
#tr.en: (By) the name of Sîn, Šamaš, Nin-marki

2. u3 _lugal-la-bi in-pa3-mesz_ 
#tr.ts: u šarrīšunu itmû
#tr.en: and their king they have sworn.

3. _igi_ li-pi2-it-er3-ra _gudu4_ 
#tr.ts: maḫār lipit-erra gudapšûm
#tr.en: Before Lipit-erra, gudapšu-priest;

4. _igi_ dingir-szu-i-bi-szu _gudu4_ 
#tr.ts: maḫār ilšu-i(b)bīšu gudapšûm
#tr.en: before Ilšu-ibbīšu, gudapšu-priest;

5. _igi_ ZA-AB-ru-rum 
#tr.ts: maḫār zabrurum
#tr.en: before Zabrurum;

6. _igi_ be-li2-ip-pa-al-sa3 
#tr.ts: maḫār bēlī-ippalsa(m)
#tr.en: before Bēlī-ippalsam;

7. _igi_ ma-ri-{d}mar-tu 
#tr.ts: maḫār mari-amurrum
#tr.en: before Mari-amurrum;

8. _igi_ nu-ru-um 
#tr.ts: maḫār nūrum
#tr.en: before Nūrum;

9. _igi_ li-pi2-it-isz8-tar2# 
#tr.ts: maḫār lipit-ištar
#tr.en: before Lipit-ištar;

10. _igi_ {d}suen-ma-gir _gudu4_ 
#tr.ts: maḫār sîn-māgir gudapšûm
#tr.en: before Sîn-māgir, gudapšu-priest;

11. _igi_ {d}suen-be-el-i3-li2# _dub-sar_ 
#tr.ts: maḫār sîn-bēl-ilī ṭupšarrim
#tr.en: before Sîn-bēl-ilī, the scribe;

12. _igi_ i-ri-ba-am _aga#-us2# lugal_
#tr.ts: maḫār erībam rēdi šarrim
#tr.en: before Erībam, the king's officer;

13. _igi_ {d}da-mu-a-zu-gal 
#tr.ts: maḫār damu-azugal
#tr.en: before Damu-azugal.

$ blank space 
14. _kiszib3 lu2 inim-ma-bi-mesz_ 
