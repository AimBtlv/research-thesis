&P272993 = ARM 02, 082 
#atf: lang akk 
@tablet 
@obverse 
1. [a-na] be-li2-ia# 
2. qi2-bi2-ma 
3. um-ma# za-ki-ra-ha-am-mu-u2 _ARAD2_-ka-a-ma 
4. a-lum qa-at,-t,u2-na-an{ki} u3 ha-al-s,u2-um sza-lim 
5. i-na pa-ni-tim-ma tup-pi2 aq-ba-a-hi-im isz-tu kur-da{ki} 
6. a-na _e2_-ka-pa-an ik-szu-da-an-ni 
7. um#-ma-a-mi ha-am-mu-ra-pi2 _lugal_ kur#-da{ki} a-na ma-ri{ki} 
8. a-na s,e-er _lugal_ i-la-ak asz-szum _nig2-gub hi-a_-szu 
9. a-na s,e-er _lugal_ szu-pu-ur-ma i-si-ik-ti _nig2-gub hi-a_-szu 
10. li-il-qu2-ni-kum 
11. _ninda_ u3 _kasz nig2-gub_-szu i-na _e2_-ka-pa-an 
12. re-sza-am li-ki-il an-ni-tam aq-ba-a-hu-um 
13. [a-na s,e-ri]-ia isz-pu-ra-am-ma qa-tam# 
14. [a-na qa-tim] isz-tu _e2_-ka-pa-an t,e4-ma-am li?-[x] 
15. [i-na tup-pi2]-im# u2-sza-at,-t,e4-ra-[am]-ma* 
# coll. Durand, LAPO 16 (1997) p. 420 n. 62 
16. a#-[na] s,e#-er be-li2-[ia] 
17. asz-pu-ra-am i-na-an-na asz-szum a-la-ak 
18. {disz}ha-am-mu-ra-pi2 _lugal_ kur-da{ki} 
@reverse 
1. [{disz}]aq-ba-a-hu-um sza-ni-isz a-na s,e#-[ri-ia] 
2. isz-pu-ra-am um-ma-a-mi t,e4#-em#-ka lu#-u2 [s,u2]-bu#-ut 
3. a-na s,e-er _lugal_ szu-pu-ur-ma i-si-ik-ti 
4. _nig2-gub hi-a_ ha-am-mu-ra-pi2 _ninda kasz_ u3 _udu [hi-a]_ 
5. li-il-qu2-ni-kum an-ni-tam aq-ba-a-hu-um 
6. isz-pu-ra-am [i-na-an]-na# i-si-ik-ti _nig2-gub hi-a_-szu 
# According to Durand, LAPO 16 (1997) p. 420 n. 63 i-na-an-na is clear 
7. be-li2 li-si-[ka-am]-ma# an-ni-tam la an-ni-tam 
# Durand, LAPO 16 (1997) p. 420 n. 64 reads: li-si-i[k-szum-m]a* 
8. be-li2 li-isz-pu-ra#-am u3 1(disz)* [_lu2_ i-na] _dumu#*-mesz* ulu3*-gal2_ 
9. li-il-li-kam-ma _nig2-gub# hi-a_-szu#* [u2-sza]-ka#-al* 
# coll. Birot, ARM 27 (1993) p. 147 
10. u3 szum-ma _gu4_ mi-im-ma a-na# [_nig2-gub_]-szu# 
11. it,-t,a3-ab-ba-ah 1(disz) _gu4_ i-gi-[se-e] _e2-gal_-lim 
12. szi-ra-am im-la-a-ma ik-ta*-bi-it!-ma 
# coll. Birot, ARM 27 (1993) p. 147 
13. i-na u2-zu-uz-zi-im sza-ap-la-nu-um 
14. sze-pi2-szu da-mu-um is,-ba-at-ma u2-zu-uz#-za-am# 
15. u2-ul i-le-i u3 a-<na> _sza3-gal_-szu i-na du#*-un#*-ni 
# coll. Birot, ARM 27 (1993) p. 147 
16. usz-ta-na-at-bu-szu _gu4_ szu-u2 a-la-kam# 
17. a#-na ma-ri{ki} u2-ul i-le-i 
18. be-li2 t,e4-em _gu4_ sza-a-ti# 
19. an-ni-tam la an-ni-tam# 
20. [li-isz-pu]-ra#-am
