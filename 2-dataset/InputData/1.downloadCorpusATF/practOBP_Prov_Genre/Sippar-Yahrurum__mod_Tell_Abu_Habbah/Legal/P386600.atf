&P386600 = TCL 01, 164
#atf: lang akk
@tablet
@obverse
1. asz-szum _5(disz) gu4 hi-a_
#tr.ts: aššum ḫamšat alpī
#tr.en: Concerning 5 oxen

2. sza dingir-szu-ib-ni _ugula gidri_ sza _erin2#_ szar-rum-la-ba{ki}
#tr.ts: ša ilšu-ibni akil ḫaṭṭātim ša ṣābim šarrum-laba
#tr.en: of Ilšu-ibni, colonel of the Šarrum-laba's troops,

3. sza ha-al-qu2-ma
#tr.ts: ša ḫalqūma
#tr.en: that disappeared and

4. i-na qa2-ti ib-ni-{d}marduk _dumu_ {d}suen-i-din-nam
#tr.ts: ina qātī ibni-marduk mār sîn-i(d)dinam
#tr.en: in the possession (lit. hands) of Ibni-marduk son of Sîn-iddinam,

5. {disz}ib-ni-e2-mah-ti-la _sipa_
#tr.ts: ibni-emaḫtila rē’ûm
#tr.en: ibni-emaḫtila the shepherd

6. u3 a-ta-mu _dumu_ {d}suen-i-ri!-ba
#tr.ts: u atamu mār sîn-irība(m)
#tr.en: and Atamu son of Sîn-irībam

7. ik-ka-asz-du-ma
#tr.ts: ikkašdūma
#tr.en: were founded,

8. tup-pi2 a-wi-le-e a-bu _erin2_
#tr.ts: ṭuppi awīlê a(b)bū ṣābim
#tr.en: a letter of the gentlemen officials

9. a-na ib-ni-{d}suen _gal-ukken-na_
#tr.ts: ana ibni-sîn mu'irrim
#tr.en: to Ibni-sîn the chairman of the Assembly

10. u3 ip-qu2-{d}na-bi-um _szu-i_
#tr.ts: u ipqu-nabium gallābim
#tr.en: and Ipqu-nabûm the barber

11. il-li-ka-am a-na babila2{ki}
#tr.ts: illikam ana bābilim
#tr.en: arrived (and) to Babylon

12. u2-sze-lu-szu-nu-ti
#tr.ts: ušēlūšunūti
#tr.en: they (Ibni-sîn and Ipqu-nabûm) brought them.

13. ma-har a-wi-le-e a-bu _erin2_
#tr.ts: maḫar awīlê a(b)bū ṣābim
#tr.en: Before the gentlemen officials

14. [a-wa-tum] da-ab-ba-a-ma
#tr.ts: awâtum dabbāma
#tr.en: the cases have been pleaded and

15. _[gu4 hi]-a#_ ri-a-ba-am
#tr.ts: aplī riābam
#tr.en: to return the oxen

16. [iq]-bu-szu-nu-szi!-[im]
#tr.ts: iqbūšunūšim
#tr.en: they have ordered to them.

17. [{disz}]a-wi-il-esz18#-dar#
#tr.ts: awīl-ištar
#tr.en: Awīl-ištar

18. _[dumu]_ ib-ni-{d}utu
#tr.ts: mār ibni-šamaš
#tr.en: son of Ibni-šamaš,

19. [...]
#tr.ts: ...
#tr.en: ...

@reverse
1. i-[...]
#tr.ts: ...
#tr.en: ...

2. _1(disz) gu4 mu 3(asz)_ x x x x x [...]
#tr.ts: ištēn alpam ša šālaš šanātim ...
#tr.en: a three-years-old ox ...

3. a-na i-din-{d}marduk _dub-sar erin2_
#tr.ts: ana i(d)din-marduk ṭupšar ṣābim
#tr.en: to Iddin-marduk the military scribe,

4. ki-isz-da-at ib-ni-{d}marduk _dumu_ {d}suen-i-din-nam
#tr.ts: kišdat ibni-marduk mār sîn-i(d)dinam
#tr.en: the asset of Ibni-marduk son of Sîn-iddinam,

5. id-di-in
#tr.ts: iddin
#tr.en: has given.

$ single ruling
6. _igi_ a-wi#-il#-esz18-dar _dumu_ ib-ni-{d}utu
#tr.ts: maḫar awīl-ištar mār ibni-šamaš
#tr.en: Before Awīl-ištar son of Ibni-šamaš;

7. _igi_ i3-li2-ma-a-hi _dumu_ dingir-szu-a-bu-szu
#tr.ts: maḫar ilīma-aḫī mār ilšu-abūšu
#tr.en: before Ilīma-aḫī son of Ilšu-abūšu;

8. _igi_ ib-ni-{d}er3-ra _dumu_ {d}marduk-mu-sza-lim
#tr.ts: maḫar ibni-erra mār marduk-muša(l)lim
#tr.en: before Ibni-erra son of Marduk-mušallim;

9. _igi_ {d}suen-mu-sza-lim _dumu_ e-t,e-rum
#tr.ts: maḫar sîn-muša(l)lim mār eṭerum
#tr.en: before Sîn-mušallim son of Eṭerum;

10. _igi_ szu-mu-um-li-s,i _dumu-<e2>-dub-ba-a_
#tr.ts: maḫar šumum-liṣi mār bīt ṭuppī
#tr.en: before Šumum-līṣi the royal military scribe.

$ blank space
11. _iti NE-NE-gar u4 9(disz)-kam_
#tr.ts: waraḫ abim ūmam tišītum
#tr.en: The month of Abum, the day 9,

12. _mu_ am-mi-s,a-du-qa2 _lugal-e# alan nam-nir-gal2-la-an#-ni zubi{bi} ku3-sig17-ga-a-ke4 e2-babbar-ra-sze3 in-ne-en-ku4_
#tr.ts: šanat ammi-ṣaduqa šarrum ṣalam etellūtīšu ina gamlim ša ḫurāṣim ina ebabbar ušērib(u)
#tr.en: the year: "Ammi-ṣaduqa the king brought into the Ebabbar a statue of his sovereignty with a curved staff of gold.".

