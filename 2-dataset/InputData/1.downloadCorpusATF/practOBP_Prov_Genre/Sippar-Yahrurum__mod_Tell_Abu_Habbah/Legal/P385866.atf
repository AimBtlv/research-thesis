&P385866 = CT 06, pl. 47, Bu 1891-05-09, 2474 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _1(disz) geme2_ at-kal-szi-im 
#tr.ts: ana ištēn amtim atkalšim
#tr.en: Regarding one female slave (named) Atkalšim

2. sza a-ia-ti-ia um-ma-sza 
#tr.ts: ša ayyatīya ummaša
#tr.en: whom Ayyatīya her mother

3. a-na hu-la-al-tim _dumu-munus-a-ni_ 
#tr.ts: ana ḫulaltim martīša
#tr.en: to Ḫulaltum her daughter

4. i-zi-bu-szi-ma hu-la-al-tum 
#tr.ts: īzibūšīma ḫulaltum
#tr.en: bequeathed and (in return) Ḫulaltum,

5. {disz}a-ia-ti-ia um-ma-sza 
#tr.ts: ayyatīya ummaša
#tr.en: her mother Ayyatīya

6. it-ta-asz-szu-szi-i-ma 
#tr.ts: ittaššûšīma
#tr.en: supported;

7. {disz}{d}suen-na-s,ir mu-ti 
#tr.ts: sîn-nāṣir muti
#tr.en: Sîn-nāṣir, husband

8. {disz}a-ia-ti-ia sza i-na bu-lu-ut,* 
# Coll. Bert Ferwerda 
#tr.ts: ayyatīya ša ina buluṭ
#tr.en: of Ayyatīya, who during the life

9. {disz}a-ia-ti-ia _mu 2(u)-kam_ 
#tr.ts: ayyatīya šittā šanātim
#tr.en: of Ayyatīya, 20 years (ago)

10. i-zi-bu-szi-ma _dub_ la ra-ga-[mi-im] 
#tr.ts: īzibūšīma ṭuppi la ragamim
#tr.en: had abandoned (and) a tablet renouncing all claims

11. a-na mi-im-ma sza a-ia-ti-ia szu-[zu-bu] 
#tr.ts: ana mimma ša ayyatīya šuzubu
#tr.en: to anything belonging to Ayyatīya had to make out,

12. isz-tu a-ia-ti-ia 
#tr.ts: ištu ayyatīya	
#tr.en: after Ayyatīya

13. a-na szi-ma-ti-sza 
#tr.ts: ana šimatīša	
#tr.en: died (lit. to her fate

14. il-li-ku 
#tr.ts: illiku
#tr.en: went),

@reverse 
1. {disz}sin-na-s,ir a-na hu-la-al-tim 
#tr.ts: sîn-nāṣir ana ḫulaltim
#tr.en: Sîn-nāṣir against Ḫulaltum,

2. asz-szum at-kal-szi-im 
#tr.ts: aššum atkalšim
#tr.en: concerning Atkalšim,

3. ir-gu-um-ma i-szar-li-im 
#tr.ts: irgumma išarlim
#tr.en: brought a claim so Išarlim,

4. ra-bi-a-an zimbir{ki} 
#tr.ts: rabiān sippar
#tr.en: the mayor of Sippar,

5. u3 kar zimbir{ki} di-nam 
#tr.ts: u kār sippar dīnam	
#tr.en: and the kārum body of Sippar, a trial

6. u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: ušāḫizūšunūtīma
#tr.en: granted them and

7. ar-nam i-mi-du-szu 
#tr.ts: arnam īmidūšu
#tr.en: imposed a penalty on him.

8. u2-ul i-ta-ar-ma u2-ul i-ra-ga-am! 
#tr.ts: ul itârma ul ira(g)gam
#tr.en: (That) again he will not raise a claim,

9. _mu_ {d}utu {d}marduk u3 ha-am-mu-ra-pi2 
#tr.ts: nīš šamaš marduk u ḫammurapi
#tr.en: (by) the name of Šamaš, Marduk and Ḫammurapi (Sîn-nāṣir swore).

10. di-in i-szar-li-im 
#tr.ts: dīn išarlim
#tr.en: Verdict of: Išarlim,

11. {disz}inim-{d}utu _ugula dam-gar3_ 
#tr.ts: awāt-šamaš akil tamkārī
#tr.en: Awāt-šamaš overseer of the merchants,

12. {disz}ki-{d}en-lil2-qi2-in-ni 
#tr.ts: itti-enlil-qinnī
#tr.en: Itti-enlil-qinnī

13. {disz}bur-sin 
#tr.ts: būr-sîn
#tr.en: Būr-sîn,

14. {disz}dingir-szu-ba-ni 
#tr.ts: ilšu-bānī
#tr.en: Ilšu-bānī.

15. _iti sze-sag11-ku5_ 
#tr.ts: waraḫ addarim
#tr.en: The month of Addarum

16. _mu i7 ti-lim-da {d}en-lil2-la2_ 
#tr.ts: šanat nāram tilimat-enlil
#tr.en: the year "(Ḫammurapi dug) the canal 'Watering-vessel-of-Enlil'"

@envelope 
$ (unpublished, except for the seals:) 
@seal 1 
# Teissier seal no. 5 
1. dingir-szu-ba-ni dam-gar3 
#tr.ts: ilšu-bānī tamkārum
#tr.en: Ilšu-bānī merchant

2. dumu i-bi-{d}nin-szubur 
#tr.ts: mār i(b)bi-ilabrat
#tr.en: son of Ibbi-ilabrat,

3. ARAD nig2 {d}nin-szubur 
#tr.ts: wardum ša ilabrat
#tr.en: servant of Ilabrat.

@seal 2 
# Teissier seal no. 80 
1. bur-{d}suen 
#tr.ts: būr-sîn
#tr.en: Būr-sîn

2. dumu {d}suen-sze-mi 
#tr.ts: mār sîn-šēmi
#tr.en: son of Sîn-šēmi.

@seal 3 
# Teissier seal no. 356 
$ (uninscribed)

@seal 4 
# Teissier seal no. 421 
$ (hem impression with caption:) 
1. sza sin-na-s,ir
#tr.ts: ša sîn-nāṣir
#tr.en: of Sîn-nāṣir
