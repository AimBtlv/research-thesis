&P370441 = CT 08, pl. 12, Bu 1891-05-09, 2460 
#atf: lang akk 
@tablet 
@obverse 
1. {disz}ka-al-ka-tum 
#tr.ts: kalkatum
#tr.en: Kalkatum

2. u3 da-qa2-tum _dam-ni_ 
#tr.ts: u da(q)qatum aššassu
#tr.en: and Daqqatum his wife,

3. {disz}a-ha-ta-ni _dumu-munus_ {d}utu-ha-zi#-[ir] 
#tr.ts: aḫātani mārat šamaš-ḫāzir
#tr.en: Aḫātani daughter of Šamaš-ḫāzir

4. it-ta-asz-szi-szu-nu-ti 
#tr.ts: ittaššīšunūti
#tr.en: sustained them.

5. ki-ma a-ha-ta-ni 
#tr.ts: kīma aḫātani
#tr.en: Because Aḫātani

6. {disz}ka-al-ka-tum u3 da-qa2-tum 
#tr.ts: kalkatum u da(q)qatum
#tr.en: Kalkatum and Daqqatum

7. it-ta-asz-szu-u2 
#tr.ts: ittaššīšu
#tr.en: sustained (lit. him),

8. {disz}{d}suen-im-gur-ra-an-ni 
#tr.ts: sîn-imgurranni
#tr.en: Sîn-imguranni,

9. _dumu_ <<munus>> ka-al-ka-tum u3 da-qa2-tum 
#tr.ts: mār kalkatum u da(q)qatum
#tr.en: the son of Kalkatum and Daqqatum,

10. a-na a-ha-ta-ni _dumu-munus_ {d}utu-ha-zi-ir 
#tr.ts: ana aḫātani mārat šamaš-ḫāzir
#tr.en: to Aḫātani daughter of Šamaš-ḫāzir,

11. i-ta-asz-szi-im id-di-nu 
#tr.ts: itaššim iddinū
#tr.en: (in order to) sustain her, they (the cloister authorities) gave.

12. i-na _mu 1(disz)-kam 1(asz) 1(barig) sze-ba_ 
#tr.ts: ina ištēt šattim ištēn kur ištēn pān ipram
#tr.en: In one year, 360 litres of food allowance,

13. _[6(disz)] sila3 i3-ba 1(disz) gin2 ku3-babbar_ 
#tr.ts: šeššet qa piššatam ištēn šiqil kaspam
#tr.en: 6 litres of oil allotment, 1 shekel of silver

14. [{disz}{d}]suen#-im#-[gur-ra-an-ni] 
#tr.ts: sîn-imguranni
#tr.en: Sîn-imguranni

15. [a-di] ba-al-[t,a-at] 
#tr.ts: adi balṭat
#tr.en: as long as (Aḫātani) lives

@reverse 
1. [i]-na-ad-di-[isz]-szi 
#tr.ts: inaddišši
#tr.en: will give her.

2. isz-tu a-ha-ta-ni 
#tr.ts: ištu aḫatani
#tr.en: After Aḫātani

3. i-lu-sza iq-te-ru-szi 
#tr.ts: ilūša iqterūši
#tr.en: dies (lit. her god will call her),

4. {disz}{d}suen-im-gur-ra-an-ni 
#tr.ts: sîn-imguranni
#tr.en: Sîn-imguranni

5. sza ra-ma-ni-szu 
#tr.ts: ša ramanīšu
#tr.en: will be free (lit. belong to himself).

6. _mu_ {d}utu {d}a-a {d}amar-utu 
#tr.ts: nīš šamaš ayya marduk
#tr.en: (By) the life of Šamaš, Ayya, Marduk

7. u3 ha-am-mu-ra-pi2 it-mu 
#tr.ts: u ḫammurapi itmû
#tr.en: and Ḫammurapi, they have sworn.

8. _igi_ {d}suen-ba-ni _ugula lukur {d}utu_ 
#tr.ts: maḫar sîn-bānī akil nadīt šamaš
#tr.en: Before Sîn-bānī overseer of the nadītu(s) of Šamaš;

9. _igi_ {d}amar-utu-ta-ia-ar 
#tr.ts: maḫar marduk-ta(y)yār
#tr.en: before Marduk-tayyār;

10. _igi_ sig-i3-li2-szu 
#tr.ts: maḫar ipqu-ilīšu
#tr.en: before Ipqu-ilīšu;

11. _igi_ dumu-zimbir{ki} 
#tr.ts: maḫar mār-sippir
#tr.en: before Mār-sippar;

12. _igi_ {d}suen-i-din-nam 
#tr.ts: maḫar sîn-i(d)dinam
#tr.en: before Sîn-iddinam;

13. _igi_ u-bar-{d}utu 
#tr.ts: maḫar ubār-šamaš
#tr.en: before Ubār-šamaš;

14. _igi_ {d}utu-ma-an-szum2 
#tr.ts: maḫar šamaš-manšum
#tr.en: before Šamaš-manšum;

15. _igi_ {d}suen-e-ri-ba-am 
#tr.ts: maḫar sîn-erībam
#tr.en: before Sîn-erībam;

@left 
@column 1 
1. _igi_ mu-ta-ap-lum 
#tr.ts: maḫar mūtaplum
#tr.en: before Mūtaplum.

2. _iti apin-du8-a_ 
#tr.ts: waraḫ kinūnim
#tr.en: The month of Kinūnum

@column 2 
1. _mu e2 <nam>-he2 {d}iszkur_ 
#tr.ts: šanat enamḫe adad
#tr.en: the year: "(He built) the Enamḫe, (the temple) of Adad".
