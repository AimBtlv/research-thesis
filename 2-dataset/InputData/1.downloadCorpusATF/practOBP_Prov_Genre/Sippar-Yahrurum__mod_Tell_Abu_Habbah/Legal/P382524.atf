&P382524 = CT 02, pl. 43, Bu 1891-05-09, 2175a 
#atf: lang akk 
@tablet 
@obverse 
1. {disz}hu-za-lum u3 KA-{d}a-a _lukur_ {d}utu
#tr.ts: ḫuzalum u pî-ayya nadīt šamaš
#tr.en: Ḫuzalum and Pî-ayya nadītu of Šamaš,
2. _dumu-me_ na-bi-{d}utu 
#tr.ts: mārū nabi-šamaš
#tr.en: sons of Nabi-šamaš,
3. asz-szum _igi-sa2_ la-ma-sa3-at {d}inanna sza _ga2#-[gi-a]{ki}_ 
#tr.ts: aššum igisîm lama(s)sat ištar ša gagîm
#tr.en: on account of the (annual) tax to the statue of Ištar in (lit. of) the cloister
4. is,-s,a-ab-tu {disz}{d}suen-na-di-in-szu-mi 
#tr.ts: iṣṣabtu sîn-nādin-šumī
#tr.en: that was taken, Sîn-nādin-šumī,
5. sza-pi2-ir zimbir{ki} _di-ku5-mesz_ ik-szu-du!-ma 
#tr.ts: šāpir sippar dayyānī ikšudūma
#tr.en: the governor of Sippar, (and) the judges have approached
6. a-wa-ti-szu-nu i-mu-ru-ma 
#tr.ts: awātīšunu īmurūma
#tr.en: so they have investigated their case and:
7. _3(disz) sila3 ninda e2_ {d}utu a-na _2(disz) sila3 ninda-ta_ tu-ur-ru 
#tr.ts: šalāšat qa akal bīt šamaš ana šina qa akalim turru
#tr.en: 3 litres of bread (from ?) the temple of Šamaš reduced to 2 litres of bread,
8. _6(disz) sila3 kasz 2(disz) {dug}bur-zi utu2 1(disz) {dug}bur-de2-a_ 
#tr.ts: šeššet qa šikaram šittā pursâtim diktim ištēn pūram nāqiam
#tr.en: 6 litres of beer, 2 bowls of dairy, 1 platter,
9. 2(disz) mi-sze-er-tim _uzu szu!-ti-a_ {disz}hu-za-lum 
#tr.ts: šittā mīšertim šīrim namḫartim ḫuzalum
#tr.en: 2 cuts of meat received by Ḫuzalum (as a prerogative)
10. sza sza-ta-mu-ti-szu sza _e2_ {d}utu 
#tr.ts: ša šata(m)mūtīšu ša bīt šamaš
#tr.en: of his status as accountant in the temple of Šamaš
11. i-na _iti 1(disz)-kam u4 6(disz)-kam 2(disz) sila3 kasz_ sza ki-di-im 
#tr.ts: ina ištēn warḫim šeššet ūmī šinā qa šikaram ša kīdim
#tr.en: for one month and six days, 2 litres of beer from outside
12. i-s,a-am u3 ma-dam u2-pa-hi-ru-ma 
#tr.ts: īṣam u mādam upa(ḫ)ḫirūma
#tr.en: they have collected everything and
13. _7(disz) gin2 ku3-babbar igi-sa2_ la-ma-sa3-at {d}inanna 
#tr.ts: sebet šiqil kaspim igisîm lama(s)sat ištar
#tr.en: (on:) 7 shekels of silver, the (annual) tax for the statue of Ištar,
14. _7(asz) 3(barig) sze gur ninda_ u3 _kasz_ qa2-du-um 
#tr.ts: sebet kur šalāšat pān îm akalim u šikarim qadum
#tr.en: 2.280 litres of barley bread and beer together with
15. _3(asz) sze gur_ sza isz-tu _iri_ sza3-ga{ki?} 
#tr.ts: šalāšat kur îm ša ištu āli šaga
#tr.en: 900 litres of barley, which from the city of Šaga
16. il-la-qe2-a-am mi-il-qe2-<et> {disz}hu-za-lum <a>-hi-sza 
#tr.ts: illaqiam milqēt ḫuzalum aḫīša
#tr.en: was taken, the income of Ḫuzalum her brother
17. sza KA-{d}a-a il-te-qu2-u2 
#tr.ts: ša pî-ayya ilteqû
#tr.en: that Pî-ayya had taken,
18. i-na _ka2 ga2-gi-a{ki}_ 
#tr.ts: ina bāb gagîm
#tr.en: at the gate of the cloister
19. {disz}KA#-[{d}]a#-a# u3# hu-za-lum 
#tr.ts: pî-ayya u ḫuzalum
#tr.en: Pî-ayya and Ḫuzalum
20. sza im-ta-ag-ru-u2-ma 
#tr.ts: ša imtagrūma
#tr.en: have come to an agreement and,
@reverse 
1. i-na mi-it-gu-ur-ti-szu-nu 
#tr.ts: ina mitgurtīšunu
#tr.en: in full agreement,
2. i-na _7(disz) gin2 ku3-babbar igi-sa2_ la-ma-sa3-at {d}inanna 
#tr.ts: ina sebet šiqil kaspim igisîm lama(s)sat ištar
#tr.en: with: 7 shekels of silver, the (annual) tax for the statue of Ištar (of which)
3. _5(disz) gin2 ku3-babbar_ ki-is,-ru? sza KA-{d}a-[a] x-ru-um?-ma 
#tr.ts: ḫamšat šiqil kaspim kiṣru(m) ša pî-ayya ...
#tr.en: 5 shekels of silver, the rent that Pî-ayya ... and
4. _2(disz) gin2 ku3-babbar_ szi-ta-at _igi-sa2_ 
#tr.ts: šinā šiqil kaspim šītat igisîm
#tr.en: 2 shekels of silver, the remainder of the (annual) tax,
5. _6(asz) 3(barig) sze gur_ sza _ninda kasz_ 
#tr.ts: šeššet kur šalāšat pān îm ša akalim šikarim
#tr.en: 1.980 litres of bread and beer
6. {disz}KA-{d}a-a _dumu-munus_ na-bi-{d}utu 
#tr.ts: pî-ayya mārat nabi-šamaš
#tr.en: Pî-ayya, daughter of Nabi-šamaš,
7. a#-na# hu-za-lum a-ha-sza i-pu-ul# 
#tr.ts: ana ḫuzalum aḫāša īpul
#tr.en: has satisfied Ḫuzalum her brother (so)
8. ru-gu-me-szu is-su2-uh 
#tr.ts: rugu(m)mêšu issuḫ
#tr.en: he has renounced his claim.
9. u2-ul i-ta-ar-ma {disz}hu-za-lum 
#tr.ts: ul itârma ḫuzalum
#tr.en: (That) again Ḫuzalum,
10. a-na _7(disz) gin2 ku3-babbar igi-sa2_ la#-ma#-si2 {d}inanna 
#tr.ts: ana sebet šiqil kaspim igisîm lama(s)si ištar
#tr.en: regarding the 7 shekels of silver, the (annual) tax for the statue of Ištar,
11. u3 _6(asz) 3(barig) sze gur_ sza _ninda_ u3 _kasz_ 
#tr.ts: u šeššet kur šalāšat pān îm ša akalim šikarim
#tr.en: and the 1.980 litres of bread and beer,
12. a-na KA-{d}a-a _dumu-munus_ na-bi-{d}utu a-ha-ta-szu 
#tr.ts: ana pî-ayya mārat nabi-šamaš aḫātašu
#tr.en: against Pî-ayya, daughter of Nabi-šamaš his sister,
13. u2-ul i-ra-ga-am 
#tr.ts: ul ira(g)gam
#tr.en: not raise a claim
14. _mu_ {d}utu {d}a-a {d}marduk 
#tr.ts: nīš šamaš ayya marduk
#tr.en: by the life of Šamaš, Ayya, Marduk
15. u3 sa-am-su-i-lu-na _lugal-e_ it-mu-u2 
#tr.ts: u samsu-iluna šarrim itmû
#tr.en: and Samsu-iluna the king they have sworn.
$ single ruling 
16. _igi_ {d}marduk-ni-szu 
#tr.ts: maḫar marduk-nīšu
#tr.en: Before Marduk-nīšu (and)
17. _igi_ ra-pa-asz-s,il2-li2-e2-a _ugula-mesz lukur_ {d}utu 
#tr.ts: maḫar rapaš-ṣilli-ea aklī nadiāt šamaš
#tr.en: before Rapaš-ṣilli-ea, the overseers of Šamaš’s Nadītu's;
18. _igi_ a-wi-il-{d}iszkur _dub-sar lukur {d}utu-mesz_ 
#tr.ts: maḫar awīl-adad ṭupšar nadiāt šamaš
#tr.en: before Awīl-adad, the scribe of Šamaš’s Nadītu's;
19. _igi_ lu-sza-lim-be-li2 sza _lukur {d}utu-mesz_ 
#tr.ts: maḫar lu-šalim-bēlī ša nadiātim šamaš
#tr.en: before Lu-šalim-bēlī of Šamaš’s Nadītu's.
20. _iti sig4-a u4 2(u) 1(disz)-kam_ 
#tr.ts: waraḫ simānim ūmam ešrā ištēn
#tr.en: The month of Simānum, the day 21
21. _mu_ sa-am-su-i-lu-na _lugal-e alan {gesz}tukul! sig3-ge e2!-sag-il2-la mu-un-na-a_ 
#tr.ts: šattum ša samsu-iluna šarrum ṣalmam kakkam māḫiṣam ina esagila īpušu
#tr.en: the year in which Samsu-iluna the king made a statue (representing himself) wielding a weapon in the Esagila.
