&P512369 = BAP 104 
#atf: lang akk 
@tablet 
@obverse 
1. _1(disz) sar e2 du3-a <u3> kislah#_ 
#tr.ts: ištēn mūšar bītum epšum u maškanum
#tr.en: A built and unbuilt plot of 1 SAR
2. _da e2_ sin-i-qi2-sza-am 
#tr.ts: ṭēḫi bīt sîn-iqīšam
#tr.en: next to the house of Sîn-iqīšam
3. u3 _da e2_ esz18-dar-um-ma-sza 
#tr.ts: u ṭēḫi bīt ištar-ummaša
#tr.en: and next to the house of Ištar-ummaša,
4. _2(disz) kusz3_ mu-s,u2-um a-na _sila_ 
#tr.ts: šittā ammat mūṣûm ana sūqim
#tr.en: (with) a right-of-way to the street of 2 cubits,
5. _ha-la_ ib-ni-{d}utu 
#tr.ts: zītti ibni-šamaš
#tr.en: is the share (of the inheritance) of Ibni-šamaš
6. sza _ki_ sin-i-qi2-sza-am 
#tr.ts: ša itti sîn-iqīšam
#tr.en: that with Sîn-iqīšam
7. u3 er3-ra-na-s,ir 
#tr.ts: u erra-nāṣir
#tr.en: and Erra-nāṣir
8. i-zu-u2-zu 
#tr.ts: izūzu
#tr.en: has divided;
9. isz-tu pi2-e a-di _ku3#-sig17#_ 
#tr.ts: ištu pê adi ḫurāṣim
#tr.en: everything (lit. from chaff to gold)
10. zi-zu-u2 
#tr.ts: zīzu
#tr.en: is divided.
11. a-hu-um a-na a-hi-im 
#tr.ts: aḫum ana aḫim
#tr.en: (That) brother against brother
12. u2-ul i-ra-ga-am 
#tr.ts: ul ira(g)gam
#tr.en: will not raise a claim,
13. _mu_ {d}utu {d}a-a 
#tr.ts: nīš šamaš ayya
#tr.en: by the life of Šamaš, Ayya,
14. {d}marduk 
#tr.ts: marduk
#tr.en: Marduk
@reverse 
1. u3 {d}suen-mu-ba-[li2-it,] 
#tr.ts: u sîn-muba(l)liṭ
#tr.en: and Sîn-muballiṭ,
2. _in-pa3#-[de3-mesz]_ 
#tr.ts: itmû
#tr.en: they have sworn.
3. _igi_ sin-pu-ut,-ra-am 
#tr.ts: maḫar sîn-puṭram
#tr.en: Before Sîn-puṭram;
4. _igi_ sin-i-din-nam 
#tr.ts: maḫar sîn-i(d)dinam
#tr.en: before Sîn-iddinam;
5. _igi_ li-bu-ra#-am# 
#tr.ts: maḫar libū(r)ram
#tr.en: before Libūrram;
6. _igi_ ARAD2-i3-li2-szu 
#tr.ts: maḫar warad-ilīšu
#tr.en: before Warad-ilīšu;
7. _igi_ sza-{d}isz-ha-ra 
#tr.ts: maḫar ša-išḫara
#tr.en: before Ša-išḫara;
8. _igi_ sin-ma-gir 
#tr.ts: maḫar sîn-māgir
#tr.en: before Sîn-māgir;
9. _igi_ ARAD2-{d}mar-tu 
#tr.ts: maḫar warad-amurru
#tr.en: before Warad-amurru;
10. _igi_ sin-dingir 
#tr.ts: maḫar sîn-ilī
#tr.en: before Sîn-ilī;
11. _igi_ li-bur-na-di-szu 
#tr.ts: maḫar libur-nādīšu
#tr.en: before Libūr-nādīšu.
12. _mu i7 tu-tu-he2-[gal2]_
#tr.ts: šanat nāram tutu ḫengallum
#tr.en: The year "(Sîn-muballiṭ dug) the canal 'Tutu is abundance'"
