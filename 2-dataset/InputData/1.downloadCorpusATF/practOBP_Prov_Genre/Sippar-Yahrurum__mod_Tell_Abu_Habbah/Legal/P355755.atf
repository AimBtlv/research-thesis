&P355755 = CT 04, pl. 07, Bu 1888-05-12, 0038 
#atf: lang akk 
@tablet 
@obverse 
1. _igi_ {d}marduk-na-s,i-ir
#tr.ts: maḫar marduk-nāṣir
#tr.en: Before: Marduk-nāṣir,
2. DISZ lu2-{d}mar-tu _u2-tul2_ 
#tr.ts: awīl-amurru utullim
#tr.en: Awil-amurru chief shepherd,
3. DISZ sag-il2-dah-mu _u2-tul2_ 
#tr.ts: sagil-daḫmu utullim
#tr.en: Sagil-daḫmu chief shepherd,
4. DISZ {d}utu-tab-ba-szu _aga-us2 e2_ 
#tr.ts: šamaš-tappāšu rēdi bitim
#tr.en: Šamaš-tappāšu soldier of the temple,
5. DISZ a-ha-am-nir-szi _ugula dam-gar3_ TUR DA 
# The last two signs are a mistake from the next line 
#tr.ts: aḫam-nirši akil tamkārī
#tr.en: Aḫam-nirši overseer of the merchants,
6. DISZ {d}nanna-ki-ag2 _dumu_ ur-{d}lugal-ban3-da 
#tr.ts: nanna-kiaĝ mār ur-lugalbanda
#tr.en: Nanna-kiaĝ daughter of Ur-lugalbanda,
7. DISZ i-tur2-ki-nu-um _dumu_ i-din-sin 
#tr.ts: itūr-kimum mār i(d)din-sîn
#tr.en: Itūr-kimum son of Iddin-sîn,
8. DISZ asz-ri-{d}en-lil2 _dumu_ be-lum 
#tr.ts: ašri-enlil mār bēlum
#tr.en: Ašri-enlil son of Bēlum,
9. DISZ {d}suen-a-bu-szu _dumu_ isz-me-sin 
#tr.ts: sîn-abūšu mār išme-sîn
#tr.en: Sîn-abūšu son of Išme-sîn,
10. DISZ {d}suen-ub-lam _dumu_ a-bu-t,a3-bu-um 
#tr.ts: sîn-ublam mār abu-ṭābum
#tr.en: Sîn-ublam son of Abu-ṭābum,
11. DISZ {d}suen-i-qi2-sza-am _dumu_ inim-{d}utu 
#tr.ts: sîn-iqīšam mār awat-šamaš
#tr.en: Sîn-iqīšam son of Awat-šamaš,
12. DISZ a-ma-na-nu-um _dumu_ ib-ni-sin 
#tr.ts: amananum mār ibni-šîn
#tr.en: Amananum son of Ibni-sîn,
13. DISZ {d}suen-dingir _sipa dumu_ sin-e-ri-ba-am 
#tr.ts: sîn-ilum rē’im mār sîn-erībam
#tr.en: Sîn-ilum shepherd son of Sîn-erībam,
14. u3 ma-ta-tum 
#tr.ts: u matatum
#tr.en: and Matatum,
15. DISZ i-bi-{d}nin-szubur _dumu_ {d}suen-ga-mil 
#tr.ts: i(b)bi-ilabrat mār sîn-gāmil
#tr.en: Ibbi-ilabrat son of Sîn-gāmil
16. u3 {d}suen-ub-lam ha-za-a-nu-um 
#tr.ts: u sîn-ublam ḫaza(n)num
#tr.en: and Sîn-ublam the chief magistrate
@reverse 
1. a-wa-at bi-ti-tim 
#tr.ts: awat bītim
#tr.en: a case regarding the house
2. isz-ku-nu-ma 
#tr.ts: iškunūma
#tr.en: have brought and,
3. _igi_ szi-bi an-nu-ti-in 
#tr.ts: maḫar šībī annûtin
#tr.en: before these witnesses,
4. {disz}{d}suen-ub-lam ki-a-am iq-bi 
#tr.ts: sîn-ublam kīam iqbi
#tr.en: Sîn-ublam thus said
5. um-ma szu-ma 
#tr.ts: umma šūma
#tr.en: as follows:
6. _ku3-babbar_ szi-im bi-ti-ia 
#tr.ts: kaspam šīm bītīya
#tr.en: "The silver, the price of my house
7. ga-am-ra-am u3 bi-tam ki-ma bi-tim 
#tr.ts: gamram u bītam kima bītim
#tr.en: full, and a house for a house
8. {disz}i#-bi#-{d}nin-szubur i-din-nam 
#tr.ts: i(b)bi-ilabrat i(d)dinam
#tr.en: Ibbi-ilabrat has given to me;
9. li-ib#-bi t,a3-ab 
#tr.ts: libbī ṭāb
#tr.en: my heart is satisfied,
10. bi-tam sza ki-ma bi-tim 
#tr.ts: bītam ša kima bītim
#tr.en: the house that for a house
11. id-di-nam a-szar e-li-ia t,a3-bu
#tr.ts: iddinam ašar elīya ṭābu
#tr.en: he has given to me, where is accetptable to me
12. a-na-ad-di-in mi-nam 
#tr.ts: anaddin mīnam
#tr.en: i can give. What
13. e-li-ia ti-szu 
#tr.ts: elīya tīšu
#tr.en: do you have against me?";
14. li-ib-bi tu-ut,-t,i4-ib 
#tr.ts: libbī tuṭṭīb
#tr.en: "You have satisfied my heart!"
15. ki-a-am {d}suen-ub-lam 
#tr.ts: kīam sîn-ublam
#tr.en: thus (to) Sîn-ublam
16. {disz}i-bi-{d}nin-szubur i-pu-ul 
#tr.ts: i(b)bi-ilabrat īpul
#tr.en: Ibbi-ilabrat replied.
17. _mu_ {d}utu {d}marduk _mu_ a-pil-sin 
#tr.ts: nīš šamaš marduk nīš apil-sîn
#tr.en: (By) the name of Šamaš (and) Marduk, (by) the name of Apil-sîn
18. u3 _iri{ki}_ zimbir{ki} 
#tr.ts: u āli sippar
#tr.en: and the city of Sippar (they have sworn).
19. sza a-wa-at tup-pi2-im an-ni-i-im 
#tr.ts: ša awat ṭuppim annim
#tr.en: Whoever the content of this document
@left 
@column 1 
1. u2-na-ka-ru 
#tr.ts: una(k)karu
#tr.en: alters (is cursed).
@column 2 
1. _mu e2 {d}inanna ki-bala-masz-da3{ki}_ 
#tr.ts: šattum ša bīt ištar elip
#tr.en: The year in which the temple of Ištar in Elip (was built).
