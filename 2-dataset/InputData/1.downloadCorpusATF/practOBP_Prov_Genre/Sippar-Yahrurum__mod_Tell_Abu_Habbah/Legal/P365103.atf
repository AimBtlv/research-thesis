&P365103 = CT 02, pl. 22, Bu 1891-05-09, 301 
#atf: lang akk 
@tablet 
@obverse 
1. _1/2(disz) ma-na ku3-babbar_ sza er3-ra-[ga-mil] 
#tr.ts: mišil manā kaspam ša erra-gamil
#tr.it: (Riguardo a) 1/2 mina d'argento che Erra-gamil
2. a-na e-ri-ib-{d}suen 
#tr.ts: ana erib-sîn
#tr.it: a Erib-sin
3. a-na _tab-ba_ i-di-nu
#tr.ts: ana tappûtim i(d)dinu
#tr.it: per una collaborazione ha dato
4. u3 _1/3(disz) ma-na-ta-am3_
#tr.ts: u šaluš manā 
#tr.it: e 1/3 di mina ciascuno
5. hi-im-s,a-tu-szu-nu
#tr.ts: ḫimṣātušunu
#tr.it: come profitto.
6. a-na _e2_ {d}utu e-ri-ib-{d}suen
#tr.ts: ana bīt šamaš erib-sîn
#tr.it: Nella casa (= tempio) di Šamaš Erib-sin,
7. _dumu-mesz_ er3-ra-ga-mil
#tr.ts: mārī erra-gamil
#tr.it: i figli di Erra-gamil,
8. _dumu-munus-mesz_ er3-ra-ga-mil
#tr.ts: mārāt erra-gamil
#tr.it: le figlie di Erra-gamil
9. u3 _dam-a-ni_ er3-ra-ga-mil
#tr.ts: u aššat erra-gamil
#tr.it: e la moglie di Erra-gamil
10. i-ru-bu-u2-ma
#tr.ts: īrubūma
#tr.it: sono entrati ed
11. {disz}e-ri-ib-{d}suen
#tr.ts: erib-sîn
#tr.it: Erib-sin
12. ni-ka-si2-szu _igi_ {d}utu i-pu-usz-ma
#tr.ts: nika(s)sišu maḫar šamaš īpušma
#tr.it: il suo resoconto dinnanzi a Šamaš ha mostrato e
13. _5/6(disz) ma-na 7(disz) gin2 ku3-babbar_ i-na _e2_ {d}utu u2-bi-ru-ma
#tr.ts: parasrab manā sebet šiqil kaspam ina bīt šamaš ubi(r)rūma
#tr.it: 5/6 di mina e 7 sicli d'argento, nel tempio di Šamaš (i giudici) hanno stabilito.
14. li-bu _dumu-mesz_ er3-ra-ga-mil
#tr.ts: li(b)bu mārī erra-gamil
#tr.it: I cuori dei figli di Erra-gamil,
15. _dumu-munus-mesz_ er3-ra-ga-mil
#tr.ts: mārāt erra-gamil
#tr.it: delle figlie di Erra-gamil
16. u3 _dam-a-ni_ er3-ra-ga-mil
#tr.ts: u aššat erra-gamil
#tr.it: e della moglie di Erra-gamil
17. {disz}e-ri-ib-{d}suen
#tr.ts: erib-sîn
#tr.it: Erib-sin
@reverse
1. u2-t,i3-ib
#tr.ts: uṭīb
#tr.it: ha soddisfatto.
2. u2-ul i-tu-ru-u2-ma
#tr.ts: ul itu(r)rūma
#tr.it: (Che) non ritorneranno (sull'argomento) e (che)
3. a-na e-ri-ib-{d}suen
#tr.ts: ana erib-sîn
#tr.it: contro Erib-sin
4. isz-tu pe2-e [a-di] _ku3#-sig17_
#tr.ts: ištu pê adi ḫurāṣim 
#tr.it: (su) ogni aspetto (lit. dalla pula all'oro) 
5. u2-ul i-ra-[ga]-mu# it-mu!-u2!
#tr.ts: ul ira(g)gamū itmû
#tr.it: non reclameranno, hanno giurato.
6. _igi_ ig-mil-sin _dumu_ sin-[be]-el#-i3-li2
#tr.ts: maḫar igmil-sîn mār sîn-bēl-ilī
#tr.it: Dinnanzi a Igmil-sin, figlio di Sin-bel-ili;
7. _igi_ bur-{d}iszkur _dumu_ a-di#-du-um
#tr.ts: maḫar bur-adad mār adidum
#tr.it: dinnanzi a Bur-adad, figlio di Adidum;
8. _igi_ {d}suen-na-s,i-ir _igi_ puzur4-{d}utu
#tr.ts: maḫar sîn-naṣir maḫar puzur-šamaš
#tr.it: dinnanzi a Sin-naṣir (e) dinnanzi a Puzur-šamaš,
9. _dumu-mesz_ hu-ur-za!-nim
#tr.ts: mārī ḫurzanim
#tr.it: figli di Ḫurzanim;
10. _igi_ ma-an-ni-ia _dumu_ i-pi2#-iq#-esz18-dar
#tr.ts: maḫar mannia mār ipiq-ešdar
#tr.it: dinnanzi a Mannia, figlio di Ipiq-ištar;
11. _igi_ be-el-szu-nu _dumu_ ma-an-nu-um-ki-ma-i3-li2-ia
#tr.ts: maḫar bēlšunu mār mannum-kima-iliya
#tr.it: dinnanzi a Belšunu, figlio di Mannum-kima-iliya;
12. _igi_ i-pi2-iq-{d}iszkur
#tr.ts: maḫar ipiq-adad
#tr.it: dinnanzi a Ipiq-adad,
13. _dumu_ na-ra-am-i3-li2-szu
#tr.ts: mār naram-ilišu
#tr.it: figlio di Naram-ilišu;
14. _igi_ nu-ur2-i3-li2-szu _dumu_ u2-ku-un!-pi4-sza
#tr.ts: maḫar nur-ilišu mār ukunpiša
#tr.it: dinnanzi a Nur-ilišu, figlio di Ukunpiša;
15. _igi_ ARAD2-sin _dumu_ {d}suen-ga-mil
#tr.ts: maḫar warad-sîn mār sîn-gamil
#tr.it: dinnanzi a Warad-sin, figlio di Sin-gamil.
