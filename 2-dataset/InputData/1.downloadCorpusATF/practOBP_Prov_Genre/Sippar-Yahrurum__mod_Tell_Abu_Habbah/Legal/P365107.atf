&P365107 = CT 02, pl. 26, Bu 1891-05-09, 332 
#atf: lang akk 
@tablet 
@obverse 
1. _2(disz) 1/2(disz) sar 8(disz) gin2 e2 du3-a_ 
#tr.ts: šinā mišil mūšar samānat šiqil bītam epšam 
#tr.it: 2 musarum e mezzo e 8 sicli di terreno edificato 
2. _da e2_ e-ri-ib-{d}suen _dumu_ puzur4-akszak{ki} 
#tr.ts: ṭēḫi bīt erib-sîn mār puzur-akšak 
#tr.it: adiacente alla casa di Erib-sin figlio di Puzur-Akšak 
3. u3 _da e2_ a-bi!-ma-ra-as, _dumu_ ha-ia-ab-ni-dingir 
#tr.ts: u ṭēḫi bīt abi-maraṣ mār ḫayabni-ilu 
#tr.it: e adiacente alla casa di Abī-maraṣ figlio di Ḫayabni-ilu 
4. u3 i-ta _sila e2_-su _sag-bi sila dagal_ {d}bu-ne2-ne2 
#tr.ts: u ita sūqim bīssu rēšušu ribīt bunene 
#tr.it: e confinante con la strada della sua casa, il suo fronte (è) il viale (del dio) Bunene, 
5. _ki_ geme2-{d}utu _lukur_ {d}utu _dumu-munus_ ga-mi-dingir 
#tr.ts: itti amat-šamaš nadīt šamaš mārat gami-ilu 
#tr.it: da Amat-šamaš naditu di Šamaš figlia di Gamilu, 
6. {disz}la-ma-si2 _lukur_ {d}utu _dumu-munus_ puzur4-akszak{ki}-ma 
#tr.ts: lamassi nadīt šamaš mārat puzur-akšakma 
#tr.it: Lamassi, naditu di Šamaš figlia proprio di Puzur-Akšak, 
7. i-na sza-we-ri-sza _in-szi-in-sa10_ 
#tr.ts: ina šaweriša išām 
#tr.it: con il suo anello ha comprato 
8. _sa10 til-la-bi-sze3 ku3-babbar in-na-an-la2_ 
#tr.ts: ana šīmišu gamrim kaspim išqul 
#tr.it: al suo prezzo giusto (in) argento ha pagato (lit. pesato). 
9. _gesz-gan-na ib2-ta-bala_ 
#tr.ts: bukānam šūtuq 
#tr.it: Il pestello è stato ceduto (= la transazione è avvenuta), 
10. _inim-bi al-til sza3-ga-a-ni i3-du10_ 
#tr.ts: awassu gamrat libbašu ṭāb 
#tr.it: la trattativa è terminata, il suo cuore è soddisfatto. 
11. _u4-kur2-sze3 lu2 lu2-ra_ 
#tr.ts: ana warkiāt ūmī awīlum ana awīlim 
#tr.it: Nei giorni a venire, uomo contro uomo 
12. _inim nu-um-ga2-ga2-a_ 
#tr.ts: ul iraggum 
#tr.it: non reclami. 
13. _mu_ {d}utu {d}a-a {d}marduk 
#tr.ts: niš šamaš ayya marduk 
#tr.it: Nel nome di Šamaš, Aya, Marduk 
14. u3 sin-mu-ba-li2-it, 
#tr.ts: u sîn-muballit 
#tr.it: e Sîn-muballit 
15. _in-pa3-de3-esz_ 
#tr.ts: itmû 
#tr.it: hanno giurato. 
@reverse 
1. _igi_ a-wi-il-dingir _dumu_ ku-bu-tum 
#tr.ts: maḫar awīl-ili mār kubutum 
#tr.it: Dinnanzi a Awīl-ilim, figlio di Kubbutum; 
2. _igi_ {d}suen-e-ri-ba-am _dumu_ {d}nanna-lu2-ti 
#tr.ts: maḫar sîn-eribam mār nanna-luti 
#tr.it: dinnanzi a Sîn-eribam, figlio di Nanna-luti; 
3. _igi_ {d}suen-pu-ut,-ra-am _dumu_ ma-ni-um 
#tr.ts: maḫar sîn-puṭram mār manium 
#tr.it: dinnanzi a Sîn-puṭram, figlio di Manium; 
4. _igi_ {d}suen-e-ri-ba-am _dumu_ i-ku-pi4-sza 
#tr.ts: maḫar sîn-eribam mār ikupiša 
#tr.it: dinnanzi a Sîn-eribam, figlio di Ikupiša; 
5. _igi_ sig-{d}iszkur _dumu_ na-ra-am-i3-li2-szu 
#tr.ts: maḫar ipiq-adda mār naram-ilišu 
#tr.it: dinnanzi a Ipiq-Adda, figlio di Naram-ilišu; 
6. _igi_ {d}utu-nu-ur2-ma-tim _dumu_ {d}utu-kur-i-i3-li2 
#tr.ts: maḫar šamaš-nur-matim mār šamaš-šadi-ilim 
#tr.it: dinnanzi a Šamaš-nur-matim, figlio di Šamaš-šadi-ilim; 
7. _igi_ nu-ur2-i3-li2-szu _dumu_ ARAD2-{d}szakkan2 
#tr.ts: maḫar nur-ilišu mār warad-šakkan 
#tr.it: dinnanzi a Nur-ilišu, figlio di Warad-Šakkan; 
8. _igi_ {d}en-lil2-a-bu-um _dumu_ puzur4-{d}utu 
#tr.ts: maḫar ellil-abum mār puzur-šamaš 
#tr.it: dinnanzi a Ellil-abum, figlio di Puzur-Šamaš; 
9. _igi_ sza-ma-ia _dumu_ it-ti-dingir-mil-ki 
#tr.ts: maḫar šamaya mār itti-ilim-milkī 
#tr.it: dinnanzi a Šamaya, figlio di itti-ilim-milkī; 
10. _igi_ ip-qa2-tum _dumu_ sin-e-ri-ba-am 
#tr.ts: maḫar ipqatum mār sîn-eribam 
#tr.it: dinnanzi a Ipqatum, figlio di Sîn-eribam; 
11. _igi_ lu-usz-ta-mar-sin _dumu_ i3-li2-i-din-nam 
#tr.ts: maḫar luštamar-sîn mār ilī-iddinam 
#tr.it: dinnanzi a Luštamar-Sîn, figlio di Ilī-iddinam; 
12. _igi_ {d}utu-na-s,ir _dumu_ e-ri-ba-am 
#tr.ts: maḫar šamaš-naṣir mār eribam 
#tr.it: dinnanzi a Šamaš-naṣir, figlio di Eribam; 
13. _igi_ {d}utu-na-s,ir _dumu_ na-ra-am-i3-li2-szu 
#tr.ts: maḫar šamaš-naṣir mār naram-ilišu 
#tr.it: dinnanzi a Šamaš-naṣir, figlio di Naram-ilišu; 
14. _igi_ {d}sze-rum-i3-li2 _igi_ {d}utu-kur-i-i3-li2 
#tr.ts: maḫar šerum-ilī maḫar šamaš-šadi-ilim 
#tr.it: dinnanzi a Šerum-ilī (e) dinnanzi a Šamaš-šadi-ilim, 
15. _dumu-me_ sin-illat 
#tr.ts: mārī sîn-illat 
#tr.it: figli di Sîn-illat; 
16. _igi_ e2-a-he2-gal2 _dumu_ nu-ur2-sin 
#tr.ts: maḫar ea-ḫengallī mār nur-sîn 
#tr.it: dinnanzi a Ea-ḫengallī, figlio di Nur-Sîn; 
17. _igi_ sin-i-din-nam _dub-sar_ 
#tr.ts: maḫar sîn-iddinam ṭupšarrum 
#tr.it: dinnanzi a Sîn-iddinam, lo scriba. 
18. _iti sze-sag11-ku5 u4 8(disz)-kam_ 
#tr.ts: waraḫ addarum samānat ūmum 
#tr.it: Il mese di Addarum, il giorno 8, 
19. _mu_ {d}utu {d}iszkur 
#tr.ts: šattum šamaš adda 
#tr.it: l’anno (in cui Sîn-muballit ha costruito il trono a) Šamaš e Adda.
