9. i-di-szi-ma 
#tr.ts: i(d)diš(š)ima
#tr.en: gave (lit. her):

10. _1(disz) {na4}ur5 dabin_ 
#tr.ts: ištēt erâm ana tappinnim
#tr.en: 1 grindstone for coarse flour,

11. _3(disz) {gesz}gu-za ma2-lah5_ 
#tr.ts: šalāš kussî malāḫim
#tr.en: 3 "sailor’s chairs",

12. _1(disz) gesz-nu2 hi-a_ 
#tr.ts: ištēt eršam
