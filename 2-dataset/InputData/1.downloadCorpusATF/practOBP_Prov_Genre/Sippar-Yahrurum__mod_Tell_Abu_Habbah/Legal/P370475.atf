&P370475 = CT 08, pl. 32, Bu 1891-05-09, 0396 
#atf: lang akk 
@tablet 
@obverse 
1. tup-pi2 szi-ma-tim 
#tr.ts: ṭuppi šīmātim
#tr.en: The sale document

2. sza {d}sze-rum-na-wi-ir 
#tr.ts: ša šērum-nāwir
#tr.en: of Šērum-nāwir,

3. sza _ki_ i-ku-un-pi4-{d}suen 
#tr.ts: ša itti ikun-pî-sîn
#tr.en: which with Ikun-pî-sîn

4. i-il-li-a-am-ma he-pi2 
#tr.ts: illiamma ḫepi(m)
#tr.en: appears, is (considered) broken.

5. _u4 kur2-sze3_ a-na nu-ma-tim 
#tr.ts: ana warkiāt ūmī ana numātim
#tr.en: (That) in future, about the household furnishings

6. sza ma-hi-ra-at 
#tr.ts: ša maḫirat
#tr.en: that she has received

7. u3 tup-pi2 {d}sze-rum-na-wi-ir 
#tr.ts: u ṭuppi šērum-nāwir
#tr.en: and (about) Šērum-nāwir’s document,

8. {disz}il-ta-ni 
#tr.ts: iltani
#tr.en: Iltani

9. _dumu-munus_ dumu-zimbir{ki} 
#tr.ts: mārat mār-sippir
#tr.en: daughter of Mār-sippar

10. a-na i-ku-un-pi4-{d}suen 
#tr.ts: ana ikun-pî-sîn
#tr.en: against Ikun-pî-sîn

11. u2-ul i-ra-gu-um 
#tr.ts: ul ira(g)gum
#tr.en: will not raise a claim,

@reverse 
1. _mu_ {d}utu {d}amar-utu u3 sa-am-su-i-lu-na _lugal_ 
#tr.ts: nīš šamaš marduk u samsu-iluna šarrim
#tr.en: (by) the name of Šamaš, Marduk and Samsu-iluna the king

2. it-ma 
#tr.ts: itmâ
#tr.en: she has sworn.

$ single ruling 
3. _igi_ {d}suen-re-me-ni _dumu_ i-bi-{d}nin-szubur 
#tr.ts: maḫar sîn-rēmēni mār i(b)bi-ilabrat
#tr.en: Before Sîn-rēmēni son of Ibbi-ilabrat;

4. _igi_ i-bi-{d}suen _dumu_ sig-an-nu-ni-tum 
#tr.ts: maḫar i(b)bi-sîn mār ipqu-annunītum
#tr.en: before Ibbi-sîn son of Ipqu-annunītum;

5. _igi_ sig-{d}a-a u3 ri-isz-{d}utu 
#tr.ts: maḫar ipqu-ayya u rīš-šamaš
#tr.en: before Ipqu-ayya and Rīš-šamaš

6. _dumu-mesz_ szesz-nir-szi 
#tr.ts: mārī aḫam-nirši
#tr.en: sons of Aḫam-niršī;

7. _igi_ {d}suen-re-me-ni ha-za-nu 
#tr.ts: maḫar sîn-rēmēni ḫaza(n)nu(m)	
#tr.en: before Sîn-rēmēni the burgomaster;

8. _igi_ sig-{d}a-a _dub-sar_ 
#tr.ts: maḫar ipqu-ayya ṭupšarrim
#tr.en: before Ipqu-ayya the scribe;

9. _igi_ il-ta-ni _dumu-munus_ mu-na-wi-rum 
#tr.ts: maḫar iltani mārat muna(w)wirum
#tr.en: before Iltani daughter of Munawwirum;

10. _igi_ ta-ri-ba-tum _dumu-munus_ {d}utu-ri-x 
#tr.ts: maḫar taribatum mārat šamaš-...
#tr.en: before Taribatum daughter of Šamaš-...

11. _iti sze-sag11-ku5 u4 1(u)-kam_ 
#tr.ts: waraḫ addarim ūmam ešertum
#tr.en: The month of Addarum, the day 10,

12. _mu erin2_ i-da-ma-ra-as, 
#tr.ts: šanat ummān idamaraṣ
#tr.en: the year "(Samsu-iluna the king smote) the troops of Idamaraṣ".

