&P481355 = MHET 2/1, 105 
#atf: lang akk
@tablet 
@obverse 
1. _1(disz) sar e2 du3-a_ 
#tr.ts: ištēn mūšar bītam epšam
#tr.en: A built house plot of 1 SAR

2. i-ta be-la-kum 
#tr.ts: itā bēlakum
#tr.en: next to (the house of) Bēlakum

3. u3 i-ta lu2-{d}nanna 
#tr.ts: u itā awīl-sîn
#tr.en: and next to (the house of) Awīl-sîn,

4. {disz}ri-ba-am-i3-li2 {d}a-a-tal-lik# _ama-ni-a_ 
#tr.ts: rībam-ilī ayya-tallik ummaša
#tr.en: Rībam-ilī (and) Ayya-tallik her mother

5. a-na e-ri-isz-tum _nu-gig2_ 
#tr.ts: ana erištum qadištim
#tr.en: to Erištum the qadištu,

6. ma-ar-ti-szu-nu 
#tr.ts: mārtīšunu
#tr.en: their daughter,

7. i-di-nu u3 mi-im-ma 
#tr.ts: i(d)dinū u mimma
#tr.en: have given and everything,

8. ma-la i-ba-asz-szu-u2 
#tr.ts: mala ibaššu
#tr.en: as much as is available,

9. _nu-gig2_ u3 na-di-tum 
#tr.ts: qadištum u nadītum
#tr.en: the qadištu and the nadītu

10. mi-it-ha-ri-isz 
#tr.ts: mitḫāriš
#tr.en: equally

11. i-zu-zu 
#tr.ts: izūzū
#tr.en: have divided.

12. _igi_ {d}utu u3 {d}iszkur 
#tr.ts: maḫar šamaš u adad
#tr.en: Before Šamaš and Adad;

13. _igi_ ib-ni-{d}iszkur _sanga_ {d}iszkur  
#tr.ts: maḫar ibni-adad šangê adad
#tr.en: before Ibni-adad, chief administrator of Adad('s temple);

14. _igi_ {d}utu-an-dul3-li2 _dumu_ nu-ri-ia 
#tr.ts: maḫar šamaš-ṣulūlī mār nūrīya
#tr.en: before Šamaš-ṣulūlī son of Nūrīya;

15. _igi_ ku-ni-ia _dumu_ im-gur-sin 
#tr.ts: maḫar kunīya mār imgur-sîn
#tr.en: before Kunīya son of Imgur-sîn;

@reverse 
1. _igi_ mu-na-wi-rum _dumu_ sin-i-din-nam 
#tr.ts: maḫār muna(w)wirum mār sîn-i(d)dinam
#tr.en: before Munawwirum son of Sîn-iddinam;

2. _igi_ na-bi-i3-li2-szu _dumu_ ip-qu2-sza 
#tr.ts: maḫār nabi-ilīšu mār ipquša
#tr.en: before Nabi-ilīšu son of Ipquša;

3. _igi_ mu-sza-pi2-il-szu-nu 
#tr.ts: maḫār mušapilšunu
#tr.en: before Mušapilšunu

4. _dumu_ {d}mar-tu-kur-i
#tr.ts: mār amurru-mātī
#tr.en: son of Amurru-mātī;

5. _igi_ be-la-kum _dumu_ sa3-na-tum 
#tr.ts: maḫar bēlakum mār sanatum
#tr.en: before Bēlakum son of Sanatum;

6. _igi_ {d}utu-i-din-nam _dumu_ sin-dingir 
#tr.ts: maḫār šamaš-i(d)dinam mār sîn-ilī
#tr.en: before Šamaš-iddinam son of Sîn-ilī;

7. _igi_ a-li2-wa-aq-rum _{lu2}azlag2_  
#tr.ts: maḫar āli-waqrum aškālim
#tr.en: before Āli-waqrum, fuller;

8. _igi_ isz-me-{d}iszkur _dumu_ im-gur-sin 
#tr.ts: maḫār išme-adad mār imgur-sîn
#tr.en: before Išme-adad son of Imgur-sîn;

9. _igi_ tab-gi-ri-{d}utu
#tr.ts: maḫār tap(pi)-gi(r)ri-šamaš
#tr.en: before Tappi-girri-šamaš

10. _dumu_ er3-ra-ba-ni 
#tr.ts: mār erra-bānī
#tr.en: son of Erra-bānī;

11. _igi_ dingir-pi4-{d}utu _dub-sar_ 
#tr.ts: maḫār ilum-pî-šamaš ṭupšarrim
#tr.en: before Ilum-pî-šamaš the scribe.

