&P510412 = BDHP 34 & 35 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _e2_ ga-gi-im _sag-geme2 sag-nita2_ 
#tr.ts: ana bīt gagîm amtim wardim
#tr.en: Regarding the house in (lit. of) the cloister, the male and female slave,

2. bu-sze-e sza da-mi-iq-tim 
#tr.ts: būšê ša damiqtim
#tr.en: the property of Damiqtum

3. _dumu-munus_ ki-ki-nim 
#tr.ts: mārat kikinim
#tr.en: daughter of Kikinum,

4. {disz}i-din-{d}nin-szubur {disz}e-ri-ba-am-sin 
#tr.ts: i(d)din-ilabrat erībam-sîn
#tr.en: Iddin-ilabrat, Erībam-sîn

5. {disz}a-bu-wa-qar u3 si2-pi2-ri-tum 
#tr.ts: abu(m)-waqar u si(p)pirītum
#tr.en: Abum-waqar and Sippirītum

6. ir-gu-mu-u2-ma _di-ku5-mesz_ 
#tr.ts: irgumūma dayyānū
#tr.en: made a claim. The judges

7. i-na _e2-babbar-ra_ di-nam u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: ina ebabbar dīnam ušāḫizūšunūtīma
#tr.en: granted them a trial in the Ebabbar.

8. {disz}da-mi-iq-tum a-na ni-isz _dingir_ 
#tr.ts: damiqtum ana nīš ilim
#tr.en: Damiqtum, to (make her swear by) the name of the god,

9. a-na pa-ni pa-pa-hi-im id-di-szi-i-ma 
#tr.ts: ana pāni papāḫim iddī(š)šīma
#tr.en: (the president of the court) handed her over to the sanctuary;

10. i-na pa-ni pa-pa-hi-im 
#tr.ts: ina pāni papāḫim
#tr.en: before the sanctuary

11. im-ta-ga-ar-ma 
#tr.ts: imtagarma
#tr.en: she agreed and

12. _1(u) gin2 e2_ i-na ga-gi-im 
#tr.ts: ešret šiqil bītam ina gagîm
#tr.en: a house of 10 shekels in the cloister

13. {disz}da-mi-iq-tum 
#tr.ts: damiqtum
#tr.en: Damiqtum

14. a-na si2-pi2-ri-tum id-di-in 
#tr.ts: ana si(p)pirītum iddin
#tr.en: gave to Sippirītum.

@reverse 
1. u2-ul i-tu-ru-u2-ma 
#tr.ts: ul itu(r)rūma
#tr.en: (That) again

2. {disz}i-din-{d}nin-szubur e-ri-ba-am-sin 
#tr.ts: i(d)din-ilabrat erībam-sîn
#tr.en: Iddin-ilabrat, Erībam-sîn,

3. {disz}a-bu-wa-qar u3 si2-pi2-ri2-tum 
#tr.ts: abu(m)-waqar u si(p)pirītum
#tr.en: Abum-waqar and Sippirītum

4. a-na _e2 sag-munus sag-nita2_ 
#tr.ts: ana bītim amtim wardim
#tr.en: concerning the house, the male and female slave,

5. isz-tu pe2-e a-di _ku3-sig17_ a-na mu-na-wi-ir-tum _dumu-munus_ {d}utu-tab-ba-szu 
#tr.ts: išṭu pê adi ḫurāṣim ana muna(w)wirtum mārat šamaš-tappâšu
#tr.en: everything (that Damiqtum gave) to Munawwirtum daughter of Šamaš-tappâšu

6. u2-ul i-ra-ga-mu {d}utu {d}amar-utu 
#tr.ts: ul ira(g)gamū šamaš marduk
#tr.en: will not raise a claim, (by) Šamaš, Marduk,

7. {disz}sin-mu-ba-li2-it, u3 _iri_ zimbir{ki} 
#tr.ts: sîn-muba(l)liṭ u āli sippar
#tr.en: Sîn-muballiṭ and the city of Sippar (they swore).

8. _igi_ ARAD2-sin u3 sza-lim-pa-li-ih-szu 
#tr.ts: maḫar warad-sîn u šalim-paliḫšu
#tr.en: Before Warad-sîn and Šalim-paliḫšu;

9. _igi_ {d}nin-szubur-ma-an-szum2 
#tr.ts: maḫār ilabrat-iddinam
#tr.en: before Ilabrat-iddinam;

10. _igi_ {d}utu-ta-ia-ar 
#tr.ts: maḫār šamaš-tayār
#tr.en: before Šamaš-tayār;

11. _igi_ ka-lu-mu-um 
#tr.ts: maḫār kalumum
#tr.en: before Kalumum;

12. _igi_ li-bu-ra-am 
#tr.ts: maḫār libu(r)ram
#tr.en: before Liburram;

13. _igi_ i-da-du-um 
#tr.ts: maḫar idadum
#tr.en: before Idadum;

14. _igi_ {d}utu-tab-ba-e 
#tr.ts: maḫar šamaš-tappê
#tr.en: before Šamaš-tappê;

15. _igi_ sin-ia-tum 
#tr.ts: maḫar sîyyatum
#tr.en: before Sîyyatum.

