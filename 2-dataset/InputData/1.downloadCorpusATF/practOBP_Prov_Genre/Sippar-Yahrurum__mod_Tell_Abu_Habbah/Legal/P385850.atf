&P385850 = CT 06, pl. 33, Bu 1891-05-09, 0586 
#atf: lang akk 
@tablet 
@obverse 
1. {disz}{d}marduk-mu-ba-li2-it, 
#tr.ts: marduk-muba(l)liṭ
#tr.en: Marduk-muballiṭ

2. u3 {d}suen-i-din-nam _szesz-a-ni_ 
#tr.ts: u sîn-i(d)dinam aḫūšu
#tr.en: and Sîn-iddinam his brother

3. _dumu-<mesz>_ ip-t,u2-ur-{d}suen 
#tr.ts: mārū ipṭur-sîn
#tr.en: sons of Ipṭur-sîn

4. a-na sza-at-{d}a-a _dumu-munus_ a-wi-il-dingir 
#tr.ts: ana šāt-ayya mārat awīl-ilī
#tr.en: against Šāt-ayya daughter of Awīl-ilī

5. asz-szum _e2_ sza ga-gi-im 
#tr.ts: aššum bītim ša gagîm
#tr.en: concerning the house in (lit. of) the cloister

6. ir-gu-mu-u2-ma 
#tr.ts: irgumūma
#tr.en: have made a claim so

7. _di-ku5-mesz_ i-na _e2_ {d}utu 
#tr.ts: dayyānū ina bīt šamaš
#tr.en: the judges, in the temple of Šamaš,

8. di-nam u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: dīnam ušāḫizūšunūtīma
#tr.en: have granted them a trial.

9. sza-at-{d}a-a _dumu-munus_ a-wi-il-dingir 
#tr.ts: šāt-ayya mārat awīl-ilī
#tr.en: Šāt-ayya daughter of Awīl-ilī

10. a-na ni-isz {d}[a]-a 
#tr.ts: ana nīš ayya
#tr.en: (to make her swear by) the life of Ayya

11. id-di-nu-u2-szi#-ma 
#tr.ts: iddinūšīma
#tr.en: have handed her over and

12. i-na ba-ab ni-isz# _dingir#_ 
#tr.ts: ina bāb nīš ilim
#tr.en: at the gate of the oath for the god

13. im#-ta#-ag-ru-u2-ma 
#tr.ts: imtagrūma
#tr.en: they have reached an agreement

14. u3# _sza3!_ {d}marduk-mu-ba-li2-it, 
#tr.ts: u libbi marduk-muba(l)liṭ
#tr.en: and the heart of Marduk-muballiṭ

15. u3 {d}suen-i-din-nam _szesz-a-ni_ 
#tr.ts: u sîn-i(d)dinam aḫīšu
#tr.en: and Sîn-iddinam his brother

@reverse 
1. sza-at-{d}a-a u2-t,i3!-i-ib 
#tr.ts: šāt-ayya uṭīb
#tr.en: Šāt-ayya has satisfied.

2. u2-ul i-tu-ru-ma 
#tr.ts: ul itu(r)rūma
#tr.en: (That) again,

3. {d}marduk-mu-ba-li2-it, 
#tr.ts: marduk-muba(l)lliṭ
#tr.en: Marduk-muballiṭ

4. u3 {d}suen-i-din-nam _szesz-a-ni_ 
#tr.ts: u sîn-i(d)dinam aḫūšu
#tr.en: and Sîn-iddinam his brother

5. a-na sza-at-{d}a-a 
#tr.ts: ana šāt-ayya
#tr.en: against Šāt-ayya,

6. asz-szum _e2_ sza ga-gi-im 
#tr.ts: aššum bītim ša gagîm
#tr.en: concerning the house in the cloister,

7. u2-ul i-ra-ga-mu-u2 
#tr.ts: ul ira(g)gamū
#tr.en: will not raise a claim (and that if)

8. tup-pu-um se2-eh-tum i-li-a-am-ma 
#tr.ts: ṭuppum ṣīḫtum i(l)liamma
#tr.en: the invalid tablet appears

9. ih-he-e-ep-pe2 _mu_ {d}utu {d}marduk 
#tr.ts: iḫḫeppe nīš šamaš marduk
#tr.en: it will be destroyed, by the name of Šamaš, Marduk

10. u3 a-pil-sin in!-pa3-de3-<<szu>>-mesz 
#tr.ts: u apil-sîn itmû
#tr.en: and Apil-sîn have sworn.

11. _igi_ {d}nin-szubur-ba-ni 
#tr.ts: maḫar ilabrat-bānī
#tr.en: Before Ilabrat-bānī;

12. _igi_ sin-<e>-mu-qi2 _lu2-muhaldim!(GU)_ 
#tr.ts: maḫar sîn-emūqī nuḫatimmim
#tr.en: before Sîn-emūqī, cook;

13. _igi_ {d}utu-da-ia-an _dumu_ {d}utu-na-s,ir 
#tr.ts: maḫār šamaš-dayyān mār šamaš-nāṣir
#tr.en: before Šamaš-dayyān son of Šamaš-nāṣir;

14. _igi_ usz!-tasz-ni-dingir 
#tr.ts: maḫār uštašni-ilum
#tr.en: before Uštašni-ilum;

15. _igi_ e-ri-sum2-ma-tum 
#tr.ts: maḫār eri(s)sum-mātum
#tr.en: before Erissum-mātum;

16. [_igi_] be-le-su2-nu 
#tr.ts: maḫar bēle(s)sunu
#tr.en: before Bēlessunu;

@left 
1. _igi_ ha-zi-rum _dumu_ {d}utu-da-ia-an 
#tr.ts: maḫar ḫazirum mār šamaš-dayyān
#tr.en: before Ḫazirum son of Šamaš-dayyān;

2. _igi_ na-ra-nu-um _dumu_ ARAD-{d}iszkur 
#tr.ts: maḫar nāranum mār warad-adad
#tr.en: before Nāranum son of Warad-adad.

3. _mu i7 a-pil-sin-he2-gal2_ 
#tr.ts: šanat nāram apil-sîn-ḫengallum
#tr.en: The year “(He dug) the canal ‘Apil-sîn-is-abundance’”.
