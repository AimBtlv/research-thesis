&P365123 = CT 02, pl. 45, Bu 1891-05-09, 2178a & MHET 2/2, 183 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _3(disz) 1/3(disz) sar 7(disz) gin2# [e2 du3-a_] 
#tr.ts: ana šalāšat u šaluš mūšar sebet šiqil bītim epšim
#tr.en: Concerning a built house plot of 207 shekels
2. qa2-du-um _1(disz) 1/3(disz) kusz3 sag_ x [...] 
#tr.ts: qadum ištēn u šaluš ammat pūtim ...
#tr.en: along with a front of 80 cubits ...,
3. ki-isz!-da-at {d}utu-be-el-[i3-li2] 
#tr.ts: kišdāt šamaš-bēl-ilī
#tr.en: the acquisition from Šamaš-bēl-ilī
4. sza _ki_ {d}utu-be-el-i3-li2 _dumu_ s,il2-li2-{d}utu 
#tr.ts: ša itti šamaš-bēl-ilī mār ṣillī-šamaš
#tr.en: that from Šamaš-bēl-ilī son of Ṣillī-šamaš
5. {disz}ma-an-na-szi _lukur_ {d}utu _dumu-munus_ ni-id-nu-sza 
#tr.ts: mannaši nadīt šamaš mārat nidnuša
#tr.en: Mannaši nadītu of Šamaš daughter of Nidnuša
6. i-sza-mu i-tu-ur2 {d}utu-be-el-i3-li2 
#tr.ts: išāmu itūr šamaš-bēl-ilī
#tr.en: had bought, again Šamaš-bēl-ilī
7. a-na ma-an-na-szi _lukur_ {d}utu ir-gu-um-ma 
#tr.ts: ana mannaši nadīt šamaš irgumma
#tr.en: brought a claim against Mannaši nadītu of Šamaš, so
8. _di-ku5-mesz_ di-nam u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: dayyānū dīnam ušāḫizūšunūtīma
#tr.en: the judges have tried against them and,
9. i-na sza-sza-ri-im sza {d}utu 
#tr.ts: ina ša(š)šārim ša šamaš
#tr.en: by means of the saw of Šamaš,
10. _e2_ us-sa3-ni-iq-ma _1(u) 2(disz) gin2 e2_ 
#tr.ts: bītum ussa(n)niqma šinšeret šiqil bītum
#tr.en: the house has been checked and 12 shekels of house 
11. a-na _ka_ tup-pa-at szi-ma-tim im-t,i3-ma 
#tr.ts: ana pî ṭuppāt šīmātim imṭīma
#tr.en: were lacking from the (amount in the) sale contracts;
12. ki-ma _1(u) 2(disz) gin2 e2 sila dagal-la_ 
#tr.ts: kīma šinšeret šiqil bītim ribītim
#tr.en: instead of an area of 12 shekels by the square,
13. _1/2(disz)! sar e2_ wa-ar-ka-tum szu-pa-lum 
#tr.ts: šaluš mūšar bītum warkatum šupalum
#tr.en: a rear area of 30 shekels, low-lying,
14. _da! e2_ dumu-bi-zi-za-na _dumu_ ra-ab-bi-ia 
#tr.ts: ṭēḫi bīt mār-bizizana mār rabbīya
#tr.en: adjoining the house of Mār-bizizana son of Rabbīya,
15. a-na ma-an-na-szi in-na-di-in 
#tr.ts: ana mannaši innadin
#tr.en: has been given to Mannaši.
16. asz-szum i-tu-ru-ma {d}utu-be-el-i3-li2 
#tr.ts: aššum itūrūma šamaš-bēl-ilī
#tr.en: Because Šamaš-bēl-ilī returned (to the matter) and
17. a-na ma-an-na-szi ir-gu-mu 
#tr.ts: ana mannaši irgumu
#tr.en: complained against Mannaši,
18. ar-nam i-mi-du-szu 
#tr.ts: arnam īmidūšu
#tr.en: (the judges) have imposed a penalty to him.
19. u2-ul i-ta-ar-ma 
#tr.ts: ul itârma
#tr.en: (That) again
@reverse 
1. {disz}{d}utu-be-el-i3-li2 
#tr.ts: šamaš-bēl-ilī
#tr.en: Šamaš-bēl-ilī,
2. {disz}{d}zar-pa-ni-tum-um-mi _dam-ni_ 
#tr.ts: zarpanitum-ummī aššassu
#tr.en: his wife Zarpanitum-ummī,
3. {disz}be-le-ti-ia _lukur_ {d}utu 
#tr.ts: bēletīya nadīt šamaš
#tr.en: Bēletīya the nadītu of Šamaš
4. u3 ta-ad-di-in-nu-nu _nu-<<NA>>-bar_ 
#tr.ts: u taddin-nunu kulmašītum
#tr.en: and Taddin-nunu the kulmašītu,
5. _dumu-mesz_ 
#tr.ts: mārū
#tr.en: the sons
6. a-na ma-an-na-szi _lukur_ {d}utu _dumu-munus_ ni-id-nu-sza 
#tr.ts: ana mannaši nadīt šamaš mārat nidnuša
#tr.en: against Mannaši nadītu of Šamaš daughter of Nidnuša
7. u3 a-ah-hi-i-sza 
#tr.ts: u aḫḫīša
#tr.en: and her brothers
8. u2-ul i-ra-ga-am 
#tr.ts: ul ira(g)gam
#tr.en: will not sue,
9. _mu_ {d}utu {d}marduk 
#tr.ts: nīš šamaš marduk
#tr.en: by the life of Šamaš, Marduk,
10. {disz}ha-am-mu-ra-pi2 u3 {iri}zimbir{ki} it-mu-u2 
#tr.ts: ḫammurapi u sippar itmû
#tr.en: Ḫammurapi and Sippar they have sworn.
$ single ruling 
11. _igi_ sin-e-ri-ba-am 
#tr.ts: maḫar sîn-erībam
#tr.en: Before Sîn-erībam;
12. _igi_ na-ra-am-i3-li2-szu 
#tr.ts: maḫar nāram-ilīšu
#tr.en: before Nāram-ilīšu;
13. _igi_ bur-sin 
#tr.ts: maḫar būr-sîn
#tr.en: before Būr-sîn;
14. _igi_ mu-na-wi-rum _dumu_ i-ku-pi2-sza! 
#tr.ts: maḫar muna(w)wirum mār ikū(n)-pīša
#tr.en: before Munawwirum son of Ikūn-pīša;
15. _igi_ dingir-szu-a-bu-szu _igi_ {d}utu-<an>-dul3-li2 
#tr.ts: maḫar ilšu-abūšu maḫar šamaš-ṣulūlī
#tr.en: before Ilšu-abūšu, before Šamaš-ṣulūlī
16. _dumu-me_ {d}utu-ga-mil 
#tr.ts: mārī šamaš-gāmil
#tr.en: sons of Šamaš-gāmil;
17. _igi_ nu-ur2-i3-li2-szu _dumu_ sin-ub-lam 
#tr.ts: maḫar nūr-ilīšu mār sîn-ublam
#tr.en: before Nūr-ilīšu son of Sîn-ublam;
18. _igi_ sin-na-s,ir _dumu_ en-nam-sin 
#tr.ts: maḫar sîn-nāṣir mār ennam-sîn
#tr.en: before Sîn-nāṣir son of Ennam-sîn;
19. _igi_ sin-isz-me-a-ni _igi_ ib-ni-[{d}we-er] 
#tr.ts: maḫar sîn-išmea(n)ni maḫar ibni-wer
#tr.en: before Sîn-išmeanni, before Ibni-wer,
20. _igi_ sin-re-me-ni _dumu-me_ ri-ba-am#-[i3-li2] 
#tr.ts: maḫar sîn-rēmēni mārī ribam-ilī
#tr.en: before Sîn-rēmēni sons of Ribam-ilī;
21. _igi_ e-mu-uq-szu#-dan [...] 
#tr.ts: maḫar emūq-šudan ...
#tr.en: before Emūq-šudan ...;
22. _igi_ ip-qu2?-[...] 
#tr.ts: maḫar ipqu ...
#tr.en: before Ipqu...;
