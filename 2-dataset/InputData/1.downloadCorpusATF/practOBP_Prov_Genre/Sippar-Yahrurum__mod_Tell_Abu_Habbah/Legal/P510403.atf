&P510403 = BDHP 22 & 23 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _a-sza3 e2 sag-munus sag-nita2_ 
#tr.ts: ana eqlim bītim amtim wardim
#tr.en: Concerning the field, the house, the male and female slave,

2. bu-sze-sza u3 wa-ar-ka-ti-sza 
#tr.ts: būšêša u warkatīša
#tr.en: her personal possessions and her inherited property

3. sza geme2-{d}utu _lukur_ {d}utu 
#tr.ts: ša amat-šamaš nadīt šamaš
#tr.en: of Amat-šamas nadītu of Šamaš

4. _dumu-munus_ ARAD-{d}nanna 
#tr.ts: mārat warad-nanna
#tr.en: daughter of Warad-nanna,

5. {disz}sig-zalag2-{d}nanna 
#tr.ts: sig-zalag-nanna
#tr.en: Sig-zalag-nanna

6. _dumu_ {d}nanna-lu2-du10 
#tr.ts: mār nanna-lu-dug
#tr.en: son of Nanna-lu-dug

7. u2-la i-ta-ar-ma 
#tr.ts: ula itârma
#tr.en: will not return (on the decision) and

8. u3-la e-ra-ga-am 
#tr.ts: ula era(g)gam
#tr.en: will not raise a claim.

9. {disz}hi-il-lum _di-ku5_ babila2{ki} 
#tr.ts: ḫillum dayyān bābila
#tr.en: Ḫillum judge of Babylon,

10. 1(disz) _di-ku5_ zimbir{ki} 
#tr.ts: ištēn dayyān sippar
#tr.en: one judge from (lit. of) Sippar

11. u3 lukur {d}utu _di-ku5_ ga-gi-im 
#tr.ts: u nadīt šamaš dayyān gagîm
#tr.en: and (from ?) the nadītu(s) of šamaš, a judge of the cloister;

12. _mu_ {d}utu {d}amar-utu 
#tr.ts: nīš šamaš marduk
#tr.en: (by) the name of Šamaš, Marduk

13. u3 sa3-bi-um _in-pa3-de3_ 
#tr.ts: u ṣabium itamma
#tr.en: and Ṣabium, he swears.

14. ap-lu-sa3-a 
#tr.ts: aplu(s)sa
#tr.en: Her inheritance,

15. a#-sza-ar e-ra-mu 
#tr.ts: ašar erâmu
#tr.en: wherever she prefers,

16. i-na-di-in 
#tr.ts: ina(d)din
#tr.en: (Amat-šamas) may give.

@reverse 
