&P365177 = CT 08, pl. 14, Bu 1888-05-12, 223 
#atf: lang akk 
@tablet 
@obverse 
1. _1(esze3) 3(iku) GAN2 a-sza3 ab-sin2_ 
#tr.ts: ištēn ebel šalašat ikû šer’am
#tr.en: A cultivated field of 9 ikû

2. _a-gar3_ szu-na-ak-bu 
#tr.ts: nagûm šunakbu
#tr.en: in the Šunakbu irrigation district,

3. _a-sza3_ ip-qa2-tum 
#tr.ts: eqel ipqatum
#tr.en: the field of Ipqatum

4. _dumu_ {d}utu-li-me-er 
#tr.ts: mār šamaš-liwwir
#tr.en: son of Šamaš-liwwir,

5. _ki_ ip-qa2-tum _dumu_ {d}utu-li-me-er 
#tr.ts: itti ipqatum mār šamaš-liwwir
#tr.en: from Ipqatum son of Šamaš-liwwir,

6. be-el _a-sza3_ 
#tr.ts: bēl eqlim
#tr.en: the owner of the field,

7. {disz}ia-di-u2 su-tu-u2 
#tr.ts: yadiu sutû
#tr.en: Yadiu the sutean

8. _dumu_ ta-ak-ti 
#tr.ts: mār takti
#tr.en: son of Takti

9. _a-sza3_ a-na er-re-szu-tim 
#tr.ts: eqlam ana errēšūtim
#tr.en: the field in tenancy

10. a-na _gu2-un_ 
#tr.ts: ana biltim 
#tr.en: for rent 

11. a-na _mu 1(disz)-kam_ 
#tr.ts: ana ištēt šattim
#tr.en: for 1 year

12. _ib2-ta-e3_ 
#tr.ts: ušēṣi
#tr.en: has rented.

13. _u4 buru14-sze3_ 
#tr.ts: ina ūm ebūrim 
#tr.en: At harvest time,

@reverse 
1. _a-sza3_ pi2-i szu-ul-pi2-szu 
#tr.ts: eqlam pî šulpīšu
#tr.en: the field, according to its cultivated area,

2. i-sza-ad-da-du-ma 
#tr.ts: išaddadūma
#tr.en: they will measure and

3. _1(bur3) GAN2 1(disz)-e 8(asz) sze gur_ 
#tr.ts: ana ištēn būrim šamānat kur âm
#tr.en: 8 kor of barley per 1 bur (of field, according to)

4. _{gesz}ban2 {d}utu gu2-un a-sza3_ 
#tr.ts: sūt šamaš bilat eqlim
#tr.en: the sūtu-vessel of Šamaš, (as) rent of the field,

5. _i3-ag2-e_ 
#tr.ts: imaddad
#tr.en: he (Yadiu) will pay.

6. i-na li-ib-bu _gu2-un a-sza3_-szu 
#tr.ts: ina libbu bilat eqlīšu
#tr.en: Of the yield of his field,

7. _1(disz) gin2 ku3-babbar_ ma-hi-ir 
#tr.ts: ištēn šiqil kaspam maḫir
#tr.en: he received 1 shekel of silver.


$ single ruling 
8. _igi_ ARAD2-{d}utu _ugula gidri_
# Probably a scribal error for ARAD2-{d}amar-utu (Rivkah Harris, Ancient Sippar (1975) p. 99 n. 75)
#tr.ts: maḫar warad-šamaš akil ḫaṭṭātim
#tr.en: Before Warad-šamaš, colonel;

9. _igi_ ARAD2-e2-idim-an-na 
#tr.ts: maḫar warad-eidimanna
#tr.en: before Warad-eidimanna

10. _dumu_ ip-qa2-tum 
#tr.ts: mār ipqatum
#tr.en: son of Ipqatum;

11. _igi_ szu-mu-um-li-ib-szi _dumu_ i-na-pa-le-e-szu 
#tr.ts: maḫar šumum-libši mār ina-palê-šu
#tr.en: before Šumum-libši son of Ina-palê-šu.

$ single ruling 
12. _iti gu4#-si#-sa2! u4 1(disz)-kam_ 
#tr.ts: waraḫ ayyarim ūmam ištenum
#tr.en: The month of Ayyarum, the day 1,

13. _mu_ am-mi-s,a-du-qa2 _lugal-e [sipa zi sze-ga?] {d}utu [{d}]amar#-utu-[bi-da-ke4?]_ 
#tr.ts: šanat ammi-ṣaduqa šarrum rē'um kīnum šēmûm ša šamaš u marduk
#tr.en: the year: "Ammi-ṣaduqa the king, loyal and obedient shepherd of Šamaš and Marduk (remitted the debts).".

