&P365113 = CT 02, pl. 32, Bu 1891-05-09, 361 
#atf: lang akk 
@tablet 
@obverse 
1. _3(iku) GAN2 a-sza3 ab-sin2_ 
#tr.ts: šalāš ikû šer’am
#tr.en: A cultivated field of 3 ikû
2. _sza3 a-sza3_ ta-wi-ir-tim sza _dumu-mesz_ szu!(TE)-ge-esz 
#tr.ts: libbu eqlim tawirtim ša mārī šugeš
#tr.en: inside the irrigated land of Šugeš’s sons,
3. _a-gar3_ na-gu-u2 
#tr.ts: ugārim nagû(m)
#tr.en: (in) the meadow “Nagûm”
4. _bala-ri i7_ ir-ni-na 
#tr.ts: ebertim nār irnina
#tr.en: (on) the other side of the canal “Irnina”;
5. _a-sza3_ ri-isz-{d}marduk _dumu_ dumu-u4-2(u)-kam _dumu_ szu-ge-esz 
#tr.ts: eqel rīš-marduk mār mār-ešrîm mār šugeš
#tr.en: the field of Rīš-marduk son of Mār-ešrîm son of Šugeš,
6. _ki_ ri-isz-{d}marduk _dumu_ dumu-u4-2(u)-kam be-el _a-sza3_ 
#tr.ts: itti rīš-marduk mār mār-ešrîm bēl eqlim
#tr.en: from Rīš-marduk son of Mār-ešrîm, the owner of the field,
7. a-na qa2-be2-e a-ta-na-ah-i3-li2 
#tr.ts: ana qabê atanaḫ-ilī
#tr.en: on behalf of Atanaḫ-ilī
8. _dumu_ s,il2-li2-{d}utu 
#tr.ts: mār ṣilli-šamaš
#tr.en: son of Ṣilli-šamaš,
9. {disz}ab-du-isz-ta-ra su-ga-gu 
#tr.ts: abdu-ištar sugāgu(m)
#tr.en: Abdu-ištar the sugāgu-official
10. u3 ri-isz-{d}marduk be-el _a-sza3_ 
#tr.ts: u rīš-marduk bēl eqlim
#tr.en: and Rīš-marduk the owner of the field,
11. _a-sza3_ a-na er-re-szu-tim 
#tr.ts: eqlam ana errēšūtim
#tr.en: the field in tenancy,
12. a-na _gu2-un_ a-na _tab-ba_ 
#tr.ts: ana biltim ana tappîm
#tr.en: together (lit. as partners) for rent
13. a-na _mu 1(disz)-kam ib2-ta-e3_ 
#tr.ts: ana ištet šattim ušēṣū
#tr.en: have rented for 1 year.
14. a#-wi-lum ma-la a-wi-lim 
#tr.ts: awīlum mala awīlim
#tr.en: Each of them (in equal share),
15. ma-na-ah-tam a-na _a-sza3_-im 
#tr.ts: mānaḫtam ana eqlim
#tr.en: the expenses for the field
16. i-sza-ak-ka-nu 
#tr.ts: išakkanū
#tr.en: will put up.
@reverse
1. _u4 buru14-sze3_ 
#tr.ts: ina ūm ebūrim
#tr.en: At harvest time,
2. _a-sza3_ a-na pi2-i szu-ul-pi2-szu 
#tr.ts: eqlam ana pî šulpīšu
#tr.en: the field, according to its cultivated area,
3. i-sza-ad-da-du-ma 
#tr.ts: išaddadūma
#tr.en: they will measure and
4. _1(bur3) GAN2 1(disz)-e 8(asz) sze gur {gesz}ban2_ {d}utu 
#tr.ts: ana išten būr šamānat kur âm ina sūt šamaš
#tr.en: 18 kor of barley, (according to) the sūtu-vessel of Šamaš, per 1 bur (of field)
5. _gu2-un a-sza3 i3-ag2-e-mesz_ 
#tr.ts: bilat eqlim imaddadū
#tr.en: they will pay (as) rent of the field;
6. u3 ma-na-ah-ta-szu-nu i-ip-pa-lu-ma 
#tr.ts: u mānaḫtašunu ippalūma
#tr.en: then they will take compensation for their expenses and
7. _sze_-am ba-szi-a-am x x x x 
#tr.ts: âm bāšiam ...
#tr.en: the remaining barley ...
8. mi-it-ha-ri-isz i-zu-uz-zu 
#tr.ts: mitḫariš izuzzū
#tr.en: will divide equally.
9. _sza3 gu2-un a-sza3_-szu _igi-4(disz)-gal2 ku3-babbar_ ma-hi-ir 
#tr.ts: libbu bilat eqlīšu rabiat šiqil kaspam maḫir
#tr.en: From the rent of his field, (the owner) has received one fourth of shekel of silver.
$ single ruling
10. _igi_ a-ta-na-ah-i3-li2 _dumu_ s,il2-li2-{d}utu 
#tr.ts: maḫar atanaḫ-ilī mār ṣilli-šamaš
#tr.en: Before Atanaḫ-ilī, son of Ṣilli-šamaš;
11. _igi_ gi-mil-{d}marduk _dumu_ s,il2-li2-{d}utu 
#tr.ts: maḫar gimil-marduk mār ṣilli-šamaš
#tr.en: before Gimil-marduk, son of Ṣilli-šamaš;
12. _igi_ i3-li2-i-qi2-sza-am _dumu_ e-tel-pi4-{d}marduk 
#tr.ts: maḫar ilī-iqīšam mār etel-pî-marduk
#tr.en: before Ilī-iqīšam, son of Etel-pî-marduk;
13. _igi_ {d}suen!-e-ri-ba-am _dumu e2-dub-ba#-[a]_
#tr.ts: maḫar sîn-erībam mār bīt ṭuppi
#tr.en: before Sîn-erībam, the scribe.
$ single ruling 
14. _iti gu4-si-sa2 u4 3(disz)-kam_ 
#tr.ts: waraḫ ayyarim ūmam šalāštum
#tr.en: The month of Ayyarum, the day 3
15. _mu_ am-mi-s,a-du-qa2 _lugal-e {uruda#}ki-lugal!-gub-ba ib2-diri#-ga e2 mah e2-ni2-te-en-[du10-sze3] ki!-a bi2-ib2-us2-a_ 
#tr.ts: šattum ša ammi-ṣaduqa šarrum manzāzam ṣīram watram ina bītim ṣīrim enitendu iškunu
#tr.en: the year in which Ammi-ṣaduqa the king put in place a socle of bronze that is superb into Enitendu, the temple of the abundance.
@seal 1
$ (uninscribed) 
1. _kiszib3_ ab-du-isz-ta-ra 
#tr.ts: kunuk abdu-ištar
#tr.en: Seal of Abdu-ištar
