&P370437 = CT 08, pl. 10, Bu 1888-05-12, 158 
#atf: lang akk 
@tablet 
@obverse 
1. _1(esze3) 3(iku) GAN2 a-sza3 ab-sin2_ 
#tr.ts: ištēn ebel šalašat ikû šer’am
#tr.en: A cultivated field of 9 ikû

2. _a-gar3_ szu-na-ak-bu 
#tr.ts: nagûm šunakbu
#tr.en: in the Šunakbu irrigation district,

3. _a-sza3_ ip-qa2-tum _dumu_ {d}utu-li-me*-[er] 
#tr.ts: eqel ipqatum mār šamaš-liwwir
#tr.en: the field of Ipqatum son of Šamaš-liwwir,

4. _ki_ ip-qa2-tum _dumu_ {d}utu-li-me*-er 
# Tablet has ME, not PI as copied: coll. Woestenburg, November 1997
#tr.ts: itti ipqatum mār šamaš-liwwir
#tr.en: from Ipqatum son of Šamaš-liwwir,

5. be-el _a-sza3_ 
#tr.ts: bēl eqlim
#tr.en: the owner of the field,

6. a-na qa2-be2-e _aga-us2#_ ba-ab-tim 
#tr.ts: ana qabê rēdi babtim
#tr.en: upon the authorization of the ward's police,

7. {disz}ia-di-u2 su-tu-u2 
#tr.ts: yadiu sutû
#tr.en: Yadiu the sutean

8. _dumu_ ta-ak-ti 
#tr.ts: mār takti
#tr.en: son of Takti

9. _a-sza3_ a-na er-re-szu-tim 
#tr.ts: eqlam ana errēšūtim
#tr.en: the field in tenancy

10. a-na _gu2-un_ a-na _mu 1(disz)-kam_ 
#tr.ts: ana biltim ana ištēt šattim
#tr.en: for rent for 1 year

11. _ib2-ta-e3_ 
#tr.ts: ušēṣi
#tr.en: has rented.

12. _u4 buru14-sze3 a-sza3_ pi2-i szu-ul-pi2-szu 
#tr.ts: ina ūm ebūrim eqlam pî šulpīšu		
#tr.en: At harvest time, the field, according to its cultivated area,

13. i-sza-ad-da-du-ma 
#tr.ts: išaddadūma
#tr.en: they will measure and

@reverse 
1. _1(bur3) GAN2 1(disz)-e 8(asz) sze gur {gesz}ban2 {d}utu_ 
#tr.ts: ana ištēn būrim šamānat kur âm sūt šamaš
#tr.en: 8 kor of barley per 1 bur (of field, according to) the sūtu-vessel of Šamaš,

2. _gu2-un a-sza3 i3-ag2-e_ 
#tr.ts: bilat eqlim imaddad
#tr.en: he (Yadiu) will pay as rent of the field.

$ single ruling 
3. _igi_ ARAD2-{d}amar-utu _ugula gidri_ 
#tr.ts: maḫar warad-marduk akil ḫaṭṭātim
#tr.en: Before Warad-marduk, colonel;

4. _igi_ ARAD2-e2-idim-an-na 
#tr.ts: maḫar warad-eidimanna
#tr.en: before Warad-eidimanna

5. _dumu_ ip-qa2-tum 
#tr.ts: mār ipqatum
#tr.en: son of Ipqatum;

6. _igi_ szu-mu-um-li-ib-szi _dumu_ i-na-pa-le-e-szu 
#tr.ts: maḫar šumum-libši mār ina-palê-šu
#tr.en: before Šumum-libši son of Ina-palê-šu.

$ single ruling 
7. _iti gu4-si-sa2 u4 1(disz)-kam_ 
#tr.ts: waraḫ ayyarim ūmam ištenum
#tr.en: The month of Ayyarum, the day 1,

8. _mu_ am-mi-s,a-du-qa2 _lugal-e sipa zi sze-ga {d}utu {d}amar-utu-bi-da-ke4#_ 
#tr.ts: šanat ammi-ṣaduqa šarrum rē'um kīnum šēmûm ša šamaš u marduk
#tr.en: the year: "Ammi-ṣaduqa the king, loyal and obedient shepherd of Šamaš and Marduk (remitted the debts).".

