&P258484 = BE 06/1, 072 
#atf: lang akk 
@tablet 
@obverse 
1. _2/3(disz) gin2 ku3-babbar_ ka-an-kum 
#tr.ts: šinip šiqil kaspim kankum
#tr.en: A sealed document for 2/3 of shekel of silver,
2. _sza3 ku3-babbar su-si-ig_ 
#tr.ts: ina libbi kasap šusik
#tr.en: from the silver of the fellmonger
3. zimbir{ki} u3 na-we-e-szu 
#tr.ts: Sipparim u nawêšu
#tr.en: of Sippar and its pasture land,
4. sza _mu_ a-bi-e-szu-uh _lugal-e_ 
#tr.ts: ša šanat abi-ešuḫ šarrum
#tr.en: for the year “abi-ešuḫ the king
5. _i7 zubi_ a-bi-e-szu-uh 
#tr.ts: zā’ibam abi-ešuḫ
#tr.en: the canal (named) 'abi-ešuḫ'
6. _mi-ni-in-dun-na_ 
#tr.ts: iḫri
#tr.en: dug”.
7. _mu-kux(DU)_ e-t,e-rum 
#tr.ts: šūrubtim eṭerum
#tr.en: Delivered by Eṭerum
8. _dumu#_ ARAD-{d}suen 
#tr.ts: mār warad-sîn
#tr.en: son of Warad-sîn,
@reverse 
1. nam-ha-ar-ti 
#tr.ts: namḫarti
#tr.en: received by
2. {disz}{d}marduk-na-s,i-ir 
#tr.ts: marduk-nāṣir
#tr.en: Marduk-nāṣir
3. u3 {d}marduk-mu-ba-li2-it, 
#tr.ts: u marduk-muba(l)liṭ
#tr.en: and Marduk-muballiṭ
4. de-ki-i sza na-ka-rum _szu-i_ 
#tr.ts: dēkī ša nakarum gallābim
#tr.en: the summoners (under the responsability) of Nakarum the barber.
$ single ruling 
5. _iti gu4-si-<sa2> u4 1(u)-kam_ 
#tr.ts: waraḫ ayyarim ūmam ešret
#tr.en: The month of Ayyarum, the day 10,
6. _mu a-bi-e-szu-uh lugal-e bar2-bar2 ku3-sig17 ku3-babbar-bi-da-ke4_ 
#tr.ts: šanat abi-ešuḫ šarrum parakkī ša ḫurāṣim u kaspim
#tr.en: the year "Abi-ešuḫ the king (made) daises of gold and silver".

&P258499 = BE 06/1, 040 
#atf: lang akk 
@tablet 
@obverse 
1. _1(disz) {gesz}mar uruda_ 
#tr.ts: išten marrum ša erîm
#tr.en: 1 bronze spade,
2. _2(disz) {gesz}mar-HI_ 
# Foldi reads: -ha2, contra photo
#tr.ts: šinā marrū
#tr.en: 2 spades,
3. _2(disz) {gesz}u3-szub sig4 al-ur3-ra_ 
#tr.ts: šittā nalbanātum ša agurrim
#tr.en: 2 molds for (kiln-fired) bricks,
4. 2(disz) {gesz}me-sze-qum
#tr.ts: šinā mesēqū
#tr.en: 2 strickles,
5. _1(u) {gi}dupsik-hi-a_ 
#tr.ts: ešret tupšikkū
#tr.en: 10 hods
6. _nig2-szu_ ip-qa2-tum _dumu_ pa-hal-li-im 
#tr.ts: ša qāti ša ipqatum mār paḫallim
#tr.en: are the possessions (lit. in the hands) of Ipqatum son of Paḫallum
7. {disz}{d}iszkur-ma-an-szum 
#tr.ts: adad-manšum
#tr.en: (that) Adad-manšum
8. _dumu_ e-te-ia-tum 
#tr.ts: mār eteyatum
#tr.en: son of Eteyatum
@reverse 
1. ma#-hi-ir 
#tr.ts: maḫir
#tr.en: has received;
2. _e2-gal_ i-pa-al 
#tr.ts: ekallam i(p)pal
#tr.en: he will settle the palace.
3. _iti sig4-a u4 5(disz)-kam_ 
#tr.ts: waraḫ simānim ūmam ḫamšat
#tr.en: The month of Simānum, the day 5
4. _mu bad3 kar-{d}utu_ u3 ra#-pi2-qum 
#tr.ts: šanat dūr kār-šamaš u rapiqum
#tr.en: the year: “The walls of Kār-šamaš and Rapiqum”.
$ (1 or 2 uninscribed seals)

