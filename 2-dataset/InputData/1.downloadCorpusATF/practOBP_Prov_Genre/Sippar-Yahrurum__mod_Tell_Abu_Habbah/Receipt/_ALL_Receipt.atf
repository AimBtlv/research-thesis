&P510410 = BDHP 30
#atf: lang akk
@tablet
@obverse
1. _5(disz) gin2 ku3-babbar na4_ {d}utu
#tr.ts: ḫamsat šiqil kaspam aban šamaš
#tr.en: 5 shekels of silver according to the weight of Šamaš,

2. _sza3 sa10 1(asz) gu2-un siki hi-a_
#tr.ts: libbum šīm ištēt bilat šipātim
#tr.en: are part of the price of 1 talent of wool

3. sza _e2-gal_
#tr.ts: ša ekallim
#tr.en: of the palace,

4. _nig2-szu_ u2-tul2-esz18-dar a-bi _erin2-mesz_
#tr.ts: ša qāti utul-ištar abi ṣābi
#tr.en: that are under the responsability of Utul-ištar the official (and)

5. sza _mu_ am-mi-s,a-du-qa2 _lugal-e {uruda}ki-lugal-gub-ba i3-mah-a u3 ki-lugal-gub-ba kur didli-a_
#tr.ts: ša šanat ammi-ṣaduqa šarrum manzāz šarrim ṣīram u manzāz šarrim šadî
#tr.en: that, (in) the year: "Ammi-ṣaduqa the king (placed) a magnificent royal socle of copper and a royal socle (decorated with) mountains",

8. sza _ki_ isz-me-{d}suen _dumu_ {d}suen-be-el-ap-lim
#tr.ts: ša itti išme-sîn mār sîn-bēl-aplim
#tr.en: (lit. that) from Išme-sîn son of Sî-bēl-aplim

9. {disz}{d}marduk-mu-sza-lim {disz}dingir-szu-ib-ni
#tr.ts: marduk-musa(l)lim ilšu-ibni
#tr.en: Marduk-musallim, Ilšu-ibni

10. u3 _dumu-mesz_ nu-ur2-{d}utu
#tr.ts: u mārī nūr-šamaš
#tr.en: and Nūr-šamaš's sons

@reverse
1. im#-hu-ru
#tr.ts: imḫrū
#tr.en: received.

2. _mu-kux(DU)_
#tr.ts: šūrubti
#tr.en: Delivered (by)

3. {disz}{d}marduk-mu-sza-lim {disz}dingir-szu-ib-ni
#tr.ts: marduk-muša(l)lim ilšu-ibni
#tr.en: Marduk-musallim, Ilšu-ibni

4. u3 _dumu-mesz_ nu-ur2-{d}utu
#tr.ts: u māri nūr-šamaš
#tr.en: and Nūr-šamaš's sons;

5. nam-ha-ar-ti
#tr.ts: namḫarti(m)
#tr.en: received by

6. {disz}isz-me-{d}suen _dumu_ {d}suen-be-el-ap-lim
#tr.ts: išme-sîn mār sîn-bēl-aplim
#tr.en: Išme-sîn son of Sîn-bēl-aplim.

7. _igi_ szu-mu-um-li-ib-szi _dumu_ pir-hi-i3-li2-szu
#tr.ts: maḫar šumum-libši mār pir'i-ilīšu
#tr.en: Before Šumum-libsi son of Pir'i-ilīšu;

8. _igi_ be-el-szu-nu _dumu_ dingir-szu-ba-ni
#tr.ts: maḫar bēlšunu mār ilšu-bānī
#tr.en: before Bēlšunu son of Ilšu-bānī.

9. _iti szu-numun-a u4 1(u) 8(disz)-kam_
#tr.ts: waraḫ dumuzi ūmam šamāššeret
#tr.en: The month of Dumuzi, the day 18

10. _mu_ am-mi-s,a-du-qa2 _lugal-e alan-a-ni szu silim-ma (x) ab!-di-di in-ne-en!-ku4!-ra!
#tr.ts: šattum ša ammi-ṣaduqa šarrum ṣalamšu šulmam qābiam ušēribu
#tr.en: The year (in) which Ammi-ṣaduqa the king brought (into Emeteursag) a statue of himself uttering a greeting.

