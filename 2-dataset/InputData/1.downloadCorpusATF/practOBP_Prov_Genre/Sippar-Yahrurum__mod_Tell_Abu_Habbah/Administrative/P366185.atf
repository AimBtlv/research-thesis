12. [u3 i-ta {d}]suen#-i-qi2-sza-am _dumu_ {d}utu-kam u3 a-[sza3 lukur_ {d}utu]
#tr.ts: u itā sîn-iqīšam mār šamaš-kam u eqel nadīt šamaš
