&P366188 = CT 47, 65
#atf: lang akk
@tablet
@obverse
1. _ibila_ inim-{d}a-a _lukur_ {d}utu _dumu-munus_ sin-e-ri-ba-am
#tr.ts: aplūt awāt-ayya nadīt šamaš mārat sîn-erībam
#tr.en: (Concerning) the inheritance of Awāt-ayya nadītu of Šamaš daughter of Sîn-erībam,

2. {disz}be-le-su2-nu _lukur_ {d}utu _dumu-munus_ pa-le-e-{d}iszkur
#tr.ts: bēle(s)sunu nadīt šamaš mārat palê-adad
#tr.en: Bēlessunu nadītu of Šamaš daughter of Palê-adad

3. re-di-it wa-ar-ka-ti-sza
#tr.ts: rēdīt warkatīša
#tr.en: is the heiress of her legacy.

4. _1(bur3) GAN2 a-sza3_ i-na _a-gar3_ tu-ha-mu-um
#tr.ts: ištēn būr eqlum ina ugār tuḫamum
#tr.en: A field of 18 IKU in the Tuḫamum irrigation district

5. i-na ti-in-ni-ha-ra
#tr.ts: ina tinniḫara
#tr.en: at Tinniḫara,

6. i-ta _a-sza3#_ dingir-pi4-sza
#tr.ts: itā eqel annum-pīša
#tr.en: next to the field of Annum-pīša

7. u3 i-ta# [_a-sza3_] {d}nin-kar-ra-ak
#tr.ts: u itā eqel ninkarrak
#tr.en: and next to the field of Ninkarrak;

8. _1(esze3) 3(iku) GAN2# [a]-sza3#_ i-na hal-hal-la
#tr.ts: ištēn ebel šalāšat ikû eqlum ina ḫalḫalla
#tr.en: a field of 9 IKU at Ḫalḫalla

9. i-ta _a-sza3 dingir-szu-a-bu-szu
#tr.ts: itā eqel ilšu-abūšu
#tr.en: next to the field of Ilšu-abūšu

10. u3 i-ta _a-sza3#_ {d}suen-e-ri-ba-am
#tr.ts: u itā eqel sîn-erībam
#tr.en: and next to del field of Sîn-erībam;

11. _1(bur3) GAN2 {gesz}kiri6_ [...] i7-mah#
#tr.ts: ištēn būr kirûm ... maḫ
#tr.en: an orchard of 1 BUR on (?) the Maḫ canal

12. i-ta _{gesz}kiri6_ [sig-er-s,e-tim _dumu_ ni]-id#-nu-sza
#tr.ts: itā kiri ipqu-erṣetim mār nidnuša
#tr.en: next to the orchard of Ipqu-erṣetim son of Nidnuša;

13. _3(disz) 2/3(disz) sar e2 [ga2-gi4]-a{ki}_
#tr.ts: šalāšat u šinip mūšar bīt gagîm
#tr.en: a house of 220 shekels in (lit. of) the cloister;

14. _1(disz) geme2_ {d}iszkur-du#-[um-qi2 _1(disz) geme2_ pi]-ha-tum
#tr.ts: ištēt amtum adad-dumqi ištēt amtum piḫatum
#tr.en: 1 female slave (named) Adad-dumqi; 1 female slave (named) Piḫatum;

15. _1(disz) geme2 a-li2-a-[hi 3(disz) {na4}kinkin] dabin_
#tr.ts: ištēt amtum aliyaḫ šalāš eretûm ana tappinnim
#tr.en: 1 female slave (named) Aliyaḫ; 3 grindstones for coarse flour;

16. _2(disz) {na4}kinkin zi3-gu#_ [mi-im-ma an-ni]-im#
#tr.ts: šittā eretûm ana isqūqim mimma annîm
#tr.en: 2 grindstones for fine flour; all this

17. bu-szu-sza wa-ar-[ka-sa3 s,u2-lu-sza?]
#tr.ts: būšûša warkassa ṣullûša
#tr.en: her properties (and) her inherited possessions, her pin

18. sza i-na i-ga-ri-[im za-aq-pa-at?]
#tr.ts: ša ina igārim zaqpat
#tr.en: is the one stuck into the wall,

19. isz-tu pe2-e a-di _ku3-sig17#_ [sza inim-{d}a-a _lukur_ {d}utu _dumu-munus_] sin-eri-ba-am
#tr.ts: ištu pê adi ḫurāṣim ša awāt-ayya nadīt šamaš mārat sîn-erībam
#tr.en: everything is what Awāt-ayya nadītu of Šamaš daughter of Sîn-erībam,
# some text moved from previous line

20. a-na be-le-su2-nu _dumu-munus_ pa-le-e-{d}iszkur a-hi-sza id-di-nu
#tr.ts: ana bēle(s)sunu mārat palê-adad aḫīša iddinu
#tr.en: has given Bēlessunu, daughter of his brother Palê-adad.

21. a-di inim-{d}a-a _dumu-munus_ sin-eri-ba-am a-ha-at a-bi-sza
#tr.ts: adi awāt-ayya mārat sîn-erībam aḫat abīša
#tr.en: As long as Awāt-ayya daughter of Sîn-erībam, her aunt (lit. sister of her father),

22. ba-al-t,a-a-at
#tr.ts: balṭat
#tr.en: is alive,

@reverse
1. mi-im-mu-sza qa2-as-sa3 u3-ka-al
#tr.ts: mimmûša qāssa ukāl
#tr.en: she (lit. her hand) will hold her possessions;

2. isz-tu [inim-{d}a-a _lukur_ {d}utu a]-ha-at a-bi-sza
#tr.ts: ištu awāt-ayya nadīt šamaš aḫat abīša
#tr.en: after Awāt-ayya nadītu of Šamaš her aunt

3. a-na szi-[ma-ti-sza it]-ta-al-ku
#tr.ts: ana šimatīša ittalku
#tr.en: die (lit. go to her fate),

4. mi-im-[ma-sza pi2-i t,up-pi2-im an]-ni-im
#tr.ts: mimmaša pî ṭuppim annîm
#tr.en: her possessions, the content of this tablet,

5. sza [be-le-su2-nu _dumu-munus_ pa]-le#-e-{d}iszkur
#tr.ts: ša bēlessunu mārat palê-adad
#tr.en: will belong to Bēlessunu daughter of Palê-adad (and)

6. a-szar# [e-li-sza t,a3-bu ap-lu]-sa3 i-na-ad-di-in
#tr.ts: ašar elīša ṭābu aplu(s)sa inaddin
#tr.en: she will be able to give her legacy wherever is acceptable to her.

7. {disz}be-[le-su2-nu _dumu-munus_ pa-le]-{d}iszkur
#tr.ts: bēlessunu mārat palê-adad
#tr.en: (If) Bēlessunu daughter of Palê-adad

8. a-na inim#-[{d}a-a i-ra]-ga-mu
#tr.ts: ana awāt-ayya ira(g)gamu
#tr.en: make a claim against Awāt-ayya (and)

9. u2-ul! um-[mi-ia at-ti i]-qa2-ab-bi-ma
#tr.ts: ul ummīya atti iqabbīma
#tr.en: says: "You are not my mother!",

10. t,up-pi2 ap-[lu-ti-sza ...] i-he-ep-pe2 [x?]
#tr.ts: ṭuppi aplutīša ... i(ḫ)ḫeppê
#tr.en: the tablet of her inheritance ... will be destroyed.

11. a-di! in-bi#-[ki ba-al]-t,a#-at
#tr.ts: adi inbi-erṣetim balṭat
#tr.en: As long as Inbi-erṣetim is alive,

12. _mu#? 1(disz)-[kam ...] ku3-babbar 6(disz) sila3 i3-gesz_
#tr.ts: ištēn šattim ... kaspam šeššet qa šamnam
#tr.en: every year ... silver, 6 litres of oil

13. {disz}be-le-su2#-[nu _dumu]-munus_ pa-la-{d}iszkur i-na-ad-di-isz-szi-im#
#tr.ts: bēle(s)sunu mārat palā-adad inaddiššim
#tr.en: Bēlessunu daughter of Palê-adad will give her.

14. _mu_ {d}utu {d}[a]-a# {d}marduk u3 sa-am-su-i-lu-[na] _lugal_ it-mu-u2
#tr.ts: nīš šamaš ayya marduk u samsu-iluna šarrim itmû
#tr.en: (By) the life of Šamaš, Ayya, Mardulk and Samsu-iluna the king they have sworn.

$ single ruling
15. _igi_ ARAD-{d}suen _igi#_ sin-e-ri-ba-am _sanga {d}[utu-mesz_]
#tr.ts: maḫar warad-sîn maḫar sîn-erībam šangê šamaš
#tr.en: Before Warad-sîn (and) before Sîn-erībam, chief admninistrators of Šamaš(' temple);

16. _igi_ sig-an-nu-ni-tum _igi_ a-wi-il-isz8-tar2 _di-ku5-mesz_
#tr.ts: maḫar ipqu-annunītum maḫar awīl-ištar dayyānī
#tr.en: before Ipqu-annunītum (and) before Awīl-ištar, judges;

17. _igi_ {d}marduk-ni-szu _igi_ ra-pa-asz-s,il2-li2-e2-a _ugula lukur {d}utu-mesz_
#tr.ts: maḫar marduk-nīšu maḫar rapaš-ṣilli-ea aklī nadiāt šamaš
#tr.en: before Marduk-nīšu (and) before Rapaš-ṣilli-ea, overseers of Šamaš's nadītus;

18. _igi_  a-wi-il-{d}iszkur _igi_ lu-sza-lim-be-li2
#tr.ts: maḫar awīl-adad maḫar lū-šalim-bēlī
#tr.en: before Awīl-adad; before Lū-šalim-bēlī.

$ single ruling
19. _iti sze-sag11-ku5 u4 3(u)-kam_
#tr.ts: waraḫ addarim ūmam šalāšā
#tr.en: The month of Addarum, the day 30,

20. <_mu_> sa-am-su-i-lu-na _lugal_ alan {gesz}tukul sig3-ge_
#tr.ts: šanat samsu-iluna šarrum ṣalmam kakkam māḫiṣam
#tr.en: the year: "Samsu-iluna the king (made) a statue (representing himself) wielding a weapon.".

@envelope
@obverse
1. [_ibila_ inim-{d}a-a _lukur_ {d}utu _dumu-munus_ sin-e-ri-ba-am]
#tr.ts: aplūt awāt-ayya nadīt šamaš mārat sîn-erībam
#tr.en: (Concerning) the inheritance of Awāt-ayya nadītu of Šamaš daughter of Sîn-erībam,

2. [{disz}be-le-su2-nu _lukur_ {d}utu _dumu-munus_] pa-la-{d}iszkur
#tr.ts: bēle(s)sunu nadīt šamaš mārat palā-adad
#tr.en: Bēlessunu nadītu of Šamaš daughter of Palā-adad

3. re-di-it [wa]-ar#-ka-ti-sza
#tr.ts: rēdīt warkatīša
#tr.en: is the heiress of her legacy.

4. _1(bur3) GAN2 a-sza3 kankal_ i-na tu-ha-mu-um
#tr.ts: ištēn būr eqlum kankallum ina tuḫamum
#tr.en: A fallow field of 18 IKU in the Tuḫamum irrigation district

5. i-na ti-in-ni-a-ra
#tr.ts: ina tinniḫara
#tr.en: at Tinniḫara,

6. i-ta _a-sza3_ dingir-pi4-sza
#tr.ts: itā eqel annum-pīša
#tr.en: next to the field of Annum-pīša

7. u3 i-ta _a-sza3_ {d}nin-i3-si-in-na
#tr.ts: u itā eqel nin-isinna
#tr.en: and next to the field of Nin-isinna;

8. _1(esze3) 3(iku) GAN2 a-sza3 kankal_ i-na hal-hal-la{ki}
#tr.ts: ištēn ebel šalāšat ikû eqlum kankallum ina ḫalḫalla
#tr.en: a fallow field of 9 IKU at Ḫalḫalla

9. i-ta _a-sza3 dingir-szu-a-bu-szu
#tr.ts: itā eqel ilšu-abūšu
#tr.en: next to the field of Ilšu-abūšu

10. u3 i-ta _a-sza3_ {d}suen-e-ri-ba-am
#tr.ts: u itā eqel sîn-erībam
#tr.en: and next to del field of Sîn-erībam;

11. _1(bur3) GAN2 {gesz}kiri6_ i-na i7-mah
#tr.ts: ištēn būr kirûm ina maḫ
#tr.en: an orchard of 1 BUR on the Maḫ canal

12. i-ta _{gesz#}[kiri6_] sig-er-s,e-tim _dumu_ ni-id-nu-sza
#tr.ts: itā kiri ipqu-erṣetim mār nidnuša
#tr.en: next to the orchard of Ipqu-erṣetim son of Nidnuša;

13. _3(disz) 2/3(disz) sar e2 ga2-gi-a{ki}_
#tr.ts: šalāšat u šinip mūšar bīt gagîm
#tr.en: a house of 220 shekels in the cloister;

14. _1(disz) geme2_ {d}iszkur-du-um-qi2 _1(disz) geme2_ pi2-a-tum
#tr.ts: ištēt amtum adad-dumqi ištēt amtum pi(ḫ)atum
#tr.en: 1 female slave (named) Adad-dumqi; 1 female slave (named) Piḫatum;

15. _1(disz) geme2 a-li2-a-hi 3(disz) {na4}kinkin zi3-gu_
#tr.ts: ištēt amtum aliyaḫ šalāš eretûm ana isqūqim
#tr.en: 1 female slave (named) Aliyaḫ; 3 grindstones for fine flour;

16. _2(disz) {na4}kinkin dabin_ mi-im-ma an-ni-im
#tr.ts: šittā eretûm ana tappinnim mimma annîm
#tr.en: 2 grindstones for coarse flour; all of this are

17. bu-szu-sza wa-ar-ka-sa3 s,u2-lu-sza i-ga-ri-im
#tr.ts: būšūša warkassa ṣu(l)lûša ša igārim
#tr.en: her properties (and) her inherited possessions; her pin is the one (stuck into) the wall.

18. isz-tu pe2-e a-di _ku3-sig17_ sza inim-{d}a-a _lukur_ {d}utu
#tr.ts: ištu pê adi ḫurāṣim ša awāt-ayya nadīt šamaš
#tr.en: Everything of Awāt-ayya nadītu of Šamaš

19. _dumu-munus_ {d}suen-e-ri-ba-am a-ha-at a-bi-sza
#tr.ts: mārat sîn-erībam aḫat abīša
#tr.en: daughter of Sîn-erībam, her aunt,

20. sza be-le-su2-nu _lukur {d}utu dumu-munus_ pa-la-{d}iszkur a-hi-sza
#tr.ts: ša bēle(s)sunu nadīt šamaš mārat palā-adad aḫīša
#tr.en: belongs to Bēlessunu, nadītu of Šamaš, daughter of Palā-adad her brother.

21. a-di inim-{d}a-a _dumu-munus_ {d}suen-e-ri-ba-am
#tr.ts: adi awāt-ayya mārat sîn-erībam
#tr.en: As long as Awāt-ayya daughter of Sîn-erībam,

22. a-ha-at a-bi-sza ba-al-t,a-a-at
#tr.ts: aḫat abīša balṭat
#tr.en: her aunt, is alive,

23. mi-im-mu-sza qa2-as-sa3 u3-ka-a-al
#tr.ts: mimmûša qāssa ukāl
#tr.en: she will hold her possessions;

24. isz-tu inim-{d}a-a _lukur_ {d}utu _dumu-munus_ {d}suen-e-ri-ba-am
#tr.ts: ištu awāt-ayya nadīt šamaš mārat sîn-erībam
#tr.en: after Awāt-ayya nadītu of Šamaš daughter of Sîn-erībam,

25. a-ha-at a-bi-sza
#tr.ts: aḫat abīša
#tr.en: her aunt,

26. a-na szi-ma-ti-sza it-ta-al-ku
#tr.ts: ana šimatīša ittalku
#tr.en: die,

27. mi-im-ma-sza pi2-i t,up-pi2-im an-ni-im
#tr.ts: mimmaša pî ṭuppim annîm
#tr.en: her possessions, the content of this tablet,

28. sza be-le-su2-nu _dumu-munus_ pa-la-{d}iszkur a-hi-sza
#tr.ts: ša bēlessunu mārat palā-adad aḫīša
#tr.en: will belong to Bēlessunu daughter of Palā-adad her brother (and)

29. a-szar e-li-sza t,a3-bu
#tr.ts: ašar elīša ṭābu
#tr.en: wherever is acceptable to her

@reverse
1. ap-lu-sa3 i-na-ad-di-in
#tr.ts: aplu(s)sa inaddin
