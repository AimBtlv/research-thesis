&P370426 = CT 08, pl. 02, Bu 1891-05-09, 0747 
#atf: lang akk 
@tablet 
@obverse 
1. _1(u) 6(disz) ma-na ku3-babbar_ 
#tr.ts: šeššeret manā kaspum
#tr.en: 16 minas of silver

