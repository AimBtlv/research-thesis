1. qa2-du _sze-sag11-ku5_ sza ARAD2-i3-li2-szu _sipa_ 
#tr.ts: qadu eṣēdim ša warad-ilīšu rē’îm
#tr.en: Pertaining to the harvest of Warad-ilī the shephard:

$ single ruling 
2. _1(disz) gin2 ku3-babbar_ a-wi-il-ia 
#tr.ts: ištēn šiqil kaspum awīlya
#tr.en: 1 shekel of silver (to) Awīlya;

3. _1(disz) gin2 ku3-babbar_ ha-bil-a-hi 
#tr.ts: ištēn šiqil kaspum ḫabil-aḫī
#tr.en: 1 shekel of silver (to) Ḫabil-aḫī;

4. _1(disz) gin2 ku3-babbar_ {d}er3-ra-na-s,i-ir 
#tr.ts: ištēn šiqil kaspum erra-nāṣir
#tr.en: 1 shekel of silver (to) Erra-nāṣir;

5. _1(disz) gin2 ku3-babbar_ i-din-{d}amar-utu ka-ka-bu 
#tr.ts: ištēn šiqil kaspum i(d)din-amurru ka(k)kabu(m)
#tr.en: 1 shekel of silver (to) Iddin-amurru, kakkabum (?);

6. _1(disz) gin2 ku3-babbar_ tu-un-na-tum 
#tr.ts: ištēn šiqil kaspum tunnatum
#tr.en: 1 shekel of silver (to) Tunnatum;

7. _1(disz) gin2 ku3-babbar_ ta-ri-bu-um _dumu_ ri!-ba-tum 
#tr.ts: ištēn šiqil kaspum tarībum mār ribatum
#tr.en: 1 shekel of silver (to) Tarībum son of Ribatum;

8. _1(disz) gin2 ku3-babbar_ ARAD2-{d}i-ba-ri 
#tr.ts: ištēn šiqil kaspum warad-ibari
#tr.en: 1 shekel of silver (to) Warad-ibari;

9. _1/2(disz) gin2 ku3-babbar_ id-da-tum _muhaldim_ 
#tr.ts: mišil šiqil kaspum iddatum nuḫatimmum
#tr.en: half a shekel of silver (to) Iddatum, the cook;

10. _1(disz) gin2 ku3-babbar_ ARAD2-{d}a-ba-a 
#tr.ts: ištēn šiqil kaspum warad-abaya
#tr.en: 1 shekel of silver (to) Warad-abaya;

11. _1(disz) gin2 ku3-babbar_ dumu-munus-{d}utu 
#tr.ts: ištēn šiqil kaspum mārat-šamaš
#tr.en: 1 shekel of silver (to) Mārat-šamaš;

12. _1(disz) gin2 ku3-babbar_ e-ze-zi-isz8-tar2-ra-bi 
#tr.ts: ištēn šiqil kaspum ezēzi-ištar-rabi
#tr.en: 1 shekel of silver (to) Ezēzi-ištar-rabi;

13. _1(disz) gin2 ku3-babbar_ i3-li2-e-mu-qi2 a-hu-szu 
#tr.ts: ištēn šiqil kaspum ilī-emūqī aḫūšu
#tr.en: 1 shekel of silver (to) Ilī-emūqī his brother;

14. _1(disz) gin2 ku3-babbar_ ta-ri-bu-um KA#?-[x] 
#tr.ts: ištēn šiqil kaspum tarībum ...
#tr.en: 1 shekel of silver (to) Tarībum ...;

