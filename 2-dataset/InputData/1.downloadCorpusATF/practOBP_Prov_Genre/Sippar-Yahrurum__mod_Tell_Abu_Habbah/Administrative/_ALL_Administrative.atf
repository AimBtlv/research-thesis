&P257612 = PBS 08/2, 183 
#atf: lang akk 
@tablet 
@obverse 
1. bi-ib-lu sza a-na inim-{d}a-a 
#tr.ts: biblu(m) ša ana awat-ayya
#tr.en: Betrothal gift that for Awat-ayya
2. u3 dumu-ki _dumu-mesz_ ARAD-{d}er3-ra il-li-ku 
#tr.ts: u mār-erṣetim mārī warad-erra illeqû
#tr.en: and Mār-erṣetim, sons of Warad-erra, was received.
3. a-na _u4 3(disz)-kam_ si-bu-ut sza-at-tim 
#tr.ts: ana šalāšat ūmī sibūt šattim
#tr.en: For the three days of the (festival of) "sibūt šatti"
4. 1(disz) _uzu-ur2_ u3 1(disz) ka-ap-tu-ku-u2 
#tr.ts: ištēn pēmum u ištēn kaptu(k)kû(m)
#tr.en: one thigh-cut of meat and one kaptukkû-vessel,
5. _2(u) sze ku3-babbar_-szu-nu 
#tr.ts: ešrā uṭṭētum kasapšunu
#tr.en: 20 grains (of silver) is their value;
6. _u4_-um si-bu-ut sza-at-tim 
#tr.ts: ūm sibūt šattim
#tr.en: the (first) day of the "sibūt šatti" (festival)
7. 2(disz) _dug_ ka-ap-tu-ku-u2 1(disz) _uzu_ sza-sza-al-lu sza _gu4_ 
#tr.ts: šinā kaptu(k)kū ištēn šašallu(m) ša alpim
#tr.en: two kaptukkû-vessels, one piece of meat from the neck tendons of an ox,
8. 1(disz) _uzu_ i-mi-it-tum sza _udu-nita2_ 
#tr.ts: ištēt imittum ša immerim
#tr.en: one shoulder-cut (of meat) of a sheep,
9. _1/3(disz) gin2 ku3-babbar_-szu-nu 
#tr.ts: šaluš šiqlum kasapšunu
#tr.en: 1/3 shekel (of silver) is their value;
10. 1(disz) _dug_ hu-bu-un-nu sza _1/3(disz) sila3 1(u) 5(disz) sze ku3-babbar_-szu 
#tr.ts: ištēn ḫubunnu(m) ša šaluš qûm ḫamiššeret uṭṭētum kasapšu
#tr.en: one ḫubunnum-bowl of 1/3 liter capacity, 15 grains (of silver) is its value.
11. isz!-tu i-na li-ib-bu ma-tim a-tu-ra-am 
#tr.ts: ištu ina libbu mātim atūram
#tr.en: After I returned from the hinterland,
12. 1(u) _ku6 hi-a_ 3(disz) _dug_ ka-ap-tu-ku-u2 
#tr.ts: ešret nūnū šalāšat kaptu(k)kū
#tr.en: ten fishes, three kaptukkû-vessels,
13. _1(ban2) zi3 sag 1/3(disz) gin2 2(u) 7(disz) sze ku3-babbar_-szu-nu 
#tr.ts: ištēt sât qēmum rēštûm šaluš šiqlum ešrā u sebe uṭṭētum kasapšunu
#tr.en: 1 seah of first-quality flour, 87 grains (of silver) is their value;
14. _u4_-um szi-im-tim sza na-di-a-tim 
#tr.ts: ūm šīmtim ša nadiātim
#tr.en: the memorial day of the nadītu's
15. _igi-4(disz)-gal2 ku3-babbar_ sza-sza-al-lu sza _gu4_ 
#tr.ts: rabiat kaspim šašallū ša alpim
#tr.en: 1/4 (shekel) of silver for the neck tendons of an ox
16. u3 ni-si-ih i-mi-tim# sza _gu4_ 
#tr.ts: u nisiḫ imi(t)tim ša alpim
#tr.en: and a shoulder cut (of meat) of an ox,
17. _3(disz) sze-dib#?-ba{sar}_
#tr.ts: šalāš šediba
#tr.en: three šediba's (a plant ?),
18. _1/3(disz) gin2 8(disz) sze ku3-babbar_-szu-nu 
#tr.ts: šaluš šiqlum šamāne uṭṭētum kasapšunu
#tr.en: 68 grains (of silver) is their value;
19. _u4_-um# _iti# ab-e3-a_ sza na!-di!-a-tim 
#tr.ts: ūm waraḫ ṭebētim ša nadiātim
#tr.en: the nadītum's day of the month of Ṭebētum
20. _1/3(disz) gin2 ku3-babbar_ a-na szi-ka-ri 
#tr.ts: šaluš šiqil kaspum ana šikari(m)
#tr.en: 1/3 shekel of silver for the beer
21. sza s,u2-ha-ra-tu-sza isz-ti-a 
#tr.ts: ša ṣuḫārātūša ištiā
#tr.en: that her servant girls drank.
@obverse
1. 3(disz) _dug_ ka-ap-tu-ku-u2 
#tr.ts: šalāšat kaptu(k)kū
#tr.en: three kaptukkû-vessels,
2. 2(disz) _ku6 hi-a_ 
#tr.ts: šinā nūnū
#tr.en: two fishes,
3. 1(disz) _dug_ hu-bu-un-nu sza 1(disz) _sila3_ 
#tr.ts: ištēn ḫubunnu(m) ša ištēn qûm
#tr.en: one ḫubunnu-bowl of 1 liter capacity,
4. _1/2(disz) gin2 ku3-babbar_-szu-nu 
#tr.ts: mišil šiqlum kasapšunu
#tr.en: 1/2 shekel (of silver) is their value,
5. _u4_-um s,u2-ha-ar-tum i-ru-ba-am 
#tr.ts: ūm ṣuḫārtum īrubam
#tr.en: when the girl entered (the cloister);
6. _1(disz) gin2 ku3-babbar_ ne2-be2-hu-um 
#tr.ts: ištēn šiqil kaspum nēbeḫum
#tr.en: 1 shekel of silver is the payment
7. a-na dumu-er-s,e-tim _dumu_ ARAD2-{d}er3-ra a-bi-sza 
#tr.ts: ana mār-erṣetim mār warad-erra abīša
#tr.en: to Mār-erṣetim, son of Warad-erra her father;
8. _1(disz) gin2 ku3-babbar_ sza 2(disz) un-qa2-tim 
#tr.ts: ištēn šiqil kaspum ša šittā unqātim
#tr.en: 1 shekel of silver for two rings
9. a-na inim-{d}a-a _dumu-munus_ ARAD2-{d}er3-ra 
#tr.ts: ana awat-ayya mārat warad-erra
#tr.en: to Awat-ayya, daughter of Warad-erra;
10. _1(ban2)# zi3 sag 5(disz) sila3# dabin 4(disz) dug_ ka-al-lu 
#tr.ts: ištēt sât qēmum rēštûm, ḫamšat qa tappinnum erbet kallū
#tr.en: 1 seah of first-quality flour, 5 liters of coarse flour, four bowls,
11. [n] 4(disz)# _dug_ ka-ap#-tu-ku-u2 
#tr.ts: n erbet kaptu(k)kū
#tr.en: n + 4 kaptukkû-vessels,
12. 1(disz)# _uzu_ ni-ik#-su-um sza _szah_ 
#tr.ts: ištēn niksum ša šaḫîm
#tr.en: one cut of meat of a pig
13. sza a-na ga-gi-im i-ru-bu 
#tr.ts: ša ana gagim īrubū
#tr.en: which entered the cloister,
14. _igi!-4(disz)?-gal2 ku3-babbar_-szu-nu 
#tr.ts: rabiat kasapšunu
#tr.en: 1/4 (shekel of silver) is their value,
15. sza a-na inim-{d}a-a _dumu-munus_ ARAD2-{d}er3-ra i-ru-bu 
#tr.ts: ša ana awat-ayya mārat warad-erra īrubū
#tr.en: which entered for Awat-ayya, daughter of Warad-erra;
16. _1(ban2) zi3 sag 5(disz) sila3 dabin 4(disz) dug_ ka-al-lu 
#tr.ts: ištēt sât qēmum rēštûm ḫamšat qa tappinnum erbet kallū
#tr.en: 1 seah of first-quality flour, 5 liters of coarse flour, four bowls,
17. 1(disz) _dug_ ka-ap-tu-ku-u2 sza a-na dumu-ki _dumu_ ARAD2-{d}er3-ra 
#tr.ts: ištēn kaptu(k)kû(m) ša ana mār-erṣetim mār warad-erra
#tr.en: one kaptukkû-vessel which are for Mār-erṣetim son of Warad-erra,
18. _2(u) sze ku3-babbar_-szu-nu 
#tr.ts: ešrā uṭṭētum kasapšunu
#tr.en: 20 grains (of silver) is their value;
19. _1(disz) sila3 i3 szu-ur2-man_ i-na e-ri-ib ge-ri-szu 
#tr.ts: ištēn qa šaman šurmēni ina erib gi(r)rīšu
#tr.en: 1 liter of cypress oil upon the arrival of his caravan,
20. _igi-5(disz)-gal2 ku3-babbar_-szu 
#tr.ts: ḫamušti kasapšu
#tr.en: 1/5 (shekel of silver) is its value;
21. _szunigin 4(disz) 2/3(disz) gin2 1(u) 5(disz) sze ku3-babbar_ 
#tr.ts: napḫarum erbet u šinip šiqil ḫamiššeret uṭṭet kaspum
#tr.en: total: 4 and 2/3 shekels (and) 15 grains (= 855 grains) of silver.
