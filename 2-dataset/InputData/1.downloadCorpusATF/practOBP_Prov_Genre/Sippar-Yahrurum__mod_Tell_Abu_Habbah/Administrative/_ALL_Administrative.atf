2. _1(u) 5(disz) gin2_ li-pi2-it-{d}iszkur _dumu_ pir-hi-i3-li2-szu 
#tr.ts: ḫamiššeret šiqlū lipit-adad mār pirḫi-ilīšu
#tr.en: 15 shekels (from) Lipit-adad son of Piḫri-ilīšu;

3. _2(disz) gin2_ dingir-szu-ba-ni _dumu_ ip-qa2-tum 
#tr.ts: šinā šiqlū ilšu-bānī mār ipqatum
#tr.en: 2 shekels (from) Ilšū-bānī son of Ipqatum;

4. _3(disz) gin2_ dingir-szu-ba-ni _dumu_ szu-mi-esz18-dar 
#tr.ts: šalāšat šiqlū ilšu-bānī mār šumī-ištar
#tr.en: 3 shekels (from) Ilšu-bānī son of Šumī-ištar;

5. _2(disz) 1/2(disz) gin2_ ta-ri-bu-sza _dumu_ i-bi-{d}utu 
#tr.ts: šinā u mišil šiqlū tarībuša mār i(b)bi-šamaš
#tr.en: 2 and a half shekels (from) Tarībuša son of Ibbi-šamaš;

6. _1(disz) gin2_ e-t,i-rum _dumu_ dingir-szu-na-s,ir 
#tr.ts: ištēn šiqlum eṭirum mār ilšu-nāṣir
#tr.en: 1 shekel (from) Eṭirum son of Ilšu-nāṣir;

7. _1(disz) 1/2(disz) gin2_ ib-ni-{d}marduk _dumu_ dingir-szu-ba-ni 
#tr.ts: ištēn u mišil šiqlū ibni-marduk mār ilšu-bānī
#tr.en: 1 and a half shekels (from) Ibni-marduk son of Ilšu-bānī;

8. _7(disz) gin2 dumu-mesz_ dingir-szu-ba-ni 
#tr.ts: sebet šiqlū mārī ilšu-bānī
#tr.en: 7 shekels (from) Ilšu-bānī’s sons;

$ single ruling 
9. _2/3(disz) ma-na 7(disz) gin2 ku3-babbar_ 
#tr.ts: šinip manā sebet šiqil kaspum
#tr.en: (total:) 47 shekels (lit. 2/3 of mina and 7 shekels) of silver,

10. _sza3 ku3-babbar sa10 siki e2_ {d}utu 
#tr.ts: libbum kaspim šīm šipāt bīt šamaš
#tr.en: part of the silver, price of the wool of the Šamaš's temple

11. sza a-na _sa10 4(disz) gu4 sza3-gu4_ 
#tr.ts: ša ana šâmim erbet alpī kullizim
#tr.en: which, to buy 4 plow oxen (lit. oxen of the ox-driver)

12. a-na _ensi2-mesz a-sza3_ {d}utu 
#tr.ts: ana iššakkī eqel šamaš
#tr.en: for the iššakku-farmers of the Šamaš’s field,

13. _nig2 szu!_ {d}suen-a-ha-am-i-din-nam 
#tr.ts: būš sîn-aḫam-i(d)dinam
#tr.en: under the responsability of Sîn-aḫam-iddinam (and)

14. a-na qa2-be2-e ib-ni-{d}marduk 
#tr.ts: ana qabê ibni-marduk
#tr.en: upon the authorization of Ibni-marduk

15. _sza13-dub-ba_ RI? 
#tr.ts: šandabakkim ...
#tr.en: the chief accountant ...,

@reverse 
1. in-na-ad-nu-ma 
#tr.ts: innadnūma
#tr.en: has been given and

2. a-na dingir-szu-ib-ni _ugula dam-gar3-mesz_ 
#tr.ts: ana ilšu-ibni akil tamkarī
#tr.en: to Ilšu-ibni the overseer of the merchants

3. in-na-ad-nu 
#tr.ts: innadnu
#tr.en: has been given.

$ single ruling 
4. _giri3_ dingir-szu-ib-ni _ugula dam-gar3-mesz_ 
#tr.ts: šēp ilšu-ibni akil tamkarī
#tr.en: Through Ilšu-ibni the overseer of the merchants

5. u3 _di-ku5-mesz_ zimbir{ki} 
#tr.ts: u dayyānī sippir
#tr.en: and the judges of Sippar.

$ blank space 
