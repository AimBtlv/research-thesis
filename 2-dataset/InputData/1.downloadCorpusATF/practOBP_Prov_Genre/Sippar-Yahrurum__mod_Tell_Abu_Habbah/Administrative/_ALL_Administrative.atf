#tr.ts: šamāššeret manā kaspum
#tr.en: (total:) 18 minas of silver,

12. sza# [i]-na# _1(disz) [ma-na-e_ ... ma-ah-ru] 
#tr.ts: ša ina ištēn manā ... maḫru
