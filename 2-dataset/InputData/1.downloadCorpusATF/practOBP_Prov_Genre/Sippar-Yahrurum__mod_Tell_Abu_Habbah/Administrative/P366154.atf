&P366154 = CT 47, 12 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _1(bur3) GAN2 a-sza3_ sza ia-[gu]-da#-nim 
#tr.ts: ana ištēn būr eqlim ša yagudanim
#tr.en: Concerning the field of 1 BUR in Yagudanum,

2. i-ta {d}suen-ba-ni-i 
#tr.ts: itā sîn-bānī
#tr.en: next to (the field of) Sîn-bānī

3. u3 i-ta ia-hi-dingir 
#tr.ts: u itā yaḫī-ilum
#tr.en: and next to (the field of) Yaḫī-ilum, (and)

4. _2/3(disz) sar e2 du3-a_ sza ga-gi-im 
#tr.ts: šinip mūšar bītim epšim ša gagîm
#tr.en: the built house plot of 40 shekels in the cloister,

5. {disz}ia-ar-bi-dingir 
#tr.ts: yarbi-ēl
#tr.en: Yarbi-ēl

6. a-na ha-li-ia-tum _lukur {d}utu_ 
#tr.ts: ana ḫaliyatum nadīt šamaš
#tr.en: against Ḫaliyatum nadītu of Šamaš

7. ir-gu-um-ma 
#tr.ts: irgumma
#tr.en: raised a claim.

8. {disz}a-wi-il-isz8-tar2 ra-bi-<a>-nu 
#tr.ts: awīl-ištar rabiānu(m)
#tr.en: Awīl-ištar the mayor

9. u3 _di-ku5-mesz_ zimbir(|UD.KIB.NUN.NA|){ki} 
#tr.ts: u dayyānū sippir
#tr.en: and the judges of Sippar

10. i-na _e2 {d}utu_ di-nam
#tr.ts: ina bīt šmamš dīnam
#tr.en: in the temple of Šamaš a trial

11. u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: ušāḫizūšunūtīma
#tr.en: granted them and

12. {disz}ha-li-ia-tum 
#tr.ts: ḫaliyatum
#tr.en: Ḫaliyatum,

13. a-na ni-isz {d}a-a be-el-ti-sza 
#tr.ts: ana nīš ayya bēltīša
#tr.en: to (make her swear by) the life of Ayya her mistress,

14. i-di-nu-ma 
#tr.ts: i(d)dinūma
#tr.en: they handed over;

15. i-na ba-ab ni-isz _dingir_ 
#tr.ts: ina bāb nīš ilim
#tr.en: at the gate of the oath for the god

16. im-ta-ag-ru-nim-ma 
#tr.ts: imtagrūnimma
#tr.en: they agreed with each other and

17. _dub_ la ra-ga-mi-im 
#tr.ts: ṭuppi la ragamim
#tr.en: a no-claim deed

18. i-t,u2-bi-szu-ma 
#tr.ts: iṭūbīšūma
#tr.en: of his own free will

19. i-zi-ib
#tr.ts: īzib
#tr.en: he made out.

20. u2-ul i-ta-ar-ma 
#tr.ts: ul itârma
#tr.en: (That) again

@reverse 
1. {disz}ia-ar-bi-dingir 
#tr.ts: yarbi-ēl
#tr.en: Yarbi-ēl,

2. {disz}geme2-{d}utu {disz}i-zi-za-re-e 
#tr.ts: amat-šamaš izizarê
#tr.en: Amat-šamaš, Izizarê

3. u3 ma-nu-um a-na ha-li-ia-tum 
#tr.ts: u ma(n)nûm ana ḫaliyatum
#tr.en: and Mannûm, against Ḫaliyatum

4. u2-ul i-ra-<ga>-mu 
#tr.ts: ul ira(g)gamū
#tr.en: will not rise a claim,

5. _mu_ {d}utu {d}a-a {d}amar-utu u3 {d}suen-mu-ba-li2-it, 
#tr.ts: nīš šamaš ayya marduk u sîn-muba(l)liṭ
#tr.en: (by) the life of Šamaš, Ayya, Marduk and Sîn-muballiṭ

6. _in-pa3-de3-mesz_ 
#tr.ts: itmû
#tr.en: they swore.

$ single ruling 
7. _igi_ {d}suen-i-qi2-sza-am _dumu_ inim-{d}utu 
#tr.ts: maḫar sîn-iqīšam mār awāt-šamaš
#tr.en: Before Sîn-iqīšam son of Awāt-šamaš;

8. _igi_ lu2-{d}nanna _dumu_ isz-me-{d}suen 
#tr.ts: maḫar awīl-nanna mār išme-sîn
#tr.en: before Awīl-nanna son of Išme-sîn;

9. _igi_ i-din-dingir _dumu_ a-wi-il-dingir 
#tr.ts: maḫar i(d)din-ilī mār awīl-ilī
#tr.en: before Iddin-ilī son of Awīl-ilī;

10. _igi_ {d}suen-i-qi2-sza-am _dumu_ {d}utu-zi-mu 
#tr.ts: maḫar sîn-iqīšam mār šamaš-zimu
#tr.en: before Sîn-iqīšam son of Šamaš-zimu;

11. _igi_ u-bar-{d}utu _dumu_ e-la-li 
#tr.ts: maḫar ubār-šamaš mār elali
#tr.en: before Ubār-šamaš son of Elali;

12. _igi_ {d}nin-szubur-ma-an-szum2 _ugula lukur {d}utu_ 
#tr.ts: maḫar ilabrat-iddinam akil nadīt šamaš
#tr.en: before Ilabrat-iddinam overseer of the nadītu(s) of Šamaš;

13. _igi_ {d}utu-ta-ia-ar 
#tr.ts: maḫar šamaš-tayyār
#tr.en: before Šamaš-tayyār;

14. _igi_ ka-lu-mu-um 
#tr.ts: maḫar kalūmum
#tr.en: before Kalūmum;

15. _igi_ li-bu-ra-am 
#tr.ts: maḫar libū(r)ram
#tr.en: before Libūrram;

16. _igi_ {d}utu-tab-ba-e 
#tr.ts: maḫar šamaš-tappê
#tr.en: before Šamaš-tappê;

17. _igi_ i-zi-za-re-e 
#tr.ts: maḫar izizarê
#tr.en: before Izizarê

18. _dumu_ im-gur-{d}suen 
#tr.ts: mār imgur-sîn
#tr.en: son of Imgur-sîn.

