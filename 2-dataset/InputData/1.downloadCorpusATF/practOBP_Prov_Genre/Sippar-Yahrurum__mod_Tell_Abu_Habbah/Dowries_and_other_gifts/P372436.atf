&P372436 = VS 08, 015 & 016
#atf: lang akk
@tablet
@obverse
1. _1(disz) sag-geme2_ mu-ti-ba-asz-ti _mu-ni_
#tr.ts: ištēt amtam mutī-bāštī šumša
#tr.en: 1 female slave, Mutī-bāštī is her name,

2. {disz}{d}suen-pi2-la-ah
#tr.ts: sîn-pilaḫ
#tr.en: Sîn-pilaḫ

3. a-na sza-ad-da-szu _dam-a-ni_
#tr.ts: ana šaddašu aššatīšu
#tr.en: to Šaddašu his wife

4. i-qi2-i-isz
#tr.ts: iqīš
#tr.en: has given.

5. _dumu-mesz_ {d}suen-pi2-la-ah
#tr.ts: mārū sîn-pilaḫ
#tr.en: Sîn-pilaḫ's sons

6. u2-ul i-ra-ag-ga-mu-szi-im
#tr.ts: ul iraggamūšim
#tr.en: will not claim against her.

7. isz-tu u4-um t,up-[pu]-um
#tr.ts: ištu ūm ṭuppum
#tr.en: From the day the tablet

8. in-ni-iz-bu
#tr.ts: innizbu
#tr.en: is deposited,

9. <_dumu-mesz_> ma-la mu-ti-ba-asz-ti
#tr.ts: mārū mala mutī-bāštī
#tr.en: however many children Mutī-bāštī

10. ul-la-du
#tr.ts: u(l)ladu
#tr.en: bears,

11. sza sza-ad-da-szu-ma
#tr.ts: ša šaddašūma
#tr.en: (they) will belong only to Šaddašu.

12. {disz}sa3-<<bi>>-ni-iq-pi2-sza
#tr.ts: saniq-pīša
#tr.en: Saniq-pīša

13. _dumu-munus_ sza-ad-da-szu
#tr.ts: mārat šaddašu
#tr.en: is the daughter of Šaddašu.

@reverse
1. _igi_ szu-{d}mar-tu
#tr.ts: maḫar gimil-amurru
#tr.en: Before Gimil-amurru;

2. _igi_ dam-qum
#tr.ts: maḫar damqum
#tr.en: before Damqum;

3. _igi_ bi-ki-in-nu-um
#tr.ts: maḫar bikinnum
#tr.en: before Bikinnum;

4. _igi_ {d}suen-re-me-ni
#tr.ts: maḫar sîn-rēmēni
#tr.en: before Sîn-rēmēni;

5. _igi_ a-hu-ki-nu-um
#tr.ts: maḫar aḫu(m)-kīnum
#tr.en: before Aḫum-kīnum;

6. _igi_ a-hi-li-im
#tr.ts: maḫar aḫilim
#tr.en: before Aḫilim;

7. _igi_ mu-ha-du-um
#tr.ts: maḫar muḫa(d)dûm
#tr.en: before Muḫaddûm (and)

8. _igi_ sa3-ri-qum
#tr.ts: maḫar sa(r)riqum
#tr.en: before Sarriqum

9. _dumu-mesz_ {d}suen-pi2-la-ah
#tr.ts: mārī sîn-pilaḫ
#tr.en: sons of Sîn-pilaḫ;

10. _igi_ {d}i7-ra-bi _dub-sar_
#tr.ts: maḫar nārum-rabi ṭupšarrim
#tr.en: before Nārum-rabi the scribe;

11. _igi_ {d}suen-isz-me-ni
#tr.ts: maḫar sîn-išme(an)ni
#tr.en: before Sîn-išmeanni;

12. _igi_ sa3-bi-bu-um
#tr.ts: maḫar sabibum
#tr.en: before Sabibum;

13. _igi_ lu2-{d}suen-ka
#tr.ts: maḫar awīl-sîn
#tr.en: before Awīl-sîn.

14. _mu_ <<TUG2>> {d}utu u3 {d}a-a
#tr.ts: šanat šamaš u ayya
#tr.en: The year Šamaš and Ayya.

