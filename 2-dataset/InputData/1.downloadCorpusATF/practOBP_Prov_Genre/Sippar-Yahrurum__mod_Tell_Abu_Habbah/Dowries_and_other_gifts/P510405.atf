&P510405 = BDHP 25  
#atf: lang akk 
@tablet 
@obverse 
1. _4(iku) [n?] GAN2# a-sza3_ 
#tr.ts: erbet ... ikû eqlam
#tr.en: A field of 4+n (?) IKU

2. i-na ta-wi-ir-tum 
#expected ta-wi-ir-tim
#tr.ts: ina tawirtum
#tr.en: in the arable area

3. i-na u2-ga-ar gi-za-ni-im 
#tr.ts: ina ugār gizānim
#tr.en: in the Gizānum irrigation district,

4. i-ta na-asz-pa-<ku?>-tum na-di-tim 
#tr.ts: itā našpakūtum nadītim
#tr.en: next to the storeroom of the nadītu;

5. _2(iku) GAN2 a-sza3_ i-na za-asz2-ki-im 
#tr.ts: šinā ikû eqlam ina zaškim
#tr.en: a field of 2 IKU in the Zaškum (irrigation district)

6. i-ta i-zi-ib-dingir 
#tr.ts: itā izib-ilum
#tr.en: next to (the property of) Izib-ilum

7. u3 sa-me-hu-um 
#tr.ts: u sameḫum
#tr.en: and Sameḫum;

8. _1(disz) sag-nita2_ i3-li2-illat-ti _mu-ni_ 
#tr.ts: ištēt amtam ilī-tillatī šumša
#tr.en: 1 female slave, her name is Ilī-tillatī,

9. na-szi i-s,i2-sza 
#tr.ts: nāši iṣīša
#tr.en: the carrier of her firewood,

10. ha-am-ma-ta-ar 
#tr.ts: ḫammatar
#tr.en: Ḫammatar

11. a-na sa-e-ra-tum 
#tr.ts: ana sa’eratum
#tr.en: to Sa’eratum

12. ma-ar-ti-szu i-di-in 
#tr.ts: mārtīšu i(d)din
#tr.en: his daughter has given.

13. a-di ha-am-ma-<ta>-ar ba-al-t,u2 
#tr.ts: adi ḫammatar balṭu
#tr.en: As long as Ḫammatur is alive,

14. wa-ra-sa3 i-sza-pa-ar 
#tr.ts: wara(s)sa iša(p)par
#tr.en: he will have the authority on her slave 

15. u3 e-qe2-el-sza i-ka-al 
#tr.ts: u eqelša i(k)kal
#tr.en: and will have the usufruct of her field.

@reverse 
1. [wa-ar]-ki ha-am-ma-ta-ar 
#tr.ts: warki ḫammatar
#tr.en: After Ḫammatar(‘s death),

2. _a-sza3_ sa-e-ra-tim 
#tr.ts: eqel s’aeratim
#tr.en: the field will be of Sa’eratum;

3. wa-ar-ki sa-e-ra-tim 
#tr.ts: warki s’aeratim
#tr.en: after Sa’eratum(‘s death),

4. a-hu-sza a-na uk-la-ti-szu-nu 
#tr.ts: a(ḫ)ḫūša ana uklātīšunu
#tr.en: her brothers (will have it) for their nourishment.

5. _igi_ la-ah-bi-ru 
#tr.ts: maḫar laḫbiru
#tr.en: Before Laḫbiru,

6. _igi_ la-mu-ra 
#tr.ts: maḫar lamura
#tr.en: before Lamura,

7. _igi_ nu-di-dingir 
#tr.ts: maḫar nudi-ilum
#tr.en: before Nudi-ilum (and)

8. _igi_ puzur4-{d}utu 
#tr.ts: maḫar puzur-šamaš
#tr.en: before Puzur-šamaš

9. ma-ru su-um-li-s,i2-im 
#tr.ts: mārū sum-līṣim
#tr.en: sons of Sum-līṣim;

10. _igi_ ia-ta-ar-dingir 
#tr.ts: maḫar yatar-ilum
#tr.en: before Yatar-ilum (and)

11. _igi_ ar-na-bu-um 
#tr.ts: maḫar arnabum
#tr.en: before Arnabum

12. ma-ru ba-al-li-im 
#tr.ts: mārū ballim
#tr.en: sons of Ballum;

13. _igi_ ia-ak-ri-dingir 
#tr.ts: maḫar yakri-ilum
#tr.en: before Yakri-ilum

14. _dumu_ im-lik-{d}suen 
#tr.ts: mār imlik-sîn
#tr.en: son of Imlik-sîn

15. u3 s,i-li-bu-um _dub-sar_ 
#tr.ts: u ṣilibum ṭupšarrim
#tr.en: and Ṣilibum the scribe;

16. _igi_ i-zi-ib-dingir 
#tr.ts: maḫar izib-ilum
#tr.en: before Izib-ilum

17. _dumu_ i-ku-pi2-{d}suen
#tr.ts: mār ikū(n)-pî-sîn
#tr.en: son of Ikūn-pî-sîn.
