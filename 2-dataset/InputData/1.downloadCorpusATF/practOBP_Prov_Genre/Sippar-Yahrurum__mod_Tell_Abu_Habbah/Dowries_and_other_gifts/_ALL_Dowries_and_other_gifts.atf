&P370506 = CT 08, pl. 49, Bu 1891-05-09, 2484
#atf: lang akk
@tablet
@obverse
1. _1(esze3) 1(iku) GAN2 a-sza3_ i-ta i-lu-ni
#tr.ts: ištēn ebel ištēn ikû eqlum itā iluni
#tr.en: A field of 7 IKU next to (the field of) Iluni

2. u3 i-ta i-zi-a-szar
#tr.ts: u itā izi-ašar
#tr.en: and next to (the field of) Izi-ašar,

3. isz-tu {i7}za-bi-am a-na ma-asz-ka-nim
#tr.ts: ištu zabiam ana maškanim
#tr.en: from the Zabiam canal to the threshing floor;

4. _3(disz)_ ra-t,a2*-tum sza _{gesz}pesz3_
#tr.ts: šalāšat raṭātum ša tīnātim
#tr.en: 3 channels with fig trees

5. isz-tu a-ta-pu-um sza {d}a-a-la-tum
#tr.ts: ištu ata(p)pum ša ayalatum
#tr.en: from the ditch of Ayalatum

6. a-na _1(u) nindan usz sag-bi_ a-na il-ta-nim
#tr.ts: ana ešret nindan šiddim pūssu ana iltanim
#tr.en: for 10 rods length, its front is toward the north;

7. _1(disz) sar [e2] du3-a i-ta _e2_ na-ki-mu-um
#tr.ts: ištēn mūšar bītum epšum itā bīt nākimum
#tr.en: a built house plot of 1 SAR next to the house of Nākimum

8. u3 i-ta su-qi2-im mu-s,u2-szu
#tr.ts: u itā sūqim muṣušu
#tr.en: and next to the street, its right-of-way

9. a-na ba-ab a-hu-la-pi2-{d}utu u2-s,i
#tr.ts: ana bāb aḫulap-šamaš u(ṣ)ṣi
#tr.en: has the exit towards the gate of Aḫulap-šamaš.

10. {disz}il-ta-ni _dumu-munus_ ha-li-ia-tum
#tr.ts: iltani mārat ḫaliyatum
#tr.en: Iltani, daughter of Ḫaliyatum,

11. u2-ra-ba-szi-ma a-na mu-tim i-na-di-szi
#tr.ts: ura(b)bašīma ana mutim ina(d)di(š)ši
#tr.en: will raise her and give her in marriage (lit. to a husband).

12. zi-ti ha-li-ia-tum _lukur_ {d}marduk
#tr.ts: zi(t)ti ḫaliyatum nadīt marduk
#tr.en: The share of Ḫaliyatum nadītu of Marduk

13. sza i-zi-a-szar i-di-nu-szi-im
#tr.ts: ša izi-ašar i(d)dinūšim
#tr.en: that Izi-ašar gave her,

14. a-di ba-al-t,a3-at i-ka-al
#tr.ts: adi balṭat i(k)kal
#tr.en: as long as she lives she will have the usufruct;

15. _ibila_ na-ki-mu-um
#tr.ts: aplum nākimum
#tr.en: the (only) heir is Nākimum.

16. u2-um na-ki-mu-um
#tr.ts: ūm nākimum
#tr.en: On the day that Nākimum

17. li-bi ha-li-ia-tum
#tr.ts: li(b)bi ḫaliyatum
#tr.en: to (lit. the heart of) Ḫaliyatum

18. usz-ta-am-ri-s,u2 i-na ap-lu-ti-sza
#tr.ts: uštamriṣu ina aplūtīša
#tr.en: causes sorrow, from her inheritance

@reverse
1. i-na-sa3-ah-szu
#tr.ts: ina(s)saḫšu
#tr.en: she will remove him.

2. a-na bu-szi a-ma-la ha-li-ia-tum
#tr.ts: ana būšī amala ḫaliyatum
#tr.en: Concerning all the movable property that Ḫaliyatum

3. i-ra-asz-szu-u2 na-ki-mu-um
#tr.ts: iraššu nākimum
#tr.en: will acquire, Nākimum

4. u2-ul a-wa-su2
#tr.ts: ul awa(s)su
#tr.en: has no claim;

5. _a-sza3 u3 {gesz}kiri6 ibila_ na-ki-mu-um
#tr.ts: eqlum u kirûm aplūt nākimum
#tr.en: (just) the field and the orchard are the inheritance of Nākimum.

6. _igi_ mu-da-du-um _dumu_ usz-tasz-ni-dingir
#tr.ts: maḫar mudādum mār uštašni-ilum
#tr.en: Before Mudādum son of Uštašni-ilum;

7. _igi_ a-bi-lu-s,u2 _dumu_ li-pi2-it-sin
#tr.ts: maḫar abī-luṣu mār lipit-sîn
#tr.en: before Abi-luṣu son of Lipit-sîn;

8. _igi_ ip-qu2-sza _dumu_ a-ab-ba-t,a3-bu-um
#tr.ts: maḫar ipquša mār abum-ṭābum
#tr.en: before Ipquša son of Abum-ṭābum;

9. _igi_ an-ni-dingir _dumu_ sin-tu-kul2-ti
#tr.ts: maḫar anni-ilum mār sîn-tukultī
#tr.en: before Anni-ilum son of Sîn-tukultī;

10. _igi_ sin-pu-ut,-ra-am _dumu_ su-ka-li-ia
#tr.ts: maḫar sîn-puṭram mār su(k)ka(l)līya
#tr.en: before Sîn-puṭram son of Sukkallīya;

11. _igi_ a-pi2-li-ia _dumu_ sze-er-sze-ru-um
#tr.ts: maḫar apilīya mār šerše(r)rum
#tr.en: before Apilīya son of Šeršerrum;

12. _igi_ pa-ar-ga-nu-um _dumu_ a-sa3-ru-um
#tr.ts: maḫar parganûm mār azarum
#tr.en: before Paraganûm son of Azarum;

13. _igi_ i-na-szu-dingir _dumu_ nu-ur2-{d}utu
#tr.ts: maḫar ina-qāt-ilim mār nūr-šamaš
#tr.en: before Ina-qāt-ilim son of Nūr-šamaš;

14. _igi_ ip-qa2-tum _dumu_ hat,-t,i3-im
#tr.ts: maḫar ipqatum mār ḫaṭṭim
#tr.en: before Ipqatum son of Ḫaṭṭim;

15. _igi_ tu-tu-na-s,ir
#tr.ts: maḫar tutu-nāṣir
#tr.en: before Tutu-nāṣir

16. _aga-us2_ szar-ri-im
#tr.ts: rēdi šarrim
#tr.en: soldier of the king;

17. _igi_ sin-dingir _dumu_ ku-da-nu-um
#tr.ts: maḫar sîn-ilum mār kūdanum
#tr.en: before Sîn-ilum son of Kūdanum.

18. _mu_ a-pil-sin u2-ra-am-mi-ku
#tr.ts: šanat apil-sîn urammiku
#tr.en: The year: "Apil-sîn washed".

