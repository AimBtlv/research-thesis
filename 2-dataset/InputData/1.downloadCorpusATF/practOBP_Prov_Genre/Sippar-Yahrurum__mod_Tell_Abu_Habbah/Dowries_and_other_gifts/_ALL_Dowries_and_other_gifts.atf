&P365165 = CT 08, pl. 02, Bu 1888-05-12, 010 
#atf: lang akk 
@tablet 
@obverse 
1. _1/2(disz) gin2 ku3-sig17_ sza pa-ni na-ap-sza-ti-sza
#tr.ts: mišil šiqil ḫurāṣum ša pāni napšatīša
#tr.en: One golden pendant of 1/2 shekel;

2. _2(disz) gin2 har-szu ku3-babbar_ 
#tr.ts: šinā siqil semerum ša kaspim
#tr.en: a silver bracelet of 2 shekels;

3. _1(disz) gin2 szu-gur ku3-babbar_ 
#tr.ts: ištēn siqil unqum ša kaspim
#tr.en: a silver ring of 1 shekel;

4. _1(disz) tug2 guz-za_ 
#tr.ts: ištēn i’lum
#tr.en: 1 guza-garment;

5. _3(disz) tug2 hi-a 3(disz) {tug2}bar-si hi-a_ 
#tr.ts: šalāšat lubārū šalāš paršīgātum
#tr.en: 3 garments; 3 sashes;

6. _1(disz) {uruda}szen tur ki-la2-bi 5(disz) ma-na_ 
#tr.ts: ištēn tangussum ḫamšat manā šuqultašu
#tr.en: 1 metal pot, its weight is 5 mina;

7. _1(disz) {na4}ur5 zi3-gu 1(disz) {na4}ur5 dabin_ 
#tr.ts: ištēt erûm ana isqūqim ištēt erûm ana tappinnim
#tr.en: 1 grindstone for fine flour; 1 grindstone for coarse flour;

8. _1(disz) gesz-nu2 5(disz) {gesz}gu-za hi-a_ 
#tr.ts: ištēn eršum ḫamiš kussiātum
#tr.en: 1 bed; 5 chairs;

9. _1(disz) {gesz}banszur 1(disz) {gi}pisan szu-i_ 
#tr.ts: ištēn paššūrum ištēn pisan gallābim
#tr.en: 1 table; 1 barber’s chest;

10. _1(disz) {gi}pisan zu2-kesz2_ 
#tr.ts: ištēn pisan kiṣrim
#tr.en: 1 container (with) hanging arrangement;

11. _1(disz) {gi}pisan dub_ 
#tr.ts: ištēn pisan ṭuppim
#tr.en: 1 chest for tablet(s);

12. {disz}{munus}su-ra-tum szu-gi-tum _nin9-a-ni_ 
#tr.ts: su(r)ratum šugītum aḫāssa
#tr.en: her sister Surratum the šugītu;

13. mi-im-ma an-ni-i-im 
#tr.ts: mimma annîm
#tr.en: all this is (the property)

14. sza {d}suen-e-ri-ba-am a-bu-sza 
#tr.ts: ša sîn-erībam abūša
#tr.en: which Sîn-erībam her father

15. _dumu_ a-wi-il-{d}suen 
#tr.ts: mār awīl-sîn
#tr.en: son of Awīl-sîn

16. a-na la-ma-sa3-tum _lukur_ {d}marduk u3 _nu-bar_ 
#tr.ts: ana lama(s)satum nadīt marduk u kulmašītum
#tr.en: to Lamassatum nadītu of Marduk and kulmašītum,

17. ma-ar-ti-szu 
#tr.ts: mārtīšu
#tr.en: her daughter,

18. i-na _e2_ an-nu-ni-tum i-na ni*-szi-ti-sza 
# Collation Walker ad Wilcke, Fs Kraus (1982) p. 461 
#tr.ts: ina bīt annunītum ina nīšitīša
#tr.en: in the temple of Annunītum upon her elevation

19. u2-we-du-szi-im-ma 
#tr.ts: uwe(d)dušimma
#tr.en: assigned and

20. {disz}{munus}szu-bu-ul-tum um-ma-sza 
#tr.ts: šubultum ummaša
#tr.en: Šubultum her mother,

21. {disz}qi2-sza-at-{d}suen {disz}ig-mil-{d}suen 
#tr.ts: qīšat-sîn igmil-sîn
#tr.en: Qīšat-sîn, Igmil-sîn

22. u3 zimbir{ki}-li-sze-er ah-hu-sza 
#tr.ts: u sippir-lišer aḫḫūša
#tr.en: and Sippar-lišer her brothers

23. _dumu-mesz_ {d}suen-e-ri-ba-am 
#tr.ts: mārū sîn-erībam
#tr.en: sons of Sîn-erībam

24. id-di-nu-szi-im-ma 
#tr.ts: iddinūšimma
#tr.en: gave her and

25. a-na _e2_ dingir-szu-ba-ni mu-ti-sza 
#tr.ts: ana bīt ilšu-bānī mutīša
#tr.en: into the house of her husband Ilšu-bānī 

26. _dumu_ {d}suen-i-din-nam 
#tr.ts: mār sîn-i(d)dinam
#tr.en: son of Sîn-iddinam

27. u2-sze-ri-bu-ma 
#tr.ts: ušēribūma
#tr.en: they made enter and

28. in-na-ad-nu-szum 
#tr.ts: innadnūšum
#tr.en: were given to him.

@reverse 
1. isz-tu _1/3(disz) ma-na ku3-babbar_ te-er-ha-as-sa3 
#tr.ts: ištu šaluš manā kaspum terḫassa
#tr.en: After one-third mina of silver, her bride,

2. i-na qa2-an-ni-sza ra-ak-su-ma 
#tr.ts: ina qannīša rāksūma
#tr.en: was handed over to her (lit. was tied in her hem) and

3. a-na dingir-szu-ba-ni mu-ti-sza tu-ur-ru 
#tr.ts: ana ilšu-bānī mutīša turru
#tr.en: was returned to Ilšu-bānī her husband,

4. _u4 kur2-sze3_ ma-ru-sza ap-lu-sza 
#tr.ts: ana warkiāt ūmī mārūša aplūša
#tr.en: thenceforth her sons will be her heirs.

5. _mu_ {d}utu {d}marduk u3 am-mi-di-ta-na _lugal_ 
#tr.ts: nīš šamaš marduk u ammi-ditana šarrim
#tr.en: (By) the name of Šamaš, Marduk and Ammi-ditana the king

6. _in-pa3_ 
#tr.ts: itma
#tr.en: she swore.

$ single ruling 
7. _igi_ sig-an-nu-ni-tum _dumu_ {d}suen-i-din-nam
#tr.ts: maḫar ipqu-annunītum mār sîn-i(d)dinam
#tr.en: Before Ipqu-annunītum son of Sîn-iddinam;

8. _igi_ ib-ni-{d}utu _masz2-szu-gid2-gid2_ 
#tr.ts: maḫar ibni-šamaš bārîm
#tr.en: before Ibni-šamaš, diviner;

9. _igi_ ib-ni-{d}marduk _dumu_ nu-ra-tum
#tr.ts: maḫar ibni-marduk mār nūratum
#tr.en: before Ibni-marduk son of Nūratum;

10. _igi_ ARAD-{d}suen _dumu_ {d}suen-i-din-nam
#tr.ts: maḫar warad-sîn mār sîn-i(d)dinam
#tr.en: before Warad-sîn son of Sîn-iddinam;

11. _igi_ {d}suen-na-di-in-szu-mi _dumu_ {d}marduk-na-s,i-ir
#tr.ts: maḫar sîn-nadin-šumī mār marduk-nāṣir
#tr.en: before Sîn-nadin-šumi son of Marduk-nāṣir;

12. _igi_ {d}suen-isz-me-a-ni _dumu_ ib-ni-{d}marduk
#tr.ts: maḫar sîn-išmea(n)ni mār ibni-marduk
#tr.en: before Sîn-ismeanni son of Ibni-marduk;

13. _igi_ gi-mil-{d}marduk _dumu_ s,il2-li2-{d}utu
#tr.ts: maḫar gimil-marduk mār ṣilli-šamaš
#tr.en: before Gimil-marduk son of Ṣilli-šamaš;

14. _igi_ a-bu-um-wa-qar _dumu_ {d}suen-i-din-nam
#tr.ts: maḫar abum-waqar mār sîn-i(d)dinam
#tr.en: before Abum-waqar son of Sîn-iddinam;

15. _igi_ i-na-ul-masz-numun _dumu_ ni-id-nu-sza
#tr.ts: maḫar ina-ulmaš-zērum mār nidnuša
#tr.en: before Ina-ulmaš-zērum son of Nidnuša;

16. _igi_ {d}suen-a-ha-am-i-din-nam _dumu_ {d}iszkur-ma-an-szum2 
#tr.ts: maḫar sîn-aḫam-i(d)dinam mār-adad-manšūm
#tr.en: before Sîn-aḫam-iddinam son of Adad-manšum;

17. _igi_ dingir-szu-ba-ni
#tr.ts: maḫar ilšu-bānî
#tr.en: before Ilšu-bānī (and)

18. _igi_ be-el-szu-nu _dumu-mesz_ a-wi-il-{d}suen
#tr.ts: maḫar bēlšunu mārī awīl-sîn
#tr.en: before Bēlšunu sons of Awīl-sîn;

19. _igi_ {d}suen-na-s,i-ir _dub-sar_ 
#tr.ts: maḫar sîn-nāṣir ṭupšarrim
#tr.en: before Sîn-nāṣir the scribe.

$ single ruling 
20. _iti sze-sag11-ku5 u4 2(u) 6(disz)-kam_ 
#tr.ts: waraḫ addarim ūmam ešrā šeššet
#tr.en: The month of Addarum, the day 26,

21. _mu_ am-mi-di-ta-na _lugal-e alan nam-ur-sag-ga2 sa-am-su-i-lu-na pa4-bil-en-na e2-nam-ti-[la]-sze3 u3 alan nam-en-na-ni e2-me-te-ur-sag-ga2-sze3# in-ne-en-ku4-ra#_ 
#tr.ts: šattum ša ammi-ditana šarrum ṣalam qarrādūtim ša samsu-iluna abi abīšu ina enamtila u ṣalam bēlūtim ina emeteursag īrubu
#tr.en: the year in which Ammi-ditana the king brought an heroic statue of Samsu-iluna his grandfather into Enamtila and a statue of his rulership into Emeteursag.

