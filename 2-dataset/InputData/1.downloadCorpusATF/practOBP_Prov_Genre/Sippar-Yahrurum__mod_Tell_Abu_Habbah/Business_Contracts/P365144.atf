&P365144 = CT 06, pl. 30, Bu 1891-05-09, 0421  
#atf: lang akk 
@tablet 
@obverse 
1. _ibila-sze3_ hu-nu-ub-tum 
#tr.ts: ana aplūt ḫu(n)nubtum
#tr.en: Concerning the inheritance of Ḫunnubtum,

2. la-ma-si2-i3# 
#tr.ts: lama(s)sī
#tr.en: Lamassī

3. re-di-it wa-ar-ka-ti-sza 
#tr.ts: rēdīt warkatīša
#tr.en: is the heiress of her legacy.
# Suurmeijer reads: -sza at end of next line, copy omits

4. _1(esze3) 2(iku) GAN2 a-sza3_ 
#tr.ts: ištēn ebel šinā ikû eqlum
#tr.en: A field of 8 IKU

5. i-na na-gu-um 
#tr.ts: ina nagûm
#tr.en: in the Nagûm (district);

6. _e2 du3-a_ sza zimbir{ki} 
#tr.ts: bītum epšum ša sippir
#tr.en: a built house plot in Sippar,

7. sza {d}nin-szubur#-en-nam 
#tr.ts: ša ilabrat-ennam
#tr.en: of Ilabrat-ennam;

8. _e2 du3-a_ sza ga-gu-um 
#tr.ts: bītum epšum ša gagûm
#tr.en: a built house plot in (lit. of) the cloister;

9. ma-la ma-s,u2-u2 
#tr.ts: mala maṣû
#tr.en: as much as is available,

10. bu-szu-sza u3 wa-ar-ka-sa6 
#tr.ts: būšûša u warka(s)sa
#tr.en: her inherited property and her personal possessions,

11. sza hu-nu-ub-tum 
#tr.ts: ša ḫu(n)nubtum
#tr.en: it is Ḫunnubtum's.

12. ma-la i-ba-asz-szu 
#tr.ts: mala ibaššû
#tr.en: All that there is,

13. isz-tu pe2-e a-di _ku3-sig17_ 
#tr.ts: ištu pê adi ḫurāṣim
#tr.en: everything (lit. from chaff to gold)

14. sza la-ma-si2-ma 
#tr.ts: ša lama(s)sīma
#tr.en: belongs exclusively to Lamassī.

15. mi-im-ma an-ni-im 
#tr.ts: mimma annîm
#tr.en: All this,

16. {disz}hu-nu-ub-tum _ama#-[a-ni_] 
#tr.ts: ḫu(n)nubtum ummaša
#tr.en: Ḫunnubtum her mother

17. a-na la-ma-[si2 ...] 
#tr.ts: ana lama(s)sī ...
#tr.en: to Lamassī ...

18. _dumu-munus-a-ni_ bu-sze-[e ...] 
#tr.ts: mārtīša būšê
#tr.en: her daughter, the property ...

