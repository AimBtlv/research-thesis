&P365169 = CT 08, pl. 06, Bu 1888-05-12, 042
#atf: lang akk
@tablet
@obverse
1. _1(disz) sag-geme2_ an-nu-ni-tum#-[...]
#tr.ts: ištēt amtum annunītum-...
#tr.en: 1 female slave, Annunītum-...

2. _mu-ni-im_
#tr.ts: šumša
#tr.en: is her name,

3. sza! ba-za-tum _lukur {d}amar-utu_
#tr.ts: ša bazatum nadīt marduk
#tr.en: of Bazatum nadītu of Marduk

4. _dumu-munus_ dumu-isz8-tar2
#tr.ts: mārat mār-ištar
#tr.en: daughter of Mār-ištar,

5. a-na pu-ha-ti-sza#
#tr.ts: ana puḫatīša
#tr.en: as an exchange for her,

6. _1(disz) sag-geme2_ ma-x#-[...]
#tr.ts: ištēt amtum ma...
#tr.en: 1 female slave, ...

7. _mu-ni-[im]_
#tr.ts: šumša
#tr.en: is her name,

8. _e2_ dingir-[szu]-a-bu-szu
#tr.ts: bīt ilšu-abūšu
#tr.en: (from) the house of Ilšu-abūšu

9. _dumu_ [szar]-rum-{d}iszkur
#tr.ts: mār šarrum-adad
#tr.en: son of Šarrum-adad.

10. {disz}dingir-szu#-[a-bu]-szu
#tr.ts: ilšu-abūšu
#tr.en: Ilšu-abūšu

11. _dumu_ szar-rum-{d#}iszkur
#tr.ts: mār šarrum-adad
#tr.en: son of Šarrum-adad

12. _sag-geme2_ ki-ma _sag-geme2_
#tr.ts: amtam kīma amtim
#tr.en: one female slave for one female slave

@reverse
1. a-na ba-za-tum _lukur {d}amar-utu_
#tr.ts: ana bazatum nadīt marduk
#tr.en: to Bazatum nadītu of Marduk

2. _dumu-munus_ dumu-isz8-tar2
#tr.ts: mārat mār-ištar
#tr.en: daughter of Mār-ištar

3. i-na mi-it-gu-ur-ti-szu-nu
#tr.ts: ina mitgurtīšunu
#tr.en: in mutual understanding

4. im-ta-ag-ru-u2-ma
#tr.ts: imtagrūma
#tr.en: they have agreed with each other so

5. id-di-in-ma _geme2_ u2-pi2-ih
#tr.ts: iddinma amtam upīḫ
#tr.en: he has given and the female slave has exchanged.

6. pu-uh-hu-u2 szu-ur-ru#-u2#
#tr.ts: puḫḫū šurrû
#tr.en: They have completed the exchange by sending off

7. le-qu2#-u2# li-ib-ba#-[szu-nu t,a3-ab]
#tr.ts: leqû libbašunu ṭāb
#tr.en: (and) taking possession; their heart is satisfied.

8. _u4 kur2-sze3#_ a#-hu a-na a-hi#-[im]
#tr.ts: ana warkiāt ūmī aḫu(m) ana aḫim
#tr.en: (That) in future brother against brother

9. u2-ul i#-ra#-gu-um#
#tr.ts: ul ira(g)gum
#tr.en: will not raise a claim,

10. _mu_ {d}utu {d}amar-utu u3 sa-am-su-[i-lu-na]
#tr.ts: nīš šamaš marduk u samsu-iluna
#tr.en: (by) the name of Šamaš, Marduk and Samsu-iluna

11. it-mu-u2
#tr.ts: itmû
#tr.en: they have sworn.

$ (line 12 is erased)
13. _igi_ szar-rum-{d}iszkur _dumu_ {d}[...]
#tr.ts: maḫar šarrum-adad mār ...
#tr.en: Before Šarrum-adad son of ...;

14. _igi_ sig-an-nu-ni-tum# [...]
#tr.ts: maḫar ipqu-annunītum
#tr.en: before Ipqu-annunītum;

15. _igi_ sin-be-el-ap!-[lim ...]
#tr.ts: maḫar sîn-bēl-aplim
#tr.en: before Sîn-bēl-aplim;

16. _igi_ an-pi4-{d}utu [...]
#tr.ts: maḫar annum-pî-šamaš
#tr.en: before Annum-pî-šamaš;

17. _igi_ sin-e-ri-ba-am# [...]
#tr.ts: maḫar sîn-erībam
#tr.en: before Sîn-erībam;

@left
@column 1
1. _igi_ {d}utu-szu-mu-un-dab5#
#tr.ts: maḫar utu-šumundib
#tr.en: before Utu-šumundib;

2. _igi_ na-bi-il3-a-ba4
#tr.ts: maḫar nabi-ilaba
#tr.en: before Nabi-ilaba (and)

3. _igi_ szu-i3-li2-szu _dumu-me_ dumu-isz8-tar2
#tr.ts: maḫar šū-ilīšu mārī mār-ištar
#tr.en: before Šū-ilīšu sons of Mār-ištar;

@column 2
1. _igi_ im-gur-sin _dub-sar_
#tr.ts: maḫar imgur-sîn ṭupšarrim
#tr.en: before Imgur-sîn, the scribe.

2. _iti udru{duru5} u4 1(disz)-kam_
#tr.ts: waraḫ šabāṭim ūmam ištēn
#tr.en: The month of Šabāṭum, the day 1

3. _mu_ sza-ah-na-a#
#tr.ts: šanat šaḫna
#tr.en: the year: "(Samsu-iluna destroyed) Šaḫna.".
