&P257793 = PBS 08/2, 195 
#atf: lang akk 
@tablet 
@obverse 
1. _1(disz) ma-na ku3-babbar_ 
#tr.ts: ištēn manā kaspim
#tr.en: 1 mina of silver,
2. _masz2 1(disz) ma-na 1/3(disz) gin2_
#tr.ts: ṣibat šalšat siqlam ana ištēn manā
#tr.en: the interest of 1/3 of shekel for each mina
3. u2-s,a-ab 
#tr.ts: u(ṣ)ṣab
#tr.en: he will add,
4. _ki_ za-ab-lum 
#tr.ts: itti zablum
#tr.en: from Zablum
5. {disz}{d}suen-i-mi-ti 
#tr.ts: sîn-imi(t)ti
#tr.en: Sîn-imitti,
6. sza i-na sza-ib-di-i 
#tr.ts: ša ina šaibdi
#tr.en: who in Šaibdi
7. wa!-asz-bu 
#tr.ts: wašbu
#tr.en: dwells,
8. _ku3-babbar szu ba-an-ti_ 
#tr.ts: kaspam ilqe
#tr.en: (that) silver has received.
9. _u4_ ki-nu-ni 
#tr.ts: ina ūm kinūni
#tr.en: In the day of the Kinūnu festival
10. _ku3-babbar u3 masz2-bi_ 
#tr.ts: kaspam u ṣibassu
#tr.en: the silver and its interest
11. _i3-la2-e_ 
#tr.ts: išaqqal
#tr.en: he will pay.
@reverse 
1. _mu e2_ {d}inanna# 
#tr.ts: šattum bīt inanna
#tr.en: The year (in which) the temple of Inanna
2. im-me-ru-um i-pu-szu 
#tr.ts: immerum ipušu
#tr.en: Immerum built.
3. _igi_ ap-lu-szi 
#tr.ts: maḫar apluši
#tr.en: Before Apluši,
4. _dumu_ isz-bi-ir-di-ni 
#tr.ts: mār išbirdini
#tr.en: son of Išbirdini;
5. _igi_ a-hi-um-mi-szu 
#tr.ts: maḫar aḫī-ummīšu
#tr.en: before Aḫī-ummīšu,
6. _dumu_ sze-ru-um-i3-li2 
#tr.ts: mār šērum-ilī
#tr.en: son of Šērum-ilī;
7. _igi_ {d}nanna-ma-an-szum2 
#tr.ts: maḫar nanna-manšum
#tr.en: before Nanna-manšum,
8. _dumu_ {d}suen-gal 
#tr.ts: mār sîn-gal
#tr.en: son of Sîn-gal;
9. _igi_ {d}suen-isz-me-a-ni 
#tr.ts: maḫar sîn-išmea(n)ni
#tr.en: before Sîn-išmeanni,
10. _dumu_ ia-ta-da?-tum 
#tr.ts: mār iatadatum
#tr.en: son of Iatadatum;
11. _igi_ {d}suen-i-mi-ti 
#tr.ts: maḫar sîn-imi(t)ti
#tr.en: before Sîn-imitti
12. _dumu_ zi-kir-a-szur3 
#tr.ts: mār zikir-a(š)šur
#tr.en: son of Zikir-aššur;
@left 
1. _igi_ pa-ti-tum 
#tr.ts: maḫar patitum
#tr.en: before Patitum;
2. _igi_ puzur4-sin 
#tr.ts: maḫar puzur-sîn
#tr.en: before Puzur-sîn,
