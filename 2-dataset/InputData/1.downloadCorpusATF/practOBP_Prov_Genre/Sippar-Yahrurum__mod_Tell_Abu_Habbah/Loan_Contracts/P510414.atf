&P510414 = BDHP 37 
#atf: lang akk 
@tablet 
@obverse 
1. _1/2(disz) ma-na 3(disz) gin2 ku3-babbar_ 
#tr.ts: mišil manā šalāšat šiqil kaspam
#tr.en: 33 shekel of silver

2. _ki_ inim-{d}nanna 
#tr.ts: itti inim-nanna
#tr.en: from Inim-nanna

3. ARAD-{d}suen _dumu_ ka-ar-sza-ia 
#tr.ts: warad-sîn mār karšaya
#tr.en: Warad-sîn son of Karšaya

4. _szu ba-an-ti_ 
#tr.ts: ilqe
#tr.en: has borrowed.

5. _2(iku) 1/2(iku) GAN2 a-<sza3>_ i-na e-bi-ir-tim 
#tr.ts: šinā u mišil ikû eqlam ina ebirtim
#tr.en: A field of 250 SAR on the other bank

6. i-na na-gi-im 
#tr.ts: ina nagîm
#tr.en: in the district,

7. i-na ta-wi-ir-tim 
#tr.ts: ina tarwitim
#tr.en: in the large (from next line) arable land

8. ra-bi-tim sza i-li-li 
#tr.ts: rabîtim ša ilili
#tr.en: of Ilili

9. i-na _mar{ar}_-gi-im 
#tr.ts: ina margîm
#tr.en: in Margûm,

10. _ki_ ARAD-{d}suen inim-{d}nanna 
#tr.ts: itti warad-sîn inim-nanna
#tr.en: Inim-nanna from Warad-sîn

11. _a-sza3 szu ba-an-ti_ 
#tr.ts: eqlam ilqe
#tr.en: has received the field.

12. _a-sza3 u3 ku3-babbar_ i-ta-t,a3-lu 
#tr.ts: eqlum u kaspum i(t)taṭalū
#tr.en: Field and silver are of equal value.

13. a-na e-bu-ri-im 
#tr.ts: ana ebūrim
#tr.en: At harvest time,

14. _3(asz) 1(barig) 4(ban2) gur sze gu2 a-sza3_ 
#tr.ts: šalāšat kur ištēn pān erbe sūt âm bilat eqlim
#tr.en: 1.000 litres of barley, the yield of the field,

15. i-na ma-asz-ka-nim 
#tr.ts: ina maškanim
#tr.en: on the threshing floor

@reverse 
1. ARAD-{d}suen a-na inim-{d}nanna 
#tr.ts: warad-sîn ana inim-nanna
#tr.en: Warad-sîn to Inim-nanna

2. i-ma-da-ad 
#tr.ts: ima(d)dad
#tr.en: will measure out;

3. u3-la im-du-ud-ma 
#tr.ts: ula imdudma
#tr.en: if he do not measure out,

4. _a-sza3_ inim-{d}nanna i-ki-im-szu-ma 
#tr.ts: eqlam inim-nanna i(k)kimšuma
#tr.en: Inim-nanna will take away the field from him and

5. i-ru-usz e-zi-ib 
#tr.ts: i(r)ruš ezib
#tr.en: will cultivate (it), apart from

6. pi2 t,up-pi2-szu sza _a-sza3_ 
#tr.ts: pî tuppīšu ša eqlim	
#tr.en: the content of his tablet about the field

7. sza ga-me-er-tim 
#tr.ts: ša gamertim
#tr.en: in its totality.

8. _mu_ sza _bad3_ ga-gi-im 
#tr.ts: šattum ša dūr gagîm
#tr.en: The year in which the wall of the cloister

9. im-me-ru-um i-pu-szu 
#tr.ts: immerum īpušu
#tr.en: Immerum built.

10. _igi_ sza-i3-li2-ia 
#tr.ts: maḫar ša-ilīya
#tr.en: Before Ša-ilīya

11. _dumu_ ka-ar-sza-ia 
#tr.ts: mār karšaya
#tr.en: son of Karšaya;

12. _igi_ inim-{d}en-lil2-la2 
#tr.ts: maḫar inim-enlil
#tr.en: before Inim-enlil

13. _dumu_ {d}en-lil2-la2-e-lu 
#tr.ts: mār enlil-elu(m)
#tr.en: son of Enlil-elum;

14. _igi_ {d}en-lil2-la2-ba-ni 
#tr.ts: maḫar enlil-bānī
#tr.en: before Enlil-bānī

15. _dumu_ inim-{d}en-lil2-la2 
#tr.ts: mār inim-enlil
#tr.en: son of Inim-enlil;

16. _igi_ {d}suen-i-din-nam _szitim?_ 
#tr.ts: maḫar sîn-i(d)dinam itinnim
#tr.en: before Sîn-iddinam, house builder,

17. _dumu_ szu-{d}kab-ta 
#tr.ts: mār šū-kabta
#tr.en: son of Šū-kabta;

18. _igi_ nu-ur2-i3-li2-szu 
#tr.ts: maḫār nūr-ilīšu
#tr.en: before Nūr-ilīšu

@left 
1. _dumu_ nu-ur2-{d}utu _igi_ {d}utu-he2-gal2 
#tr.ts: mār nūr-šamaš maḫar šamaš-ḫengallī
#tr.en: son of Nūr-šamaš; before Šamaš-ḫengallī

2. _dumu_ ARAD-{d}nanna 
#tr.ts: mār warad-nanna
#tr.en: son of Warad-nanna.

