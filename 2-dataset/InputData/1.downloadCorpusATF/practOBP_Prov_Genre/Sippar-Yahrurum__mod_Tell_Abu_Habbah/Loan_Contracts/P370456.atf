&P370456 = CT 08, pl. 21, Bu 1891-05-09, 0494
#atf: lang akk
@tablet
@obverse
1. _1(asz) gu2-un siki_ sza _e2-gal_
#tr.ts: ištēt bilat šipātum ša ekallim
#tr.en: 1 talent of palace's wool,

2. _sa10 1(u) gin2 ku3-babbar_
#tr.ts: šīmum ešret šiqil kaspum
#tr.en: worth 10 shekels of silver,

3. _nig2-szu_ u2-tul2-esz18-dar a-bi _erin2-mesz_
#tr.ts: ša qāti utul-ištar abi ṣābi
#tr.en: under the responsability of Utul-ištar the official,

4. _ki_ isz-me-{d}suen _dumu_ {d}suen-be-el-ap-lim
#tr.ts: itti išme-sîn mār sîn-bēl-aplim
#tr.en: from Išme-sîm son of Sîn-bēl-aplim

5. {disz}{d}marduk-mu-sza-lim _dumu_ {d}suen-i-din-nam
#tr.ts: marduk-muša(l)lim mār sîn-i(d)dinam
#tr.en: Marduk-mušallim son of Sîn-iddinam,

6. {disz}dingir-szu-ib-ni _dumu_ {d}suen-e-ri-ba-am
#tr.ts: ilšu-ibni mār sîn-erībam
#tr.en: Ilšu-ibni son of Sîn-erībam

7. u3 _dumu-mesz_ nu-ur2-{d}utu ah-hu-szu-nu
#tr.ts: u mārū nūr-šamaš aḫḫūšunu
#tr.en: and Nūr-šamaš's sons, their brothers,

8. _szu ba-an-ti-mesz_
#tr.ts: ilqû
#tr.en: have received.

9. _u4_-um ti-ru _e2-gal_
#tr.ts: ūm tīrū ekallim
#tr.en: When the officials of the palace

10. isz-sza-as2-su!-u2
#tr.ts: iššassū
#tr.en: call,

11. _ku3-babbar_ a-na _e2-gal_
#tr.ts: kaspam ana ekallim
#tr.en: the silver to the palace

@reverse
1. _i3-la2-e-mesz_
#tr.ts: išaqqalū
#tr.en: they will pay.

$ single ruling
2. _igi_ szu-mu-li-ib-szi _dumu_ pir-hi!-i3-li2-szu
#tr.ts: maḫar šumu-libsi mār pir'i-ilīšu
#tr.en: Before Šumu-libsi son of Pir'i-ilīšu;

3. _igi_ be-el-szu-nu _dumu_ dingir-szu-ba-ni
#tr.ts: maḫar bēlšunu mār ilšu-bānī
#tr.en: before Bēlšunu son of Ilšu-bānī.

$ single ruling
$ blank space
4. _iti szu-numun-a u4 2(u)-kam_
#tr.ts: waraḫ dumuzi ūmam ešrā
#tr.en: The month of Dumuzi, the day 20,

5. _mu_ am-mi-s,a-du-qa2 _lugal-e {uruda}ki-lugal-gub-ba i3-mah-a_
#tr.ts: šanat ammi-ṣaduqa šarrum manzāz šarrim ṣīram
#tr.en: the year: "Ammi-ṣaduqa the king, (placed in Enamḫe) a royal socle of copper which was magnificent".

@seal 1
$ (uninscribed)
1. _{na4}kiszib3_ be-el-szu-nu
#tr.ts: kunuk bēlšunu
#tr.en: Seal of Bēlšunu

@seal 2
$ (uninscribed)
1. _{na4}kiszib3_ {d}marduk-mu-sza-lim
#tr.ts: kunuk marduk-muša(l)lim
#tr.en: Seal of Marduk-mušallim
