&P366248 = CT 48, 052 
#atf: lang akk 
@tablet 
@obverse 
1. {disz}da-qa2-tum 
#tr.ts: da(q)qatum
#tr.en: Daqqatum

2. _ki_ la-ma-si2 _dumu-munus_ ha-ni-im um-mi-sza 
#tr.ts: itti lama(s)sī mārat ḫanim ummīša
#tr.en: from Lamassī daughter of Ḫanim her mother

3. {disz}ka-al-ka-tum 
#tr.ts: kalkatum
#tr.en: Kalkatum

4. a-na a-szu-tim u3 mu-tu-tim 
#tr.ts: ana a(š)šūtim u mutūtim
#tr.en: in marriage (lit. as wife and husband)

5. i-hu-us-si2 
#tr.ts: īḫussi
#tr.en: has taken her;

6. te-er-ha-sa3 _1(u) gin2 ku3-babbar_ id-di-in 
#tr.ts: terḫa(s)sa ešret šiqil kaspam iddin
#tr.en: her bridewealth, 10 shekel of silver he has given.

7. {disz}ka-al-ka-tum 
#tr.ts: kalkatum
#tr.en: (If) Kalkatum

8. a-na da-qa2-tum a-sza-ti-szu 
#tr.ts: ana da(q)qatum a(š)šatīšu
#tr.en: to Daqqatum his wife

9. u2-ul a-sza-ti i-qa2-bi-ma 
#tr.ts: ul a(š)šatī iqa(b)bīma
#tr.en: say: "You are not my wife!",

10. _1/3(disz) ma-na ku3-babbar i3-la2-e_ 
#tr.ts: šaluš manā kaspam išaqqal
#tr.en: he will pay 20 shekel of silver

11. u3 da-qa2-tum 
#tr.ts: u da(q)qatum
#tr.en: and (if) Daqqatum

12. a-na ka-al-ka-tum mu-ti-sza 
#tr.ts: ana kalkatum mutīša
#tr.en: to Kalkatum her husband

13. u2-ul mu-ti at-ta i-qa2-bi-ma 
#tr.ts: ul mutī atta iqa(b)bīma
#tr.en: say: “You are not my husband!”,

14. isz-tu _an-za-gar3_ i-na-pa-s,u2-ni-isz-szi 
#tr.ts: ištu dimtim ina(p)paṣūnišši
#tr.en: (the judges) will hurl her from the tower.

15. _igi_ {d}utu-tab-ba-szu _dumu_ {d}utu-ra-bi 
#tr.ts: maḫar šamaš-nāṣir mār šamaš-rabi		
#tr.en: Before Šamaš-nāṣir son of Šamaš-rabi;

16. _igi_ {d}suen-na-s,ir _dumu_ {d}i-szum-na-s,ir# 
#tr.ts: maḫār sîn-nāṣir mār išum-nāṣir
#tr.en: before Sîn-nāṣir son of Išum-nāṣir;

17. _igi_ sza-i3-li2-szu _dumu_ x-[{d}utu] 
#tr.ts: maḫar šā-ilīšu mār ...
#tr.en: before Šā-ilīšu son of ...;

@reverse 
1. _igi_ lu-usz-ta-mar 
#tr.ts: maḫar luštamar
#tr.en: before Luštamar

2. _dumu_ sin-isz-me-an-ni 
#tr.ts: mār sîn-išmeanni
#tr.en: son of Sîn-išmeanni;

3. _igi_ sin-i-din-nam _dumu_ is-su2-ka-bi-it 
#tr.ts: maḫar sîn-i(d)dinam mār issu-kabit
#tr.en: before Sîn-iddinam son of Issu-kabit;

4. _igi_ {d}utu-ha-zi-ir 
#tr.ts: maḫar šamaš-ḫāzir
#tr.en: before Šamaš-ḫāzir;

5. _igi_ be-le-su2-nu _dumu_ a-bi-sa-ma-as2 
#tr.ts: maḫar bēle(s)sunu mār abī-samas
#tr.en: before Bēlessunu son of Abī-samas;

6. _igi_ geme2-{d}utu _igi_ szu-ha-tum 
#tr.ts: maḫar amat-šamaš maḫar šuḫatum
#tr.en: before Amat-šamaš; before Šuḫatum;

7. _igi_ szu-ha-tum 
#tr.ts: maḫar šuḫatum
#tr.en: before Šuḫatum;

8. _igi_ be-la-tum 
#tr.ts: maḫar bēlatum
#tr.en: before Bēlatum;

9. _igi_ e-ri-isz-tum 
#tr.ts: maḫar ērištum
#tr.en: before Ērištum;

10. _igi_ ku-na-a _munus-dub-sar_ 
#tr.ts: maḫar kuna ṭupšarratim
#tr.en: before Kuna the female scribe.

