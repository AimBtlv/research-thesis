2. _dumu-munus_ qa2-ra-su-mu-ia 
#tr.ts: mārat qara'-šumuya
#tr.en: daughter of Qara'-šumuya;

3. _igi_ ku-mu-s,i2-li
#tr.ts: maḫar kumu-ṣili
#tr.en: before Kumu-ṣili.

