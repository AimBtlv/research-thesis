&P386534 = TCL 01, 098 & 099
#atf: lang akk
@tablet
@obverse
1. _2(disz) sar e2_ szi-ki-it-tum
#tr.ts: šinā mūšar bītum šikittum
#tr.en: A building proper of 2 SAR
# CAD Š/2 šikittu A mng. 1c-2' (p. 430b)

2. _da e2_ sin-e-ri-ba-am _dumu_ ARAD-i3-li2-szu
#tr.ts: itā bīt sîn-erībam mār warad-ilīšu
#tr.en: next to the house of Sîn-erībam son of Warad-ilīšu,

3. _sag-bi sila za3-e3-a_
#tr.ts: pūssu sūqum āṣītum
#tr.en: its front is the street Āṣītum,

4. _2(disz) nindan usz 1(disz) nindan sag_
#tr.ts: šinā nindan šiddum ištēn nindan pūtum
#tr.en: the length is 2 rods, the front is 1 rod;

5. _1(disz) sag-nita2_ ARAD-{d}edin
#tr.ts: ištēn wardum warad-edin
#tr.en: 1 male slave (named) Warad-edin;

6. _1(disz) sag-nita2_ lu-mur-gi-mil-{d}utu hal-qum
#tr.ts: ištēn wardum lūmur-gimil-šamaš ḫalqum
#tr.en: 1 male slave (named) Lūmur-gimil-šamaš, fugitive;

7. _1(disz) sag-nita2_ ta-ri-bu-um
#tr.ts: ištēn wardum taribum
#tr.en: 1 male slave (named) Taribum;

8. _1(disz) sag-geme2_ {d}asz-ra-tum-um-mi
#tr.ts: ištēt amtum ašratum-ummī
#tr.en: 1 female slave (named) Ašratum-ummī;

9. _ha-la_ li-pi2-it-isz8-tar2 _dumu_ sze-rum-i3-li2
#tr.ts: zītti lipit-ištar mār šērum-ilī
#tr.en: is the share of Lipit-ištar son of Šērum-ilī

10. sza _ki_ sin-ma-gir i-bi-sin
#tr.ts: ša itti sîn-māgir i(b)bi-sîn
#tr.en: that with Sîn-māgir (and) Ibbi-sîn

11. _dumu-me_ sze-rum-i3-li2
#tr.ts: mārī šērum-ilī
#tr.en: sons of Šērum-ilī (and with)

12. {disz}sin-i-din-nam u3 ri-isz-{d}utu
#tr.ts: sîn-i(d)dinam u rīš-šamaš
#tr.en: Sîn-iddinam and Rīš-šamaš

13. _dumu-me_ dingir-szu-i-bi-szu i-zu-zu
#tr.ts: mārī ilšu-i(b)bīšu izūzū
#tr.en: sons of Ilšu-ibbīšu, has shared

14. u3 ap-lu-ut la-ma-si2 _lukur {d}utu_
#tr.ts: u aplūt lama(s)si nadīt šamaš
#tr.en: and the inheritance of Lamassī nadītu of Šamaš,

15. a-ha-ti-szu-nu sza bi-ri-szu-nu
#tr.ts: aḫātīšunu ša birīšunu
#tr.en: their sister, will belong to them.

16. zi-zu ga-am-ru
#tr.ts: zīzu gamru
#tr.en: The division is completed.

17. isz-tu pe2-e a-di _ku3-sig17_
#tr.ts: ištu pê adi ḫurāṣim
#tr.en: (That) everything (lit. from chaff to gold)

@reverse
1. a-hu-um a-na a-hi-im
#tr.ts: aḫum ana aḫim
#tr.en: one against the other (lit. brother against brother)

2. u2-ul i-ra-ga-am
#tr.ts: ul ira(g)gam
#tr.en: will not claim,

3. _mu_ {d}utu {d}a-a {d}marduk
#tr.ts: nīš šamaš ayya marduk
#tr.en: (by) the name of Šamaš, Ayya, Marduk

4. u3 ha-am-mu-ra-pi2 it-mu-u2
#tr.ts: u ḫammurapi itmû
#tr.en: and Ḫammurapi they have sworn.

$ single ruling
5. _igi_ {d}nanna-tum _dumu_ na-ra-am-sin
#tr.ts: maḫar nannatum mār narām-sîn
#tr.en: Before Nannatum son of Narām-sîn;

6. _igi_ si2-li-lum _dumu_ sza-ma-ia
#tr.ts: maḫar sililum mār šamaya
#tr.en: before Sililum son of Šamaya;

7. _igi_ {d}utu-illat-su2 _dumu_ nu-ur2-{d}kab-ta
#tr.ts: maḫar šamaš-tillassu mār nūr-kabta
#tr.en: before Šamaš-tillassu son of Nūr-kabta;

8. _igi_ sin-szar-ma-tim _dumu_ i-bi-sin
#tr.ts: maḫar sîn-šar-mātim mār i(b)bi-sîn
#tr.en: before Sîn-šar-mātim son of Ibbi-sîn;

9. _igi_ dingir-szu-a-bu-szu _dumu_ i3-li2-i-din-nam
#tr.ts: maḫar ilšu-abūšu mār ilī-i(d)dinam
#tr.en: before Ilšu-abūšu son of Ilī-iddinam;

10. _igi_ i3-li2-i-din-nam _dumu_ ma-s,i-am-i3-li2
#tr.ts: maḫar ilī-i(d)dinam mār maṣiam-ilī
#tr.en: before Ilī-iddinam son of Maṣiam-ilī;

11. _igi_ szu-mi-ki# _dumu_ sin-a-bu-szu
#tr.ts: maḫar šumi-erṣetim mār sîn-abūšu
#tr.en: before Šumi-erṣetim son of Sîn-abūšu;

12. _igi_ i-din-{d}en-lil2 _dumu_ sin#-[re]-me-ni
#tr.ts: maḫar i(d)din-enlil mār sîn-rēmēni
#tr.en: before Iddin-enlil son of Sîn-rēmēni;

13. _igi_ sig-e2-a _dub-sar
#tr.ts: maḫar ipqu-ea ṭupšarrim
#tr.en: before Ipqu-ea the scribe.

14. _iti NE-NE-gar u4 2(u) 2(disz)-kam_
#tr.ts: waraḫ abim ūmam ešrā u šinā
#tr.en: The month of Abum, the day 22,

15. _mu bad3 ma2-ri2{ki} u3 ma3-al-gi4-a{ki} mu-un-gul-gul_
#tr.ts: šanat dūr mari u malgium i'but
#tr.en: the year: "(Ḫammurapi) destroyed the walls of Mari and Malgium.".

