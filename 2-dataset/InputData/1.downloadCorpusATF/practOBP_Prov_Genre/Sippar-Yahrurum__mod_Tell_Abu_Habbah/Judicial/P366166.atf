&P366166 = CT 47, 31 
#atf: lang akk 
@tablet 
@obverse 
1. a-na _5(disz) 1/2(disz) sar 5(disz) gin2 e2 du3-a_ 
#tr.ts: ana ḫamšat mišil mūšar ḫamšat siqil bītim epšim
#tr.en: Concerning the built house plot of 70 shekels

2. sza _da e2_ nu-ur2-i3-li2-szu 
#tr.ts: ša ṭēḫi bīt nūr-ilīšu
#tr.en: that is adjacent to the house of Nūr-ilīšu

3. u3# _da e2_ {d}a-a-tal-lik _lukur {d}utu_ 
#tr.ts: u ṭēḫi bīt ayya-tallik nadīt šamaš
#tr.en: and adjacent to the house of Ayya-tallik nadītu of Šamaš

4. _dumu-munus_ dingir-szu-i-bi-szu# 
#tr.ts: mārat ilšu-i(b)bīšu
#tr.en: daughter of Ilšu-ibbīšu (and)

5. sza _ki_ {d}suen-re-me-ni {disz}bur-{d}suen 
#tr.ts: ša itti sîn-rēmēni būr-sîn
#tr.en: that from Sîn-rēmēni, Būr-sîn

6. u3 geme2-{d}utu _lukur {d}utu dumu-me_ szu-{d}utu 
#tr.ts: u amat-šamaš nadīt šamaš mārī šū-šamaš
#tr.en: and Amat-šamaš nadītu of Šamaš, sons of Šū-šamaš,

7. {disz}la-ma-si2 _lukur {d}utu dumu-munus_ sin-e-ri-ba-am 
#tr.ts: lama(s)sī nadīt šamaš mārat sīn-erībam
#tr.en: Lamassī nadītu of Šamaš daughter of Sîn-erībam

8. a-na szi-im ga-me-er i-sza-mu 
#tr.ts: ana šīm gamer išamu
#tr.en: for (its) full price had bought.

9. isz-tu i-sza-mu-ma li-ba-szu-nu t,a3-bu-ma 
#tr.ts: ištu išamūma li(b)bašunu ṭābūma
#tr.en: After she bought, their (the sellers') heart was satisfied and

10. _mu 3(disz)-kam_ il-li-ku 
#tr.ts: šalāš šanātum illikū
#tr.en: 3 years passed,

11. {disz}{d}suen-re-me-ni u3 e-tel-pi4-{d}utu _dumu-ni_ 
#tr.ts: sîn-rēmēni u etel-pî-šamaš māršu
#tr.en: Sîn-rēmēni and Etel-pî-šamaš his son

12. a-na la-ma-si2 _dumu-munus_ sin-e-ri-ba-am 
#tr.ts: ana lama(s)sī mārat sîn-erībam
#tr.en: against Lamassī daughter of Sîn-erībam

13. ir-gu-mu szar-ra-am im-hu-ru-u2-ma 
#tr.ts: irgumū šarram imḫurūma
#tr.en: raised a claim (and) approached the king.

14. {disz}dingir-da-mi-iq il-li-kam-ma 
#tr.ts: ilī-damīq illikamma
#tr.en: Ilī-damīq came and

15. {disz}{d}suen-i-din-nam ra-bi-a-an zimbir{ki} 
#tr.ts: sîn-i(d)dinam rabiān sippir
#tr.en: Sîn-iddinam the mayor of Sippar,

16. _di-ku5-mesz u3 kar_ zimbir{ki} i-na _e2_ {d}utu <<i-na _e2_ {d}utu>> 
#tr.ts: dayyānū u kār sippir ina bīt šamaš
#tr.en: the judges and the kārum body of Sippar, in the temple of Šamaš

17. di-nam u2-sza-hi-zu-szu-nu-ti-ma 
#tr.ts: dīnam ušāḫizūšunūtīma
#tr.en: granted them a trial.

18. asz-szum i-na la i-di-im 
#tr.ts: aššum ina la idim
#tr.en: Since without reason

19. szar-ra-am im-hu-ru 
#tr.ts: šarram imḫuru
#tr.en: (Sîn-rēmēni) approached the king

@reverse 
