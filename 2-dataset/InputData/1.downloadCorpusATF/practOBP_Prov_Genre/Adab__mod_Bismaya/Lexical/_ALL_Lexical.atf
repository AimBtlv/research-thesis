20.  # melix(|KAx(GAR.SZA3.A)|) " me-li         ~ |KAx(GAR.SZA3.A)| = %a ne-em-[lu]-um#
#lem: jeli[throat]
21.  # melix(|KAxU2|)            " me-li         ~ |KAxU2|            = %a ne-em-lu#-um#
#lem: jeli[throat]
22.  # durix(|KAxUSZ|)            " du-re         ~ |KAxUSZ|           = %a ka-sa3-su2#-um#
