&P229548 = PBS 05, 145 
#atf: use lexical
#link: def A = Q000302 = Lu-azlag B and C
# CBS 11067 + CBS 11397 = MSL 12, 175 G 
@tablet
@obverse
@column 1
1. lu2 hul-gig = %a ze2?#-e-rum# & %s [lu2 hul]-gig# = %a ze2-e-rum
>>A Seg.1, 42
2. lu2 szag4 hul-gig ab-szesz4-a = %a sza# li-ib-ba#-szu ze2-ru-tam pa-asz-szu & %s lu2# szag4# hul-gig ab-szesz4-a = %a sza li-ib-ba-szu ze2-ru-tam pa-asz-szu
>>A Seg.1, 43
3. lu2# szag4 hul ak = %a na-an-ze2-rum & %s lu2 szag4 hul-gig = %a na-ASZ-ze2-rum
>>A Seg.1, 44
4. lu2# erim2# = %a ra-ag-gum & %s lu2# erim2 = %a ra#-ag-gum
>>A Seg.1, 45
5. lu2# erim2# DU# = %a a-a-bu#-um# & %s lu2# erim2# DU = %a a-a-bu-um
>>A Seg.1, 46
6. lu2# kasz4#-e# = %a la-si-mu-um & %s lu2#-kasz4-e# = %a la#-si-mu-um
>>A Seg.1, 47
7. lu2# im2#-ma# = %a sza#-a-nu-u2 & %s lu2# im2#-ma# = %a sza-a-nu-u2
>>A Seg.1, 48
8. lu2# dub3# tuku = %a be2-el2 bi-ir-ki & %s lu2# dub3 tuku = %a be2#-el2 bi-ir-ki
>>A Seg.1, 49
9. [lu2 usu tuku] = %a [be-el e-mu-qi2] & %s [lu2] usu(|[A2].KAL#|)# tuku = %a be-el e-mu-qi2#
>>A Seg.1, 50
10. lu2 nig2 [tuku] = %a [sza-a-ru]-u2# & %s lu2# [nig2 tuku] = %a sza#-a-ru-u2
>>A Seg.1, 51
11. lu2 nig2 nu-tuku# = %a [la-ap]-nu-um# & %s lu2# nig2# [nu-tuku] = %a [la-ap]-nu#-um#
>>A Seg.1, 52
12. lu2 nig2 tuku-tuku = %a ra#-a#-szu-u2# & %s lu2# nig2# tuku#-[tuku] = %a [ra-a]-szu#-u2#
>>A Seg.1, 53
13. lu2# ni2# tuku# = %a na-ah-du# & %s lu2 ni2 [tuku] = %a [na]-ah#-du#
>>A Seg.1, 54
14. lu2# ig# tuku# = %a ug-gu#-gum & %s lu2# ig [tuku] = %a ug#-gu#-gum#
>>A Seg.1, 55
15. [...] = %a [sza ka]-as2-pa-am# i#-szu#-u2# & %s lu2# ku3# [tuku] = %a [sza] ka#-as2#-pa#-am# i#-szu#-u2#
>>A Seg.1, 56
16. [...] = %a [x (x)]-x-am# i#-szu#-u2# & %s lu2# [...] = %a [...]-am# i#-szu#-u2#
>>A Seg.1, 57
17. [...] = %a [...] & %s lu2# [...] = %a [...]-u2#
>>A Seg.1, 58
$ broken

