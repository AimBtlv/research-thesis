&P349923 = MSL 13, 243
#atf: use lexical
#Ni 10149
#MSL 13, 243 text E
#copy Geers
1'. [gu3-(...)] = %a  [...]-um#
2'. [gu3-...] = %a  [ri-ig-mu-um] sza# ki-ma [...] il#-bu-u2
3'. [gu3-...] = %a  [x-x]-x#-tum#
4'. [gu3-...] = %a  [ri]-ig#-mu-um ra-ap-szum
5'. gu3# KA#-AN-NI-SI = %a  ri#-ig#-mi isz-ta-ra-an
6'. gu3# hul2-la = %a  ri-gi4-im hi-e-du-u2-tim
7'. gu3#-mur ak = %a  qar-du-um
8'. [gu3]-de2-de2 = %a  gu2-di-id-du-u2
9'. [gu3] de2#-a = %a  na-bu-u2
10'. [gu3] ga2#-ga2 = %a  ri-ig-mu-um na-du-u2
11'. [gu3-...] szub [...] x#-x# = %a  ri-ig-mu-um# ka x# di?-e-im mu-qu2-x
12'. [eme] = %a  [li]-sza#-nu-um
13'. [eme hul] = %a  [li]-sza-nu#-um# le-mu-ut-tum
14'. [eme ...] = %a  [x]-x#-x#-mu-tum
15'. [eme an-tuk] = %a  [li]-sza#-nam i-szu
16'. [eme ...] = %a  [...]-x#-ku-u2-um#
17'. [eme ...] = %a  [...]-x#-[x]
@reverse
1'. nundun#-[...]-x# = %a [...]
2'. nundun HAR = %a [...]
3'. nundun gid2-da = %a [...]
4'. nundun pe-el = x#-x#-[...]
5'. nundun gun3-gun3 = %a  ku-uz-zu#-[bu-um]
6'. nundun du10-ga = %a  t,a-a-ba-tum#
7'. nundun bur2-re balag-ga2 = %a  na-sa3-a-sum2
8'. nundun gu-bar-ra = %a  sza-ap-ta-an sza i-na qa2-e bi-e-[ra/sza]
9'. usz11 = %a  im-tum
10'. usz11-musz = %a  i-ma-at [s,e-ri-im]
11'. usz11 pirig-ga2 = %a  i-ma-at [la-bi-im]
12'. usz11 szum2-mu = %a  im#-[tum ...]
13'. usz11 ga-[x] = %a  [...]
14'. usz11# [...] = %a  [...]
15'. usz11# [...] = %a  [...]
