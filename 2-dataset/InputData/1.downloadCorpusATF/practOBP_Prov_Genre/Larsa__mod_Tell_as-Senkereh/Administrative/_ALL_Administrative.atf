#tr.en: Ubārrum, 
2. _dumu#_ i3-li2-ma-li-[ki] 
#tr.en: son of Ilī-mālikī, 
3. _ARAD2#_ {d}AN#-mar#-tu# 
#tr.en: servant of An-Martu. 
@seal 4 
