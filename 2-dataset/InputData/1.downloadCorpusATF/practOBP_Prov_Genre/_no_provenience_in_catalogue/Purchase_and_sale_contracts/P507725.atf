&P507725 = BAP 030
#atf: lang akk 
@tablet 
@obverse 
1. _1(disz) sar 1(u) gin2 e2 du3-a_ 
#tr.ts: ištēn mūšar ešret siqil bītum epšum
#tr.en: A built house plot of 70 shekels

2. _da e2_ mu-na-wi-rum 
#tr.ts: ṭēḫi bīt muna(w)wirum
#tr.en: next to the house of Munawwirum

3. u3 _da e2_ a-ra-ar-rum 
#tr.ts: u ṭēḫi bīt ararrum
#tr.en: and next to the house of Ararrum,

4. _sag-bi e-sir2_ 
#tr.ts: pūssu sūqum
#tr.en: its front is the street,

5. _egir-bi e2_ an-pi4-sza 
#tr.ts: warkassu bīt anum-pîša
#tr.en: its rear is the house of Anum-pîša,

6. _e2_ {d}nanna-tum {disz}e-tel-pi4-{d}marduk 
#tr.ts: bīt nannatum etel-pî-marduk
#tr.en: is the house of Nannatum, Etel-pî-marduk

7. u3 gi-mil-{d}marduk 
#tr.ts: u gimil-marduk
#tr.en: and Gimil-marduk

8. _dumu-mesz_ a-ra-ar-rum 
#tr.ts: mārī ararrum
#tr.en: sons of Ararrum (which)

9. _ki_ {d}nanna-tum {disz}e-tel-pi4-{d}marduk 
#tr.ts: itti nannatum etel-pî-marduk
#tr.en: from Nannatum, Etel-pî-marduk

10. u3 gi-mil-lum 
#tr.ts: u gimillum
#tr.en: and Gimillum,

11. _lugal e2-a-ke4_ 
#tr.ts: bēlī bītim
#tr.en: owners of the house,

12. {disz}gi-mil-lum _dumu_ i-tur-dingir 
#tr.ts: gimillum mār itūr-ilum
#tr.en: Gimillum son of Itūr-ilum

13. _in-szi-in-sa10_ 
#tr.ts: išām
#tr.en: has bought;

14. _sa10 til-la-bi-sze3_ 
#tr.ts: ana šīmīšu gamrim
#tr.en: as its full price,

15. _1/3(disz) ma-na 4(disz) 1/2(disz) gin2 ku3-babbar_ 
#tr.ts: šaluš manā erbet u mišil šiqil kaspam
#tr.en: 24 and a half shekels of silver

16. _in-na-an-la2_ 
#tr.ts: išqul
#tr.en: he has paid.

@reverse 
1. _u4 kur2-sze3 lu2 lu2-ra_ 
#tr.ts: ana warkiāt ūmim awīlum ana awīlim
#tr.en: That in future one against the other

2. _inim nu-um-ga2-ga2-a_ 
#tr.ts: ul iraggumu
#tr.en: will not raise a claim,

3. _mu_ {d}marduk u3 ha-am-mu-ra-pi2 _lugal_ 
#tr.ts: niš marduk u ḫammurapi šarrim
#tr.en: (by) the name of Marduk and Ḫammurapi the king

4. _in-pa3-de3-esz_ 
#tr.ts: itmû
#tr.en: they have sworn.

5. _igi_ i-t,ib-li-ib-<ba>-szu _dumu_ {d}suen-ga-mil 
#tr.ts: maḫār iṭib-libbašu mār sîn-gāmil
#tr.en: Before Iṭib-libbašu son of Sîn-gāmil;

6. _igi_ i-li-szu-nu-ti _dumu_ a-hu-ni 
#tr.ts: maḫār ilīšunūti mār aḫuni
#tr.en: before Ilīšunūti son of Aḫuni;

7. _igi_ {d}marduk-na-s,ir _dumu_ {d}suen-i-qi2-sza-[am] 
#tr.ts: maḫār marduk-nāṣir mār sîn-iqīšam
#tr.en: before Marduk-nāṣir son of Sîn-iqīšam;

8. _igi_ {d}iszkur-na-da _dumu_ a-bi-ia x x x 
#tr.ts: maḫār adad-nada mār abīya ...
#tr.en: before Adad-nada son of Abīya ...;

9. _igi_ hu-za-lum _dumu_ {d}marduk-na-s,ir 
#tr.ts: maḫār ḫuzalum mār marduk-nāṣir
#tr.en: before Ḫuzalum son of Marduk-nāṣir;

10. _igi_ szu-te-szu-ra-szum _dumu_ e-tel-pi4-{d}na-bi-um 
#tr.ts: maḫār šutēšurāšum mār etel-pî-nabium
#tr.en: before Šutēšurāšum son of Etel-pî-nabûm;

11. _igi_ u-bar-rum _dumu_ sza-dingir 
#tr.ts: maḫār ubarrum mār ša-ilum
#tr.en: before Ubarrum son of Ša-ilum;

12. _igi_ il-lu-lum _dumu_ dingir-ma 
#tr.ts: maḫar illulum mār ilūma
#tr.en: before Illulum son of Ilūma;

13. _igi_ sig-esz18-dar _dumu_ ma-ta-tum 
#tr.ts: maḫār ipqu-ištar mār matatum
#tr.en: before Ipqu-ištar son of Matatum;

14. _igi_ na-bi-i3-li2-szu _dub-sar_ 
#tr.ts: maḫār nabi-ilīšu ṭupšarrim
#tr.en: before Nabi-ilīšu the scribe.

