&P291972 = Model Contracts pl. 12-14 
#atf: lang sux 
@tablet 
@obverse 
1. 1(u) 5(disz) 1/2(disz) gin2 ku3-[babbar] 
#tr.en: 15 1/2 shekels of silver, 
2. masz2 1(disz) gin2 igi 5(disz)#-[gal2 ba-an]-tuku# 
#tr.en: having interest at 1/5 shekel per shekel, 
3. ki i-dam-i3-li2 
#tr.en: from Idam-ili 
4. {disz}szu-{d}lugal 
#tr.en: Šu-Haniš 
5. u3 tesz2-me-{d}nin-gal# dam#-a-ni 
#tr.en: and Tašme-Ningal, his wife, 
6. szu# ba-an-ti-me-esz 
#tr.en: received. 
7. iti {gesz}apin-du8-a 
#tr.en: In the month Arahsamnu 
8. <sag ku3-babbar> u3# ku3 masz2-bi 
#tr.en: the capital silver and the silver (of) its interest 
9. i3-la2-e-me-esz 
#tr.en: they shall pay.
10. szu-du3-a# 
#tr.en: The surety 
11. {disz}szu#-{d}lugal# 
#tr.en: (for) Šu-Haniš 
@reverse 
1. [u3 tesz2-me-{d}]nin#-gal-[ra] 
#tr.en: and Tašme-Ningal 
2. {disz}ar-bi-tu-ra#-[am] 
#tr.en: Arbi-turam 
3. in-de6! 
#tr.en: pledged. 
4. tukum-bi 
#tr.en: If 
5. {disz}szu#-{d}lugal 
#tr.en: Šu-Haniš 
6. u3 tesz2-me-{d}nin-gal dam-a-ni 
#tr.en: and Tašme-Ningal, his wife, 
7. u2-gu ba#-an-de2 
#tr.en: disappear, 
8. {disz}ar-bi-tu-ra#-am 
#tr.en: Arbi-turam 
9. sag ku3-babbar u3 ku3 masz2-bi 
#tr.en: the capital silver and the silver (of) its interest 
10. i3-la2-e-me-esz 
#tr.en: shall pay.

