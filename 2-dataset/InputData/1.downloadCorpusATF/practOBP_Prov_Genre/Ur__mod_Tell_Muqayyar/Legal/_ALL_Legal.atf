#tr.ts: nūr-šamaš
#tr.en: Nūr-šamaš
2. _gala-mah_ {d}nanna 
#tr.ts: galmāḫum ša nanna
#tr.en: chief singer of Nanna
3. _ARAD_ {d}utu u3 {d}nin-szubur 
#tr.ts: warad šamaš u nin-šubur
#tr.en: servant of Šamaš and Nin-šubur
@seal 3 
1. il3-szu-a-bu-[szu] 
#tr.ts: ilšu-abūšu
