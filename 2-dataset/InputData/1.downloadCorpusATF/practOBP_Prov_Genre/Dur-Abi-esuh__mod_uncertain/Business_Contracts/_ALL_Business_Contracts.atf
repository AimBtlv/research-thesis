&P325258 = CUSAS 08, 007
#atf: lang akk
@tablet
@obverse
1. [n] 5(disz) _gin2 ku3-babbar_
#tr.ts: n ḫamšat šiqil kaspam
#tr.en: n+5 shekels of silver

2. [a]-na# _sa10 sag-nita2_
#tr.ts: ana šīm warad
#tr.en: for the purchase of a healty slave
#healty from the next line.

3. _iri bad3-an{ki}_ nam-ri
#tr.ts: āli badan namri(m)
#tr.en: from (lit. of) the city of Bad An

4. sza i-din-{d}marduk _ugula e2_ {d}nin-urta
#tr.ts: ša i(d)din-marduk akil bīt ninurta
#tr.en: that Iddin-marduk overseer of the Ninurta's temple

5. a-na {d}en-lil2-mu-ba-li2-it, _nu-esz3_
#tr.ts: ana enlil-muba(l)liṭ nešakkim
#tr.en: to Enlil-muballiṭ the nešakku-priest

6. _dumu_ ur-{d}sa-dara4-nun-na
#tr.ts: mār ur-sadaranunna
#tr.en: son of Ur-sadaranunna

7. id-di-nu
#tr.ts: iddinu
#tr.en: has given.

8. a-na _iti 1(disz)-kam_
#tr.ts: ana ištēn waḫrim
#tr.en: Within one month,

9. _1(disz) sag-nita2 iri bad3-an{ki}_ nam-ra
#tr.ts: ištēn warad āli badan namra(m)
#tr.en: 1 healty slave from the city of Bad An

10. ub-ba-lam
#tr.ts: ubbalam
#tr.en: will bring.
.
11. _dam-gar3_-su2 in-ne-ep-pu-usz-ma
#tr.ts: tamkārūssu inneppušma
#tr.en: His bill will be settled and

@reverse
1. _ib2#-tag4_ a-na ma-li-i
#tr.ts: šittum ana malî(m)
#tr.en: the remainder in full

2. i-na-ap-pa-al
#tr.ts: inappal
#tr.en: will be paid.

$ single ruling
3. _igi_ dingir-ma-an-szum2 _dumu_ lu2-{d}nusku
#tr.ts: maḫar ilum-manšum mār awīl-nusku
#tr.en: Before Ilum-manšum son of Awīl-nusku;

4. _igi_ qur2-di-esz18-tar2 _dumu_ dingir-ma-an-szum2
#tr.ts: maḫar qurdi-ištar mār ilum-manšum
#tr.en: before Qurdi-ištar son of Ilum-manšum;
;
5. _igi_ a-li2-ba-ni-szu _dumu_ ARAD-i3-li2-szu
#tr.ts: maḫar ali-bānīšu mār warad-ilīšu
#tr.en: before Ali-bānīšu son of Warad-ilīšu;

6. _igi_ ip-qu2-{d}en-lil2
#tr.ts: maḫar ipqu-enlil
#tr.en: before Ipqu-enlil.

$ single ruling
$ blank space
$ seal impression
7. _iti GAN2-GAN2-e2 u4 1(disz)-kam_
#tr.ts: waraḫ kislīmim ūmam ištēnum
#tr.en: The month of Kislīmum, the day 1,

8. _mu_ am-mi-s,a-du-qa2 _lugal-e alan#-a-ni szu silim-ma ab-di-di-e-de3#_
#tr.ts: šanat ammi-ṣaduqa šarrum ṣalamšu šulmam qābiam
#tr.en: the year: "Ammi-ṣaduqa the king (brought into Emeteursag) a statue (representing him) uttering a prayer.".

