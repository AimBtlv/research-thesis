&P325274 = CUSAS 08, 002
#atf: lang akk
@tablet
@obverse
1. 1(disz) _sag-geme2_ i-na-li-ib-bi-er-szi-et _mu-ni_
#tr.ts: ištēn amtum ina-libbi-eršiet šumša
#tr.en: One female slave, Ina-libbi-eršiet is her name,

2. _sza3_ ki-szi-it-ti ka-kal-a{ki}
#tr.ts: ina libbi kišitti Kagala
#tr.en: from the booty of Kagala,

3. _iri_ sza sukkal{ki}
#tr.ts: āli sukkal
#tr.en: the city of Sukkal, is

4. _sag-geme2_ dingir-szu-ib-ni u3 ri-isz-{d}marduk
#tr.ts: amat ilšu-ibni u rīš-marduk
#tr.en: the female slave of Ilšu-ibni and Rīš-marduk

5. _dumu-mesz_ szum-ma-dingir
#tr.ts: mārī šumma-ilum
#tr.en: sons of Šumma-ilum.

6. _ki_ dingir-szu-ib-ni _u3_ ri-isz-{d}marduk
#tr.ts: itti ilšu-ibni u rīš-marduk
#tr.en: From Ilšu-ibni and Rīš-marduk

7. _dumu-mesz_ szum-ma-dingir
#tr.ts: mārī šumma-ilum
#tr.en: sons of Šumma-ilum,

8. be-lu _sag-geme2_
#tr.ts: bēlū amtim
#tr.en: the masters of the slave,

9. a-na qa2-be2-e a-li2-ta-li-mi _dumu_ {d}nin-urta-si-li-im
#tr.ts: ana qabê ali-talīmi mār ninurta-silim
#tr.en: on behalf of Ali-talīmi son of Ninurta-silim,

10. {d}en-lil2-ma-an-szum2 _nu-esz3_
#tr.ts: enlil-manšum nešakkum
#tr.en: Enlil-manšum the the nešakku-priest

11. _in-szi-in-sa10_
#tr.ts: išam
#tr.en: has bought.

12. _sa10 til-la-bi-sze3_
#tr.ts: ana šīmīša gamrim
#tr.en: For her full price,

13. _1(u) 1/3(disz) gin2 ku3-babbar in-na-an-la2_
#tr.ts: ešret u šaluš šiqil kaspam išqul
#tr.en: he has paid 1860 grains of silver

14. _u3 igi 6(disz)-gal2 si-bi_ isz-ku-un
#tr.ts: u šuduš šiqlam atrīša iškun
#tr.en: and 30 grains (of silver) he has established as her additional payment.

15. _3(disz) u4_-mi te-eb-i-tum
#tr.ts: šalāšat ūmī teb'ītum
#tr.en: Three days (for) the inspection,

16. _iti 1(disz)-kam_ be2-en-nu
#tr.ts: ištēn waḫrum bennu(m)
#tr.en: one month (for the slave’s contracting) epilepsy.

17. a-na ba-aq-ri-sza ki-ma s,i-im-da-at _lugal_
#tr.ts: ana baqrīša kīma ṣimdat šarrim
#tr.en: For claims on her, in accordance with the royal decree,

@reverse
1. iz-za-az-ma
#tr.ts: izzazma
#tr.en: (the sellers) are (lit. is) the only responsible.

$ single ruling
2. _igi_ {d}nin-urta-mu-sza-lim _nu-esz3_
#tr.ts: maḫar ninurta-muša(l)lim nešakkim
#tr.en: Before Ninurta-mušallim, nešakku-priest;

3. _igi_ nu-ur2-{d}en-lil2 _nu-esz3_
#tr.ts: maḫar nūr-enlil nešakkim
#tr.en: before Nūr-enlil, nešakku-priest;

4. _igi_ {d}utu-ma-an-szum2 _{lu2}lunga {d}en-lil2-la2_
#tr.ts: maḫar šamaš-manšum sīrāš enlil
#tr.en: before Šamaš-enlil, brewer of Enlil;

5. _igi_ {d}en-lil2-be-el-i3-li2 _dumu_ lugal-ab-ba-a-ni
#tr.ts: maḫar enlil-bēl-ilī mār lugal-abbani
#tr.en: before Enlil-bēl-ilī son of Lugal-abbani;

6. _igi_ {d}nanna-ma-an-szum2 _gudu4_ {d}nin-urta
#tr.ts: maḫar nanna-manšum pašīš ninurta
#tr.en: before Nanna-manšum, pašīšu-priest of Ninurta;

7. _igi_ a-wi-il-{d}utu _dumu_ {d}sze-rum-ba-ni
#tr.ts: maḫar awīl-šamaš mār šerum-bānī
#tr.en: before Awīl-šamaš son of Šerum-bānī;

8. _igi_ ur-{d}sa-dara3-nun-na _{lu2}lunga {d}en-lil2-la2_
#tr.ts: maḫar ur-sadaranunna sīrāš enlil
#tr.en: before Ur-sadaranunna, brewer of Enlil.

$ single ruling
$ blank space
$ seal impression
9. _iti ab-e3 u4 2(u)-kam_
#tr.ts: waraḫ ṭebētim ūmam ešrā
#tr.en: The month of Ṭebētum, the day 20,

10. _mu_ am-mi-s,a-du-qa2 _lugal-e alan-a-ni masz2 igi-du8-a szu#-[a-ni an-da-gal2-la] u3 alan-a-ni szud3 ab-be2-a e2-nam-ti-la-sze3 in-ne-en-ku4#-[ra]
#tr.ts: šattum ša ammi-ṣaduqa šarrum ṣalamšu ša urīṣam ana tāmartim ina qātīšu ibaššû u ṣalamšu qābi ikribim ana enamtila ušēribu
#tr.en: the year (in) which Ammi-ṣaduqa the king brought into the Enamtila a statue of himself in which he held a lamb as a gift in (his) hand and a statue of himself offering prayer.

# some text moved to preceding line
