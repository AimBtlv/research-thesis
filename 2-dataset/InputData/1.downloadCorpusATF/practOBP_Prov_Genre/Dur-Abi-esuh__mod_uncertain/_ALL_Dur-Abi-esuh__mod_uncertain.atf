&P325278 = CUSAS 08, 001
#atf: lang akk
@tablet
@obverse
1. 1(disz) _sag-nita2 tur-ra_ {d}utu-tap-pi2-i3-li2-ia _mu-ni_
#tr.ts: ištēn wardum šerrum šamaš-tappî-ilīya šumšu
#tr.en: One young slave, šamaš-tappî-ilīya is his name,

2. wi-li-id _e2_ nibru{ki}
#tr.ts: wilid bīt nippur
#tr.en: house-born from Nippur, is

3. _sag-nita2_ lu2-{d}nin-urta _dumu#_ {d#}en#-lil2-ni-szu
#tr.ts: warad awīl-ninurta mār enlil-nīšu
#tr.en: the slave of Awīl-ninurta son of Enlil-nīšu.

4. _ki_ lu2-{d}nin-urta _dumu#_ {d#}en#-lil2-ni-szu
#tr.ts: itti awīl-ninurta mār enlil-nīšu
#tr.en: From Awīl-ninurta son of Enlil-nīšu,

5. be-li2-szu
#tr.ts: bēlīšu
#tr.en: his master,

6. {disz}sza-al-li-lu-mu-ur
#tr.ts: šalli-lūmur
#tr.en: Šalli-lūmur

7. _dumu_ {d}nin-urta-apin
#tr.ts: mār ninurta-ēriš
#tr.en: son of Ninurta-ēriš

8. _in-szi-in-sa10_
#tr.ts: išam
#tr.en: has bought.

9. _sa10 til-la-bi-sze3_
#tr.ts: ana šīmīšu gamrim
#tr.en: For his full price,

10. _1/3(disz) ma-na ku3-babbar_
#tr.ts: šaluš manā kaspam
#tr.en: 20 shekels of silver

11. _in-na-an-la2_
#tr.ts: išqul
#tr.en: he has paid

12. _u3 1/3(disz) gin2 ku3-babbar_
#tr.ts: u šaluš šiqil kaspam
#tr.en: and 60 grains of silver

13. _si-bi_ isz-ku-un
#tr.ts: atrīšu iškun
#tr.en: he has established as his additional payment.

@reverse
1. 3(disz) _u4_-mi te-eb-hi-tum
#tr.ts: šalāšat ūmī teb'ītum
#tr.en: Three days (for) the inspection,

2. _iti 1(disz)-kam_ be-en-nu
#tr.ts: ištēn waḫrum bennu(m)
#tr.en: one month (for the slave’s contracting) epilepsy.

3. a-na ba-aq-ri-szu
#tr.ts: ana baqrīšu
#tr.en: For claims on him,

4. ki-ma s,i-im-da-at _lugal_
#tr.ts: kīma ṣimdat šarrim
#tr.en: in accordance with the royal decree,

5. iz-za-az
#tr.ts: izzaz
#tr.en: (the seller) is responsible.

6. _igi_ {d}nin-urta-mu-ba-li2-it, _di-ku5_
#tr.ts: maḫar ninurta-muba(l)liṭ dayyānim
#tr.en: Before Ninurta-muballiṭ, judge;

7. _igi_ gi-mil-i3-li2-szu _{lu2}lunga {d}en-lil2-la2_
#tr.ts: maḫar gimil-ilīšu sīrāš enlil
#tr.en: before Gimil-ilīšu, brewer of Enlil;

8. _igi_ dingir-szu-ib-ni-szu _dumu ugula dam-gar3_
#tr.ts: maḫar ilšu-ibnīšu mār akil tamkārim
#tr.en: before Ilšu-ibnīšu, son of the merchant(s) overseer;

9. _igi_ u2-ba-a _simug_
#tr.ts: maḫar ubaya nappāḫim
#tr.en: before Ubaya, smith;

10. _igi_ dingir-szu-ba-ni _dub-sar_
#tr.ts: maḫar ilšu-bānī ṭupšarrim
#tr.en: before Ilšu-bānī the scribe.

$ single ruling
$ blank space
@top
1. _[iti] apin#-du8-a u4 2(u) 1(disz)-kam_
#tr.ts: warah kinūnim ūmam ešrā u ištēn
#tr.en: The month of Kinūnum, the day 21,

2. [_mu_ am]-mi-di-ta-na _lugal#-e {[d]}lamma {d}lamma bar su3-ga-ke4_
#tr.ts: šattum ša ammi-ditana šarrum lamassāt zumrī rīšī
