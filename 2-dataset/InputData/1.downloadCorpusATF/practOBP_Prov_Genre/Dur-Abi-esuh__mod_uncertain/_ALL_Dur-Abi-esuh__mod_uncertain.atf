#tr.en: thus Lugal-gubani: 
4. {d}en-lil2 li-ba-al-li-it,#-ka 
#tr.en: “May Enlil keep you in good health! 
5. {disz}sa3-ap-hu-li-ip-hur 
#tr.en: Sapḫu-lipḫur, 
6. sza#? ip#?-<pa?>-ar-ku 
#tr.en: who stopped work (?), 
