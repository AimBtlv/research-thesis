&P325290 = CUSAS 08, 025 
#atf: lang akk 
@tablet 
@obverse 
1. _3(u) 1(disz) udu szu-gi-na_ 
#tr.ts: šalāšā u ištēn immerū šuginim
#tr.en: 31 sheep for the daily offerings,

2. szi-ta-at _udu szu-gi-na_ 
#tr.ts: šītat immerī šuginim
#tr.en: the rest of the sheep for the daily offerings

3. sza _iti bara2-za3-gar_ 
#tr.ts: ša waraḫ nišānim
#tr.en: of the month of Nišanum

4. sza i-na _iti gu4-si-sa2_ 
#tr.ts: ša ina waraḫ ayyarim
#tr.en: that in the month of Ayyarum,

5. a-na _szuku {d}en-lil2 {d}nin-lil2-la2_ 
#tr.ts: ana kurummat enlil ninlil
#tr.en: as food offering for Enlil, Ninlil,

6. {d}nin-urta {d}nusku 
#tr.ts: ninurta nusku
#tr.en: Ninurta, Nusku

7. _u3 esz3-esz3-hi-a_ sza nibru{ki} 
#tr.ts: u eššešī ša nibru
#tr.en: and the eššešum-festivals of Nippur,

8. {disz}ARAD-{d}be-le-tim s,u2-ha-ru 
#tr.ts: warad-bēlētim ṣuḫāru(m)
#tr.en: Warad-bēlētim, the servant

9. sza na-bi-{d}en-lil2 _ugula dam-gar3_ 
#tr.ts: ša nabi-enlil akil tamkarim
#tr.en: of Nabi-enlil the overseer of the merchant(s),

10. a-na _bad3_-a-bi-e-szu-uh{ki} 
#tr.ts: ana dūr-abiešuḫ
#tr.en: at Dūr-abiešuḫ,

11. sza _gu2!-hi!-a i7_ ha-am-mu-ra-pi2 nu-hu-usz ni-szi  
#tr.ts: ša kišādāt nār ḫammurapi-nuḫus-nišī
#tr.en: on the banks of the canal "Ḫammurapi-nuḫus-nišī",

12. ub-lam 
#tr.ts: ublam
#tr.en: has brought.

13. nam-har-ti 
#tr.ts: namḫarti
#tr.en: Received (by)

@reverse 
1. _nu-esz3-mesz gudu4-mesz {d}nin-lil2-la2_ 
#tr.ts: nešakkī gudapsī ninlil
#tr.en: the nešakku (and) gudapšu priests of Ninlil

2. _u3 gudu4-mesz {d}nin-urta_ 
#tr.ts: u gudapsī ninurta
#tr.en: and the gudapšu-priests of Ninurta,

3. e-zu-ub _1(u) 6(disz) udu szu-gi-na_ 
#tr.ts: ezub šeššeret immerī šuginim
#tr.en: apart from the 16 sheep for the daily offerings

4. _sza3 udu szu-gi-na_ sza bara2-za3-gar 
#tr.ts: libbum immerī šuginim ša nišānim
#tr.en: from the sheep for the daily offerings for Nisānum

5. sza a-di-ni la ib-ba-ab-ba-lam 
#tr.ts: ša adīni la ibbabbalam
#tr.en: that have not yet been brought.

$ single ruling 
$ blank space 
6. _iti gu4-si-sa2 u4 7(disz)-kam_ 
#tr.ts: waraḫ ayyarim ūmam sebetti
#tr.en: The month of Ayyarum, the day 7,

7. _mu_ am-mi-s,a-du-qa2 _lugal-e uruda alan sza3-asz-sza4-a-ni e2-sag-il2-la-ta mi-ni-in-tum2-ma_ 
# some text moved to preceding line
#tr.ts: šattum ša ammi-ṣaduqa šarrum ṣalmam ša werîm gitmālīšu ša ina esagila ublam
#tr.en: the year (in) which Ammi-ṣaduqa the king (brought into the Ebabbar) a statue of copper (for Papnunna) his perfect (prince) that carried out of Esagila.

@left 
