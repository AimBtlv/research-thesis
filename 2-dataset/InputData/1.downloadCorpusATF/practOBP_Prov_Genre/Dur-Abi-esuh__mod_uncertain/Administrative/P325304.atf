&P325304 = CUSAS 08, 023
#atf: lang akk
@tablet
@obverse
1. _4(u) 3(disz) udu szu-gi-na_
#tr.ts: erbâ u šalāšat immerū šuginim
#tr.en: 43 sheep for the daily offerings,

2. sza a-na _szuku_ {d}en-lil2 {d}nin-lil2 {d}nin-urta {d}nusku
#tr.ts: ša ana kurummat enlil ninlil ninurta nusku
#tr.en: which (are) as food offering for Enlil, Ninlil, Ninurta, Nusku

3. _u3 esz3-esz3-hi-a_ sza nibru{ki}
#tr.ts: u eššešī ša nibru
#tr.en: and the eššešum-festivals of Nippur

4. sza _iti sze-saga11-ku5_
#tr.ts: ša waraḫ addarim
#tr.en: during the month of Addarum

5. sza _mu_ am-mi-s,a-du-qa2 _lugal-e {gesz}dur2-gar ku3-sig17-ga-a ki-bad-ra2-asz i3-tum2-ma_
# some text moved to preceding line
#tr.ts: ša šanat ammi-ṣaduqa šarrum kussiam ša ḫurāṣim ša ana nasīkātim ušallaku
#tr.en: of the year "Ammi-ṣaduqa the king (brought into the Enamtila) a golden throne which was suitable for the temple sanctum.",

6. sza mi-li2-{d}utu _ugula dam-gar3_
#tr.ts: ša ṣillī-šamaš akil tamkarim
#tr.en: that Ṣillī-šamaš, the overseer of the merchant(s),

7. a-na nibru{ki} ub-lu
#tr.ts: ana nibru ublu
#tr.en: has brought to Nippur.

8. nam-har-ti
#tr.ts: namḫarti
#tr.en: Received (by):

9. {disz}giri3-ni-i3-sa6 _nu-esz3_
#tr.ts: girni-išag nešakkim
#tr.en: Girni-išag, the nešakku-priest;

10. {disz}{d}en-lil2-ma-an-szum2 _nu-esz3_
#tr.ts: enlil-manšum nešakkim
#tr.en: Enlil-manšum, the nešakku-priest

11. _u3 nu-esz3-mesz_ ah-hi-szu-nu
#tr.ts: u nešakkī aḫḫīšunu
#tr.en: and their fellow nešakku-priests;

12. {disz}{d}marduk-mu-ba-li2-it, _gudu4_
#tr.ts: marduk-muba(l)liṭ gudapšîm
#tr.en: Marduk-muballiṭ, the gudapšu-priest;

13. {disz}giri3-ni-i3-sa6 _gudu4_
#tr.ts: girni-išag gudapšîm
#tr.en: Girni-išag, the gudapšu-priest;

@reverse
1. {disz}{d}en-lil2-ni-szu _gudu4_
#tr.ts: enlil-nīšu gudapšîm
#tr.en: Enlil-nīšu, the gudapšu-priest;

2. {disz}na-bi-{d}en-lil2 _gudu4_
#tr.ts: nabi-enlil gudapšîm
#tr.en: Nabi-enlil, the gudapšu-priest

3. _u3 gudu4-mesz_ ah-hi-szu-nu
#tr.ts: u gudapsī aḫḫīšunu
#tr.en: and their fellow gudapšu-priests.

4. sza a-na pi2-i _dub_-pi2
#tr.ts: ša ana pî ṭuppi(m)
#tr.en: This (is) in agreement with the content of the tablet,

5. sza i-din-{d}mar-tu _gal-ukken-na_
#tr.ts: ša i(d)din-amurru mu'irrum
#tr.en: that Iddin-amurrum the commander

6. a-na i3-li2-i-qi2-sza-am a-bi _erin2_
#tr.ts: ana ilī-iqīšam abi ṣābim
#tr.en: to Ilī-iqīšam the official

7. u2-sza-bi-lam
#tr.ts: ušabilam
#tr.en: has sent,

8. ik-ka-an-ku
#tr.ts: ikkanku
#tr.en: (tablet which is) sealed.

$ single ruling
9. _giri3_ i-din-{d}nin-urta _sza13-dub-ba_
#tr.ts: šēp i(d)din-ninurta šandabakkim
#tr.en: Under the authority of Iddin-ninurta, the archivist;

10. {disz}{d}utu-lu2-ti _sza13-dub-ba_
#tr.ts: šamaš-luti šandabakkim
#tr.en: Šamaš-luti, the archivist

11. _u3_ {d}suen-i-din-nam _sza3-tam e2_ {d}en-lil2
#tr.ts: u sîn-i(d)dinam šatam bīt enlil
#tr.en: and Sîn-iddinam, the administrator of Enlil's temple.

$ single ruling
12. _kaskal_ {d}na-bi-um-na-s,i-ir
#tr.ts: harrān nabium-nāṣir
#tr.en: (Transport) service of Nabium-nāṣir

13. _u3_ ib-ni-{d}mar-tu
#tr.ts: u ibni-amurrum
#tr.en: and Ibni-amurrum.

14. iti sze-saga11-ku5 u4 4(disz)-kam#_
#tr.ts: waraḫ addarim ūmam erbet
#tr.en: The month of Addarum, the day 4,

15. _mu_ am-mi-s,a-du-qa2 _lugal#-[e] {gesz}dur2-gar ku3-sig17-ga-a_
#tr.ts: šanat ammi-ṣaduqa šarrum kussiam ša ḫurāṣim
#tr.en: the year: "Ammi-ṣaduqa the king, (brought into the Enamtila) a golden throne.".

