&P306536 = YOS 02, 003
#atf: lang akk
@tablet
@obverse
1. [...] x x x x [...]
2. [qi2]-bi2-ma 
#tr.en: speak!
3. um#-ma lu-mur-sza-_{d}marduk_-ma
#tr.en: Thus (says) Lūmur-ša-Marduk:
4. _{d}utu_ li-ba-al-li-it,-ku-nu-ti
#tr.en: "May Šamaš keep you alive."
5. asz-szum sze-e-im sza sza-_ma2-du-du{ki}_
#tr.en: "Concerning the barley of (the city) Ša-malāhi,"
6. a-di isz-tu i-na-an-na _u4 2(disz) kam_
#tr.en: "within two days from now,"
7. _{gesz}ma2_ i-sa-an-ni-qa2-am
#tr.en: "the boat will arrive."
8. a-na sze-e-im szu-a-ti
#tr.en: "About this barley,
9. la te-e-gi-a
#tr.en: "do not be careless!"
@reverse
1. pi2-ha-at sze-e-im szu-a-ti e-li-ku-nu#-u2
#tr.en: "The responsibility for this barley is on you!"
2. u3 ki-ma aq-bu-ku-nu-szi-im
#tr.en: "And as I have told you,
3. a-wi-le-e e-es-ha-a-nim
#tr.en: "the men, to me assign!"
